            "tools/dev-cli/services/jaribu-aggregator-summary-gate.cs",
            "tools/dev-cli/services/release-packages.cs",
            "tools/dev-cli/services/skill-spec-lint.cs",
            "tools/dev-cli/services/template-nupkg.cs",
            "tools/dev-cli/services/template-smoke-content-assets.cs",
            "tools/dev-cli/services/template-smoke/**",
            "tools/dev-cli/services/workflow-path-classes.cs",
            "tests/tools/agent-identity-cli-tests/**",
            "tests/tools/dev-cli-tests/**",
            "source/foundation/**",
            "source/libraries/timewarp-modules/**",
            "source/libraries/timewarp-identity/**",
            "source/libraries/timewarp-402/**",
            "source/analyzers/**",
            "tests/foundation/**",
            "tests/libraries/timewarp-identity-tests/**",
            "tests/libraries/timewarp-402-tests/**",
            "tests/analyzers/**",
            "skills/**/analysis/**",
