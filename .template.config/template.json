{
  "$schema": "http://json.schemastore.org/template",
  "author": "Steven T. Cramer",
  "classifications": [
    "TimeWarp",
    "Web",
    "Blazor",
    "Hosted"
  ],
  "description": "A project template for creating a containerized or monolith solution.",
  "groupIdentity": "TimeWarp.Architecture",
  "identity": "TimeWarp.Architecture.CSharp",
  "name": "TimeWarp Architecture",
  "preferNameDirectory": true,
  "shortName": "timewarp-architecture",
  "sourceName": "TimeWarp.Architecture",
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(true)",
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "artifacts/**",
            "tools/agent-identity-cli/**",
            "tests/tools/agent-identity-cli-tests/**",
            "source/foundation/**",
            "source/libraries/timewarp-modules/**",
            "source/libraries/timewarp-identity/**",
            "source/analyzers/**",
            "tests/foundation/**",
            "tests/libraries/timewarp-identity-tests/**",
            "tests/analyzers/**"
          ]
        },
        {
          "condition": "(!grpc)",
          "exclude": [
            "source/container-apps/grpc/**",
            "source/container-apps/web/projects/web-spa/features/superhero/**",
            "source/container-apps/web/projects/web-spa/services/superhero-grpc-service-provider.cs"
          ]
        },
        {
          "condition": "(!api)",
          "exclude": [
            "source/container-apps/api/**",
            "source/container-apps/web/projects/web-spa/features/weather-forecast/**",
            "source/container-apps/web/projects/web-spa/services/mocks/mock-api-service.cs",
            "source/container-apps/web/projects/web-spa/services/api-services/api-server-api-service.cs",
            "tests/container-apps/web/web-spa-integration-tests/serialization/api-service-body-casing-tests.cs",
            "tests/common/timewarp-testing/applications/api-test-server-application.cs",
            "tests/common/timewarp-testing-tests/**",
            "tests/container-apps/api/**",
            "tests/container-apps/web/web-spa-integration-tests/features/weather-forecast/**"
          ]
        },
        {
          "condition": "(!web)",
          "exclude": [
            "source/container-apps/web/**",
            "tests/common/timewarp-testing/applications/web-test-server-application.cs",
            "tests/common/timewarp-testing/applications/spa-test-application.cs",
            "tests/common/timewarp-testing-tests/**",
            "tests/container-apps/web/**"
          ]
        },
        {
          "condition": "(!yarp)",
          "exclude": [
            "source/container-apps/yarp/**",
            "tests/common/timewarp-testing/applications/yarp-test-server-application.cs",
            "tests/container-apps/web/web-spa-integration-tests/pipeline/clone-state-behavior-tests.cs"
          ]
        },
        {
          "condition": "(!postgres)",
          "exclude": [
            "source/container-apps/web/platform/postgres/**",
            "source/container-apps/web/features/identity/ef-principal-store-infrastructure.cs",
            "tests/container-apps/web/web-infrastructure-tests/**"
          ]
        }
      ]
    }
  ],
  "symbols": {
    "grpc": {
      "type": "parameter",
      "description": "Include the grpc container app (Superheros)",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "api": {
      "type": "parameter",
      "description": "Include the api container app (Weather)",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "web": {
      "type": "parameter",
      "description": "Include the web container app",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "yarp": {
      "type": "parameter",
      "description": "Include the yarp proxy server",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "postgres": {
      "type": "parameter",
      "description": "Add Postgres Features",
      "datatype": "bool",
      "defaultValue": "true"
    }
  },
  "tags": {
    "language": "C#",
    "type": "project"
  }
}
