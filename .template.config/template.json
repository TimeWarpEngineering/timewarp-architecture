          "condition": "(!grpc)",
          "exclude": [
            "source/container-apps/grpc/**",
            "source/container-apps/web/projects/web-spa/features/superhero/**",
            "source/container-apps/web/projects/web-spa/services/superhero-grpc-service-provider.cs",
            "tests/container-apps/web/web-spa-integration-tests/features/superhero/**",
            "tests/container-apps/yarp/yarp-integration-tests/grpc-route-ingress-path-tests.cs"
          ]
        },
        {
          "condition": "(!api)",
          "exclude": [
            "source/container-apps/api/**",
            "source/container-apps/web/projects/web-spa/features/weather-forecast/**",
            "source/container-apps/web/projects/web-spa/services/mocks/mock-api-service.cs",
            "source/container-apps/web/projects/web-spa/services/api-services/api-server-api-service.cs",
            "tests/container-apps/web/web-spa-integration-tests/serialization/api-service-body-casing-tests.cs",
            "tests/common/timewarp-testing/applications/api-test-server-application.cs",
            "tests/common/timewarp-testing-tests/**",
            "tests/container-apps/api/**",
            "tests/container-apps/web/web-spa-integration-tests/features/weather-forecast/**"
          ]
        },
        {
          "condition": "(!web)",
          "exclude": [
            "source/container-apps/web/**",
            "source/container-apps/aspire/projects/aspire-app-host/web-server-resource.cs",
            "source/container-apps/aspire/projects/aspire-app-host/postgres-resources.cs",
            "tests/common/timewarp-testing/applications/web-test-server-application.cs",
            "tests/common/timewarp-testing/applications/agent-scope-approval.cs",
            "tests/common/timewarp-testing/postgres-web-host.cs",
            "tests/common/timewarp-testing-tests/**",
            "tests/container-apps/web/**",
            "tests/container-apps/yarp/**",
            "tests/container-apps/aspire/aspire-tests/ingress-smoke-tests.cs",
            "tests/container-apps/aspire/aspire-tests/postgres-volume-model-tests.cs"
          ]
        },
        {
          "condition": "(!yarp)",
          "exclude": [
            "source/container-apps/yarp/**",
            "source/container-apps/aspire/projects/aspire-app-host/ingress-resource.cs",
            "tests/common/timewarp-testing/applications/yarp-test-server-application.cs",
            "tests/container-apps/web/web-spa-integration-tests/pipeline/clone-state-behavior-tests.cs",
            "tests/container-apps/yarp/**"
          ]
        },
        {
          "condition": "(!postgres || !web)",
          "exclude": [
            "tools/dev-cli/endpoints/db-*.cs",
            "tools/dev-cli/services/db-ef.cs",
            "tools/dev-cli/services/db-nuke.cs"
          ]
        },
        {
          "condition": "(!postgres)",
          "exclude": [
            "source/container-apps/web/platform/postgres/**",
            "source/container-apps/aspire/projects/aspire-app-host/postgres-resources.cs",
            "source/container-apps/web/features/identity/ef-principal-store-infrastructure.cs",
            "source/container-apps/web/features/identity/principal-entity-type-configuration-infrastructure.cs",
            "source/container-apps/web/features/identity/credential-entity-type-configuration-infrastructure.cs",
            "source/container-apps/web/features/admin/principals/ef-principal-role-store-infrastructure.cs",
            "source/container-apps/web/features/admin/principals/principal-role-assignment-entity-type-configuration-infrastructure.cs",
            "source/container-apps/web/features/profile/ef-profile-store-infrastructure.cs",
            "source/container-apps/web/features/profile/profile-entity-type-configuration-infrastructure.cs",
            "source/container-apps/web/features/admin/roles/ef-role-store-infrastructure.cs",
            "source/container-apps/web/features/admin/roles/role-entity-type-configuration-infrastructure.cs",
            "source/container-apps/web/features/admin/roles/ef-role-permission-store-infrastructure.cs",
            "source/container-apps/web/features/admin/roles/ef-role-agent-scope-store-infrastructure.cs",
            "source/container-apps/web/platform/authorization/ef-principal-agent-scope-store-infrastructure.cs",
            "source/container-apps/web/platform/authorization/principal-agent-scope-grant-entity-type-configuration-infrastructure.cs",
            "source/container-apps/web/features/agent-links/ef-agent-human-link-store-infrastructure.cs",
            "source/container-apps/web/features/agent-links/agent-human-link-entity-type-configuration-infrastructure.cs",
            "source/container-apps/web/features/settings/ef-site-settings-store-infrastructure.cs",
            "source/container-apps/web/features/settings/site-settings-entity-type-configuration-infrastructure.cs",
            "source/container-apps/web/features/feedback/**",
            "source/container-apps/web/projects/web-spa/features/feedback/**",
            "source/container-apps/web/projects/web-spa/features/admin/feedback/**",
            "source/container-apps/web/projects/web-spa/components/composites/FeedbackBody.razor",
            "source/container-apps/web/projects/web-spa/components/composites/FeedbackBody.razor.css",
            "source/container-apps/web/projects/web-spa/services/feedback-paste-js-module.cs",
            "source/container-apps/web/projects/web-spa/source/features/feedback-paste.ts",
            "source/container-apps/web/projects/web-spa/features/application/screenshot-state/screenshot-state.capture-for-feedback.cs",
            "tests/container-apps/web/web-server-integration-tests/features/feedback/**",
            "tests/container-apps/web/web-server-integration-tests/open-api-binary-content-tests.cs",
            "tests/common/timewarp-testing/postgres-web-host.cs",
            "tests/container-apps/web/web-spa-integration-tests/features/feedback/feedback-details-layout-tests.cs",
            "tests/container-apps/web/web-spa-integration-tests/features/feedback/feedback-page-path-tests.cs",
            "tests/container-apps/web/web-spa-integration-tests/features/admin/feedback-admin-state-tests.cs",
            "tests/container-apps/web/web-spa-integration-tests/features/application/ask-tag-tests.cs",
            "tests/container-apps/web/web-spa-integration-tests/features/application/ask-tag-test-fixture.cs",
            "tests/container-apps/web/web-spa-integration-tests/features/application/ask-reference-tests.cs",
            "tests/container-apps/web/web-spa-playwright-tests/feedback-attachment-playwright-tests.cs",
            "tests/container-apps/web/web-spa-playwright-tests/feedback-attachment-admin-playwright-tests.cs",
            "tests/container-apps/web/web-spa-playwright-tests/feedback-attachment-picker-playwright-tests.cs",
            "tests/container-apps/web/web-spa-playwright-tests/feedback-missing-file-playwright-tests.cs",
            "tests/container-apps/web/web-server-integration-tests/features/settings/site-settings-boot-pending-migrations-tests.cs",
            "tests/container-apps/web/web-server-integration-tests/features/data-protection/data-protection-key-ring-tests.cs",
            "tests/container-apps/web/web-server-integration-tests/features/agent-chat/xai-api-key-admin-tests.cs",
            "tests/container-apps/web/web-infrastructure-tests/**",
            "tests/container-apps/aspire/aspire-tests/postgres-volume-model-tests.cs"
          ]
        }
      ]
    }
  ],
  "symbols": {
    "grpc": {
      "type": "parameter",
      "description": "Include the grpc container app (Superheros)",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "api": {
      "type": "parameter",
      "description": "Include the api container app (Weather)",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "web": {
      "type": "parameter",
      "description": "Include the web container app",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "yarp": {
      "type": "parameter",
      "description": "Include the yarp proxy server",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "postgres": {
      "type": "parameter",
      "description": "Add Postgres Features",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "templateRepository": {
      "type": "computed",
      "datatype": "bool",
      "description": "True only in this template repository, false in every generated app (task 530). Regions under it are the template repository's own: tools/dev-cli/Directory.Build.props defines the C# constant so the monorepo compiles them, and generation strips them. Never a parameter: it is not an architecture flag.",
      "value": "(false)"
    },
    "appNameKebab": {
      "type": "derived",
      "description": "The app name as a DNS-1123 label (Contoso.Shop -> contoso-shop): the committed AppHost Parameters k8s-namespace, helm-release-name and registry-repository, the MCP server card serverInfo name (task 513), and the dev CLI's description and telemetry service name in tools/dev-cli/dev.cs (task 530). Replaces the monorepo's own kebab name only where it is one of those values (onlyIf), never in repository URLs or project names.",
      "valueSource": "name",
      "valueTransform": "dnsLabel",
      "replaces": "timewarp-architecture",
      "onlyIf": [
        { "after": "\"k8s-namespace\": \"" },
        { "after": "\"helm-release-name\": \"" },
        { "after": "\"registry-repository\": \"" },
        { "after": "\"name\": \"" },
        { "after": "Development CLI for " },
        { "after": "ServiceName = \"" }
      ]
    },
    "ingressPort": {
      "type": "generated",
      "generator": "port",
      "description": "The app's own ingress port (task 311): the committed AppHost Parameters:ingress-port, which is the Compose host port and the port dev open forwards. A free port in 20000-60000 chosen at generation, so generated apps do not share one. Replaces the monorepo's 36371 only as that parameter's value (onlyIf).",
      "parameters": {
        "low": 20000,
        "high": 60000
      },
      "replaces": "36371",
      "onlyIf": [
        { "after": "\"ingress-port\": \"" }
      ]
    }
  },
  "forms": {
    "dnsLabelLowerCase": {
      "identifier": "lowerCase"
    },
    "dnsLabelSeparators": {
      "identifier": "replace",
      "pattern": "[^a-z0-9]+",
      "replacement": "-"
    },
    "dnsLabelTrim": {
      "identifier": "replace",
      "pattern": "^-+|-+$",
      "replacement": ""
    },
    "dnsLabelTruncate": {
      "identifier": "replace",
      "pattern": "^(.{63}).+$",
      "replacement": "$1"
    },
    "dnsLabel": {
      "identifier": "chain",
      "steps": [ "dnsLabelLowerCase", "dnsLabelSeparators", "dnsLabelTrim", "dnsLabelTruncate", "dnsLabelTrim" ]
    }
  },
  "tags": {
    "language": "C#",
    "type": "project"
  }
}
