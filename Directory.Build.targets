<Project>
  <!--
    Assembly marker generation (task 126-007).

    Every C# product/platform assembly gets a generated IAssemblyMarker in
    $(AssemblyMarkerNamespace) (not RootNamespace alone — container-apps share
    RootNamespace=TimeWarp.Architecture while markers live in layer sub-namespaces).

    Maps live in source/{container-apps,foundation,analyzers,libraries}/Directory.Build.props.
    Opt out: TwGenerateAssemblyMarker=false.
    Template: this file must ship in the template package (see timewarp-architecture-template.csproj).
  -->

  <PropertyGroup Label="AssemblyMarker defaults">
    <TwGenerateAssemblyMarker Condition="'$(TwGenerateAssemblyMarker)' == '' and '$(Language)' == 'C#'">true</TwGenerateAssemblyMarker>
    <TwGenerateAssemblyMarker Condition="'$(TwGenerateAssemblyMarker)' == ''">false</TwGenerateAssemblyMarker>
    <!-- Fallback only when a map did not set AssemblyMarkerNamespace. Hyphenated roots (project-name
         defaults like foundation-domain) are not valid C# namespaces — the target condition skips them. -->
    <AssemblyMarkerNamespace Condition="'$(AssemblyMarkerNamespace)' == ''">$(RootNamespace)</AssemblyMarkerNamespace>
    <TwAssemblyMarkerFile>$(IntermediateOutputPath)AssemblyMarker.g.cs</TwAssemblyMarkerFile>
  </PropertyGroup>

  <Target Name="GenerateAssemblyMarker"
          BeforeTargets="CoreCompile"
          Condition="'$(TwGenerateAssemblyMarker)' == 'true'
                 and '$(Language)' == 'C#'
                 and '$(AssemblyMarkerNamespace)' != ''
                 and !$(AssemblyMarkerNamespace.Contains('-'))
                 and '$(MSBuildProjectExtension)' == '.csproj'"
          Inputs="$(MSBuildAllProjects);$(MSBuildThisFileFullPath)"
          Outputs="$(TwAssemblyMarkerFile)">
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />

    <!-- Empty marker interface is intentional (assembly identity for typeof / scanning). -->
    <ItemGroup>
      <!-- Semicolons must be %3b — bare ';' is the MSBuild item separator and would drop them. -->
      <_TwAssemblyMarkerLines Include="// &lt;auto-generated /&gt;" />
      <_TwAssemblyMarkerLines Include="// Generated by GenerateAssemblyMarker (Directory.Build.targets). Do not edit." />
      <_TwAssemblyMarkerLines Include="#pragma warning disable CA1040 // Empty marker interface is intentional" />
      <_TwAssemblyMarkerLines Include="namespace $(AssemblyMarkerNamespace)%3b" />
      <_TwAssemblyMarkerLines Include="public interface IAssemblyMarker%3b" />
      <_TwAssemblyMarkerLines Include="#pragma warning restore CA1040" />
    </ItemGroup>

    <WriteLinesToFile File="$(TwAssemblyMarkerFile)"
                      Lines="@(_TwAssemblyMarkerLines)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(TwAssemblyMarkerFile)" Visible="false" />
      <FileWrites Include="$(TwAssemblyMarkerFile)" />
    </ItemGroup>
  </Target>
</Project>
