<!--
  Axis-1 cohesive-tree membership guard + hybrid layer includes.

  Every .cs under grpc/features/ and grpc/platform/ must end in exactly one
  registered layer suffix (from feature-filename-grammar.g.props, generated from
  the SSOT JSON). Zero-match → teaching build error. Suffix nesting is rejected
  at generation time so dual-glob-match cannot occur.

  Hybrid includes (option 1): default SDK items stay; each layer project also
  globs $(GrpcFeatureTreeRoot)/**/*-{layer}.cs and
  $(GrpcPlatformTreeRoot)/**/*-{layer}.cs with Link metadata — Compile ItemGroups
  are generated in feature-filename-grammar.g.props from the same layer list
  (no hand-duplication). features/ holds product slices; platform/ holds
  host/platform clusters that share grammar suffixes but are NOT …Features.*
  slice namespaces. Both trees may be absent (pre-migration) — MSBuild globs
  over a nonexistent directory yield zero items, so the guard is a no-op until
  content lands.

  Import once via grpc/Directory.Build.targets so the guard runs once per
  framework build of any grpc project, and each layer project gets its globs.
-->
<Project>
  <PropertyGroup>
    <GrpcFeatureTreeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../features'))</GrpcFeatureTreeRoot>
    <GrpcPlatformTreeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../platform'))</GrpcPlatformTreeRoot>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)feature-filename-grammar.g.props" />

  <!-- Membership guard runs once (grpc-server is the canonical host of the check). -->
  <Target Name="ValidateFeatureFileMembership"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'grpc-server'">
    <ItemGroup>
      <FeatureTreeFile Include="$(GrpcFeatureTreeRoot)/**/*.cs" />
      <FeatureTreeFile Include="$(GrpcPlatformTreeRoot)/**/*.cs"
                      Condition="Exists('$(GrpcPlatformTreeRoot)')" />
    </ItemGroup>

    <!--
      Match via generated FeatureFilenameLayerSuffixRegex (SSOT).
      Unmatched files have no registered -{layer} suffix and would compile nowhere.
    -->
    <ItemGroup>
      <_MatchedFeatureFile Include="@(FeatureTreeFile)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '$(FeatureFilenameLayerSuffixRegex)'))" />
      <UnmatchedFeatureFile Include="@(FeatureTreeFile)"
        Exclude="@(_MatchedFeatureFile)" />
    </ItemGroup>

    <!-- Template engine strips Conditions that use &gt; entities or empty-string item compares
         (task 115). Raw ">" in the attribute is well-formed XML and survives generation. -->
    <PropertyGroup>
      <_HasUnmatchedFeatureFiles>false</_HasUnmatchedFeatureFiles>
      <_HasUnmatchedFeatureFiles Condition="@(UnmatchedFeatureFile->Count()) > 0">true</_HasUnmatchedFeatureFiles>
    </PropertyGroup>
    <Error Condition="'$(_HasUnmatchedFeatureFiles)' == 'true'"
      Text="Feature/platform file(s) match NO registered layer suffix and would compile into no project: @(UnmatchedFeatureFile->'%(Filename)%(Extension)', ', '). Rename to '&lt;name&gt;[-&lt;function&gt;]-&lt;layer&gt;.cs' with layer one of: @(FeatureFilenameGrammarLayer->'-%(Identity)', ', '). Registry: feature-filename-grammar.json. Trees: features/ and platform/." />

  </Target>
</Project>
