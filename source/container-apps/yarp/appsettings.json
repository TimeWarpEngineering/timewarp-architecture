{
  // See corresponding C# classes for documentation.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Peers allowed to set X-Forwarded-Proto and X-Forwarded-Host. An absent section trusts
  // loopback only (Caddy on this machine, connecting to the pinned http endpoint). An explicit
  // section replaces that default. An empty list does not mean trust everyone: the headers are
  // ignored. A cluster proxy (Compose, Kubernetes, Azure Container Apps) sets KnownNetworks to
  // that proxy's CIDR (for example "10.0.0.0/8") and lists loopback in KnownProxies only when a
  // local proxy still connects.
  "TrustedProxy": {
    "KnownProxies": [ "127.0.0.1", "::1" ],
    "KnownNetworks": []
  }
}
