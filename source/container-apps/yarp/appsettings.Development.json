{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "ApiRoute": {
        "ClusterId": "Api.Server",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      // RequestHeaderOriginalHost (task 104-031) preserves the client's Host to Web.Server for the
      // routes that actually target it (WebRoute catch-all + WebSwaggerRoute), so Web.Server's
      // per-request RP-ID selection sees the public host. NOTE: this standalone-yarp config does NOT
      // route /api/identity/** (nor the other web-owned /api paths) to Web.Server — those fall to the
      // Api.Server "/api/{**catch-all}" above. That is a PRE-EXISTING routing gap (the web-owned /api
      // carve-outs the AppHost's YARP declares are simply not mirrored here; separate from 104-031,
      // relates to task 107's yarp-route generation), so passkey host-preservation via THIS config is
      // moot until that gap is closed. The verified task-112 public chain is the AppHost YARP path,
      // which DOES carve /api/identity/** -> webServer with WithTransformUseOriginalHostHeader.
      "WebRoute": {
        "ClusterId": "Web.Server",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "WebSwaggerRoute": {
        "ClusterId": "Web.Server",
        "Match": {
          "Path": "/api/web-server/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "GrpcRoute": {
        "ClusterId": "Grpc.Server",
        "Match": {
          "Path": "/grpc/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/grpc"
          }
        ]
      }
    },
    "Clusters": {
      "Api.Server": {
        "Destinations": {
          "Api.Server": {
            "Address": "https://api-server",
            "Host": "localhost"
          }
        }
      },
      "Web.Server": {
        "Destinations": {
          "Web.Server": {
            "Address": "https://web-server",
            "Host": "localhost"
          }
        }
      },
      "Grpc.Server": {
        "Destinations": {
          "Grpc.Server": {
            "Address": "https://grpc-server",
            "Host": "localhost"
          }
        }
      }
    }
  }
}
