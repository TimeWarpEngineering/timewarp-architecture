{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "ApiRoute": {
        "ClusterId": "Api.Server",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      // RequestHeaderOriginalHost (task 104-031) preserves the client's Host to Web.Server for the
      // routes that target it (WebRoute catch-all + WebSwaggerRoute), so Web.Server's per-request
      // RP-ID selection sees the public host. The web-owned /api carve-outs (/api/identity/** etc.)
      // are NOT listed here: task 107 adds them as generated in-memory routes (see program.cs
      // ConfigureServices / WebServerApiRoutePrefixes.All), matching the AppHost ingress, so they no
      // longer fall to the Api.Server "/api/{**catch-all}" above.
      "WebRoute": {
        "ClusterId": "Web.Server",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "WebSwaggerRoute": {
        "ClusterId": "Web.Server",
        "Match": {
          "Path": "/api/web-server/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "GrpcRoute": {
        "ClusterId": "Grpc.Server",
        "Match": {
          "Path": "/grpc/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/grpc"
          }
        ]
      }
    },
    "Clusters": {
      "Api.Server": {
        "Destinations": {
          "Api.Server": {
            "Address": "https://api-server",
            "Host": "localhost"
          }
        }
      },
      "Web.Server": {
        "Destinations": {
          "Web.Server": {
            // http, not https (task 107): the Web.Server routes preserve the client's original Host,
            // so an https hop would validate Web.Server's localhost dev cert against the public
            // hostname and 502 (RemoteCertificateNameMismatch) — the same shape the AppHost ingress
            // forwards over http to avoid. TLS terminates at the gateway edge. The _http. named
            // endpoint pins the http port (the plain service address resolves https-first).
            "Address": "http://_http.web-server"
          }
        }
      },
      "Grpc.Server": {
        "Destinations": {
          "Grpc.Server": {
            "Address": "https://grpc-server",
            "Host": "localhost"
          }
        }
      }
    }
  }
}
