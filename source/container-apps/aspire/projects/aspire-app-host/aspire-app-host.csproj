<Project Sdk="Aspire.AppHost.Sdk/13.4.6">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>a3d4de92-958f-4e04-b927-9d7605bee60e</UserSecretsId>
    <DefineConstants>$(DefineConstants);api;web;grpc;yarp;postgres</DefineConstants>
  </PropertyGroup>

  <!--#if (web) -->
  <PropertyGroup>
    <!-- Task 107: IngressRoutePrefixGenerator emits WebServerApiRoutePrefixes (the /api carve-outs
         owned by Web.Server) from the web-contracts ApiRoute templates, so program.cs cannot drift
         from the contracts. Only web-contracts routes participate. -->
    <EnableIngressRouteGeneration>true</EnableIngressRouteGeneration>
    <IngressWebContractAssemblies>web-contracts</IngressWebContractAssemblies>
    <!--#if (grpc) -->
    <IngressReservedPathPrefixes>grpc</IngressReservedPathPrefixes>
    <!--#endif -->
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="EnableIngressRouteGeneration" />
    <CompilerVisibleProperty Include="IngressWebContractAssemblies" />
    <!--#if (grpc) -->
    <CompilerVisibleProperty Include="IngressReservedPathPrefixes" />
    <!--#endif -->
  </ItemGroup>
  <!--#endif -->


  <ItemGroup>
    <!--#if (yarp) -->
    <PackageReference Include="Aspire.Hosting.Yarp" />
    <!--#endif -->
    <!--#if (postgres) -->
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <!-- Task 147-007: AppHost AddEFMigrations (RunDatabaseUpdateOnStart + publish artifacts). -->
    <PackageReference Include="Aspire.Hosting.EntityFrameworkCore" />
    <!--#endif -->
    <!-- Direct pin (see Directory.Packages.props): lifts StreamJsonRpc's vulnerable transitive
         MessagePack when Aspire.Hosting.Yarp isn't in the graph to do it. -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <!--#if (api) -->
    <ProjectReference Include="../../../api/projects/api-server/api-server.csproj" />
    <!--#endif -->
    <!--#if (grpc) -->
    <ProjectReference Include="../../../grpc/projects/grpc-server/grpc-server.csproj" />
    <!--#endif -->
    <!--#if (web) -->
    <ProjectReference Include="../../../web/projects/web-server/web-server.csproj" />
    <!--#endif -->
  </ItemGroup>


  <ItemGroup>
    <!-- Compile-time reference (NOT an Aspire app resource): resource-name constants alias
         ServiceNames so AppHost and apps cannot drift. Same repo/package switch as the apps. -->
    <ProjectReference Include="../../../../foundation/foundation-contracts/foundation-contracts.csproj"
                      IsAspireProjectResource="false"
                      Condition="'$(UseFoundationPackages)' != 'true'" />
    <PackageReference Include="TimeWarp.Foundation.Contracts" Condition="'$(UseFoundationPackages)' == 'true'" />
    <!--#if (web) -->
    <!-- Task 107: compile-time reference (NOT an Aspire resource) so IngressRoutePrefixGenerator can
         scan web-contracts ApiRoute templates. ExcludeAssets=runtime / Private=false: metadata only,
         never a runtime dependency of the orchestrator (foundation-contracts precedent above). -->
    <ProjectReference Include="../../../web/projects/web-contracts/web-contracts.csproj"
                      IsAspireProjectResource="false"
                      Private="false"
                      ExcludeAssets="runtime" />
    <!--#endif -->
    <!--#if (api) -->
    <!-- Task 107: api-contracts is referenced for the TWA0017 collision set only — its hosted routes
         belong to the Api.Server catch-all, never to a Web.Server ingress carve-out. -->
    <ProjectReference Include="../../../api/projects/api-contracts/api-contracts.csproj"
                      IsAspireProjectResource="false"
                      Private="false"
                      ExcludeAssets="runtime" />
    <!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <!--#if (web) -->
    <!-- Task 107: attach the Generators package so IngressRoutePrefixGenerator runs on the AppHost.
         Dual-mode (task 051/115): project ref as an Analyzer in repo mode, package in package mode. -->
    <ProjectReference Include="../../../../analyzers/timewarp-architecture-analyzers/timewarp-architecture-analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      IsAspireProjectResource="false"
                      Condition="'$(UseAnalyzerPackages)' != 'true'" />
    <PackageReference Include="$(TwArchitectureGeneratorsPackageId)" PrivateAssets="all"
                      Condition="'$(UseAnalyzerPackages)' == 'true'" />
    <!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="api-server-integration-tests" />
    <InternalsVisibleTo Include="web-spa-integration-tests" />
  </ItemGroup>

</Project>