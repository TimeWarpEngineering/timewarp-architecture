<Project Sdk="Aspire.AppHost.Sdk/13.4.3">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>a3d4de92-958f-4e04-b927-9d7605bee60e</UserSecretsId>
    <DefineConstants>$(DefineConstants);api;web;grpc;yarp</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--#if (yarp) -->
    <PackageReference Include="Aspire.Hosting.Yarp" />
    <!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <!--#if (api) -->
    <ProjectReference Include="../../api/api-server/api-server.csproj" />
    <!--#endif -->
    <!--#if (grpc) -->
    <ProjectReference Include="../../grpc/grpc-server/grpc-server.csproj" />
    <!--#endif -->
    <!--#if (web) -->
    <ProjectReference Include="../../web/web-server/web-server.csproj" />
    <!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-time reference (NOT an Aspire app resource): resource-name constants alias
         ServiceNames so AppHost and apps cannot drift. Same repo/package switch as the apps. -->
    <ProjectReference Include="../../../foundation/foundation-contracts/foundation-contracts.csproj"
                      IsAspireProjectResource="false"
                      Condition="'$(UseFoundationPackages)' != 'true'" />
    <PackageReference Include="TimeWarp.Foundation.Contracts" Condition="'$(UseFoundationPackages)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="api-server-integration-tests" />
    <InternalsVisibleTo Include="web-spa-integration-tests" />
  </ItemGroup>

</Project>