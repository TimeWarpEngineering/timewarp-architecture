<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <UserSecretsId>0e53fdd3-6f93-4d5a-9c86-040621f7929e</UserSecretsId>
    <DisableImplicitComponentsAnalyzers>true</DisableImplicitComponentsAnalyzers>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Web Server</Description>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>postgres</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
    <EnableApiEndpointGeneration>true</EnableApiEndpointGeneration>
    <!-- Only generate from web-contracts — web-spa transitively references api-contracts. -->
    <ApiEndpointContractAssemblies>web-contracts</ApiEndpointContractAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="EnableApiEndpointGeneration" />
    <CompilerVisibleProperty Include="ApiEndpointContractAssemblies" />
  </ItemGroup>

  <ItemGroup Label="Core">
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="TimeWarp.Mediator" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.CodeAnalysis" />
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Oakton" />
    <PackageReference Include="Passwordless" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\foundation\foundation-server\foundation-server.csproj" Condition="'$(UseFoundationPackages)' != 'true'" />
    <PackageReference Include="TimeWarp.Foundation.Server" Condition="'$(UseFoundationPackages)' == 'true'" />
    <ProjectReference Include="..\..\aspire\aspire-service-defaults\aspire-service-defaults.csproj" />
    <ProjectReference Include="..\web-infrastructure\web-infrastructure.csproj" />
    <ProjectReference Include="..\web-contracts\web-contracts.csproj" />
    <ProjectReference Include="..\web-spa\web-spa.csproj" />

    <ProjectReference Include="..\..\..\analyzers\timewarp-architecture-analyzers\timewarp-architecture-analyzers.csproj"
                       OutputItemType="Analyzer"
                       ReferenceOutputAssembly="false"
                       Condition="'$(UseAnalyzerPackages)' != 'true'" />
    <PackageReference Include="TimeWarp.Architecture.Generators" PrivateAssets="all"
                       Condition="'$(UseAnalyzerPackages)' == 'true'" />
    <ProjectReference Include="..\..\..\analyzers\timewarp-architecture-attributes\timewarp-architecture-attributes.csproj"
                       Condition="'$(UseAnalyzerPackages)' != 'true'" />
    <PackageReference Include="TimeWarp.Architecture.Attributes"
                       Condition="'$(UseAnalyzerPackages)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="web-server-integration-tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\aspire\aspire-app-host\constants.cs">
      <Link>Configuration\Constants.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
