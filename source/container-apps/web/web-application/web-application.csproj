<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Riok.Mapperly" />
    <!-- WebAuthnOptions/WebAuthnOptionsValidator (configuration/) use IOptions<T>/AbstractValidator
         directly — explicit rather than relying on the transitive flow from web-contracts. -->
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\foundation\foundation-application\foundation-application.csproj" Condition="'$(UseFoundationPackages)' != 'true'" />
    <PackageReference Include="TimeWarp.Foundation.Application" Condition="'$(UseFoundationPackages)' == 'true'" />
    <ProjectReference Include="..\web-contracts\web-contracts.csproj" />
    <ProjectReference Include="..\web-domain\web-domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Principal/Credential/IPrincipalStore + WebAuthn ceremony primitives for the identity
         feature handlers (task 104-003). Dual-mode — see web-contracts.csproj for the rationale. -->
    <ProjectReference Include="..\..\..\libraries\timewarp-identity\timewarp-identity.csproj" Condition="'$(UseFoundationPackages)' != 'true'" />
    <PackageReference Include="TimeWarp.Identity" Condition="'$(UseFoundationPackages)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="features\Todo\" />
  </ItemGroup>


  <!-- Axis-1 spike (114-001): feature-cohesive folders — this layer project includes its files
       from the shared features tree by filename-grammar glob. Link keeps a sane SolutionExplorer
       shape. -->
  <ItemGroup>
    <Compile Include="..\features\**\*-application.cs" Link="features\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>