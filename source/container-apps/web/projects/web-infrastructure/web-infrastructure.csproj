<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Design-time: PrivateAssets + IncludeAssets (EF standard). Bare PrivateAssets alone
         drops design-time MSBuild targets and breaks `dotnet ef` / Aspire RunDatabaseUpdateOnStart. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- efcore#27215: without Tools, EF can silently no-op migrations on some providers (Postgres tip on aspire.dev). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\foundation\foundation-infrastructure\foundation-infrastructure.csproj" Condition="'$(UseFoundationPackages)' != 'true'" />
    <PackageReference Include="TimeWarp.Foundation.Infrastructure" Condition="'$(UseFoundationPackages)' == 'true'" />
    <ProjectReference Include="..\web-application\web-application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- InMemoryPrincipalStore / InMemoryWebAuthnChallengeStore DI registration (task 104-003).
         Dual-mode via UseIdentityPackages (task 115). -->
    <ProjectReference Include="..\..\..\..\libraries\timewarp-identity\timewarp-identity.csproj" Condition="'$(UseIdentityPackages)' != 'true'" />
    <PackageReference Include="TimeWarp.Identity" Condition="'$(UseIdentityPackages)' == 'true'" />

  </ItemGroup>

  <ItemGroup>
    <!-- TypedId EF ValueConverters + ConfigureTypedIdConventions for PostgresDbContext (task 113-004).
         Generators only — convention analyzers already attach repo-wide via Directory.Build.props. -->
    <ProjectReference Include="../../../../analyzers/timewarp-architecture-analyzers/timewarp-architecture-analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      Condition="'$(UseAnalyzerPackages)' != 'true'" />
    <PackageReference Include="$(TwArchitectureGeneratorsPackageId)" PrivateAssets="all"
                      Condition="'$(UseAnalyzerPackages)' == 'true'" />
    <!-- The generator's EF-helper namespace via composed property (sourceName-safe, task 115
         pattern): a literal using in a .cs file would be rewritten to <AppName>.TypedIds.Ef on
         dotnet-new while the generator's baked-in namespace is not, breaking every generated app.
         Unconditional: the namespace is identical in source and package mode. -->
    <Using Include="$(TwArchitectureTypedIdsEfNamespace)" />
  </ItemGroup>

</Project>