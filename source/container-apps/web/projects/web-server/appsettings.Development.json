{
  // Development adds Debug for the app's own namespaces only; the base appsettings.json keeps EF
  // Core SQL off. Opt in to SQL per machine, never here:
  //   dotnet user-secrets set "Logging:LogLevel:Microsoft.EntityFrameworkCore.Database.Command" "Information"
  // or Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Information in the environment.
  // Mail stays at Information so DevelopmentEmailSender's Debug body line stays out of telemetry.
  "Logging": {
    "LogLevel": {
      "TimeWarp.Architecture": "Debug",
      "TimeWarp.Architecture.Mail": "Information"
    }
  },
  "DetailedErrors": true,
  "Authentication": {
    "UseMock": false,
    "BootstrapAdministratorPrincipalIds": []
  },
  "MeteredCapabilityOptions": {
    "Enabled": true,
    "PayTo": "0x000000000000000000000000000000000000dEaD"
  },
  "TipOptions": {
    "Enabled": true,
    "PayTo": "0x000000000000000000000000000000000000dEaD"
  },
  "Mail": {
    "Sender": "Development",
    "PickupDirectory": ""
  }
}
