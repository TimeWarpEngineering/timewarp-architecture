{
  "Serilog": {
    "Using":  [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "Logs/log.txt" } }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Destructure": [
      { "Name": "ToMaximumDepth", "Args": { "maximumDestructuringDepth": 4 } },
      { "Name": "ToMaximumStringLength", "Args": { "maximumStringLength": 100 } },
      { "Name": "ToMaximumCollectionCount", "Args": { "maximumCollectionCount": 10 } }
    ],
    "Properties": {
      "Application": "Web.Server"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "UseMock": false,
    "UseEntra": false
  },
  "AzureAd": {
    "_comment": "Used only when Authentication:UseEntra is true (task 104-021). Default path is passkey identity-session.",
    "Instance": "https://login.microsoftonline.com/",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "Domain": "contoso.onmicrosoft.com",
    "SignUpSignInPolicyId": "B2C_1_SignUpSignIn"
  },
  "SampleOptions": {
    "SampleOption": "SampleValue"
  },
  "WebAuthnOptions": {
    "RpName": "TimeWarp Architecture",
    "AllowedOrigins": []
  },
  "AgentTokenOptions": {
    "TokenLifetimeMinutes": 15
  },
  "MeteredCapabilityOptions": {
    "Enabled": false,
    "PayTo": "",
    "Network": "eip155:84532",
    "Price": "$0.10",
    "Resource": "/api/demo/metered-capability",
    "FacilitatorBase": "https://x402.org/facilitator",
    "Description": "Metered expensive capability demo"
  },
  "TipOptions": {
    "Enabled": false,
    "PayTo": "",
    "Network": "eip155:84532",
    "Price": "$0.10",
    "Resource": "/api/tip",
    "FacilitatorBase": "https://x402.org/facilitator",
    "Description": "Voluntary tip to TimeWarp Engineering. Content remains free; this is not a content fee."
  },
  "AbuseRateLimitOptions": {
    "Enabled": true,
    "PrincipalRegistration": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "PaymentChallenge": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    }
  }
}
