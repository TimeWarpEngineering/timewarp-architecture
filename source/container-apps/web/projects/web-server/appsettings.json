  "AzureAd": {
    "_comment": "Legacy 104-021 placeholders. Named Entra uses Authentication:Entra (RFC 219 D10). identity-session stays DefaultScheme.",
    "Instance": "https://login.microsoftonline.com/",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "Domain": "contoso.onmicrosoft.com",
    "SignUpSignInPolicyId": "B2C_1_SignUpSignIn"
  },
  "SampleOptions": {
    "SampleOption": "SampleValue"
  },
  "BrandOptions": {
    "_comment": "White-label brand, the one source (task 513, skill tw-brand). The WebAssembly host reads it from GET /brand.json. LogoAlt falls back to ProductName, ThemeColor to SeedColor, BackgroundColor to the light page background. ExactRamp false is the harmonized Fluent ramp. Dark tokens are the role text steps on dark paper.",
    "ProductName": "TimeWarp.Architecture",
    "LogoSrc": "images/timewarp-horizontal.svg",
    "LogoWidth": 201,
    "LogoHeight": 48,
    "SeedColor": "#55409c",
    "ExactRamp": false,
    "FaviconSrc": "favicon-32x32.png",
    "AppleTouchIconSrc": "apple-touch-icon.png",
    "Icon192Src": "icon-192.png",
    "Icon512Src": "icon-512.png",
    "OgImageSrc": "images/og-image.png",
    "Tokens": {
      "Primary": "#55409c",
      "PrimaryHover": "#6953b1",
      "PrimaryActive": "#352078",
      "PrimarySoft": "#c5b4ff",
      "OnPrimary": "#ffffff",
      "Secondary": "#0085b2",
      "SecondaryHover": "#009fd6",
      "SecondaryActive": "#004f78",
      "SecondaryBright": "#00ccff",
      "Highlight": "#69a144",
      "HighlightSoft": "#d2ffb4",
      "Info": "#0085b2",
      "PrimaryDark": "#c5b4ff",
      "SecondaryDark": "#00ccff",
      "HighlightDark": "#69a144"
    }
  },
  "SignInOptions": {
    "_comment": "Enabled browser sign-in methods. Passkey only is the checked-in default so empty Entra settings still boot. Listing Microsoft365 registers the Entra scheme and requires those settings.",
    "Methods": [ "Passkey" ]
  },
  "SiteMetadata": {
    "_comment": "Optional BaseUrl is the public https origin when the request host is not the public host. Leave it unset behind YARP so X-Forwarded-Proto and X-Forwarded-Host are used. SiteName, Title, and ImageAlt fall back to BrandOptions; the image is BrandOptions.OgImageSrc.",
    "Description": "A distributed .NET application on a batteries-included architecture: Blazor, passkey and agent-key identity, x402 payments, and agent discovery documents.",
    "ImageWidth": 1200,
    "ImageHeight": 630,
    "ImageType": "image/png"
  },
  "WebAuthnOptions": {
    "RpName": "TimeWarp Architecture",
    "AllowedOrigins": []
  },
  "AgentTokenOptions": {
    "TokenLifetimeMinutes": 15
  },
  "MeteredCapabilityOptions": {
    "Enabled": false,
    "PayTo": "",
    "Network": "eip155:84532",
    "Price": "$0.10",
    "Resource": "/api/demo/metered-capability",
    "FacilitatorBase": "https://x402.org/facilitator",
    "Description": "Metered expensive capability demo"
  },
  "TipOptions": {
    "Enabled": false,
    "PayTo": "",
    "Network": "eip155:84532",
    "Price": "$0.10",
    "Resource": "/api/tip",
    "FacilitatorBase": "https://x402.org/facilitator",
    "Description": "Voluntary tip to TimeWarp Engineering. Content remains free; this is not a content fee."
  },
  "FeedbackAttachments": {
    "ConnectionString": "",
