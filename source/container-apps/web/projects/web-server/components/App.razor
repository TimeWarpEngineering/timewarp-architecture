@namespace TimeWarp.Architecture.Components
@using Microsoft.AspNetCore.Components.Web

@code
{
  [Inject] private IOptions<BlazorSettings> BlazorSettingsAccessor { get; set; } = null!;

  [Inject] private IHostEnvironment HostEnvironment { get; set; } = null!;

  private BlazorSettings BlazorSettings => BlazorSettingsAccessor.Value;

  private IComponentRenderMode RenderMode => BlazorSettings.RenderMode switch
  {
    Configuration.RenderMode.InteractiveServer => new InteractiveServerRenderMode(BlazorSettings.Prerender),
    Configuration.RenderMode.InteractiveWebAssembly => new InteractiveWebAssemblyRenderMode(BlazorSettings.Prerender),
    Configuration.RenderMode.InteractiveAuto => new InteractiveAutoRenderMode(BlazorSettings.Prerender),
    _ => throw new InvalidOperationException($"Unsupported render mode: {BlazorSettingsAccessor.Value.RenderMode}")
  };
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TimeWarp.Architecture</title>
  <base href="/"/>

  @* Design tokens + global app styles + design-system components (plain CSS, replaces Tailwind) *@
  <link href="css/tokens.css" rel="stylesheet"/>
  <link href="css/app.css" rel="stylesheet"/>

  @* Component-scoped CSS (Blazor isolation) — Card/StatusBadge/Modal/pages *.razor.css *@
  <link href="Web.Spa.styles.css" rel="stylesheet"/>

  @* FluentUI v5 component styles. Fluent's design tokens are applied at runtime by its startup
     script from <body data-theme-color>; the shell's brand frame comes from tokens.css. *@
  <link href="_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.bundle.scp.css" rel="stylesheet" />
  <link href="_content/Microsoft.AspNetCore.Components.AI/ai-chat.css" rel="stylesheet" />

  @* Icons *@
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">

  @* PWA Manifest *@
  <link rel="manifest" href="manifest.json" />

  <HeadOutlet @rendermode=RenderMode />
</head>
@* Task 290: Fluent's beforeStart initializer builds the brand theme from these attributes, so
   Fluent components are purple from the first script tick, not blue until MainLayout went
   interactive. data-theme="light" keeps the light mode the app always used. *@
<body data-theme-color="@MainLayout.BrandColor" data-theme="light">
<Routes @rendermode=RenderMode />
@* <div id="app">@(await Html.RenderComponentAsync<App>(RenderMode.Server))</div> *@
<div id="blazor-error-ui">
  An unhandled error has occurred.
  <a href="" class="reload">Reload</a>
  <a class="dismiss">🗙</a>
</div>

@* Development/Testing only: classic script BEFORE blazor.web.js so pre-runtime boot failures are captured *@
@if (BrowserLogForwarding.IsEnabled(HostEnvironment))
{
  <script src="js/browser-log-forwarder.js"></script>
}
@* pathname + search + hash for PageAgentRoute on WebAssembly. A NavigationManager left at the base URI loses. *@
<script>
  window.timeWarpPagePath = function () {
    return location.pathname + location.search + location.hash;
  };
</script>
<script src="_framework/blazor.web.js"></script>
</body>
</html>
