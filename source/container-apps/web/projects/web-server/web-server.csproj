<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Task 145-002 R2-1: lets test infra resolve ContentRootPath from THIS project's own
       directory instead of a transitive consumer's flattened output. See the props file. -->
  <Import Project="$(RepositoryRoot)msbuild/project-directory-metadata.props" />

  <PropertyGroup>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <UserSecretsId>0e53fdd3-6f93-4d5a-9c86-040621f7929e</UserSecretsId>
    <DisableImplicitComponentsAnalyzers>true</DisableImplicitComponentsAnalyzers>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Web Server</Description>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>postgres</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..\..</DockerfileContext>
    <EnableApiEndpointGeneration>true</EnableApiEndpointGeneration>
    <!-- Only generate from web-contracts — web-spa transitively references api-contracts. -->
    <ApiEndpointContractAssemblies>web-contracts</ApiEndpointContractAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="EnableApiEndpointGeneration" />
    <CompilerVisibleProperty Include="ApiEndpointContractAssemblies" />
  </ItemGroup>

  <ItemGroup Label="Core">
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="TimeWarp.Mediator" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <!-- Task 147-007: AddEFMigrations uses web-server as the startup project for `dotnet ef
         database update`. Design must be referenced here (not only web-infrastructure) or the
         tool fails with "startup project doesn't reference Microsoft.EntityFrameworkCore.Design". -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Oakton" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\..\..\foundation\foundation-server\foundation-server.csproj" Condition="'$(UseFoundationPackages)' != 'true'" />
    <PackageReference Include="TimeWarp.Foundation.Server" Condition="'$(UseFoundationPackages)' == 'true'" />
    <ProjectReference Include="..\..\..\aspire\projects\aspire-service-defaults\aspire-service-defaults.csproj" />
    <ProjectReference Include="..\web-infrastructure\web-infrastructure.csproj" />
    <ProjectReference Include="..\web-contracts\web-contracts.csproj" />
    <ProjectReference Include="..\web-spa\web-spa.csproj" />

    <ProjectReference Include="..\..\..\..\analyzers\timewarp-architecture-analyzers\timewarp-architecture-analyzers.csproj"
                       OutputItemType="Analyzer"
                       ReferenceOutputAssembly="false"
                       Condition="'$(UseAnalyzerPackages)' != 'true'" />
    <PackageReference Include="$(TwArchitectureGeneratorsPackageId)" PrivateAssets="all"
                       Condition="'$(UseAnalyzerPackages)' == 'true'" />
    <ProjectReference Include="..\..\..\..\analyzers\timewarp-architecture-attributes\timewarp-architecture-attributes.csproj"
                       Condition="'$(UseAnalyzerPackages)' != 'true'" />
    <PackageReference Include="$(TwArchitectureAttributesPackageId)"
                       Condition="'$(UseAnalyzerPackages)' == 'true'" />

  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="web-server-integration-tests" />
  </ItemGroup>

  <!-- Task 200: Fast Up-to-date Check must not skip web-server when web-spa's gitignored
       JS initializer appears or changes. Fingerprinted names still share this unfingerprinted
       emit path. Missing file is a no-op for the check. -->
  <ItemGroup>
    <UpToDateCheckInput Include="..\web-spa\wwwroot\js\web.spa.lib.module.js" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\aspire\projects\aspire-app-host\constants.cs">
      <Link>Configuration\Constants.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- Task 200: a missed Web.Spa JS initializer is a failed host build, not a /Login surprise.
       GenerateJSModuleManifestBuildStaticWebAssets has no Inputs/Outputs (incrementalism is
       inside the task), so this AfterTargets always runs. Item compare uses Count() + a
       boolean property — the template engine strips empty-string item Conditions (task 115). -->
  <Target Name="AssertWebSpaJsInitializerInHostManifest"
          AfterTargets="GenerateJSModuleManifestBuildStaticWebAssets">
    <ItemGroup>
      <_WebSpaJsInitializerModule Include="@(_ExistingBuildJSModules)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '(?i)web\.spa.*\.lib\.module\.js'))" />
    </ItemGroup>
    <PropertyGroup>
      <_HasWebSpaJsInitializer>false</_HasWebSpaJsInitializer>
      <_HasWebSpaJsInitializer Condition="@(_WebSpaJsInitializerModule->Count()) > 0">true</_HasWebSpaJsInitializer>
      <_JsModuleBuildManifestPath Condition="'$(_JSModuleBuildManifestPath)' == ''">$(IntermediateOutputPath)jsmodules\jsmodules.build.manifest.json</_JsModuleBuildManifestPath>
    </PropertyGroup>
    <Error Condition="'$(_HasWebSpaJsInitializer)' != 'true'"
           Text="web-server JS initializer list omitted Web.Spa (web.spa*.lib.module.js). A missed Spa module is a failed build, not a runtime surprise on /Login (task 200). Manifest: $(_JsModuleBuildManifestPath). Modules: @(_ExistingBuildJSModules->'%(RelativePath)', ', '). Rebuild web-spa so TypeScript emit exists before SWA discovery (task 116), then rebuild this host." />
  </Target>

  <Target Name="AssertWebSpaJsInitializerInHostPublishManifest"
          AfterTargets="GenerateJSModuleManifestPublishStaticWebAssets">
    <ItemGroup>
      <_WebSpaJsPublishInitializerModule Include="@(_ExistingPublishJSModules)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '(?i)web\.spa.*\.lib\.module\.js'))" />
    </ItemGroup>
    <PropertyGroup>
      <_HasWebSpaJsPublishInitializer>false</_HasWebSpaJsPublishInitializer>
      <_HasWebSpaJsPublishInitializer Condition="@(_WebSpaJsPublishInitializerModule->Count()) > 0">true</_HasWebSpaJsPublishInitializer>
    </PropertyGroup>
    <Error Condition="'$(_HasWebSpaJsPublishInitializer)' != 'true'"
           Text="web-server publish JS initializer list omitted Web.Spa (web.spa*.lib.module.js). A missed Spa module is a failed publish, not a runtime surprise on /Login (task 200). Modules: @(_ExistingPublishJSModules->'%(RelativePath)', ', ')." />
  </Target>

</Project>
