<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <Description>TimeWarp Architecture Demo Application</Description>
    <!-- Assembly identity is Web.Spa (project file is web-spa.csproj for path-naming consistency).
         Required: the JS-initializer auto-detection filter is **/$(PackageId).lib.module.js, which
         must match wwwroot/js/web.spa.lib.module.js; and runtime type strings reference ", Web.Spa"
         (e.g. the counter's IncrementCounter action dispatched from JS). A 2b5a1ff6 path-rename had
         silently dropped this, breaking the JS initializer + JS-interop dispatch. -->
    <AssemblyName>Web.Spa</AssemblyName>
    <DefineConstants>grpc;api;web</DefineConstants>
    <Nullable>enable</Nullable>
    <!-- Interactive-Auto serves users whose browser culture differs from the server's; without
         full ICU data the WASM runtime aborts on startup with "Blazor detected a change in the
         application's culture" (hit by a real en-GB user on the task-112 public share; en-US
         users never see it). Cost: larger ICU payload in the WASM download. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!--<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>-->
    <!-- Auth is runtime-config-gated (tasks 145-009 + 104-021): Authentication:UseMock (dev mock),
         Authentication:UseEntra (opt-in MSAL), else identity-session. No MOCK_AUTHENTICATION /
         ENTRA DefineConstants — mock, MSAL, and identity-session code paths compile always;
         activation is MockAuthenticationRegistration / UseEntra / IdentitySessionAuthenticationRegistration.
         Use Mock web API (optional offline SPA API fakes): -->
    <!-- <DefineConstants>$(DefineConstants);MOCK_WEB_API</DefineConstants> -->
  </PropertyGroup>

  <PropertyGroup>
    <!-- 
      Suppress these logging performance rules only in this Blazor WASM project:

      CA1848 - Prefer LoggerMessage delegates over LoggerExtensions methods
      CA1873 - Avoid evaluating logging arguments when the level is disabled
      CA2254 - Logging message template should be constant

      Reason: These rules target high-throughput server scenarios. In a browser-based 
      SPA the performance gain is negligible. This is a deliberate exception to the 
      root AnalysisMode=All policy.
    -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2254</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- ReduxDevToolsEnabled is the SINGLE symbol gating Redux DevTools (task 119): service
         registration (program.cs UseReduxDevTools), the <ReduxDevTools/> component, its inject,
         and its InitAsync all compile under this symbol. It must be Debug-only: web-server
         composes these same services for prerendering, so a Release build that rendered the
         component without the registration 500'd every SPA-shell request. Do not gate any of
         those sites on #if DEBUG directly — one symbol, one truth. -->
    <DefineConstants>$(DefineConstants);ReduxDevToolsEnabled</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" />
    <PackageReference Include="BlazorComponentUtilities"/>
    <PackageReference Include="TimeWarp.Components"/>
    <PackageReference Include="Grpc.Net.Client"/>
    <PackageReference Include="Grpc.Net.Client.Web"/>
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly"/>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication"/>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client"/>
    <PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration"/>
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components"/>
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons"/>
    <PackageReference Include="Microsoft.TypeScript.MSBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Morris.Blazor.ControlFlow"/>
    <PackageReference Include="Blazilla"/>
    <PackageReference Include="TimeWarp.State" />
    <PackageReference Include="TimeWarp.State.Plus"/>
    <PackageReference Include="Timewarp.OptionsValidation"/>
    <PackageReference Include="protobuf-net.Grpc"/>
    <PackageReference Include="timewarp-heroicons"/>
    <PackageReference Include="timewarp-simple-icons"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Source generators ([Page], [StateAccess], mock-factory registry) serve ALL of web-spa —
         this reference must stay outside every feature-flag conditional. -->
    <ProjectReference Include="..\..\..\..\analyzers\timewarp-architecture-analyzers\timewarp-architecture-analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      Condition="'$(UseAnalyzerPackages)' != 'true'" />
    <PackageReference Include="$(TwArchitectureGeneratorsPackageId)" PrivateAssets="all"
                      Condition="'$(UseAnalyzerPackages)' == 'true'" />

    <!--#if(api)-->
    <ProjectReference Include="..\..\..\api\projects\api-contracts\api-contracts.csproj"/>
    <!--#endif-->
    <!--#if(grpc)-->
    <ProjectReference Include="..\..\..\grpc\projects\grpc-contracts\grpc-contracts.csproj"/>
    <!--#endif-->
    <ProjectReference Include="..\web-contracts\web-contracts.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="web-spa-integration-tests"/>
    <!-- AssemblyName of web-spa-integration-tests is web-spa-integration-Tests (capital T) so
         TimeWarp.State's Initialize() assembly-name guard passes. InternalsVisibleTo is the
         assembly name, not the csproj name. -->
    <InternalsVisibleTo Include="web-spa-integration-Tests"/>
    <InternalsVisibleTo Include="web-server-integration-tests"/>
    <InternalsVisibleTo Include="api-server-integration-tests"/>
    <InternalsVisibleTo Include="timewarp-testing"/>
  </ItemGroup>

  <ItemGroup>
    <!--<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />-->
    <Folder Include="components\editors\"/>
    <Folder Include="features\admin\" />
  </ItemGroup>

  <!-- TypeScript (source/**/*.ts -> wwwroot/js via tsconfig outDir) is compiled by
       Microsoft.TypeScript.MSBuild 7.0.1 (native tsc-go) — node/npm NOT required.
       Type-checking uses ambient declarations under source/types (tsconfig typeRoots).
       The npm lint/format toolchain was removed (059-006).

       Design (task 116 + 201 + 200): SWA globs wwwroot/** into Content at evaluation.
       ResolveProjectStaticWebAssets runs BeforeTargets=AssignTargetPaths (before Compile)
       and feeds @(Content) to DefineStaticWebAssets (RelativePathPattern=wwwroot/**).
       Rebuild = Clean;Build in one invocation: CleanTypeScriptOutputs deletes wwwroot/js
       (via obj/*/tsc-emitted.txt), but Content still lists those paths →
       DefineStaticWebAssets throws "No file exists for the asset". Fix: run the v7
       SetTscExecutable + RunTscCompile targets before SWA discovery so files exist.
       wwwroot/js is gitignored: evaluation-time Content still misses files that RunTscCompile
       just emitted in the same build, so the host JS initializer list can omit Web.Spa
       (task 200 /Login 'Spa' was undefined). Re-glob emit into Content here, after tsc and
       before ResolveProjectStaticWebAssets. Exclude="@(Content)" avoids duplicate identities
       when the files already existed at evaluation.
       v7 dropped the classic CheckFileSystemCaseSensitive / CompileTypeScript /
       GetTypeScriptOutputForPublishing chain (MSB4057 on 7.0.0/7.0.1 if those names stay
       in PrepareForBuildDependsOn). v7 does not re-add GeneratedJavascript, so the
       RemoveDuplicateTypeScriptOutputs de-dupe is gone. Do not commit wwwroot/js
       (gitignored). Local workaround can drop when SDK ships
       Microsoft.NET.Sdk.StaticWebAssets.TypeScript.targets (tracked for .NET 11).
       TypeScriptCompileBlocked after the early run skips the same targets on CoreCompile. -->
  <Target Name="CompileTypeScriptBeforeStaticWebAssets"
          BeforeTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="SetTscExecutable;RunTscCompile">
    <PropertyGroup>
      <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
    </PropertyGroup>
    <ItemGroup>
      <_TscEmittedJs Include="wwwroot\js\**\*" />
      <Content Include="@(_TscEmittedJs)" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="features\profile-menu\components\ProfileDropDown.razor" />
    <_ContentIncludedByDefault Remove="features\profile-menu\components\ProfileMenuNavLink.razor" />
    <_ContentIncludedByDefault Remove="features\profile-menu\components\ProfileMenuPanel.razor" />
  </ItemGroup>
</Project>
