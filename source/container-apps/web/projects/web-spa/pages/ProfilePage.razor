@namespace TimeWarp.Architecture.Features.Profiles
@inherits BaseComponent

@*
  Purpose: signed-in user's progressive profile — display plus optional update after the principal exists.

  Design: fetch and save go through ProfileState (TWA0022). EditForm binds IProfileDetails
  (UpdateProfile.Command) with ProfileDetailsValidator (Blazilla). Email is optional.
  Language/Region/Theme are FluentSelect bound to ProfileCatalog so junk like
  "en-US asdfasdf" cannot be typed; the same catalog backs the PUT validator.
*@

@code {
  public static string Title => "Profile";
  public static Icon? NavIcon => new Icons.Regular.Size20.Person();

  private static readonly ProfileDetailsValidator ProfileValidator = new();

  private UpdateProfile.Command Command { get; } = new();
  private IProfileDetails Details => Command;

  private bool IsLoading =>
    IsAnyActive(typeof(ProfileState.FetchProfileDataActionSet.Action));
  private bool IsBusy => ActionTrackingState.IsActive;

  protected override async Task OnInitializedAsync()
  {
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    await ProfileState.FetchProfileData();
    SyncCommandFromState();
  }

  private void SyncCommandFromState()
  {
    Command.Alias = ProfileState.Alias ?? "";
    Command.Email = ProfileState.Email;
    Command.Language = ProfileState.Language ?? "en-US";
    Command.Region = ProfileState.Region ?? "US";
    Command.Theme = ProfileState.Theme ?? "system";
    Command.Notifications = ProfileState.Notifications == true;
  }

  private async Task HandleValidSubmit()
  {
    await ProfileState.UpdateProfile(Command);
    SyncCommandFromState();
  }
}

<TimeWarpPage Title="Profile">
  <div class="twe-stack">
    <Card Title="Your profile">
      @if (IsLoading)
      {
        <p><em>Loading…</em></p>
      }
      else
      {
        <div class="twe-stack">
          <FluentAvatar
            Image=@ProfileState.Avatar
            Name=@ProfileState.Alias
            Size="AvatarSize.Size56" />
          <EditForm Model=@Details OnValidSubmit=HandleValidSubmit FormName="ProfileForm" novalidate>
            <FluentValidator Validator="@ProfileValidator" />
            <FluentStack Orientation=Orientation.Vertical VerticalGap="16">
              <div>
                <FluentTextInput @bind-Value=Details.Alias Label="Display name" Name="Alias" data-qa="ProfileAlias" style="width:100%" />
                <ValidationMessage For="@(() => Details.Alias)" />
              </div>
              <div>
                <FluentTextInput @bind-Value=Details.Email Label="Email (optional)" Name="Email" data-qa="ProfileEmail" style="width:100%" />
                <ValidationMessage For="@(() => Details.Email)" />
              </div>
              <div>
                <FluentSelect TOption="ProfileCatalog.Entry" TValue="string"
                  Items="@ProfileCatalog.Languages"
                  OptionValue="@(static entry => entry?.Code)"
                  OptionText="@(static entry => entry?.Label ?? string.Empty)"
                  @bind-Value="Details.Language"
                  Label="Language"
                  Name="Language"
                  Width="100%"
                  data-qa="ProfileLanguage" />
                <ValidationMessage For="@(() => Details.Language)" />
              </div>
              <div>
                <FluentSelect TOption="ProfileCatalog.Entry" TValue="string"
                  Items="@ProfileCatalog.Regions"
                  OptionValue="@(static entry => entry?.Code)"
                  OptionText="@(static entry => entry?.Label ?? string.Empty)"
                  @bind-Value="Details.Region"
                  Label="Region"
                  Name="Region"
                  Width="100%"
                  data-qa="ProfileRegion" />
                <ValidationMessage For="@(() => Details.Region)" />
              </div>
              <div>
                <FluentSelect TOption="ProfileCatalog.Entry" TValue="string"
                  Items="@ProfileCatalog.Themes"
                  OptionValue="@(static entry => entry?.Code)"
                  OptionText="@(static entry => entry?.Label ?? string.Empty)"
                  @bind-Value="Details.Theme"
                  Label="Theme"
                  Name="Theme"
                  Width="100%"
                  data-qa="ProfileTheme" />
                <ValidationMessage For="@(() => Details.Theme)" />
              </div>
              <FluentCheckbox @bind-Value=Details.Notifications Label="Notifications" />
              <FluentButton Type=ButtonType.Submit Appearance=ButtonAppearance.Primary Disabled=@IsBusy data-qa="ProfileSave">Save</FluentButton>
            </FluentStack>
          </EditForm>
        </div>
      }
    </Card>
  </div>
</TimeWarpPage>

