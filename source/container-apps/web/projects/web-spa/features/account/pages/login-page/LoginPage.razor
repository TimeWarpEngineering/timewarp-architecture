@namespace TimeWarp.Architecture.Features.Account
@inherits BaseComponent

@code {
  public static string Title => "Sign in";
  public static Icon? NavIcon => new Icons.Regular.Size20.PersonPasskey();
}

<PageTitle>Sign in</PageTitle>

<TimeWarpFocusedPage>
  <div class="twe-stack">
    <Card Title="Sign in">
      <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        @* Conditional UI anchor (task 166 / web.dev passkey-form-autofill): focusing this input
           opens the browser passkey autofill menu, which can include local passkeys and
           "Passkeys from a Nearby Device". Value is never used as an account identifier —
           discoverable credentials only. Required autocomplete tokens for the browser. *@
        @if (ShowAutofillAnchor)
        {
          <div class="twe-login-autofill">
            <label class="twe-login-autofill__label" for="twe-login-passkey-autofill">Passkey</label>
            <input id="twe-login-passkey-autofill"
                   class="twe-login-autofill__input"
                   type="text"
                   name="username"
                   autocomplete="username webauthn"
                   autofocus
                   data-qa="PasskeyAutofill"
                   disabled="@IsBusy"
                   aria-describedby="twe-login-autofill-hint" />
            <p id="twe-login-autofill-hint" class="twe-login-autofill__hint">
              Tap or click the field to choose a passkey (including from a nearby device).
            </p>
          </div>
        }

        <FluentButton Appearance="ButtonAppearance.Primary"
                      data-qa="ContinueWithPasskey"
                      Disabled="IsBusy"
                      OnClick="ContinueWithPasskey">
          Sign in with a passkey
        </FluentButton>

        <hr class="twe-login-divider" />

        <p class="twe-login-create">
          Don't have an account?
          <FluentButton Appearance="ButtonAppearance.Outline"
                        data-qa="CreatePasskey"
                        Disabled="IsBusy"
                        OnClick="CreatePasskey">
            Create account
          </FluentButton>
        </p>
      </FluentStack>
    </Card>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
      <FluentMessageBar Intent="MessageBarIntent.Error" Title="Error" AllowDismiss="false">
        @ErrorMessage
      </FluentMessageBar>
    }
  </div>
</TimeWarpFocusedPage>

@* Native autofill field styles (tokens only). *@
<style>
  @(@"
    .twe-login-divider {
      border: 0;
      border-top: 1px solid var(--twe-rule);
      margin: 0;
      width: 100%;
    }
    .twe-login-create {
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      color: var(--twe-ink-2);
      font-size: var(--twe-text-body);
    }
    .twe-login-autofill {
      display: flex;
      flex-direction: column;
      gap: 6px;
      width: 100%;
    }
    .twe-login-autofill__label {
      font-size: var(--twe-text-helper);
      color: var(--twe-muted);
    }
    .twe-login-autofill__input {
      width: 100%;
      box-sizing: border-box;
      padding: 10px 12px;
      border: 1px solid var(--twe-rule);
      border-radius: var(--twe-radius-sm);
      background: var(--twe-paper);
      color: var(--twe-ink);
      font: inherit;
    }
    .twe-login-autofill__input:focus {
      outline: 2px solid var(--twe-purple);
      outline-offset: 1px;
    }
    .twe-login-autofill__hint {
      margin: 0;
      font-size: var(--twe-text-helper);
      color: var(--twe-muted);
    }
  ")
</style>
