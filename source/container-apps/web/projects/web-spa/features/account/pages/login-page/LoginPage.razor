@namespace TimeWarp.Architecture.Features.Account
@inherits BaseComponent

@code {
  public static string Title => "Sign in";
  public static Icon? NavIcon => new Icons.Regular.Size20.PersonPasskey();
}

<PageTitle>Sign in</PageTitle>

<TimeWarpFocusedPage>
  <div class="twe-stack">
    <Card Title="Sign in">
      <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <FluentButton Appearance="ButtonAppearance.Primary"
                      data-qa="ContinueWithPasskey"
                      Disabled="IsBusy"
                      OnClick="ContinueWithPasskey">
          Sign in with a passkey
        </FluentButton>

        <hr class="twe-login-divider" />

        <p class="twe-login-create">
          Don't have an account?
          <FluentButton Appearance="ButtonAppearance.Outline"
                        data-qa="CreatePasskey"
                        Disabled="IsBusy"
                        OnClick="CreatePasskey">
            Create account
          </FluentButton>
        </p>
      </FluentStack>
    </Card>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
      <FluentMessageBar Intent="MessageBarIntent.Error" Title="Error" AllowDismiss="false">
        @ErrorMessage
      </FluentMessageBar>
    }
  </div>
</TimeWarpFocusedPage>

@* Divider / create-row styles: Exception B scope-handle is unnecessary — native elements only.
   Isolation would not stamp Fluent children; these classes live on native p/hr. *@
<style>
  @(@"
    .twe-login-divider {
      border: 0;
      border-top: 1px solid var(--twe-rule);
      margin: 0;
      width: 100%;
    }
    .twe-login-create {
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      color: var(--twe-ink-2);
      font-size: var(--twe-text-body);
    }
  ")
</style>
