@namespace TimeWarp.Architecture.Features.Account
@inherits BaseComponent

@code {
  public static string Title => "Sign in";
  public static Icon? NavIcon => new Icons.Regular.Size20.PersonPasskey();
}

<PageTitle>Sign in</PageTitle>

<TimeWarpPage Title="Sign in">
  <div class="twe-stack">
    <Card Title="Continue with a passkey">
      <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <p>
          No email, username, or profile form. A passkey is your account — create one once,
          then continue with the same authenticator (platform, password manager, or hardware key).
        </p>
        <p>
          Session:
          @(IsAuthenticated is true
            ? "signed in"
            : IsAuthenticated is false
              ? "not signed in"
              : "checking…")
        </p>
        <div>
          <FluentButton Appearance="ButtonAppearance.Primary"
                        data-qa="ContinueWithPasskey"
                        Disabled="IsBusy"
                        OnClick="ContinueWithPasskey">
            Continue with passkey
          </FluentButton>
        </div>
        <div>
          <FluentButton Appearance="ButtonAppearance.Outline"
                        data-qa="CreatePasskey"
                        Disabled="IsBusy"
                        OnClick="CreatePasskey">
            Create a passkey
          </FluentButton>
        </div>
      </FluentStack>
    </Card>


    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
      <FluentMessageBar Intent="MessageBarIntent.Error" Title="Error" AllowDismiss="false">
        @ErrorMessage
      </FluentMessageBar>
    }
  </div>
</TimeWarpPage>
