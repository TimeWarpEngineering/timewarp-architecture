@namespace TimeWarp.Architecture.Features.Feedback
@inherits BaseComponent

@code {
  public static string Title => "Feedback";
  public static Icon? NavIcon => new Icons.Regular.Size20.Comment();

  private Guid RequestedId;
  private string ReplyDraft = "";

  protected override async Task OnParametersSetAsync()
  {
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    if (FeedbackItemId == Guid.Empty || FeedbackItemId == RequestedId)
    {
      return;
    }

    RequestedId = FeedbackItemId;
    await FeedbackState.OpenFeedback(FeedbackItemId);
  }

  private async Task SendReplyAsync(Guid feedbackItemId)
  {
    await FeedbackState.ReplyAsFiler(feedbackItemId, ReplyDraft);
    if (FeedbackState.LastReplySucceeded)
    {
      ReplyDraft = "";
    }
  }

  private static string ActivityLabel(FeedbackActivityKind kind) => kind switch
  {
    FeedbackActivityKind.StatusChange => "Status change",
    FeedbackActivityKind.AdminReply => "Reply from the team",
    FeedbackActivityKind.FilerReply => "Your reply",
    _ => kind.ToString(),
  };
}

<TimeWarpPage Title="Feedback">
  <Section Title="Feedback" LoadingActionType="typeof(FeedbackState.OpenFeedbackActionSet.Action)">
    @if (FeedbackState.LoadError is not null)
    {
      <p data-qa="FeedbackLoadError">@FeedbackState.LoadError</p>
    }
    else if (FeedbackState.Current is { } item)
    {
      <p data-qa="FeedbackReceiptId">@item.FeedbackItemId</p>
      <p>@item.Kind</p>
      <p data-qa="FeedbackStatus">Status: @FeedbackState.CurrentStatus</p>
      <h2>@item.Title</h2>
      <FeedbackBody Body="@item.Body" Attachments="@item.Attachments"
        BodyDataQa="FeedbackItemBody" AttachmentDataQa="FeedbackItemAttachment" />
      <FluentLink Href="@item.Permalink" data-qa="FeedbackPermalink">@item.Permalink</FluentLink>
      @if (FeedbackState.CurrentActivity.Count > 0)
      {
        <ul class="feedback-item-thread" data-qa="FeedbackThread">
          @foreach (FeedbackActivityEntry entry in FeedbackState.CurrentActivity)
          {
            <li @key="entry.Sequence" data-qa="@($"Feedback{entry.Kind}")">
              <strong>@ActivityLabel(entry.Kind)</strong>
              <span>@entry.At.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", CultureInfo.InvariantCulture)</span>
              @if (entry.Kind == FeedbackActivityKind.StatusChange)
              {
                <p>@entry.FromStatus → @entry.ToStatus</p>
              }
              else
              {
                <p>@entry.Body</p>
              }
            </li>
          }
        </ul>
      }
      <TextArea @bind-Value="ReplyDraft" AriaLabel="Reply" data-qa="FeedbackReply" />
      <FluentButton Appearance="ButtonAppearance.Primary"
        data-qa="FeedbackSendReply"
        OnClick="@(() => SendReplyAsync(item.FeedbackItemId))">Send reply</FluentButton>
    }
  </Section>
</TimeWarpPage>
