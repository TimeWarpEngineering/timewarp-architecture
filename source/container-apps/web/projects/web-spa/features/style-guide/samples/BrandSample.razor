@namespace TimeWarp.Architecture.Features.StyleGuide

@code {
  [Inject] private IOptions<BrandOptions> BrandOptionsAccessor { get; set; } = null!;

  private BrandOptions Brand => BrandOptionsAccessor.Value;
}

<Card Title="Brand">
  <p class="sg-subtitle">Product name, logo, shell tokens, and the Fluent ramp come from BrandOptions. This card is the checked-in brand.</p>
  <div class="sg-brand">
    <img class="sg-brand__logo"
         src="@Brand.LogoSrc"
         alt="@Brand.LogoAlt"
         width="@Brand.LogoWidth"
         height="@Brand.LogoHeight"
         data-qa="StyleGuideBrandLogo" />
    <p class="sg-brand__fact" data-qa="StyleGuideBrandName">@Brand.ProductName</p>
    <p class="sg-brand__fact" data-qa="StyleGuideBrandSeed">@Brand.NormalizedSeedColor</p>
    <p class="sg-brand__fact" data-qa="StyleGuideBrandRamp">@(Brand.ExactRamp ? "Exact" : "Harmonized")</p>
  </div>
</Card>
