@namespace TimeWarp.Architecture.Features.StyleGuide

<Card Title="Role badges">
  <p class="sg-subtitle">A role name on a status pill. The page passes the word and the status. These samples change nothing.</p>
  <div class="sg-row sg-follow" data-qa="StyleGuideRoleBadges">
    <RoleBadge Role="Owner" Status="BadgeStatus.Warning" />
    <RoleBadge Role="Admin" Status="BadgeStatus.Info" />
    <RoleBadge Role="Staff" Status="BadgeStatus.Inactive" />
  </div>
</Card>
