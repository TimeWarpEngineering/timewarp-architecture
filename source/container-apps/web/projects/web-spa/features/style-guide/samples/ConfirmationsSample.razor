@namespace TimeWarp.Architecture.Features.StyleGuide
@inherits BaseComponent

@code {
  private Task ConfirmSampleAsync() => NoSubStyleGuideState.ConfirmSample();
}

<Card Title="Confirmations">
  <p class="sg-subtitle">A confirm asks inside the action, before any request. Enter does not confirm. Escape cancels. This sample posts a note and changes nothing else.</p>
  <FluentButton Appearance="ButtonAppearance.Outline" data-qa="ConfirmSample" OnClick="ConfirmSampleAsync">Ask to confirm</FluentButton>
</Card>
