@namespace TimeWarp.Architecture.Features.StyleGuide

@code {
  private static readonly IReadOnlyList<SignInMethod> PasskeyOnly = [SignInMethod.Passkey];

  private static readonly IReadOnlyList<SignInMethod> BothMethods =
    [SignInMethod.Microsoft365, SignInMethod.Passkey];
}

<Card Title="Sign-in">
  <p class="sg-subtitle">The server lists the offered methods. Buttons follow SignInMethod order. One method, then both.</p>
  <div data-qa="StyleGuideSignInOne">
    <SignInChoices Methods="PasskeyOnly" />
  </div>
  <div data-qa="StyleGuideSignInBoth">
    <SignInChoices Methods="BothMethods" />
  </div>
</Card>
