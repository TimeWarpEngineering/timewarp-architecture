@namespace TimeWarp.Architecture.Features.StyleGuide
@inherits BaseComponent

@code {
  public static Icon? NavIcon => new Icons.Regular.Size20.Color();
  public static string Title => "Style Guide";

  private StyleGuideParts.Selection Current => StyleGuideParts.Resolve(Part);

  private string? CrumbLabel
  {
    get
    {
      if (Current.Kind == StyleGuideParts.SelectionKind.Part)
      {
        return Current.Part!.Title;
      }

      if (Current.Kind == StyleGuideParts.SelectionKind.Unknown)
      {
        return Part;
      }

      return null;
    }
  }

}

<TimeWarpPage Title="Style Guide" BreadcrumbLabel="@CrumbLabel">
  <Description>Live brand tokens, type scale, and components — TimeWarp Enterprises brand.</Description>
  <ChildContent>
    <div class="sg-layout">
      <StyleGuideCatalog SelectedSlug="@Current.Part?.Slug" Known="@(Current.Kind != StyleGuideParts.SelectionKind.Unknown)" />
      <div class="sg-stage" data-qa="StyleGuideStage">
        @if (Current.Kind == StyleGuideParts.SelectionKind.Unknown)
        {
          <div class="sg-missing" data-qa="StyleGuideUnknown">
            <p class="sg-missing__title">No such part.</p>
            <p class="sg-missing__body">This slug is not in the catalog.</p>
            <FluentAnchorButton Appearance="ButtonAppearance.Subtle" Href="@StyleGuidePage.GetPageUrl()" data-qa="StyleGuideUnknownAll">All</FluentAnchorButton>
          </div>
        }
        else if (Current.Kind == StyleGuideParts.SelectionKind.All)
        {
          <div class="twe-stack">
            @foreach (StyleGuideParts.Part part in StyleGuideParts.PageOrder)
            {
              @StyleGuideParts.Render(part)
            }
          </div>
        }
        else
        {
          <div class="twe-stack" data-qa="StyleGuidePart" data-part="@Current.Part!.Slug">
            @StyleGuideParts.Render(Current.Part)
            <section class="sg-usage" data-qa="StyleGuideUsage">
              <h2 class="sg-usage__label">Usage</h2>
              <pre class="sg-usage__code"><code>@Current.Part.Usage</code></pre>
            </section>
          </div>
        }
      </div>
    </div>
  </ChildContent>
</TimeWarpPage>
