@namespace TimeWarp.Architecture.Features.StyleGuide
@inherits BaseComponent

@code {
  public static Icon? NavIcon => new Icons.Regular.Size20.Color();
  public static string Title => "Style Guide";

  private static readonly (string Name, string Token, string Hex)[] ColorTokens =
  [
    ("Purple (primary)", "--twe-purple", "#55409c"),
    ("Blue (secondary)", "--twe-blue", "#0085b2"),
    ("Green (highlight)", "--twe-green", "#69a144"),
    ("Ink (text)", "--twe-ink", "#1a1d28"),
    ("Muted", "--twe-muted", "#767a86"),
    ("Background", "--twe-background", "#fafafb"),
    ("Paper", "--twe-paper", "#ffffff"),
    ("Danger", "--twe-danger", "#c2342a"),
  ];

  private static readonly (string Token, string Label)[] TypeScale =
  [
    ("--twe-text-page-title", "28 — Page title"),
    ("--twe-text-section-title", "18 — Section title"),
    ("--twe-text-body", "14 — Body, button"),
    ("--twe-text-helper", "12 — Helper text"),
    ("--twe-text-eyebrow", "11 — Section eyebrow"),
  ];

  private const string StyleGuideDrawerId = "style-guide-drawer";

  private string FormDemoName { get; set; } = "Ada Lovelace";
  private string FormDemoEmail { get; set; } = "ada@example.test";

  private static readonly string[] FilterDemoStatuses = ["Open", "Closed"];
  private static readonly string[] FilterDemoKinds = ["", "Note"];
  private static readonly string[] TabDemoItems = ["Overview", "Activity", "Notes"];
  private static readonly string[] SegmentDemoItems = ["Day", "Week", "Month"];

  private static readonly Icon IntegrationConnectedIcon = new Icons.Regular.Size24.CloudSync();
  private static readonly Icon IntegrationWarningIcon = new Icons.Regular.Size24.Warning();
  private static readonly Icon IntegrationSyncIcon = new Icons.Regular.Size20.ArrowSync();

  // Message bars go through OUR NotificationState pipeline (the generated ActionSet
  // dispatcher), not a direct INotificationService call — the point is to exercise the app's own path.
  private async Task ShowMessage(MessageBarIntent intent, string title) =>
    await NotificationState.AddNotification(intent, title, externalCancellationToken: CancellationToken);

  // Exercises the exception path end-to-end: a handler throws ->
  // StateTransactionBehavior publishes ExceptionNotification -> ExceptionNotificationHandler
  // records a FluentMessageBar. Dispatched through the generated ActionSet method
  // (TWA0022 bans direct mediator Send here).
  private async Task TriggerException() =>
    await CounterState.ThrowException("Demo exception dispatched from the Style Guide.", CancellationToken);

  private Task ConfirmSampleAsync() => NoSubStyleGuideState.ConfirmSample();
}

<TimeWarpPage Title="Style Guide">
  <Description>Live brand tokens, type scale, and components — TimeWarp Enterprises brand.</Description>
  <Actions>
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Outline action."))">Outline</FluentButton>
    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => ShowMessage(MessageBarIntent.Success, "Primary action."))">Primary</FluentButton>
  </Actions>
  <ChildContent>
    <div class="twe-stack">

      <Card Title="Color Tokens">
        <div class="sg-swatches">
          @foreach ((string name, string token, string hex) in ColorTokens)
          {
            <div class="sg-swatch">
              <div class="sg-swatch__chip" style="background: var(@token);"></div>
              <div class="sg-swatch__name">@name</div>
              <div class="sg-swatch__hex">@hex</div>
            </div>
          }
        </div>
      </Card>

      <Card Title="Type Scale">
        <div class="sg-type">
          @foreach ((string token, string label) in TypeScale)
          {
            <div class="sg-type__row" style="font-size: var(@token);">@label</div>
          }
        </div>
      </Card>

      <Card Title="Forms">
        <p class="sg-subtitle">
          Forms use FormSection / FormField / FormGrid / FormActions from components/forms.
          Controls are full width by default (a field takes the whole row unless FormField.Span
          pairs short fields). Spacing tokens: --twe-space-2 (8px label→control), --twe-space-6
          (24px field row gap — Fluent 24px; Tailwind gap-y-8 is 32px, we pick 24), --twe-space-12
          (48px section gap), --twe-space-3 (12px action gap). No page-local margins.
        </p>
        <FormSection Title="Profile" Description="Identity shown on the account.">
          <FormGrid>
            <FormField Label="Display name" Hint="Shown in the app bar.">
              <FluentTextInput @bind-Value="FormDemoName" AriaLabel="Display name" Width="100%" data-qa="StyleGuideFormField" />
            </FormField>
            <FormField Label="Email" Hint="Optional.">
              <FluentTextInput @bind-Value="FormDemoEmail" AriaLabel="Email" Width="100%" />
            </FormField>
          </FormGrid>
        </FormSection>
        <FormActions>
          <FluentButton Appearance="ButtonAppearance.Subtle">Cancel</FluentButton>
          <FluentButton Appearance="ButtonAppearance.Primary">Save</FluentButton>
        </FormActions>
      </Card>

      <Section Title="Section"
               Description="Loading UI is FluentSpinner while the bound action is active; loaded content is the child. Pages sequence actions; handlers never chain a fetch."
               LoadingActionType="typeof(CounterState.IncrementCounterActionSet.Action)">
        <p>Loaded section content. Bind <code>LoadingActionType</code> to the in-flight action (for example FetchPrincipals).</p>
      </Section>

      <Card Title="Section Header">
        <SectionHeader Title="Reports" Subtitle="Summary for the current period.">
          <Aside>
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Details."))">Details</FluentButton>
          </Aside>
        </SectionHeader>
      </Card>

      <Card Title="Filter Bar">
        <p class="sg-subtitle">A paper toolbar. Search waits for a pause, then raises one callback. These values are sample text; the demo does not store them.</p>
        <FilterBar SearchText="Report" SearchPlaceholder="Search…">
          <FilterSelect Label="Status" Items="FilterDemoStatuses" Value="Open" />
          <FilterSelect Label="Kind" Items="FilterDemoKinds" Value="" OptionText="@(static value => value.Length == 0 ? "All" : value)" />
        </FilterBar>
      </Card>

      <Card Title="Tabs">
        <p class="sg-subtitle">An underline switcher. The sample does not store the value.</p>
        <Tabs Items="TabDemoItems" Value="Overview" AriaLabel="Sample views" />
      </Card>

      <Card Title="Segmented Control">
        <p class="sg-subtitle">A pill group of mutually exclusive options. The sample does not store the value.</p>
        <SegmentedControl Items="SegmentDemoItems" Value="Week" AriaLabel="Sample period" />
      </Card>

      <Card Title="Avatars">
        <p class="sg-subtitle">A circle of one or two initials on the brand fill. Small, medium, and large.</p>
        <div class="twe-stack">
          <div class="sg-row">
            <Avatar Name="Ada Lovelace" Size="InitialsAvatarSize.Small" />
            <Avatar Name="Ada Lovelace" />
            <Avatar Name="Ada Lovelace" Size="InitialsAvatarSize.Large" />
          </div>
          <div class="sg-row">
            <Avatar Name="Ada" />
            <Avatar Name="Ada Lovelace" />
            <Avatar Name="𠮷野" />
            <Avatar Name="Alexandria Josephine Montgomery-Weatherby" />
          </div>
          <div class="sg-row">
            <Avatar Name="Ada Lovelace" />
            <span>Ada Lovelace</span>
          </div>
        </div>
      </Card>

      <Card Title="Empty States">
        <p class="sg-subtitle">A full paper card, the same card with an action, and the inline form used inside a card or grid. The sample does not store a choice.</p>
        <div class="twe-stack">
          <EmptyState HeadingLevel="3" Title="No reports yet" Description="Reports appear here after the first run." />
          <EmptyState HeadingLevel="3" Title="No locations selected" Description="Choose the locations this report covers.">
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Select all locations."))">Select all locations</FluentButton>
          </EmptyState>
          <EmptyState Variant="EmptyStateVariant.Inline" Title="No rows match" Description="Try a different filter." />
        </div>
      </Card>

      <Card Title="Drawers">
        <p class="sg-subtitle">A slide-over beside the page. Opening sets the app modal id; closing clears it. One overlay is open at a time.</p>
        <FluentButton Appearance="ButtonAppearance.Primary" data-qa="DrawerOpen" OnClick="@(() => ApplicationState.SetActiveModal(StyleGuideDrawerId))">Open drawer</FluentButton>
        <Drawer Title="Sample drawer"
                IsOpen="@(ApplicationState.ActiveModalId == StyleGuideDrawerId)"
                OnClose="@(() => ApplicationState.CloseModal())"
                data-qa="StyleGuideDrawer">
          <ChildContent>
            <p>A detail or edit form can sit here without leaving the page.</p>
          </ChildContent>
          <Footer>
            <FluentButton Appearance="ButtonAppearance.Primary" data-qa="DrawerFooterClose" OnClick="@(() => ApplicationState.CloseModal())">Close</FluentButton>
          </Footer>
        </Drawer>
      </Card>

      <Card Title="KPI Cards">
        <KpiStrip>
          <KpiCard Label="Open items" Value="12" />
          <KpiCard Label="Coverage" Value="4" Unit="sites" SecondaryValue="2" SecondaryUnit="regions" />
          <KpiCard Label="On time" Value="49.5%" Caption="Last 12 months" />
          <KpiCard Label="Exceptions" Value="3" Tone="KpiTone.Danger" />
        </KpiStrip>
      </Card>

      <Card Title="Integration Cards">
        <p class="sg-subtitle">A full identity banner, and the compact pull-status row. The sample buttons post a note and change nothing.</p>
        <div class="twe-stack">
          <IntegrationCard Title="External system"
                           Meta="Last data pull 2 hours ago"
                           Icon="@IntegrationConnectedIcon"
                           Status="BadgeStatus.Active"
                           StatusLabel="Connected">
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Sync now."))">Sync now</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Disconnect."))">Disconnect</FluentButton>
          </IntegrationCard>
          <IntegrationCard Title="External system"
                           Meta="The stored connection cannot be used."
                           Icon="@IntegrationWarningIcon"
                           Status="BadgeStatus.Warning"
                           StatusLabel="Needs attention">
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Review connection."))">Review</FluentButton>
          </IntegrationCard>
          <IntegrationCard Title="External system" Meta="Last data pull 2 hours ago" />
          <IntegrationCard Variant="IntegrationCardVariant.Compact"
                           Title="External system"
                           Meta="Last data pull 2 hours ago"
                           Icon="@IntegrationSyncIcon">
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Sync now."))">Sync now</FluentButton>
          </IntegrationCard>
          <IntegrationCard Variant="IntegrationCardVariant.Compact"
                           Title=""
                           Meta="Last data pull 2 hours ago" />
        </div>
      </Card>

      <Card Title="Grouped Table">
        <p class="sg-subtitle">One table, with a row group for each title. The page supplies the groups, the order, and the cells.</p>
        <GroupedTable ColumnCount="3" Label="Work items" data-qa="StyleGuideGroupedTable">
          <thead>
            <tr>
              <TableHeader>Item</TableHeader>
              <TableHeader>Note</TableHeader>
              <TableHeader>Updated</TableHeader>
            </tr>
          </thead>
          <TableGroup Title="Open" Count="2" Meta="2 items">
            <tr>
              <Cell>Alpha</Cell>
              <Cell>First pass</Cell>
              <Cell>Today</Cell>
            </tr>
            <tr>
              <Cell>Beta</Cell>
              <Cell>First pass</Cell>
              <Cell>Yesterday</Cell>
            </tr>
          </TableGroup>
          <TableGroup Title="In progress" Count="1">
            <tr>
              <Cell>Gamma</Cell>
              <Cell>Second pass</Cell>
              <Cell>Monday</Cell>
            </tr>
          </TableGroup>
          <TableGroup Title="Closed">
            <tr>
              <Cell>Delta</Cell>
              <Cell>Filed</Cell>
              <Cell>Last week</Cell>
            </tr>
          </TableGroup>
        </GroupedTable>
      </Card>

      <Card Title="Count Chip">
        <p class="sg-subtitle">A number pill. Neutral is for a paper surface. Accent is the brand fill.</p>
        <div class="sg-row">
          <CountChip Value="1" />
          <CountChip Value="12" />
          <CountChip Value="128" />
          <CountChip Value="7" Accent="true" />
        </div>
      </Card>

      <Card Title="Confirmations">
        <p class="sg-subtitle">A confirm asks inside the action, before any request. Enter does not confirm. Escape cancels. This sample posts a note and changes nothing else.</p>
        <FluentButton Appearance="ButtonAppearance.Outline" data-qa="ConfirmSample" OnClick="ConfirmSampleAsync">Ask to confirm</FluentButton>
      </Card>

      <Card Title="Buttons (FluentUI, themed)">
        <p class="sg-subtitle">Actions use these appearances. Destructive row actions are Outline plus the danger class (token --twe-danger) — never a page-local button class.</p>
        <div class="sg-row">
          <FluentButton Appearance="ButtonAppearance.Primary">Primary</FluentButton>
          <FluentButton Appearance="ButtonAppearance.Outline">Outline</FluentButton>
          <FluentButton Appearance="ButtonAppearance.Subtle">Subtle</FluentButton>
          <FluentButton Appearance="ButtonAppearance.Transparent">Transparent</FluentButton>
          <FluentButton Appearance="ButtonAppearance.Outline" Class="twe-button-danger" data-qa="DangerOutline">Danger</FluentButton>
        </div>
      </Card>

      <Card Title="Status Badges">
        <div class="sg-row">
          <StatusBadge Status="BadgeStatus.Active" />
          <StatusBadge Status="BadgeStatus.Inactive" />
          <StatusBadge Status="BadgeStatus.Warning" />
          <StatusBadge Status="BadgeStatus.Info" />
        </div>
      </Card>

      <Card Title="Message bars (FluentUI)">
        <p class="sg-subtitle">Component reference only. Operation outcomes never render inline — they go to the shell's single notification region above (TWA0025); static Info/Warning guidance may stay in a component.</p>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
          <FluentMessageBar Intent="MessageBarIntent.Success" Title="Success" AllowDismiss="false">
            Operation completed successfully.
          </FluentMessageBar>
          <FluentMessageBar Intent="MessageBarIntent.Error" Title="Error" AllowDismiss="false">
            Something went wrong — you can select and copy this text.
          </FluentMessageBar>
          <FluentMessageBar Intent="MessageBarIntent.Warning" Title="Warning" AllowDismiss="false">
            Proceed with caution.
          </FluentMessageBar>
          <FluentMessageBar Intent="MessageBarIntent.Info" Title="Information" AllowDismiss="false">
            Helpful context that does not require immediate action.
          </FluentMessageBar>
        </FluentStack>
      </Card>

      <Card Title="Notifications (message bars)">
        <p class="sg-subtitle">Dispatched through the app's NotificationState pipeline. Bars render in the shell region at the top of the page; identical messages dedupe, Success auto-dismisses, and the stack caps at three with "+N more". The last button throws inside an action to exercise the exception → message bar path.</p>
        <div class="sg-row">
          <FluentButton Appearance="ButtonAppearance.Primary" data-qa="ToastInfo" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Heads up — this is an info message."))">Info</FluentButton>
          <FluentButton Appearance="ButtonAppearance.Primary" data-qa="ToastSuccess" OnClick="@(() => ShowMessage(MessageBarIntent.Success, "Saved successfully."))">Success</FluentButton>
          <FluentButton Appearance="ButtonAppearance.Primary" data-qa="ToastWarning" OnClick="@(() => ShowMessage(MessageBarIntent.Warning, "Careful — this is a warning."))">Warning</FluentButton>
          <FluentButton Appearance="ButtonAppearance.Primary" data-qa="ToastError" OnClick="@(() => ShowMessage(MessageBarIntent.Error, "Something went wrong."))">Error</FluentButton>
          <FluentButton Appearance="ButtonAppearance.Outline" data-qa="ToastException" OnClick="TriggerException">Throw exception</FluentButton>
        </div>
      </Card>

    </div>
  </ChildContent>
</TimeWarpPage>
