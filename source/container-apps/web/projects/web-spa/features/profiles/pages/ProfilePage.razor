@namespace TimeWarp.Architecture.Features.Profiles
@inherits BaseComponent

@*
  Purpose: signed-in user's progressive profile — display plus optional update after the principal exists.

  Design: fetch and save go through ProfileState (TWA0022). EditForm binds IProfileDetails
  (UpdateProfile.Command) with ProfileDetailsValidator (Blazilla). Email is optional.
  Language and Region are searchable FluentCombobox bound to ProfileCatalog.LanguageCodes /
  RegionCodes (string tags, same order as Languages/Regions). Theme stays a 3-way FluentSelect
  on Entry rows. Combobox has no free-form option, so junk like "en-US asdfasdf" cannot be
  submitted as a typed value; the same BCL checks back the PUT validator. Stored Language is
  not applied as UI culture. Fluent UI Blazor v5 Combobox Initialize writes closed text from
  Value is TOption then GetOptionText — so Language/Region use TOption == TValue == string with
  OptionText → LabelFor. Theme FluentSelect already shows labels without that combobox path.
  Layout is FormSection / FormGrid / FormField / FormActions (full-width controls). Cancel
  reloads the draft from ProfileState (SyncCommandFromState) — no extra action-set.
  The xAI key section is a second form after the profile form. It renders only when
  UserXaiApiKeyState.Visible is true (site mode is not Off). The draft key is page-local,
  a password field, and is cleared after a successful save. State never stores it.
*@

@code {
  public static string Title => "Profile";
  public static Icon? NavIcon => new Icons.Regular.Size20.Person();

  private static readonly ProfileDetailsValidator ProfileValidator = new();

  private UpdateProfile.Command Command { get; } = new();
  private IProfileDetails Details => Command;

  private static readonly SetUserXaiApiKey.Validator KeyValidator = new();

  private SetUserXaiApiKey.Command KeyCommand { get; } = new();

  private bool IsBusy => ActionTrackingState.IsActive;

  private string KeyStatusLine
  {
    get
    {
      if (UserXaiApiKeyState.NeedsReplacement)
      {
        string tail = UserXaiApiKeyState.Suffix is null ? "" : $" It ends in …{UserXaiApiKeyState.Suffix}.";
        return "The stored key cannot be read. Paste a new one." + tail;
      }

      if (!UserXaiApiKeyState.Configured || UserXaiApiKeyState.Suffix is null)
      {
        return "No key stored.";
      }

      return $"Configured, ends in …{UserXaiApiKeyState.Suffix}.";
    }
  }

  protected override async Task OnInitializedAsync()
  {
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    await ProfileState.FetchProfileData();
    await NoSubUserXaiApiKeyState.FetchUserXaiApiKeyStatus();
    SyncCommandFromState();
  }

  private void SyncCommandFromState()
  {
    Command.Alias = ProfileState.Alias ?? "";
    Command.Email = ProfileState.Email;
    Command.Language = ProfileState.Language ?? "en-US";
    Command.Region = ProfileState.Region ?? "US";
    Command.Theme = ProfileState.Theme ?? "system";
    Command.Notifications = ProfileState.Notifications == true;
  }

  private async Task HandleValidSubmit()
  {
    await ProfileState.UpdateProfile(Command);
    SyncCommandFromState();
  }

  private void HandleCancel() => SyncCommandFromState();

  private async Task SaveKeyAsync()
  {
    await NoSubUserXaiApiKeyState.SetUserXaiApiKey(KeyCommand.ApiKey);
    if (!UserXaiApiKeyState.SaveFailed)
    {
      KeyCommand.ApiKey = "";
    }
  }

  private Task ClearKeyAsync() => NoSubUserXaiApiKeyState.ClearUserXaiApiKey();
}

<TimeWarpPage Title="Profile">
  <Section Title="Profile" LoadingActionType="typeof(ProfileState.FetchProfileDataActionSet.Action)">
    <EditForm Model=@Details OnValidSubmit=HandleValidSubmit FormName="ProfileForm" novalidate>
      <FluentValidator Validator="@ProfileValidator" />

      <FormSection Title="Profile" Description="How you appear on this account.">
        <FormGrid>
          <FormField>
            <FluentAvatar
              Image=@ProfileState.Avatar
              Name=@ProfileState.Alias
              Size="AvatarSize.Size56" />
          </FormField>
          <FormField Label="Display name">
            <FluentTextInput @bind-Value=Details.Alias Name="Alias" AriaLabel="Display name" data-qa="ProfileAlias" Width="100%" />
            <ValidationMessage For="@(() => Details.Alias)" />
          </FormField>
          <FormField Label="Email (optional)">
            <FluentTextInput @bind-Value=Details.Email Name="Email" AriaLabel="Email (optional)" data-qa="ProfileEmail" Width="100%" />
            <ValidationMessage For="@(() => Details.Email)" />
          </FormField>
        </FormGrid>
      </FormSection>

      <FormSection Title="Preferences" Description="Language, region, theme, and notifications.">
        <FormGrid>
          <FormField Label="Language">
            <FluentCombobox TOption="string" TValue="string"
              Items="@ProfileCatalog.LanguageCodes"
              OptionText="@(static code => ProfileCatalog.LabelFor(ProfileCatalog.Languages, code))"
              @bind-Value="Details.Language"
              Name="Language"
              AriaLabel="Language"
              Placeholder="Search languages"
              Width="100%"
              Height="20rem"
              data-qa="ProfileLanguage" />
            <ValidationMessage For="@(() => Details.Language)" />
          </FormField>
          <FormField Label="Region">
            <FluentCombobox TOption="string" TValue="string"
              Items="@ProfileCatalog.RegionCodes"
              OptionText="@(static code => ProfileCatalog.LabelFor(ProfileCatalog.Regions, code))"
              @bind-Value="Details.Region"
              Name="Region"
              AriaLabel="Region"
              Placeholder="Search regions"
              Width="100%"
              Height="20rem"
              data-qa="ProfileRegion" />
            <ValidationMessage For="@(() => Details.Region)" />
          </FormField>
          <FormField Label="Theme">
            <FluentSelect TOption="ProfileCatalog.Entry" TValue="string"
              Items="@ProfileCatalog.Themes"
              OptionValue="@(static entry => entry?.Code)"
              OptionText="@(static entry => entry?.Label ?? string.Empty)"
              @bind-Value="Details.Theme"
              Name="Theme"
              AriaLabel="Theme"
              Width="100%"
              data-qa="ProfileTheme" />
            <ValidationMessage For="@(() => Details.Theme)" />
          </FormField>
          <FormField Label="Notifications">
            <FluentCheckbox @bind-Value=Details.Notifications AriaLabel="Notifications" />
          </FormField>
        </FormGrid>
      </FormSection>

      <FormActions>
        <FluentButton Type=ButtonType.Button Appearance=ButtonAppearance.Subtle Disabled=@IsBusy OnClick=HandleCancel data-qa="ProfileCancel">Cancel</FluentButton>
        <FluentButton Type=ButtonType.Submit Appearance=ButtonAppearance.Primary Disabled=@IsBusy data-qa="ProfileSave">Save</FluentButton>
      </FormActions>
    </EditForm>
  </Section>
  @if (UserXaiApiKeyState.Visible)
  {
    @if (!UserXaiApiKeyState.CanChange && !UserXaiApiKeyState.StorageAvailable)
    {
      <FormSection Title="xAI API key"
                   Description="Ask can bill this key to your xAI account. The value is never shown again after you save it."
                   data-qa="UserXaiApiKeySettings">
        <p data-qa="UserXaiApiKeyStatus">This deployment cannot store a personal key.</p>
      </FormSection>
    }
    else
    {
      <EditForm Model="KeyCommand" OnValidSubmit="SaveKeyAsync" FormName="UserXaiApiKeyForm" novalidate>
        <FluentValidator Validator="@KeyValidator" />
        <FormSection Title="xAI API key"
                     Description="Ask can bill this key to your xAI account. The value is never shown again after you save it."
                     data-qa="UserXaiApiKeySettings">
          <p data-qa="UserXaiApiKeyStatus">@KeyStatusLine</p>
          @if (UserXaiApiKeyState.SupersededByHost)
          {
            <p data-qa="UserXaiApiKeyHost">The deployment key is in use. Your key is saved and applies when that key is removed.</p>
          }
          <FormGrid>
            <FormField Label="xAI API key">
              <FluentTextInput @bind-Value="KeyCommand.ApiKey"
                               Name="ApiKey"
                               TextInputType="TextInputType.Password"
                               AutoComplete="new-password"
                               AriaLabel="xAI API key"
                               Placeholder="Paste a key"
                               Width="100%"
                               Disabled="@IsBusy"
                               data-qa="UserXaiApiKeyInput" />
              <ValidationMessage For="@(() => KeyCommand.ApiKey)" />
            </FormField>
          </FormGrid>
        </FormSection>
        <FormActions>
          <FluentButton Type="ButtonType.Submit"
                        Appearance="ButtonAppearance.Primary"
                        Disabled="@IsBusy"
                        data-qa="UserXaiApiKeySave">
            Save key
          </FluentButton>
          @if (UserXaiApiKeyState.Configured || UserXaiApiKeyState.NeedsReplacement)
          {
            <FluentButton Type="ButtonType.Button"
                          Appearance="ButtonAppearance.Outline"
                          Disabled="@IsBusy"
                          OnClick="ClearKeyAsync"
                          data-qa="UserXaiApiKeyClear">
              Clear key
            </FluentButton>
          }
        </FormActions>
      </EditForm>
    }
  }
</TimeWarpPage>
