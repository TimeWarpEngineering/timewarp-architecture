@namespace TimeWarp.Architecture.Features.AgentLinks
@using TimeWarp.Architecture.Services
@inherits BaseComponent

@code {
  public static string Title => "Agent links";
  public static Icon? NavIcon => new Icons.Regular.Size20.Link();

  [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

  private string? AccountId;

  private bool IsBusy => ActionTrackingState.IsActive;

  private bool AccountCopied => AgentLinksState.CopiedSlot == AgentLinksState.AccountIdSlot;

  protected override async Task OnInitializedAsync()
  {
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    await AgentLinksState.Fetch();
  }

  protected override async Task OnParametersSetAsync()
  {
    await base.OnParametersSetAsync();
    AccountId = AuthenticationStateTask is null
      ? null
      : (await AuthenticationStateTask).User
        .FindFirst(IdentitySessionAuthenticationStateProvider.PrincipalIdClaimType)?.Value;
  }

  private async Task ApproveAsync(Guid linkId) =>
    await AgentLinksState.Approve(linkId);

  private async Task DenyAsync(Guid linkId) =>
    await AgentLinksState.Deny(linkId);

  private async Task CopyAccountIdAsync()
  {
    if (AccountId is null)
    {
      return;
    }

    await AgentLinksState.CopyOnboarding(AgentLinksState.AccountIdSlot, AccountId);
  }

  private Task OpenPromptAsync() => ApplicationState.SetActiveModal(AgentLinkPromptModal.ModalId);
}

<TimeWarpPage Title="Agent links">
  <div class="twe-onboarding">
    <Section Title="What linking means">
      <p data-qa="LinkingExplanation">
        Linking an agent means the agent proves it holds its own key and asks to link to you.
        You approve or deny that request.
        Paid service does not require a linked human.
        After you approve, the agent can fetch the timewarp.humanUx/v1 handoff document (GetHumanUx).
      </p>
    </Section>

    <Section Title="Your account id">
      @if (AccountId is null)
      {
        <p data-qa="AccountIdMissing">Your account id appears here after you are signed in.</p>
      }
      else
      {
        <div class="twe-account-id">
          <code data-qa="AccountId">@AccountId</code>
          <FluentButton Appearance="ButtonAppearance.Outline"
                        data-qa="CopyAccountId"
                        data-copied="@(AccountCopied ? "true" : "false")"
                        OnClick="CopyAccountIdAsync">@(AccountCopied ? "Copied" : "Copy")</FluentButton>
        </div>
        <p>The agent-link prompt (a bash recipe that uses openssl and curl) opens in a modal. Copy it to your agent after you have the account id above. On Windows, the agent runs it in Git Bash or WSL. It does not run in PowerShell.</p>
        <FluentButton Appearance="ButtonAppearance.Outline"
                      data-qa="OpenAgentLinkPrompt"
                      OnClick="OpenPromptAsync">View agent prompt</FluentButton>
      }
    </Section>

    <Section Title="Optional agent ↔ human links" LoadingActionType="typeof(AgentLinksState.FetchActionSet.Action)">
      <p>Agents can request a link to you.</p>
      @if (AgentLinksState.Items.Count == 0)
      {
        <p>No agent links yet.</p>
      }
      else
      {
        <ul class="twe-stack">
          @foreach (ListAgentHumanLinks.LinkSummary item in AgentLinksState.Items)
          {
            <li>
              <div>
                Agent
                <AuthorizeView Policy="@PermissionIds.AdminPrincipalsRead">
                  <Authorized>
                    <FluentLink Href="@($"/Admin/Principals/{item.AgentPrincipalId:D}")" data-qa="AgentPrincipalLink"><code>@item.AgentPrincipalId</code></FluentLink>
                  </Authorized>
                  <NotAuthorized>
                    <code data-qa="AgentPrincipalText">@item.AgentPrincipalId</code>
                  </NotAuthorized>
                </AuthorizeView>
              </div>
              <div>Status: @item.Status</div>
              @if (item.Status == "Pending")
              {
                <FluentButton Disabled=@IsBusy Appearance=ButtonAppearance.Primary data-qa="ApproveAgentLink" OnClick="@(() => ApproveAsync(item.LinkId))">Approve</FluentButton>
                <FluentButton Disabled=@IsBusy data-qa="DenyAgentLink" OnClick="@(() => DenyAsync(item.LinkId))">Deny</FluentButton>
              }
            </li>
          }
        </ul>
      }
    </Section>
  </div>
</TimeWarpPage>
