@namespace TimeWarp.Architecture.Features.Admin.Roles
@using TimeWarp.Architecture.Features
@inherits BaseComponent

@*
  Purpose: Admin roles list — name, description, grant count and prefix chips; no per-permission widgets.

  Design: Task 206 — list is a list. Membership editing lives on RoleDetailPage
  (/Admin/Roles/{RoleId}). Summary chips are PermissionIds.PrefixesOf on stored grants, not drafts.
  New Role is a FluentButton that dispatches RoleState.OpenNewRole, a catalogued action that
  opens RolePage (/Admin/Roles/New), so Ctrl-K and Ask AI can start a role too (task 506,
  TWA0050). The catalog entry carries admin.roles.manage, RolePage's own policy; the button
  shows to every list reader, as the old link did, and RolePage refuses a reader.
  A role name is a RouteLink to RoleDetailPage. Save does not live on every row.
  The shell location breadcrumb is Home / Roles. No per-page Back button.
  Document title comes from TimeWarpPage Title via TwPageTitle.
*@

@code {
  public static Icon? NavIcon => new Icons.Regular.Size20.PeopleTeam();
  public static string Title => "Roles";

  protected override async Task OnInitializedAsync() => await RoleState.GetRoles();

  private Task OpenNewRoleAsync() => RoleState.OpenNewRole();
}

<TimeWarpPage Title="Roles">
  <div class="twe-stack">
    <p class="ds-subtitle">
      Product roles as permission bundles. Open a role to edit membership. Administrator core
      admin permissions cannot be stripped (protected-core). Create custom roles via New Role
      (empty permissions until you assign them on the role page).
    </p>
    <div>
      <FluentButton Appearance="ButtonAppearance.Primary" OnClick="OpenNewRoleAsync" data-qa="NewRole">
        New Role
      </FluentButton>
    </div>
    <Section Title="Roles" LoadingActionType="typeof(RoleState.GetRolesActionSet.Action)">
      <table class="twe-table" data-qa="RolesTable">
          <thead>
            <tr>
              <TableHeader>Name</TableHeader>
              <TableHeader>Description</TableHeader>
              <TableHeader>Permissions</TableHeader>
            </tr>
          </thead>
          <tbody>
            @foreach (GetRoles.RoleDto role in RoleState.RoleList ?? [])
            {
              int grantCount = role.Permissions.Count;
              IReadOnlyList<string> prefixes = PermissionIds.PrefixesOf(role.Permissions);
              <tr @key="role.RoleId">
                <Cell>
                  <RouteLink Route="@RoleDetailPage.GetPageUrl(role.RoleId)" data-qa="RoleDetail">@role.Name</RouteLink>
                </Cell>
                <Cell>@role.Description</Cell>
                <Cell>
                  <div class="twe-permission-summary">
                    <span class="twe-permission-count" data-qa="PermissionCount">
                      @grantCount @(grantCount == 1 ? "permission" : "permissions")
                    </span>
                    @foreach (string prefix in prefixes)
                    {
                      <StatusBadge Status="BadgeStatus.Info" Label="@($"{prefix}.*")" />
                    }
                  </div>
                </Cell>
              </tr>
            }
          </tbody>
        </table>
    </Section>
  </div>
</TimeWarpPage>
