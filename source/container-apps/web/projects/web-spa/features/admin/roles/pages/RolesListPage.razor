@namespace TimeWarp.Architecture.Features.Admin.Roles
@using TimeWarp.Architecture.Features
@inherits BaseComponent

@*
  Purpose: Admin roles list — name, description, grant count and prefix chips; no per-permission widgets.

  Design: Task 206 — list is a list. Membership editing lives on RoleDetailPage
  (/Admin/Roles/{RoleId}). Summary chips are PermissionIds.PrefixesOf on stored grants, not drafts.
  New Role stays RolePage (/Admin/Roles/New). Save does not live on every row.
*@

@code {
  public static Icon? NavIcon => new Icons.Regular.Size20.PeopleTeam();
  public static string Title => "Roles";

  private bool IsLoading =>
    IsAnyActive(typeof(RoleState.FetchRolesActionSet.Action));

  protected override async Task OnInitializedAsync() => await RoleState.FetchRoles();
}

<PageTitle>@Title</PageTitle>

<TimeWarpPage Title="Roles">
  <div class="twe-stack">
    <p class="sg-subtitle">
      Product roles as permission bundles. Open a role to edit membership. Administrator core
      admin permissions cannot be stripped (protected-core). Create custom roles via New Role
      (empty permissions until you assign them on the role page).
    </p>
    <div>
      <FluentButton Appearance="ButtonAppearance.Primary" Href="@RolePage.GetPageUrl()" data-qa="NewRole">
        New Role
      </FluentButton>
    </div>
    <Card Title="Roles">
      @if (IsLoading)
      {
        <p><em>Loading…</em></p>
      }
      else
      {
        <table class="twe-table" data-qa="RolesTable">
          <thead>
            <tr>
              <TableHeader>Name</TableHeader>
              <TableHeader>Description</TableHeader>
              <TableHeader>Permissions</TableHeader>
            </tr>
          </thead>
          <tbody>
            @foreach (GetRoles.RoleDto role in RoleState.Roles ?? [])
            {
              int grantCount = role.PermissionIds.Count;
              IReadOnlyList<string> prefixes = PermissionIds.PrefixesOf(role.PermissionIds);
              <tr @key="role.RoleId">
                <Cell>
                  <a href="@RoleDetailPage.GetPageUrl(role.RoleId)" data-qa="RoleDetail">@role.Name</a>
                </Cell>
                <Cell>@role.Description</Cell>
                <Cell>
                  <div class="twe-permission-summary">
                    <span class="twe-permission-count" data-qa="PermissionCount">
                      @grantCount @(grantCount == 1 ? "permission" : "permissions")
                    </span>
                    @foreach (string prefix in prefixes)
                    {
                      <StatusBadge Status="BadgeStatus.Info" Label="@($"{prefix}.*")" />
                    }
                  </div>
                </Cell>
              </tr>
            }
          </tbody>
        </table>
      }
    </Card>
  </div>
</TimeWarpPage>
