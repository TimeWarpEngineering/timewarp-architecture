@namespace TimeWarp.Architecture.Features.Admin.Roles
@inherits BaseComponent
@inject NavigationManager NavigationManager

@*
  Purpose: create-role form — bind IRoleDetails, dispatch RoleState.CreateRole.

  Design: web-api-contracts — EditForm binds the IRoleDetails interface; CreateRole.Command
  is the model (no view model). Blazilla FluentValidator takes the shared
  RoleDetailsValidator so only Name/Description are validated (no UserId noise).
  COPIC UX — Action ctor takes Command; submit is RoleState.CreateRole(Command).
  UserId is stamped in the handler GetRequest, not here.
  After create, navigate to RoleDetailPage so membership can be assigned (task 206);
  fall back to the list if LastCreatedRoleId is unset (create did not succeed).
*@

@code {
  private static readonly RoleDetailsValidator RoleValidator = new();

  private CreateRole.Command Command { get; } = new();
  private IRoleDetails RoleDetails => Command;

  private async Task HandleValidSubmit()
  {
    await RoleState.CreateRole(Command);
    if (RoleState.LastCreatedRoleId is Guid roleId)
    {
      NavigationManager.NavigateTo(RoleDetailPage.GetPageUrl(roleId));
      return;
    }

    NavigationManager.NavigateTo(RolesListPage.GetPageUrl());
  }
}

<EditForm Model=@RoleDetails OnValidSubmit=HandleValidSubmit FormName="RoleForm" novalidate>
  <FluentValidator Validator="@RoleValidator" />
  <FluentStack Orientation=Orientation.Vertical VerticalGap="16">

    <div>
      <FluentTextInput @bind-Value=RoleDetails.Name Label="Name" Name="Name" data-qa="RoleName" style="width:100%" />
      <ValidationMessage For="@(() => RoleDetails.Name)" />
    </div>

    <div>
      <FluentTextInput @bind-Value=RoleDetails.Description Label="Description" Name="Description" data-qa="RoleDescription" style="width:100%" />
      <ValidationMessage For="@(() => RoleDetails.Description)" />
    </div>

    <FluentButton Type=ButtonType.Submit Appearance=ButtonAppearance.Primary data-qa="RoleSave">Save</FluentButton>

  </FluentStack>
</EditForm>
