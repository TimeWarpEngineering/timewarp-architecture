@namespace TimeWarp.Architecture.Features.Admin.Roles
@using TimeWarp.Architecture.Features
@inherits BaseComponent

@*
  Purpose: Grouped permission membership editor — prefix parent (tri-state) + atom checkboxes.

  Design: Task 206. Catalog is PermissionIds.GroupsByPrefix (derived from All, not a second
  SSOT). SelectedIds is the page's working copy, not a store field. Toggles add or remove
  ids in that set. Parent click selects or clears every unlocked child. Parent FluentCheckbox
  is ThreeState for mixed display (CheckStateFor) with ShowIndeterminate=false and
  ThreeStateOrderUncheckToIntermediate=true so clicks are mixed→checked, checked→unchecked,
  unchecked→checked (FluentUI v5). Protected-core (Administrator + selected admin.*) is
  disabled so the SPA cannot uncheck a grant the server would 409. Missing cores stay
  enabled so a damaged bundle can be repaired. CanManage=false disables the whole tree.
*@

@code {
  [Parameter, EditorRequired]
  public Guid RoleId { get; set; }

  [Parameter]
  public bool CanManage { get; set; }

  [Parameter, EditorRequired]
  public HashSet<string> SelectedIds { get; set; } = new(StringComparer.Ordinal);

  private bool IsPermissionDisabled(string permissionId) =>
    !CanManage
    || PermissionIds.IsProtectedCoreLocked(
      RoleId,
      permissionId,
      SelectedIds.Contains(permissionId));

  private bool IsGroupDisabled(PermissionIds.PermissionGroup group)
  {
    if (!CanManage)
    {
      return true;
    }

    foreach (string permissionId in group.PermissionIds)
    {
      if (!IsPermissionDisabled(permissionId))
      {
        return false;
      }
    }

    return true;
  }

  private void OnPermissionSelected(string permissionId, bool selected)
  {
    if (PermissionIds.IsProtectedCoreLocked(RoleId, permissionId, SelectedIds.Contains(permissionId))
      && !selected)
    {
      return;
    }

    if (selected)
    {
      SelectedIds.Add(permissionId);
    }
    else
    {
      SelectedIds.Remove(permissionId);
    }
  }

  private void OnGroupCheckStateChanged(PermissionIds.PermissionGroup group, bool? checkState)
  {
    bool selected = checkState == true;
    foreach (string permissionId in group.PermissionIds)
    {
      if (IsPermissionDisabled(permissionId))
      {
        continue;
      }

      OnPermissionSelected(permissionId, selected);
    }
  }
}

<div class="twe-permission-editor" data-qa="RolePermissionEditor">
  @foreach (PermissionIds.PermissionGroup group in PermissionIds.GroupsByPrefix)
  {
    <div class="twe-permission-group" @key="group.Prefix" data-qa="@($"PermissionGroup-{group.Prefix}")">
      <FluentCheckbox
        ThreeState="true"
        ShowIndeterminate="false"
        ThreeStateOrderUncheckToIntermediate="true"
        Label="@($"{group.Prefix}.*")"
        CheckState="@group.CheckStateFor(SelectedIds)"
        CheckStateChanged="@(value => OnGroupCheckStateChanged(group, value))"
        Disabled="@IsGroupDisabled(group)" />
      <div class="twe-permission-group__children">
        @foreach (string permissionId in group.PermissionIds)
        {
          <FluentCheckbox
            Label="@permissionId"
            Value="@SelectedIds.Contains(permissionId)"
            ValueChanged="@(value => OnPermissionSelected(permissionId, value))"
            Disabled="@IsPermissionDisabled(permissionId)"
            data-qa="@($"Permission-{permissionId}")" />
        }
      </div>
    </div>
  }
</div>
