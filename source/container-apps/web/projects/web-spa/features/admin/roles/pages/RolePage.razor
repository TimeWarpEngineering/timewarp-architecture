@namespace TimeWarp.Architecture.Features.Admin.Roles
@using TimeWarp.Architecture.Features.Admin.Roles
@inherits BaseComponent

@*
  Purpose: New Role page — create a custom role (name and description).

  Design: Create-only. One Card with RoleForm, which binds IRoleDetails and validates with
  RoleDetailsValidator. This page loads no existing role and hosts no edit form. Editing a
  role's name and description is RoleEditForm on RoleDetailPage (/Admin/Roles/{RoleId}).
  RoleForm opens RoleDetailPage when LastCreatedRoleId changes.
*@

@code {
  public static Icon? NavIcon => new Icons.Regular.Size20.PersonAdd();
  public static string Title => "New Role";
}

<TimeWarpPage Title="New Role">
  <div class="twe-stack">
    <p class="ds-subtitle">Create a custom role.</p>
    <Card>
      <RoleForm />
    </Card>
  </div>
</TimeWarpPage>
