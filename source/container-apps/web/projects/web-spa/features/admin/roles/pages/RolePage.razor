@namespace TimeWarp.Architecture.Features.Admin.Roles
@using TimeWarp.Architecture.Features.Admin.Roles
@inherits BaseComponent

@code {
  public static Icon? NavIcon => new Icons.Regular.Size20.PersonAdd();
  public static string Title => "New Role";
}

<PageTitle>@Title</PageTitle>

<TimeWarpPage Title="New Role">
  <div class="twe-stack">
    <p class="sg-subtitle">
      Create a custom role. The form binds to <code>IRoleDetails</code> and validates with the
      shared <code>RoleDetailsValidator</code>. On save you return to the roles list.
    </p>
    <Card Title="Role">
      <RoleForm />
    </Card>
  </div>
</TimeWarpPage>
