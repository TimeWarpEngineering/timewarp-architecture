@namespace TimeWarp.Architecture.Features.Admin.Principals
@using TimeWarp.Architecture.Features
@using TimeWarp.Identity
@inherits BaseComponent

@code {
  public static string Title => "Principal";
  public static Icon? NavIcon => new Icons.Regular.Size20.Person();

  private Guid RequestedId;
  private HashSet<Guid> RoleDraft { get; set; } = [];
  private HashSet<string> ScopeDraft { get; set; } = new(StringComparer.Ordinal);

  protected override async Task OnParametersSetAsync()
  {
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    if (PrincipalId == Guid.Empty || PrincipalId == RequestedId)
    {
      return;
    }

    RequestedId = PrincipalId;
    await PrincipalState.OpenPrincipal(PrincipalId);
    CopyDrafts();
  }

  private void CopyDrafts()
  {
    CopyRoleDraft();
    CopyScopeDraft();
  }

  private void CopyRoleDraft()
  {
    if (PrincipalState.Current is not { } current || current.PrincipalId.Value != PrincipalId)
    {
      return;
    }

    RoleDraft = [.. current.RoleIds];
  }

  private void CopyScopeDraft()
  {
    if (PrincipalState.Current is not { } current || current.PrincipalId.Value != PrincipalId)
    {
      return;
    }

    ScopeDraft = new HashSet<string>(current.AgentScopeGrants, StringComparer.Ordinal);
  }

  private void OnRoleSelected(Guid roleId, bool selected)
  {
    if (selected)
    {
      RoleDraft.Add(roleId);
    }
    else
    {
      RoleDraft.Remove(roleId);
    }
  }

  private async Task OnSave(Guid principalId)
  {
    await PrincipalState.SetPrincipalRoles(new SetPrincipalRoles.Command
    {
      PrincipalId = principalId,
      RoleIds = [.. RoleDraft]
    });
    if (!PrincipalState.LastSetPrincipalRolesSucceeded)
    {
      return;
    }

    await PrincipalState.OpenPrincipal(principalId);
    CopyRoleDraft();
  }

  private bool IsSavingAgentScopes =>
    IsAnyActive(typeof(PrincipalState.SetPrincipalAgentScopesActionSet.Action));

  private void OnAgentScopeSelected(string scope, bool selected)
  {
    if (selected)
    {
      ScopeDraft.Add(scope);
    }
    else
    {
      ScopeDraft.Remove(scope);
    }
  }

  private async Task OnSaveAgentScopes(Guid principalId)
  {
    await PrincipalState.SetPrincipalAgentScopes(new SetPrincipalAgentScopes.Command
    {
      PrincipalId = principalId,
      Scopes = [.. ScopeDraft]
    });
    if (!PrincipalState.LastSetPrincipalAgentScopesSucceeded)
    {
      return;
    }

    await PrincipalState.OpenPrincipal(principalId);
    CopyScopeDraft();
  }

  private static string OrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

  private static string SourceLabel(GetPrincipal.ApprovedAgentScopeSourceDto source) =>
    source.Kind switch
    {
      GetPrincipal.AgentScopeSourceKinds.Default => "default",
      GetPrincipal.AgentScopeSourceKinds.Principal => "principal",
      GetPrincipal.AgentScopeSourceKinds.Role => RoleIds.GetRoleNameByGuid(source.RoleId ?? Guid.Empty),
      _ => source.Kind
    };
}

<TimeWarpPage Title="Principal">
  <div class="twe-stack">
    <RouteLink Route="@PrincipalsPage.GetPageUrl()" data-qa="AdminPrincipalBack">Back to principals</RouteLink>
    <Section Title="Status" LoadingActionType="typeof(PrincipalState.OpenPrincipalActionSet.Action)">
      @if (PrincipalState.LoadError is not null)
      {
        <p data-qa="AdminPrincipalLoadError">@PrincipalState.LoadError</p>
      }
      else if (PrincipalState.Current is { } principal)
      {
        <DefinitionList data-qa="AdminPrincipalStatus">
          <DefinitionItem Term="Principal"><code>@principal.PrincipalId.Value</code></DefinitionItem>
          <DefinitionItem Term="Kind">@principal.Kind</DefinitionItem>
          <DefinitionItem Term="Trust">@principal.TrustTier</DefinitionItem>
          <DefinitionItem Term="Active">@(principal.IsActive ? "yes" : "no")</DefinitionItem>
          <DefinitionItem Term="Quarantined">@(principal.IsQuarantined ? "yes" : "no")</DefinitionItem>
          <DefinitionItem Term="Roles">@string.Join(", ", principal.RoleIds.Select(static roleId => RoleIds.GetRoleNameByGuid(roleId)))</DefinitionItem>
        </DefinitionList>
      }
    </Section>

    @if (PrincipalState.Current is { } current)
    {
      <AuthorizeView Policy="@PermissionIds.AdminProfilesRead">
        <Authorized>
          <Section Title="Profile" LoadingActionType="typeof(PrincipalState.OpenPrincipalActionSet.Action)">
            @if (current.Profile is { } profile)
            {
              <DefinitionList data-qa="AdminPrincipalProfile">
                <DefinitionItem Term="Display name"><span data-qa="AdminPrincipalDisplayName">@profile.DisplayName</span></DefinitionItem>
                <DefinitionItem Term="Email"><span data-qa="AdminPrincipalEmail">@OrDash(profile.Email)</span></DefinitionItem>
                <DefinitionItem Term="Language">@profile.Language</DefinitionItem>
                <DefinitionItem Term="Region">@profile.Region</DefinitionItem>
                <DefinitionItem Term="Theme">@profile.Theme</DefinitionItem>
                <DefinitionItem Term="Notifications">@(profile.Notifications ? "on" : "off")</DefinitionItem>
              </DefinitionList>
            }
            else
            {
              <p data-qa="AdminPrincipalNoProfile">No profile.</p>
            }
          </Section>
        </Authorized>
      </AuthorizeView>

      <AuthorizeView Policy="@PermissionIds.AdminPrincipalsManage">
        <Authorized>
          <Section Title="Roles" LoadingActionType="typeof(PrincipalState.SetPrincipalRolesActionSet.Action)">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
              @foreach (Guid roleId in RoleIds.All)
              {
                <FluentCheckbox
                  Label="@RoleIds.GetRoleNameByGuid(roleId)"
                  Value="@RoleDraft.Contains(roleId)"
                  ValueChanged="@(value => OnRoleSelected(roleId, value))" />
              }
            </FluentStack>
            <FluentButton
              Appearance="ButtonAppearance.Primary"
              data-qa="SavePrincipalRoles"
              OnClick="@(async () => await OnSave(current.PrincipalId.Value))">
              Save
            </FluentButton>
          </Section>
        </Authorized>
      </AuthorizeView>

      <Section Title="Approved agent scopes" LoadingActionType="typeof(PrincipalState.OpenPrincipalActionSet.Action)">
        <ul data-qa="ApprovedAgentScopes">
          @foreach (GetPrincipal.ApprovedAgentScopeDto item in current.ApprovedAgentScopes)
          {
            <li data-qa="@($"ApprovedAgentScope-{item.Scope}")">
              <code>@item.Scope</code>
              — @string.Join(", ", item.Sources.Select(SourceLabel))
            </li>
          }
        </ul>
      </Section>

      <AuthorizeView Policy="@PermissionIds.AdminPrincipalsManage">
        <Authorized>
          <Section Title="Principal agent scopes">
            <p class="ds-subtitle">
              Grants on this principal, on top of its roles. <code>identity:read</code> stays
              allowed even when it is not checked here. A change applies at the next token issuance.
            </p>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
              @foreach (string scope in AgentScopes.All)
              {
                <div data-qa="@($"PrincipalAgentScope-{scope}")">
                  <FluentCheckbox
                    Label="@scope"
                    Value="@ScopeDraft.Contains(scope)"
                    ValueChanged="@(value => OnAgentScopeSelected(scope, value))" />
                </div>
              }
            </FluentStack>
            <FluentButton
              Appearance="ButtonAppearance.Primary"
              data-qa="SavePrincipalAgentScopes"
              Disabled="IsSavingAgentScopes"
              OnClick="@(async () => await OnSaveAgentScopes(current.PrincipalId.Value))">
              Save agent scopes
            </FluentButton>
          </Section>
        </Authorized>
      </AuthorizeView>
    }
  </div>
</TimeWarpPage>
