@namespace TimeWarp.Architecture.Features.Admin.Principals
@using TimeWarp.Architecture.Features
@inherits BaseComponent

@code {
  public static string Title => "Principal";
  public static Icon? NavIcon => new Icons.Regular.Size20.Person();

  private Guid RequestedId;

  protected override async Task OnParametersSetAsync()
  {
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    if (PrincipalId == Guid.Empty || PrincipalId == RequestedId)
    {
      return;
    }

    RequestedId = PrincipalId;
    await PrincipalState.OpenPrincipal(PrincipalId);
  }

  private async Task OnRoleSelected(Guid principalId, Guid roleId, bool selected) =>
    await PrincipalState.SetRoleSelected(principalId, roleId, selected);

  private async Task OnSave(Guid principalId)
  {
    await PrincipalState.SetPrincipalRoles(principalId);
    if (!PrincipalState.LastSetPrincipalRolesSucceeded)
    {
      return;
    }

    await PrincipalState.OpenPrincipal(principalId);
  }

  private static string OrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}

<TimeWarpPage Title="Principal">
  <div class="twe-stack">
    <FluentLink Href="/Admin/Principals" data-qa="AdminPrincipalBack">Back to principals</FluentLink>
    <Section Title="Status" LoadingActionType="typeof(PrincipalState.OpenPrincipalActionSet.Action)">
      @if (PrincipalState.LoadError is not null)
      {
        <p data-qa="AdminPrincipalLoadError">@PrincipalState.LoadError</p>
      }
      else if (PrincipalState.Current is { } principal)
      {
        <dl class="admin-principal-facts" data-qa="AdminPrincipalStatus">
          <dt>Principal</dt><dd><code>@principal.PrincipalId.Value</code></dd>
          <dt>Kind</dt><dd>@principal.Kind</dd>
          <dt>Trust</dt><dd>@principal.TrustTier</dd>
          <dt>Active</dt><dd>@(principal.IsActive ? "yes" : "no")</dd>
          <dt>Quarantined</dt><dd>@(principal.IsQuarantined ? "yes" : "no")</dd>
          <dt>Roles</dt>
          <dd>@string.Join(", ", principal.RoleIds.Select(static roleId => RoleIds.GetRoleNameByGuid(roleId)))</dd>
        </dl>
      }
    </Section>

    @if (PrincipalState.Current is { } current)
    {
      <AuthorizeView Policy="@PermissionIds.AdminProfilesRead">
        <Authorized>
          <Section Title="Profile" LoadingActionType="typeof(PrincipalState.OpenPrincipalActionSet.Action)">
            @if (current.Profile is { } profile)
            {
              <dl class="admin-principal-facts" data-qa="AdminPrincipalProfile">
                <dt>Display name</dt><dd data-qa="AdminPrincipalDisplayName">@profile.DisplayName</dd>
                <dt>Email</dt><dd data-qa="AdminPrincipalEmail">@OrDash(profile.Email)</dd>
                <dt>Language</dt><dd>@profile.Language</dd>
                <dt>Region</dt><dd>@profile.Region</dd>
                <dt>Theme</dt><dd>@profile.Theme</dd>
                <dt>Notifications</dt><dd>@(profile.Notifications ? "on" : "off")</dd>
              </dl>
            }
            else
            {
              <p data-qa="AdminPrincipalNoProfile">No profile.</p>
            }
          </Section>
        </Authorized>
      </AuthorizeView>

      <AuthorizeView Policy="@PermissionIds.AdminPrincipalsManage">
        <Authorized>
          <Section Title="Roles" LoadingActionType="typeof(PrincipalState.SetPrincipalRolesActionSet.Action)">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
              @foreach (Guid roleId in RoleIds.All)
              {
                <FluentCheckbox
                  Label="@RoleIds.GetRoleNameByGuid(roleId)"
                  Value="@PrincipalState.IsRoleSelected(current.PrincipalId.Value, roleId)"
                  ValueChanged="@(async (bool value) => await OnRoleSelected(current.PrincipalId.Value, roleId, value))" />
              }
            </FluentStack>
            <FluentButton
              Appearance="ButtonAppearance.Primary"
              data-qa="SavePrincipalRoles"
              OnClick="@(async () => await OnSave(current.PrincipalId.Value))">
              Save
            </FluentButton>
          </Section>
        </Authorized>
      </AuthorizeView>
    }
  </div>
</TimeWarpPage>
