@namespace TimeWarp.Architecture.Features.Admin.Principals
@using TimeWarp.Architecture.Features
@inherits BaseComponent

@code {
  public static Icon? NavIcon => new Icons.Regular.Size20.PersonAccounts();
  public static string Title => "Principals";

  // The grid never sorts rows itself (RefreshItems is set); a column needs a SortBy to be sortable.
  private static readonly GridSort<ListPrincipals.PrincipalSummaryDto> DisplayNameSort =
    GridSort<ListPrincipals.PrincipalSummaryDto>.ByAscending(static row => row.DisplayName);
  private static readonly GridSort<ListPrincipals.PrincipalSummaryDto> EmailSort =
    GridSort<ListPrincipals.PrincipalSummaryDto>.ByAscending(static row => row.Email);
  private static readonly GridSort<ListPrincipals.PrincipalSummaryDto> KindSort =
    GridSort<ListPrincipals.PrincipalSummaryDto>.ByAscending(static row => row.Kind);

  private bool CanReadProfiles;

  protected override async Task OnInitializedAsync()
  {
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    CanReadProfiles = await CheckAuthorization(PermissionIds.AdminProfilesRead);
    await PrincipalState.FetchPrincipals();
  }

  private async Task OnSearchChanged(string? value)
  {
    await PrincipalState.SetSearch(value ?? "");
    await PrincipalState.FetchPrincipals();
  }

  private bool IsListLoading => IsAnyActive(typeof(PrincipalState.FetchPrincipalsActionSet.Action));

  // Principal, Display name, Email, Kind, Trust, Active. Principal keeps 14rem and takes the
  // largest share (task 354).
  private const string GridColumns =
    "minmax(14rem, 2fr) minmax(8rem, 1fr) minmax(10rem, 1.2fr) minmax(6rem, 0.5fr) minmax(6rem, 0.5fr) minmax(5rem, 0.4fr)";

  private IQueryable<ListPrincipals.PrincipalSummaryDto>? GridItems => PrincipalState.Principals?.AsQueryable();

  private bool IsSortColumn(PrincipalListSortColumn column) => PrincipalState.SortBy == column;

  private DataGridSortDirection SortDirection =>
    PrincipalState.SortDescending ? DataGridSortDirection.Descending : DataGridSortDirection.Ascending;

  private static string OrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

  private async Task OnGridRefreshAsync(GridItemsProviderRequest<ListPrincipals.PrincipalSummaryDto> request)
  {
    (PrincipalListSortColumn sortBy, bool sortDescending) =
      request.SortColumns is [DataGridSortColumn<ListPrincipals.PrincipalSummaryDto> primary, ..]
        && Enum.TryParse(primary.Column.ColumnId, out PrincipalListSortColumn column)
        ? (column, !primary.Ascending)
        : (PrincipalListSortColumn.CreatedAt, false);
    if (sortBy == PrincipalState.SortBy && sortDescending == PrincipalState.SortDescending)
    {
      return;
    }

    await PrincipalState.SetSort(sortBy, sortDescending);
    await PrincipalState.FetchPrincipals();
  }
}

<TimeWarpPage Title="Principals">
  <div class="twe-stack">
    <p class="ds-subtitle">
      Inspect principals and open one to see its profile and assign product roles. Empty assignment
      resolves to Member. Bootstrap config
      (<code>Authentication:BootstrapAdministratorPrincipalIds</code>) can grant Administrator without
      a store write (host restart after change). Removing the last principal who can manage principals
      is rejected (409 last-admin) so Admin cannot lock itself out.
    </p>
    <AuthorizeView Policy="@PermissionIds.AdminProfilesRead">
      <Authorized>
        <FormField Label="Search by name or email">
          <FluentTextInput Value="@PrincipalState.Search"
            ValueChanged="@OnSearchChanged"
            AriaLabel="Search by name or email"
            Placeholder="Name or email"
            Width="100%"
            data-qa="AdminPrincipalsSearch" />
        </FormField>
      </Authorized>
    </AuthorizeView>
    <Section Title="Principals">
      @if (PrincipalState.ListLoadError is not null)
      {
        <p data-qa="AdminPrincipalsLoadError">@PrincipalState.ListLoadError</p>
      }
      else
      {
        <DataGridFrame>
          <FluentDataGrid TGridItem="ListPrincipals.PrincipalSummaryDto"
            Items="@GridItems"
            RefreshItems="@OnGridRefreshAsync"
            Loading="@IsListLoading"
            ItemKey="@(static row => row.PrincipalId.Value)"
            DisplayMode="DataGridDisplayMode.Grid"
            GridTemplateColumns="@GridColumns"
            data-qa="PrincipalsTable">
            <ChildContent>
              <TemplateColumn Title="Principal" Tooltip="true" TooltipText="@(static row => row.PrincipalId.Value.ToString())">
                <FluentLink Href="@($"/Admin/Principals/{context.PrincipalId.Value:D}")" data-qa="AdminPrincipalRow">
                  <code>@context.PrincipalId.Value</code>
                </FluentLink>
              </TemplateColumn>
              <TemplateColumn Title="Display name" ColumnId="@nameof(PrincipalListSortColumn.DisplayName)"
                Sortable="@CanReadProfiles" SortBy="@DisplayNameSort"
                IsDefaultSortColumn="@IsSortColumn(PrincipalListSortColumn.DisplayName)" InitialSortDirection="@SortDirection">
                @OrDash(context.DisplayName)
              </TemplateColumn>
              <TemplateColumn Title="Email" ColumnId="@nameof(PrincipalListSortColumn.Email)"
                Sortable="@CanReadProfiles" SortBy="@EmailSort"
                IsDefaultSortColumn="@IsSortColumn(PrincipalListSortColumn.Email)" InitialSortDirection="@SortDirection">
                @OrDash(context.Email)
              </TemplateColumn>
              <TemplateColumn Title="Kind" ColumnId="@nameof(PrincipalListSortColumn.Kind)"
                Sortable="true" SortBy="@KindSort"
                IsDefaultSortColumn="@IsSortColumn(PrincipalListSortColumn.Kind)" InitialSortDirection="@SortDirection">
                @context.Kind
              </TemplateColumn>
              <TemplateColumn Title="Trust">
                @context.TrustTier
              </TemplateColumn>
              <TemplateColumn Title="Active">
                @(context.IsActive ? "yes" : "no")
              </TemplateColumn>
            </ChildContent>
            <EmptyContent>
              <p data-qa="AdminPrincipalsEmpty">No principals match. Complete a passkey registration to create one.</p>
            </EmptyContent>
          </FluentDataGrid>
        </DataGridFrame>
      }
    </Section>
  </div>
</TimeWarpPage>
