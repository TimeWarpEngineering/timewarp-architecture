@namespace TimeWarp.Architecture.Features.Admin.Principals
@using TimeWarp.Architecture.Features
@inherits BaseComponent

@code {
  public static Icon? NavIcon => new Icons.Regular.Size20.PersonAccounts();
  public static string Title => "Principals";

  private async Task OnRoleSelected(Guid principalId, Guid roleId, bool selected) =>
    await PrincipalState.SetRoleSelected(principalId, roleId, selected);

  private async Task OnSave(Guid principalId) =>
    await PrincipalState.SetPrincipalRoles(principalId);
}

<PageTitle>@Title</PageTitle>

<TimeWarpPage Title="Principals">
  <div class="twe-stack">
    <p class="sg-subtitle">
      Assign product roles to principals. Empty assignment resolves to Member. Bootstrap config
      (<code>Authentication:BootstrapAdministratorPrincipalIds</code>) can grant Administrator without
      a store write (host restart after change). Removing the last principal who can manage principals
      is rejected (409 last-admin) so Admin cannot lock itself out.
    </p>
    <Card Title="Principals">
      @if (IsLoading)
      {
        <p><em>Loading…</em></p>
      }
      else if (PrincipalState.Principals is null || PrincipalState.Principals.Count == 0)
      {
        <p>No principals registered yet. Complete a passkey registration to create one.</p>
      }
      else
      {
        <table class="twe-table" data-qa="PrincipalsTable">
          <thead>
            <tr>
              <TableHeader>Principal</TableHeader>
              <TableHeader>Kind</TableHeader>
              <TableHeader>Trust</TableHeader>
              <TableHeader>Active</TableHeader>
              <TableHeader>Roles</TableHeader>
              <TableHeader></TableHeader>
            </tr>
          </thead>
          <tbody>
            @foreach (ListPrincipals.PrincipalSummaryDto row in PrincipalState.Principals)
            {
              Guid principalGuid = row.PrincipalId.Value;
              <tr @key="principalGuid">
                <Cell><code>@principalGuid</code></Cell>
                <Cell>@row.Kind</Cell>
                <Cell>@row.TrustTier</Cell>
                <Cell>@(row.IsActive ? "yes" : "no")</Cell>
                <Cell>
                  <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
                    @foreach (Guid roleId in RoleIds.All)
                    {
                      <FluentCheckbox
                        Label="@RoleIds.GetRoleNameByGuid(roleId)"
                        Value="@PrincipalState.IsRoleSelected(principalGuid, roleId)"
                        ValueChanged="@(async (bool value) => await OnRoleSelected(principalGuid, roleId, value))" />
                    }
                  </FluentStack>
                </Cell>
                <Cell>
                  <FluentButton
                    Appearance="ButtonAppearance.Primary"
                    data-qa="SavePrincipalRoles"
                    OnClick="@(async () => await OnSave(principalGuid))">
                    Save
                  </FluentButton>
                </Cell>
              </tr>
            }
          </tbody>
        </table>
      }
    </Card>
  </div>
</TimeWarpPage>
