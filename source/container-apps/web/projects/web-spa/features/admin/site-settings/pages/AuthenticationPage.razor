@namespace TimeWarp.Architecture.Features.Admin.SiteSettings
@inherits BaseComponent
@using TimeWarp.Architecture.Features.Settings
@using TimeWarp.Identity

@*
  Purpose: Admin authentication policy editor — Entra offer/bootstrap, passkey prompt, concurrency version.

  Design: web-api-contracts — EditForm binds ISiteSettingsDetails; UpdateSiteSettings.Command
  is the model (no view model). Version is the concurrency token, not a typed field.
  Blazilla FluentValidator takes SiteSettingsDetailsValidator. Submit is
  SiteSettingsState.UpdateSiteSettings(Command). Tenant line and Enabled/AllowBootstrap
  drift banner stay outside the form (read-only / host config, not bindable policy).
  Save is FluentButton submit Primary (RoleForm pattern), disabled while busy.
*@

@code {
  public static string Title => "Authentication";
  public static Icon? NavIcon => new Icons.Regular.Size20.ShieldLock();

  private static readonly SiteSettingsDetailsValidator SiteSettingsValidator = new();

  private UpdateSiteSettings.Command Command { get; } = new();
  private ISiteSettingsDetails Details => Command;

  private bool DraftLoaded;

  private bool IsBusy => ActionTrackingState.IsActive;

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    if (RendererInfo.IsInteractive)
    {
      await NoSubSiteSettingsState.FetchSiteSettings();
      SyncDraftFromState();
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    await base.OnAfterRenderAsync(firstRender);
    if (firstRender && RendererInfo.IsInteractive && !SiteSettingsState.HasSnapshot)
    {
      await NoSubSiteSettingsState.FetchSiteSettings();
      SyncDraftFromState();
      await InvokeAsync(StateHasChanged);
    }
  }

  private void SyncDraftFromState()
  {
    if (!SiteSettingsState.HasSnapshot)
    {
      return;
    }

    Command.EntraSignInEnabled = SiteSettingsState.EntraSignInEnabled is true;
    Command.EntraAllowBootstrap = SiteSettingsState.EntraAllowBootstrap is true;
    Command.PasskeyPromptMode = SiteSettingsState.PasskeyPromptMode;
    Command.Version = SiteSettingsState.Version;
    DraftLoaded = true;
  }

  private async Task HandleValidSubmit()
  {
    await NoSubSiteSettingsState.UpdateSiteSettings(Command);
    if (string.IsNullOrEmpty(SiteSettingsState.SaveError))
    {
      SyncDraftFromState();
    }
  }
}

<TimeWarpPage Title="Authentication">
  <div class="twe-stack twe-settings">
    <section class="twe-settings__section" data-qa="AuthenticationSettings">
      <h2 class="twe-settings__heading">Microsoft 365 sign-in policy</h2>
      <p class="twe-settings__muted">
        Configuration still registers the Microsoft 365 scheme. These settings decide whether users may use it.
      </p>
      <p class="twe-settings__value" data-qa="ConfigurationTenant">
        App registration tenant: @SiteSettingsState.ConfigurationTenantLabel
      </p>

      @if (SiteSettingsState.HasSnapshot
        && (SiteSettingsState.ConfigurationEnabledDiffers || SiteSettingsState.ConfigurationAllowBootstrapDiffers))
      {
        <FluentMessageBar Intent="MessageBarIntent.Warning" Title="Configuration drift" AllowDismiss="false">
          <span data-qa="ConfigurationPolicyDrift">
            Saved policy differs from Authentication:Entra Enabled or AllowBootstrap. Edit here or run `dev entra reseed`.
          </span>
        </FluentMessageBar>
      }

      @if (DraftLoaded)
      {
        <EditForm Model=@Details OnValidSubmit=HandleValidSubmit FormName="AuthenticationForm" novalidate>
          <FluentValidator Validator="@SiteSettingsValidator" />
          <FluentStack Orientation=Orientation.Vertical VerticalGap="16">

            <FluentCheckbox @bind-Value=Details.EntraSignInEnabled
                            Label="Offer Microsoft 365 sign-in"
                            Disabled=@IsBusy />

            <FluentCheckbox @bind-Value=Details.EntraAllowBootstrap
                            Label="Allow first-time Microsoft 365 bootstrap"
                            Disabled=@IsBusy />

            <div>
              <div class="twe-settings__field-title">Passkey prompt</div>
              <select class="twe-settings__select"
                      disabled="@IsBusy"
                      @bind="Details.PasskeyPromptMode">
                <option value="@PasskeyPromptMode.Soft">Soft (dismissible banner)</option>
                <option value="@PasskeyPromptMode.Required">Required (block app until a passkey is added)</option>
              </select>
              <ValidationMessage For="@(() => Details.PasskeyPromptMode)" />
            </div>

            @if (!string.IsNullOrEmpty(SiteSettingsState.SaveError))
            {
              <FluentMessageBar Intent="MessageBarIntent.Error" Title="Could not save" AllowDismiss="false">
                @SiteSettingsState.SaveError
              </FluentMessageBar>
            }

            <FluentButton Type=ButtonType.Submit
                          Appearance=ButtonAppearance.Primary
                          Disabled=@IsBusy
                          data-qa="AuthenticationSave">
              Save authentication settings
            </FluentButton>

          </FluentStack>
        </EditForm>
      }
    </section>
  </div>
</TimeWarpPage>

<style>
  @(@"
    .twe-settings__heading {
      margin: 0 0 12px;
      font-size: var(--twe-text-section-title);
      font-weight: 700;
      color: var(--twe-ink);
    }
    .twe-settings__muted {
      margin: 0 0 12px;
      color: var(--twe-muted);
      font-size: var(--twe-text-body);
    }
    .twe-settings__value {
      margin: 4px 0 12px;
      color: var(--twe-ink);
      font-size: var(--twe-text-body);
    }
    .twe-settings__field-title {
      font-weight: 600;
      color: var(--twe-ink);
      font-size: var(--twe-text-body);
    }
    .twe-settings__select {
      width: 100%;
      margin-top: 8px;
      padding: 8px 10px;
      border: 1px solid var(--twe-rule);
      border-radius: var(--twe-radius-sm);
      background: var(--twe-paper-2);
      color: var(--twe-ink);
      font: inherit;
    }
  ")
</style>
