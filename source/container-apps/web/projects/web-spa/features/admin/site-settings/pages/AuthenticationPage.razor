@namespace TimeWarp.Architecture.Features.Admin.SiteSettings
@inherits BaseComponent
@using TimeWarp.Architecture.Features.Settings
@using TimeWarp.Identity

@*
  Purpose: Admin authentication policy editor — Entra offer/bootstrap, accepted tenants, passkey prompt, concurrency version.

  Design: web-api-contracts — EditForm binds ISiteSettingsDetails; UpdateSiteSettings.Command
  is the model (no view model). Version is the concurrency token, not a typed field.
  Accepted tenant ids are a page-local textarea parsed into Command.EntraAcceptedTenantIds
  on submit (one id per line). Any-tenant mode keeps the list and disables the box.
  Blazilla FluentValidator takes SiteSettingsDetailsValidator. Submit is
  SiteSettingsState.UpdateSiteSettings(Command). Tenant line and Microsoft365 / AllowBootstrap
  drift banner stay outside the form (read-only / host config, not bindable policy).
  Save is FluentButton submit Primary (RoleForm pattern), disabled while busy. Save outcomes
  (409 concurrency included) are painted by the shell's MessageBars region — no page-local
  error bar; SaveFailed only decides whether to reload the draft. The drift banner is static
  Warning guidance and stays inline (task 247).
  Layout is FormSection / FormGrid / FormField / FormActions. Passkey prompt is
  FluentSelect (no native select, no page-local CSS). Tenant line and drift banner
  stay outside the EditForm. FormActions sits after FormSection (hairline above
  Save), matching Profile / RoleForm. No Cancel — draft reload is SyncDraftFromState
  after a successful save; there is no cheap unused reset on the command.
  Task 361: an Assistant section edits AssistantName on the same command (same Version, same
  settings.write policy). The page only dispatches UpdateSiteSettings: after a successful save
  AgentSurfaceState's AssistantIdentityRefreshHandler reloads the public assistant identity, so the
  button, Ctrl-K row and panel show the new name and avatar without a reload, whether this page or
  the agent saved.
*@

@code {
  public static string Title => "Authentication";
  public static Icon? NavIcon => new Icons.Regular.Size20.ShieldLock();

  private static readonly SiteSettingsDetailsValidator SiteSettingsValidator = new();

  private UpdateSiteSettings.Command Command { get; } = new();
  private ISiteSettingsDetails Details => Command;

  private bool DraftLoaded;
  private string AcceptedTenantsDraft { get; set; } = "";
  private string? AcceptedTenantsError { get; set; }

  private bool IsBusy => ActionTrackingState.IsActive;

  private static readonly PasskeyPromptMode[] PasskeyPromptModes =
  [
    PasskeyPromptMode.Soft,
    PasskeyPromptMode.Required
  ];

  private static readonly EntraTenantAcceptanceMode[] TenantAcceptanceModes =
  [
    EntraTenantAcceptanceMode.Restricted,
    EntraTenantAcceptanceMode.Any
  ];

  private static string PasskeyPromptLabel(PasskeyPromptMode mode) =>
    mode == PasskeyPromptMode.Soft
      ? "Soft (dismissible banner)"
      : "Required (block app until a passkey is added)";

  private static string TenantAcceptanceLabel(EntraTenantAcceptanceMode mode) =>
    mode == EntraTenantAcceptanceMode.Any
      ? "Any Entra tenant"
      : "Only these tenant ids";

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    if (RendererInfo.IsInteractive)
    {
      await NoSubSiteSettingsState.FetchSiteSettings();
      SyncDraftFromState();
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    await base.OnAfterRenderAsync(firstRender);
    if (firstRender && RendererInfo.IsInteractive && !SiteSettingsState.HasSnapshot)
    {
      await NoSubSiteSettingsState.FetchSiteSettings();
      SyncDraftFromState();
      await InvokeAsync(StateHasChanged);
    }
  }

  private void SyncDraftFromState()
  {
    if (!SiteSettingsState.HasSnapshot)
    {
      return;
    }

    Command.EntraSignInEnabled = SiteSettingsState.EntraSignInEnabled is true;
    Command.EntraAllowBootstrap = SiteSettingsState.EntraAllowBootstrap is true;
    Command.PasskeyPromptMode = SiteSettingsState.PasskeyPromptMode;
    Command.AssistantName = SiteSettingsState.AssistantName;
    Command.EntraTenantAcceptanceMode = SiteSettingsState.EntraTenantAcceptanceMode;
    Command.EntraAcceptedTenantIds = [.. SiteSettingsState.EntraAcceptedTenantIds];
    AcceptedTenantsDraft = string.Join('\n', Command.EntraAcceptedTenantIds.Select(id => id.ToString("D")));
    AcceptedTenantsError = null;
    Command.Version = SiteSettingsState.Version;
    DraftLoaded = true;
  }

  private async Task HandleValidSubmit()
  {
    if (Command.EntraTenantAcceptanceMode == EntraTenantAcceptanceMode.Restricted)
    {
      if (!EntraTenantIds.TryParse(AcceptedTenantsDraft, out IReadOnlyList<Guid> tenantIds, out string? error))
      {
        AcceptedTenantsError = error;
        return;
      }

      Command.EntraAcceptedTenantIds = [.. tenantIds];
    }

    AcceptedTenantsError = null;
    await NoSubSiteSettingsState.UpdateSiteSettings(Command);
    if (!SiteSettingsState.SaveFailed)
    {
      SyncDraftFromState();
    }
  }
}

<TimeWarpPage Title="Authentication">
  <p data-qa="ConfigurationTenant">
    App registration tenant: @SiteSettingsState.ConfigurationTenantLabel
  </p>

  @if (SiteSettingsState.HasSnapshot
    && (SiteSettingsState.ConfigurationEnabledDiffers || SiteSettingsState.ConfigurationAllowBootstrapDiffers))
  {
    <FluentMessageBar Intent="MessageBarIntent.Warning" Title="Configuration drift" AllowDismiss="false">
      <span data-qa="ConfigurationPolicyDrift">
        Saved policy differs from SignInOptions:Methods (Microsoft365) or Authentication:Entra:AllowBootstrap. Edit here or run `dev entra reseed`.
      </span>
    </FluentMessageBar>
  }

  @if (DraftLoaded)
  {
    <EditForm Model=@Details OnValidSubmit=HandleValidSubmit FormName="AuthenticationForm" novalidate>
      <FluentValidator Validator="@SiteSettingsValidator" />
      <FormSection Title="Microsoft 365 sign-in policy"
                   Description="Configuration still registers the Microsoft 365 scheme. These settings decide whether users may use it."
                   data-qa="AuthenticationSettings">
        <FormGrid>
          <FormField Label="Offer Microsoft 365 sign-in">
            <FluentCheckbox @bind-Value=Details.EntraSignInEnabled
                            AriaLabel="Offer Microsoft 365 sign-in"
                            Disabled=@IsBusy />
          </FormField>
          <FormField Label="Allow first-time Microsoft 365 bootstrap">
            <FluentCheckbox @bind-Value=Details.EntraAllowBootstrap
                            AriaLabel="Allow first-time Microsoft 365 bootstrap"
                            Disabled=@IsBusy />
          </FormField>
          <FormField Label="Accepted tenants">
            <FluentSelect TOption="EntraTenantAcceptanceMode" TValue="EntraTenantAcceptanceMode"
                          Items="@TenantAcceptanceModes"
                          OptionText="@TenantAcceptanceLabel"
                          @bind-Value="Details.EntraTenantAcceptanceMode"
                          AriaLabel="Accepted tenants"
                          Width="100%"
                          Disabled=@IsBusy
                          data-qa="TenantAcceptanceMode" />
            <ValidationMessage For="@(() => Details.EntraTenantAcceptanceMode)" />
          </FormField>
          <FormField Label="Tenant ids">
            <TextArea @bind-Value="AcceptedTenantsDraft"
                      AriaLabel="Accepted tenant ids"
                      Placeholder="One tenant id per line"
                      Disabled="@(IsBusy || Details.EntraTenantAcceptanceMode == EntraTenantAcceptanceMode.Any)"
                      MinHeight="6rem"
                      data-qa="AcceptedTenantIds" />
            @if (AcceptedTenantsError is not null)
            {
              <span data-qa="AcceptedTenantsError">@AcceptedTenantsError</span>
            }
            <p data-qa="TenantAcceptanceHelp">
              Restricted mode refuses any tenant that is not listed. Any Entra tenant accepts every non-empty tenant id that completes sign-in.
              Personal Microsoft accounts are included only when the app registration allows them and Authentication:Entra:TenantId is common (or consumers).
            </p>
          </FormField>
          <FormField Label="Passkey prompt">
            <FluentSelect TOption="PasskeyPromptMode" TValue="PasskeyPromptMode"
                          Items="@PasskeyPromptModes"
                          OptionText="@PasskeyPromptLabel"
                          @bind-Value="Details.PasskeyPromptMode"
                          AriaLabel="Passkey prompt"
                          Width="100%"
                          Disabled=@IsBusy />
            <ValidationMessage For="@(() => Details.PasskeyPromptMode)" />
          </FormField>
        </FormGrid>
      </FormSection>
      <FormSection Title="Assistant"
                   Description="The name the in-app assistant goes by on the top-bar button, Ctrl-K, the panel and its greeting. Its avatar is generated from the name."
                   data-qa="AssistantSettings">
        <FormGrid>
          <FormField Label="Assistant name">
            <FluentTextInput @bind-Value=Details.AssistantName
                             Name="AssistantName"
                             AriaLabel="Assistant name"
                             Width="100%"
                             Disabled=@IsBusy
                             data-qa="AssistantName" />
            <ValidationMessage For="@(() => Details.AssistantName)" />
          </FormField>
        </FormGrid>
      </FormSection>
      <FormActions>
        <FluentButton Type=ButtonType.Submit
                      Appearance=ButtonAppearance.Primary
                      Disabled=@IsBusy
                      data-qa="AuthenticationSave">
          Save authentication settings
        </FluentButton>
      </FormActions>
    </EditForm>
  }
  else
  {
    <FormSection Title="Microsoft 365 sign-in policy"
                 Description="Configuration still registers the Microsoft 365 scheme. These settings decide whether users may use it."
                 data-qa="AuthenticationSettings" />
  }
</TimeWarpPage>
