@namespace TimeWarp.Architecture.Features.Admin.Feedback
@inherits BaseComponent

@code {
  public static Icon? NavIcon => new Icons.Regular.Size20.CommentMultiple();
  public static string Title => "Feedback review";

  private static readonly string[] StatusChoices =
    ["", .. Enum.GetValues<FeedbackStatus>().Select(static status => status.ToString())];
  private static readonly string[] KindChoices =
    ["", .. Enum.GetValues<FeedbackKind>().Select(static kind => kind.ToString())];
  private static readonly string[] SeverityChoices =
    ["", .. Enum.GetValues<FeedbackSeverity>().Select(static severity => severity.ToString())];

  private string StatusValue => FeedbackAdminState.Status?.ToString() ?? "";
  private string KindValue => FeedbackAdminState.Kind?.ToString() ?? "";
  private string SeverityValue => FeedbackAdminState.Severity?.ToString() ?? "";

  private static string StatusLabel(string value) => value.Length == 0 ? "Open (default)" : value;
  private static string KindLabel(string value) => value.Length == 0 ? "All kinds" : value;
  private static string SeverityLabel(string value) => value.Length == 0 ? "All severities" : value;

  // Task 346: a grid row is pickable by Ask's Tag and resolves to its @feedback:<id>.
  private static IReadOnlyDictionary<string, object> RowMark(ListFeedback.Item item) =>
    AskTagMark.Resource(AskTagMark.FeedbackRowKind, ListFeedback.ReferencePrefix, item.FeedbackItemId.ToString("D"), item.Title);

  protected override async Task OnInitializedAsync()
  {
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    await FeedbackAdminState.FetchFeedbackList();
  }

  private async Task ApplyFilterAsync(
    FeedbackStatus? status,
    FeedbackKind? kind,
    bool includeClosed,
    FeedbackSeverity? severity,
    string? search)
  {
    await FeedbackAdminState.SetFilter(status, kind, includeClosed, severity, search ?? "");
    await FeedbackAdminState.FetchFeedbackList();
  }

  private Task OnStatusChanged(string value) =>
    ApplyFilterAsync(
      Enum.TryParse(value, out FeedbackStatus status) ? status : null,
      FeedbackAdminState.Kind,
      FeedbackAdminState.IncludeClosed,
      FeedbackAdminState.Severity,
      FeedbackAdminState.Search);

  private Task OnKindChanged(string value) =>
    ApplyFilterAsync(
      FeedbackAdminState.Status,
      Enum.TryParse(value, out FeedbackKind kind) ? kind : null,
      FeedbackAdminState.IncludeClosed,
      FeedbackAdminState.Severity,
      FeedbackAdminState.Search);

  private Task OnSeverityChanged(string value) =>
    ApplyFilterAsync(
      FeedbackAdminState.Status,
      FeedbackAdminState.Kind,
      FeedbackAdminState.IncludeClosed,
      Enum.TryParse(value, out FeedbackSeverity severity) ? severity : null,
      FeedbackAdminState.Search);

  private Task OnIncludeClosedChanged(bool value) =>
    ApplyFilterAsync(
      FeedbackAdminState.Status,
      FeedbackAdminState.Kind,
      value,
      FeedbackAdminState.Severity,
      FeedbackAdminState.Search);

  private Task OnSearchChanged(string value) =>
    ApplyFilterAsync(
      FeedbackAdminState.Status,
      FeedbackAdminState.Kind,
      FeedbackAdminState.IncludeClosed,
      FeedbackAdminState.Severity,
      value);

  private async Task GoToPageAsync(int page)
  {
    await FeedbackAdminState.SetPage(page);
    await FeedbackAdminState.FetchFeedbackList();
  }

  // The grid never sorts rows itself (RefreshItems is set); a column needs a SortBy to be sortable.
  private static readonly GridSort<ListFeedback.Item> TitleSort =
    GridSort<ListFeedback.Item>.ByAscending(static row => row.Title);
  private static readonly GridSort<ListFeedback.Item> KindSort =
    GridSort<ListFeedback.Item>.ByAscending(static row => row.Kind);
  private static readonly GridSort<ListFeedback.Item> StatusSort =
    GridSort<ListFeedback.Item>.ByAscending(static row => row.Status);
  private static readonly GridSort<ListFeedback.Item> FiledSort =
    GridSort<ListFeedback.Item>.ByAscending(static row => row.FiledAt);

  private bool IsListLoading => IsAnyActive(typeof(FeedbackAdminState.FetchFeedbackListActionSet.Action));

  // Title, Kind, Status, Severity, Filed, Owner. Title keeps 14rem and takes the largest share (task 354).
  private const string GridColumns =
    "minmax(14rem, 2fr) minmax(7rem, 0.6fr) minmax(7rem, 0.6fr) minmax(7rem, 0.5fr) minmax(11rem, 1fr) minmax(8rem, 1fr)";

  private IQueryable<ListFeedback.Item>? GridItems => FeedbackAdminState.Items?.AsQueryable();

  private bool IsSortColumn(FeedbackListSortColumn column) => FeedbackAdminState.SortBy == column;

  private DataGridSortDirection SortDirection =>
    FeedbackAdminState.SortDescending ? DataGridSortDirection.Descending : DataGridSortDirection.Ascending;

  private async Task OnGridRefreshAsync(GridItemsProviderRequest<ListFeedback.Item> request)
  {
    (FeedbackListSortColumn sortBy, bool sortDescending) =
      request.SortColumns is [DataGridSortColumn<ListFeedback.Item> primary, ..]
        && Enum.TryParse(primary.Column.ColumnId, out FeedbackListSortColumn column)
        ? (column, !primary.Ascending)
        : (FeedbackListSortColumn.FiledAt, true);
    if (sortBy == FeedbackAdminState.SortBy && sortDescending == FeedbackAdminState.SortDescending)
    {
      return;
    }

    await FeedbackAdminState.SetSort(sortBy, sortDescending);
    await FeedbackAdminState.FetchFeedbackList();
  }
}

<TimeWarpPage Title="Feedback review">
  <Description>Review filings. Filter by title, status, kind, and severity.</Description>
  <ChildContent>
    <div class="twe-stack">
      <Section Title="Filter" LoadingActionType="typeof(FeedbackAdminState.FetchFeedbackListActionSet.Action)">
        <FilterBar SearchText="@FeedbackAdminState.Search"
                   SearchTextChanged="@OnSearchChanged"
                   SearchPlaceholder="Search titles…">
          <FilterSelect Label="Status"
                        Items="StatusChoices"
                        OptionText="@(static value => StatusLabel(value))"
                        Value="@StatusValue"
                        ValueChanged="@OnStatusChanged"
                        data-qa="AdminFeedbackStatus" />
          <FilterSelect Label="Kind"
                        Items="KindChoices"
                        OptionText="@(static value => KindLabel(value))"
                        Value="@KindValue"
                        ValueChanged="@OnKindChanged"
                        data-qa="AdminFeedbackKind" />
          <FilterSelect Label="Severity"
                        Items="SeverityChoices"
                        OptionText="@(static value => SeverityLabel(value))"
                        Value="@SeverityValue"
                        ValueChanged="@OnSeverityChanged"
                        data-qa="AdminFeedbackSeverity" />
          <FluentCheckbox Value="@FeedbackAdminState.IncludeClosed"
                          ValueChanged="@OnIncludeClosedChanged"
                          Label="Show closed"
                          LabelPosition="LabelPosition.After"
                          AriaLabel="Show closed"
                          data-qa="AdminFeedbackIncludeClosed" />
        </FilterBar>
      </Section>
      <Section Title="Feedback">
        @if (FeedbackAdminState.ListLoadError is not null)
        {
          <p data-qa="AdminFeedbackLoadError">@FeedbackAdminState.ListLoadError</p>
        }
        else
        {
          <DataGridFrame>
            <FluentDataGrid TGridItem="ListFeedback.Item"
              Items="@GridItems"
              RefreshItems="@OnGridRefreshAsync"
              Loading="@IsListLoading"
              ItemKey="@(static row => row.FeedbackItemId)"
              DisplayMode="DataGridDisplayMode.Grid"
              GridTemplateColumns="@GridColumns"
              data-qa="AdminFeedbackTable">
              <ChildContent>
                <TemplateColumn Title="Title" ColumnId="@nameof(FeedbackListSortColumn.Title)"
                  Sortable="true" SortBy="@TitleSort"
                  IsDefaultSortColumn="@IsSortColumn(FeedbackListSortColumn.Title)" InitialSortDirection="@SortDirection">
                  <FluentLink Href="@($"/Admin/Feedback/{context.FeedbackItemId:D}")" data-qa="AdminFeedbackRow" @attributes="RowMark(context)">@context.Title</FluentLink>
                </TemplateColumn>
                <TemplateColumn Title="Kind" ColumnId="@nameof(FeedbackListSortColumn.Kind)"
                  Sortable="true" SortBy="@KindSort"
                  IsDefaultSortColumn="@IsSortColumn(FeedbackListSortColumn.Kind)" InitialSortDirection="@SortDirection">
                  @context.Kind
                </TemplateColumn>
                <TemplateColumn Title="Status" ColumnId="@nameof(FeedbackListSortColumn.Status)"
                  Sortable="true" SortBy="@StatusSort"
                  IsDefaultSortColumn="@IsSortColumn(FeedbackListSortColumn.Status)" InitialSortDirection="@SortDirection">
                  @context.Status
                </TemplateColumn>
                <TemplateColumn Title="Severity">
                  <span data-qa="AdminFeedbackRowSeverity">@context.Severity</span>
                </TemplateColumn>
                <TemplateColumn Title="Filed" ColumnId="@nameof(FeedbackListSortColumn.FiledAt)"
                  Sortable="true" SortBy="@FiledSort"
                  IsDefaultSortColumn="@IsSortColumn(FeedbackListSortColumn.FiledAt)" InitialSortDirection="@SortDirection">
                  @context.FiledAt.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", CultureInfo.InvariantCulture)
                </TemplateColumn>
                <TemplateColumn Title="Owner" Tooltip="true" TooltipText="@(static row => row.OwnerPrincipalId.ToString())">
                  <FeedbackOwnerLink OwnerPrincipalId="@context.OwnerPrincipalId" OwnerDisplayName="@context.OwnerDisplayName" />
                </TemplateColumn>
              </ChildContent>
              <EmptyContent>
                <EmptyState Variant="EmptyStateVariant.Inline"
                            Title="No feedback matches this filter"
                            Description="Try another status, kind, or severity."
                            data-qa="AdminFeedbackEmpty" />
              </EmptyContent>
            </FluentDataGrid>
          </DataGridFrame>
        }
        @if (FeedbackAdminState.TotalCount > 0 || FeedbackAdminState.HasPreviousPage)
        {
          <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
            <FluentButton Appearance="ButtonAppearance.Outline"
              Disabled="@(!FeedbackAdminState.HasPreviousPage)"
              data-qa="AdminFeedbackPrevious"
              OnClick="@(() => GoToPageAsync(FeedbackAdminState.Page - 1))">Previous</FluentButton>
            <span data-qa="AdminFeedbackPage">Page @FeedbackAdminState.Page · @FeedbackAdminState.TotalCount items</span>
            <FluentButton Appearance="ButtonAppearance.Outline"
              Disabled="@(!FeedbackAdminState.HasNextPage)"
              data-qa="AdminFeedbackNext"
              OnClick="@(() => GoToPageAsync(FeedbackAdminState.Page + 1))">Next</FluentButton>
          </FluentStack>
        }
      </Section>
    </div>
  </ChildContent>
</TimeWarpPage>
