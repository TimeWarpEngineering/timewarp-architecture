@namespace TimeWarp.Architecture.Features.Admin.Ai
@inherits BaseComponent
@using TimeWarp.Architecture.Features.AgentChats
@using TimeWarp.Architecture.Features.Settings

@*
  Purpose: Admin → AI. Rename the assistant, and set, replace, or clear the site xAI API key.

  Design: The assistant section binds UpdateAssistantName.Command (name and Version). The copy,
  data-qa="AssistantSettings", and AssistantNameRules validation match the section that used to
  sit on Authentication. Submit is SiteSettingsState.UpdateAssistantName. A successful save
  reloads the public identity from AssistantIdentityRefreshHandler, so the button, Ctrl-K row
  and panel update without a page reload. AssistantNameSaveFailed keeps the draft.
  The draft key is page-local and is cleared after a successful save. State never
  receives it back. The input is a password field. The editable branch shows the connection
  as an IntegrationCard; the status sentence stays the meta line, and save and clear stay
  outside the card. Host configuration and a deployment with no durable store render
  read-only text, including the setup hint. Save and clear only dispatch.
*@

@code {
  public static string Title => "AI";
  public static Icon? NavIcon => new Icons.Regular.Size20.Key();

  private static readonly SetXaiApiKey.Validator KeyValidator = new();

  private static readonly UpdateAssistantName.Validator AssistantValidator = new();

  private static readonly Icon XaiKeyIcon = new Icons.Regular.Size24.Key();

  private SetXaiApiKey.Command Command { get; } = new();

  private UpdateAssistantName.Command AssistantCommand { get; } = new();

  private bool AssistantDraftLoaded;

  private bool IsBusy => ActionTrackingState.IsActive;

  private string StatusLine
  {
    get
    {
      if (XaiApiKeyState.NeedsReplacement)
      {
        string tail = XaiApiKeyState.Suffix is null ? "" : $" It ends in …{XaiApiKeyState.Suffix}.";
        return "The stored key cannot be read. Paste a new one." + tail;
      }

      if (!XaiApiKeyState.Configured || XaiApiKeyState.Suffix is null)
      {
        return "No key stored.";
      }

      string when = XaiApiKeyState.SetAt is null
        ? ""
        : $" Set {XaiApiKeyState.SetAt.Value:u} by {XaiApiKeyState.SetByPrincipalId:D}.";
      return $"Configured, ends in …{XaiApiKeyState.Suffix}.{when}";
    }
  }

  private BadgeStatus KeyBadgeStatus =>
    XaiApiKeyState.NeedsReplacement
      ? BadgeStatus.Warning
      : XaiApiKeyState.Configured
        ? BadgeStatus.Active
        : BadgeStatus.Inactive;

  private string KeyBadgeLabel =>
    XaiApiKeyState.NeedsReplacement
      ? "Needs a new key"
      : XaiApiKeyState.Configured
        ? "Configured"
        : "No key";

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    SyncAssistantDraft();
    if (RendererInfo.IsInteractive)
    {
      await LoadAsync();
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    await base.OnAfterRenderAsync(firstRender);
    if (firstRender && RendererInfo.IsInteractive && (!XaiApiKeyState.HasSnapshot || !SiteSettingsState.HasSnapshot))
    {
      await LoadAsync();
      await InvokeAsync(StateHasChanged);
    }
  }

  private async Task LoadAsync()
  {
    if (!XaiApiKeyState.HasSnapshot)
    {
      await NoSubXaiApiKeyState.FetchXaiApiKeyStatus();
    }

    if (!SiteSettingsState.HasSnapshot)
    {
      await NoSubSiteSettingsState.FetchSiteSettings();
    }

    SyncAssistantDraft();
  }

  private void SyncAssistantDraft()
  {
    if (!SiteSettingsState.HasSnapshot)
    {
      return;
    }

    AssistantCommand.AssistantName = SiteSettingsState.AssistantName;
    AssistantCommand.Version = SiteSettingsState.Version;
    AssistantDraftLoaded = true;
  }

  private async Task SaveAssistantAsync()
  {
    await NoSubSiteSettingsState.UpdateAssistantName(AssistantCommand);
    if (!SiteSettingsState.AssistantNameSaveFailed)
    {
      SyncAssistantDraft();
    }
  }

  private async Task SaveAsync()
  {
    await NoSubXaiApiKeyState.SetXaiApiKey(Command.ApiKey);
    if (!XaiApiKeyState.SaveFailed)
    {
      Command.ApiKey = "";
    }
  }

  private Task ClearAsync() => NoSubXaiApiKeyState.ClearXaiApiKey();
}

<TimeWarpPage Title="AI">
  @if (AssistantDraftLoaded)
  {
    <EditForm Model="AssistantCommand" OnValidSubmit="SaveAssistantAsync" FormName="AssistantNameForm" novalidate>
      <FluentValidator Validator="@AssistantValidator" />
      <FormSection Title="Assistant"
                   Description="The name the in-app assistant goes by on the top-bar button, Ctrl-K, the panel and its greeting. Its avatar is generated from the name."
                   data-qa="AssistantSettings">
        <FormGrid>
          <FormField Label="Assistant name">
            <FluentTextInput @bind-Value="AssistantCommand.AssistantName"
                             Name="AssistantName"
                             AriaLabel="Assistant name"
                             Width="100%"
                             Disabled="@IsBusy"
                             data-qa="AssistantName" />
            <ValidationMessage For="@(() => AssistantCommand.AssistantName)" />
          </FormField>
        </FormGrid>
      </FormSection>
      <FormActions>
        <FluentButton Type="ButtonType.Submit"
                      Appearance="ButtonAppearance.Primary"
                      Disabled="@IsBusy"
                      data-qa="AssistantNameSave">
          Save assistant name
        </FluentButton>
      </FormActions>
    </EditForm>
  }
  else
  {
    <FormSection Title="Assistant"
                 Description="The name the in-app assistant goes by on the top-bar button, Ctrl-K, the panel and its greeting. Its avatar is generated from the name."
                 data-qa="AssistantSettings" />
  }

  @if (!XaiApiKeyState.HasSnapshot)
  {
    <FormSection Title="xAI API key"
                 Description="Ask uses this key. The value is never shown again after you save it."
                 data-qa="XaiApiKeySettings" />
  }
  else if (XaiApiKeyState.ManagedByHost)
  {
    <FormSection Title="xAI API key"
                 Description="Ask uses this key. The value is never shown again after you save it."
                 data-qa="XaiApiKeySettings">
      <p data-qa="XaiApiKeyManagedByHost">Managed by the host.</p>
      <p>XAI:ApiKey is set in configuration. This page cannot show or change it.</p>
    </FormSection>
  }
  else if (!XaiApiKeyState.StorageAvailable)
  {
    <FormSection Title="xAI API key"
                 Description="This deployment keeps the key in host configuration."
                 data-qa="XaiApiKeySettings">
      <p data-qa="XaiApiKeyHostOnly">Set the key on the host. Admin cannot store one here.</p>
      <p data-qa="XaiApiKeySetupHint">@XaiApiKeyState.SetupHint</p>
    </FormSection>
  }
  else
  {
    <EditForm Model="Command" OnValidSubmit="SaveAsync" FormName="XaiApiKeyForm" novalidate>
      <FluentValidator Validator="@KeyValidator" />
      <FormSection Title="xAI API key"
                   Description="Ask uses this key. The value is never shown again after you save it."
                   data-qa="XaiApiKeySettings">
        <IntegrationCard Title="xAI"
                         Meta="@StatusLine"
                         Icon="@XaiKeyIcon"
                         Status="@KeyBadgeStatus"
                         StatusLabel="@KeyBadgeLabel"
                         data-qa="XaiApiKeyStatus" />
        <FormGrid>
          <FormField Label="xAI API key">
            <FluentTextInput @bind-Value="Command.ApiKey"
                             Name="ApiKey"
                             TextInputType="TextInputType.Password"
                             AutoComplete="new-password"
                             AriaLabel="xAI API key"
                             Placeholder="Paste a key"
                             Width="100%"
                             Disabled="@IsBusy"
                             data-qa="XaiApiKeyInput" />
            <ValidationMessage For="@(() => Command.ApiKey)" />
          </FormField>
        </FormGrid>
      </FormSection>
      <FormActions>
        <FluentButton Type="ButtonType.Submit"
                      Appearance="ButtonAppearance.Primary"
                      Disabled="@IsBusy"
                      data-qa="XaiApiKeySave">
          Save key
        </FluentButton>
        @if (XaiApiKeyState.Configured || XaiApiKeyState.NeedsReplacement)
        {
          <FluentButton Type="ButtonType.Button"
                        Appearance="ButtonAppearance.Outline"
                        Disabled="@IsBusy"
                        OnClick="ClearAsync"
                        data-qa="XaiApiKeyClear">
            Clear key
          </FluentButton>
        }
      </FormActions>
    </EditForm>
  }
</TimeWarpPage>
