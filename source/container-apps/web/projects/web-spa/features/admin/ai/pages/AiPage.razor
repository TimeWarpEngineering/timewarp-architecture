@namespace TimeWarp.Architecture.Features.Admin.Ai
@inherits BaseComponent
@using TimeWarp.Architecture.Features.AgentChats
@using TimeWarp.Architecture.Features.Settings
@using TimeWarp.Identity

@*
  Purpose: Admin → AI. Rename the assistant, choose whose xAI key Ask uses, and set, replace, or clear the site xAI API key.

  Design: The assistant section binds UpdateAssistantName.Command (name and Version). The copy,
  data-qa="AssistantSettings", and AssistantNameRules validation match the section that used to
  sit on Authentication. Interactive init always dispatches FetchSiteSettings, including when
  sign-in already loaded a snapshot, then copies that snapshot into the draft. An agent rename
  while this page is open advances SiteSettingsState.Version. The render copies that name and
  version into the draft when the field is still the last synced value, so the form matches the
  top bar and the next save is not a 409. A typed edit is left in place. Both drafts share that
  version. When it advances and this draft's own server field still equals the last synced value,
  the draft copies the version and keeps the edit, so saving the other form does not leave a
  stale token. When that field changed on the server as well, the edited draft keeps its old
  version.
  Submit is SiteSettingsState.UpdateAssistantName. A successful save
  reloads the public identity from AssistantIdentityRefreshHandler, so the button, Ctrl-K row
  and panel update without a page reload. AssistantNameSaveFailed keeps the draft.
  The Ask API key section binds UpdateXaiByokMode.Command the same way. It sits next to the
  site key. XaiByokModeSaveFailed keeps that draft. When the host has set XAI:ApiKey the
  select is replaced by the saved label and the reason the policy has no effect.
  The draft key is page-local and is cleared after a successful save. State never
  receives it back. The input is a password field. The editable branch shows the connection
  as an IntegrationCard; the status sentence stays the meta line, and save and clear stay
  outside the card. Host configuration and a deployment with no durable store render
  read-only text, including the setup hint. Save and clear only dispatch.
*@

@code {
  public static string Title => "AI";
  public static Icon? NavIcon => new Icons.Regular.Size20.Key();

  private static readonly SetXaiApiKey.Validator KeyValidator = new();

  private static readonly UpdateAssistantName.Validator AssistantValidator = new();

  private static readonly UpdateXaiByokMode.Validator ByokValidator = new();

  private static readonly Icon XaiKeyIcon = new Icons.Regular.Size24.Key();

  private static readonly XaiByokMode[] XaiByokModes =
  [
    XaiByokMode.Allow,
    XaiByokMode.Required,
    XaiByokMode.Off
  ];

  private SetXaiApiKey.Command Command { get; } = new();

  private UpdateAssistantName.Command AssistantCommand { get; } = new();

  private UpdateXaiByokMode.Command ByokCommand { get; } = new();

  private bool AssistantDraftLoaded;

  private bool ByokDraftLoaded;

  private string SyncedAssistantName = "";

  private long SyncedAssistantVersion;

  private XaiByokMode SyncedByokMode;

  private long SyncedByokVersion;

  private bool IsBusy => ActionTrackingState.IsActive;

  private string StatusLine
  {
    get
    {
      if (XaiApiKeyState.NeedsReplacement)
      {
        string tail = XaiApiKeyState.Suffix is null ? "" : $" It ends in …{XaiApiKeyState.Suffix}.";
        return "The stored key cannot be read. Paste a new one." + tail;
      }

      if (!XaiApiKeyState.Configured || XaiApiKeyState.Suffix is null)
      {
        return "No key stored.";
      }

      string when = XaiApiKeyState.SetAt is null
        ? ""
        : $" Set {XaiApiKeyState.SetAt.Value.UtcDateTime:yyyy-MM-dd'T'HH:mm:ss'Z'} by {XaiApiKeyState.SetByPrincipalId:D}.";
      return $"Configured, ends in …{XaiApiKeyState.Suffix}.{when}";
    }
  }

  private BadgeStatus KeyBadgeStatus =>
    XaiApiKeyState.NeedsReplacement
      ? BadgeStatus.Warning
      : XaiApiKeyState.Configured
        ? BadgeStatus.Active
        : BadgeStatus.Inactive;

  private string KeyBadgeLabel =>
    XaiApiKeyState.NeedsReplacement
      ? "Needs a new key"
      : XaiApiKeyState.Configured
        ? "Configured"
        : "No key";

  private static string XaiByokModeLabel(XaiByokMode mode) =>
    mode switch
    {
      XaiByokMode.Required => "Required (user key only)",
      XaiByokMode.Off => "Off (site key only)",
      _ => "Allow (user key, then the site key)"
    };

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    if (RendererInfo.IsInteractive)
    {
      await LoadAsync(refreshSiteSettings: true);
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    await base.OnAfterRenderAsync(firstRender);
    if (firstRender && RendererInfo.IsInteractive && (!XaiApiKeyState.HasSnapshot || !SiteSettingsState.HasSnapshot))
    {
      await LoadAsync(refreshSiteSettings: !SiteSettingsState.HasSnapshot);
      await InvokeAsync(StateHasChanged);
    }
  }

  private async Task LoadAsync(bool refreshSiteSettings)
  {
    if (!NoSubXaiApiKeyState.HasSnapshot)
    {
      await NoSubXaiApiKeyState.FetchXaiApiKeyStatus();
    }

    if (refreshSiteSettings || !NoSubSiteSettingsState.HasSnapshot)
    {
      await NoSubSiteSettingsState.FetchSiteSettings();
    }

    SyncAssistantDraft();
    SyncByokDraft();
  }

  private void SyncAssistantDraft()
  {
    if (!NoSubSiteSettingsState.HasSnapshot)
    {
      return;
    }

    AssistantCommand.AssistantName = NoSubSiteSettingsState.AssistantName;
    AssistantCommand.Version = NoSubSiteSettingsState.Version;
    SyncedAssistantName = AssistantCommand.AssistantName;
    SyncedAssistantVersion = AssistantCommand.Version;
    AssistantDraftLoaded = true;
  }

  private void SyncUneditedAssistantDraft()
  {
    if (!AssistantDraftLoaded || !SiteSettingsState.HasSnapshot)
    {
      return;
    }

    if (SiteSettingsState.Version == SyncedAssistantVersion)
    {
      return;
    }

    if (string.Equals(SiteSettingsState.AssistantName, SyncedAssistantName, StringComparison.Ordinal))
    {
      AssistantCommand.Version = SiteSettingsState.Version;
      SyncedAssistantVersion = SiteSettingsState.Version;
      return;
    }

    if (AssistantCommand.AssistantName != SyncedAssistantName
      || AssistantCommand.Version != SyncedAssistantVersion)
    {
      return;
    }

    SyncAssistantDraft();
  }

  private void SyncByokDraft()
  {
    if (!NoSubSiteSettingsState.HasSnapshot)
    {
      return;
    }

    ByokCommand.XaiByokMode = NoSubSiteSettingsState.XaiByokMode;
    ByokCommand.Version = NoSubSiteSettingsState.Version;
    SyncedByokMode = ByokCommand.XaiByokMode;
    SyncedByokVersion = ByokCommand.Version;
    ByokDraftLoaded = true;
  }

  private void SyncUneditedByokDraft()
  {
    if (!ByokDraftLoaded || !SiteSettingsState.HasSnapshot)
    {
      return;
    }

    if (SiteSettingsState.Version == SyncedByokVersion)
    {
      return;
    }

    if (SiteSettingsState.XaiByokMode == SyncedByokMode)
    {
      ByokCommand.Version = SiteSettingsState.Version;
      SyncedByokVersion = SiteSettingsState.Version;
      return;
    }

    if (ByokCommand.XaiByokMode != SyncedByokMode
      || ByokCommand.Version != SyncedByokVersion)
    {
      return;
    }

    SyncByokDraft();
  }

  private async Task SaveAssistantAsync()
  {
    await NoSubSiteSettingsState.UpdateAssistantName(AssistantCommand);
    if (!SiteSettingsState.AssistantNameSaveFailed)
    {
      SyncAssistantDraft();
    }
  }

  private async Task SaveByokAsync()
  {
    await NoSubSiteSettingsState.UpdateXaiByokMode(ByokCommand);
    if (!SiteSettingsState.XaiByokModeSaveFailed)
    {
      SyncByokDraft();
    }
  }

  private async Task SaveAsync()
  {
    await NoSubXaiApiKeyState.SetXaiApiKey(Command.ApiKey);
    if (!XaiApiKeyState.SaveFailed)
    {
      Command.ApiKey = "";
    }
  }

  private Task ClearAsync() => NoSubXaiApiKeyState.ClearXaiApiKey();
}

@{
  SyncUneditedAssistantDraft();
  SyncUneditedByokDraft();
}

<TimeWarpPage Title="AI">
  @if (AssistantDraftLoaded)
  {
    <EditForm Model="AssistantCommand" OnValidSubmit="SaveAssistantAsync" FormName="AssistantNameForm" novalidate>
      <FluentValidator Validator="@AssistantValidator" />
      <FormSection Title="Assistant"
                   Description="The name the in-app assistant goes by on the top-bar button, Ctrl-K, the panel and its greeting. Its avatar is generated from the name."
                   data-qa="AssistantSettings"
                   data-assistant-version="@AssistantCommand.Version"
                   data-assistant-name="@AssistantCommand.AssistantName">
        <FormGrid>
          <FormField Label="Assistant name">
            <FluentTextInput @bind-Value="AssistantCommand.AssistantName"
                             Name="AssistantName"
                             AriaLabel="Assistant name"
                             Width="100%"
                             Disabled="@IsBusy"
                             data-qa="AssistantName" />
            <ValidationMessage For="@(() => AssistantCommand.AssistantName)" />
          </FormField>
        </FormGrid>
      </FormSection>
      <FormActions>
        <FluentButton Type="ButtonType.Submit"
                      Appearance="ButtonAppearance.Primary"
                      Disabled="@IsBusy"
                      data-qa="AssistantNameSave">
          Save assistant name
        </FluentButton>
      </FormActions>
    </EditForm>
  }
  else
  {
    <FormSection Title="Assistant"
                 Description="The name the in-app assistant goes by on the top-bar button, Ctrl-K, the panel and its greeting. Its avatar is generated from the name."
                 data-qa="AssistantSettings" />
  }

  @if (!XaiApiKeyState.HasSnapshot)
  {
    <FormSection Title="xAI API key"
                 Description="Ask uses this key. The value is never shown again after you save it."
                 data-qa="XaiApiKeySettings" />
  }
  else if (XaiApiKeyState.ManagedByHost)
  {
    <FormSection Title="xAI API key"
                 Description="Ask uses this key. The value is never shown again after you save it."
                 data-qa="XaiApiKeySettings">
      <p data-qa="XaiApiKeyManagedByHost">Managed by the host.</p>
      <p>XAI:ApiKey is set in configuration. This page cannot show or change it.</p>
    </FormSection>
  }
  else if (!XaiApiKeyState.StorageAvailable)
  {
    <FormSection Title="xAI API key"
                 Description="This deployment keeps the key in host configuration."
                 data-qa="XaiApiKeySettings">
      <p data-qa="XaiApiKeyHostOnly">Set the key on the host. Admin cannot store one here.</p>
      <p data-qa="XaiApiKeySetupHint">@XaiApiKeyState.SetupHint</p>
    </FormSection>
  }
  else
  {
    <EditForm Model="Command" OnValidSubmit="SaveAsync" FormName="XaiApiKeyForm" novalidate>
      <FluentValidator Validator="@KeyValidator" />
      <FormSection Title="xAI API key"
                   Description="Ask uses this key. The value is never shown again after you save it."
                   data-qa="XaiApiKeySettings">
        <IntegrationCard Title="xAI"
                         Meta="@StatusLine"
                         Icon="@XaiKeyIcon"
                         Status="@KeyBadgeStatus"
                         StatusLabel="@KeyBadgeLabel"
                         data-qa="XaiApiKeyStatus" />
        <FormGrid>
          <FormField Label="xAI API key">
            <FluentTextInput @bind-Value="Command.ApiKey"
                             Name="ApiKey"
                             TextInputType="TextInputType.Password"
                             AutoComplete="new-password"
                             AriaLabel="xAI API key"
                             Placeholder="Paste a key"
                             Width="100%"
                             Disabled="@IsBusy"
                             data-qa="XaiApiKeyInput" />
            <ValidationMessage For="@(() => Command.ApiKey)" />
          </FormField>
        </FormGrid>
      </FormSection>
      <FormActions>
        <FluentButton Type="ButtonType.Submit"
                      Appearance="ButtonAppearance.Primary"
                      Disabled="@IsBusy"
                      data-qa="XaiApiKeySave">
          Save key
        </FluentButton>
        @if (XaiApiKeyState.Configured || XaiApiKeyState.NeedsReplacement)
        {
          <FluentButton Type="ButtonType.Button"
                        Appearance="ButtonAppearance.Outline"
                        Disabled="@IsBusy"
                        OnClick="ClearAsync"
                        data-qa="XaiApiKeyClear">
            Clear key
          </FluentButton>
        }
      </FormActions>
    </EditForm>
  }

  @if (!SiteSettingsState.HasSnapshot || !XaiApiKeyState.HasSnapshot)
  {
    <FormSection Title="Ask API key"
                 Description="Whose xAI API key Ask uses when the deployment has not set XAI:ApiKey. The deployment key always wins."
                 data-qa="XaiByokModeSettings" />
  }
  else if (XaiApiKeyState.ManagedByHost)
  {
    <FormSection Title="Ask API key"
                 Description="Whose xAI API key Ask uses when the deployment has not set XAI:ApiKey. The deployment key always wins."
                 data-qa="XaiByokModeSettings">
      <p data-qa="XaiByokModeReadOnly">@XaiByokModeLabel(SiteSettingsState.XaiByokMode)</p>
      <p data-qa="XaiByokModeHostReason">XAI:ApiKey is set in configuration, so this policy has no effect. The deployment key always wins.</p>
    </FormSection>
  }
  else if (ByokDraftLoaded)
  {
    <EditForm Model="ByokCommand" OnValidSubmit="SaveByokAsync" FormName="XaiByokModeForm" novalidate>
      <FluentValidator Validator="@ByokValidator" />
      <FormSection Title="Ask API key"
                   Description="Whose xAI API key Ask uses when the deployment has not set XAI:ApiKey. The deployment key always wins."
                   data-qa="XaiByokModeSettings"
                   data-xai-byok-version="@ByokCommand.Version"
                   data-xai-byok-mode="@ByokCommand.XaiByokMode">
        <FormGrid>
          <FormField Label="Personal xAI API key">
            <FluentSelect TOption="XaiByokMode" TValue="XaiByokMode"
                          Items="@XaiByokModes"
                          OptionText="@XaiByokModeLabel"
                          @bind-Value="ByokCommand.XaiByokMode"
                          AriaLabel="Personal xAI API key"
                          Width="100%"
                          Disabled="@IsBusy"
                          data-qa="XaiByokMode" />
            <ValidationMessage For="@(() => ByokCommand.XaiByokMode)" />
          </FormField>
        </FormGrid>
      </FormSection>
      <FormActions>
        <FluentButton Type="ButtonType.Submit"
                      Appearance="ButtonAppearance.Primary"
                      Disabled="@IsBusy"
                      data-qa="XaiByokModeSave">
          Save xAI key policy
        </FluentButton>
      </FormActions>
    </EditForm>
  }
</TimeWarpPage>
