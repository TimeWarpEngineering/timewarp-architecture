@namespace TimeWarp.Architecture.Features.DesignSystem

@code {
  private static readonly string[] SegmentDemoItems = ["Day", "Week", "Month"];

  private static readonly string[] AxisLabels = ["W1", "W2", "W3", "W4", "W5"];

  private static readonly LineChartSeries[] ChartSeries =
  [
    new("Series A", ChartSeriesTone.Ink, [12, 18, 15, 22, 19]),
    new("Series B", ChartSeriesTone.Primary, [8, 9, 11, 10, 14]),
    new("Series C", ChartSeriesTone.Positive, [4, 5, 6, 7, 8]),
  ];
}

<Card Title="Chart frame">
  <p class="ds-subtitle">A paper frame. The page supplies the period control, the filter, and the plot.</p>
  <ChartCard Title="Sample series" HeadingLevel="3" data-qa="DesignSystemChartCard">
    <Header>
      <SegmentedControl Items="SegmentDemoItems" Value="Week" AriaLabel="Sample period" />
    </Header>
    <Filter>
      <span>All locations</span>
    </Filter>
    <ChildContent>
      <LineChart AxisLabels="AxisLabels" Series="ChartSeries" />
    </ChildContent>
    <Legend>
      <ChartLegendItem Label="Series A" Tone="ChartSeriesTone.Ink" />
      <ChartLegendItem Label="Series B" Tone="ChartSeriesTone.Primary" />
      <ChartLegendItem Label="Series C" Tone="ChartSeriesTone.Positive" />
    </Legend>
  </ChartCard>
</Card>
