@namespace TimeWarp.Architecture.Features.DesignSystem

<Card Title="Role badges">
  <p class="ds-subtitle">A role name on a status pill. The page passes the word and the status. These samples change nothing.</p>
  <div class="ds-row ds-follow" data-qa="DesignSystemRoleBadges">
    <RoleBadge Role="Owner" Status="BadgeStatus.Warning" />
    <RoleBadge Role="Admin" Status="BadgeStatus.Info" />
    <RoleBadge Role="Staff" Status="BadgeStatus.Inactive" />
  </div>
</Card>
