@namespace TimeWarp.Architecture.Features.DesignSystem

@code {
  // Each row uses the shared role class the real component uses.
  private static readonly (string Role, string Label)[] TypeScale =
  [
    ("twe-type-page-title", "28 — Page title"),
    ("twe-type-section-title", "18 — Section title"),
    ("twe-type-body", "14 — Body, button"),
    ("twe-type-helper", "12 — Helper text"),
    ("twe-type-eyebrow", "11 — Section eyebrow"),
  ];
}

<Card Title="Type Scale">
  <div class="ds-type">
    @foreach ((string role, string label) in TypeScale)
    {
      <div class="ds-type__row @role">@label</div>
    }
  </div>
</Card>
