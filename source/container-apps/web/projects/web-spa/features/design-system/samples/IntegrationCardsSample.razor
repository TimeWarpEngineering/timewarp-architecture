@namespace TimeWarp.Architecture.Features.DesignSystem
@inherits BaseComponent

@code {
  private static readonly Icon IntegrationConnectedIcon = new Icons.Regular.Size24.CloudSync();
  private static readonly Icon IntegrationWarningIcon = new Icons.Regular.Size24.Warning();
  private static readonly Icon IntegrationSyncIcon = new Icons.Regular.Size20.ArrowSync();

  private async Task ShowMessage(MessageBarIntent intent, string title) =>
    await NotificationState.AddNotification(intent, title, externalCancellationToken: CancellationToken);
}

<Card Title="Integration Cards">
  <p class="ds-subtitle">A full identity banner, and the compact pull-status row. Warning paints only the compact row. The sample buttons post a note and change nothing.</p>
  <div class="twe-stack">
    <IntegrationCard Title="External system"
                     Meta="Last data pull 2 hours ago"
                     Icon="@IntegrationConnectedIcon"
                     Status="BadgeStatus.Active"
                     StatusLabel="Connected">
      <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Sync now."))">Sync now</FluentButton>
      <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Disconnect."))">Disconnect</FluentButton>
    </IntegrationCard>
    <IntegrationCard Title="External system"
                     Meta="The stored connection cannot be used."
                     Icon="@IntegrationWarningIcon"
                     Status="BadgeStatus.Warning"
                     StatusLabel="Needs attention">
      <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Review connection."))">Review</FluentButton>
    </IntegrationCard>
    <IntegrationCard Title="External system" Meta="Last data pull 2 hours ago" />
    <IntegrationCard Variant="IntegrationCardVariant.Compact"
                     Title="External system"
                     Meta="Last data pull 2 hours ago"
                     Icon="@IntegrationSyncIcon">
      <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Sync now."))">Sync now</FluentButton>
    </IntegrationCard>
    <IntegrationCard Variant="IntegrationCardVariant.Compact"
                     Title=""
                     Meta="Last data pull 2 hours ago" />
    <IntegrationCard Variant="IntegrationCardVariant.Compact"
                     Tone="IntegrationCardTone.Warning"
                     Title="External system"
                     Meta="The connection cannot be used."
                     Icon="@IntegrationSyncIcon"
                     data-qa="DesignSystemIntegrationWarning">
      <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Review connection."))">Review</FluentButton>
    </IntegrationCard>
  </div>
</Card>
