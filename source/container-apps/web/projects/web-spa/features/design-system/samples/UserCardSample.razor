@namespace TimeWarp.Architecture.Features.DesignSystem
@inherits BaseComponent
@attribute [CrossSliceReference(typeof(ProfilePage), "Design system sample opens the profile page from the user card.")]

@code {
  // Task 506: the card's click is RouteState.ChangeRoute, not an Href (TWA0050).
  private Task OpenProfileAsync() => NoSubRouteState.ChangeRoute(newRoute: ProfilePage.GetPageUrl());
}

<Card Title="User card">
  <p class="ds-subtitle">Pinned under the navigation menu. The row is a button when it has an OnClick that dispatches the navigate action. The shell shows the signed-in person here.</p>
  <div class="twe-stack">
    <UserCard Name="Ada Lovelace" Detail="ada@example.test" OnClick="OpenProfileAsync" data-qa="DesignSystemUserCard" />
    <UserCard Name="Ada Lovelace" Detail="Signed in" />
  </div>
  <p class="ds-subtitle">SearchMode is Palette (the Ctrl-K field), Hidden, or Custom. This page keeps Palette. The nav is 240px from 1280px up, a 68px rail from 880px through 1279px, and the drawer below 880px.</p>
</Card>
