@namespace TimeWarp.Architecture.Features.DesignSystem

@code {
  // The label is the custom property, not a hex copy: tokens.css is the one source, and its dark
  // block (task 465) paints different values for the neutrals.
  private static readonly (string Name, string Token)[] ColorTokens =
  [
    ("Purple (primary)", "twe-purple"),
    ("Blue (secondary)", "twe-blue"),
    ("Green (highlight)", "twe-green"),
    ("Ink (text)", "twe-ink"),
    ("Muted", "twe-muted"),
    ("Background", "twe-background"),
    ("Paper", "twe-paper"),
    ("Danger", "twe-danger"),
  ];
}

<Card Title="Color Tokens">
  <div class="ds-swatches">
    @foreach ((string name, string token) in ColorTokens)
    {
      <div class="ds-swatch">
        <div class="ds-swatch__chip" data-token="@token"></div>
        <div class="ds-swatch__name">@name</div>
        <div class="ds-swatch__token">--@token</div>
      </div>
    }
  </div>
</Card>
