@namespace TimeWarp.Architecture.Features.DesignSystem

@code {
  private static readonly IReadOnlyList<PermissionGroup> SamplePermissions =
  [
    new("Work",
    [
      new PermissionItem("View assigned work", true),
      new PermissionItem("Edit shared records", true),
      new PermissionItem("Delete records", false)
    ]),
    new("Administration",
    [
      new PermissionItem("Manage people", false),
      new PermissionItem("Change billing", false)
    ])
  ];
}

<Card Title="Permission grid">
  <p class="ds-subtitle">Capability groups. A check is granted. A minus is not. The page passes the rows.</p>
  <div class="ds-follow" data-qa="DesignSystemPermissionGrid">
    <PermissionGrid Groups="SamplePermissions" />
  </div>
</Card>
