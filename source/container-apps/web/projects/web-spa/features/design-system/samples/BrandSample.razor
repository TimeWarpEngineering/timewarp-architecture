@namespace TimeWarp.Architecture.Features.DesignSystem

@code {
  [Inject] private IOptions<BrandOptions> BrandOptionsAccessor { get; set; } = null!;

  private BrandOptions Brand => BrandOptionsAccessor.Value;
}

<Card Title="Brand">
  <p class="ds-subtitle">Product name, logo, shell tokens, and the Fluent ramp come from BrandOptions. This card is the checked-in brand.</p>
  <div class="ds-brand">
    <img class="ds-brand__logo"
         src="@Brand.LogoSrc"
         alt="@Brand.LogoAlt"
         width="@Brand.LogoWidth"
         height="@Brand.LogoHeight"
         data-qa="DesignSystemBrandLogo" />
    <p class="ds-brand__fact" data-qa="DesignSystemBrandName">@Brand.ProductName</p>
    <p class="ds-brand__fact" data-qa="DesignSystemBrandSeed">@Brand.NormalizedSeedColor</p>
    <p class="ds-brand__fact" data-qa="DesignSystemBrandRamp">@(Brand.ExactRamp ? "Exact" : "Harmonized")</p>
  </div>
</Card>
