@namespace TimeWarp.Architecture.Features.DesignSystem
@inherits BaseComponent

@code {
  private const string DesignSystemDrawerId = "design-system-drawer";
}

<Card Title="Drawers">
  <p class="ds-subtitle">A slide-over beside the page. Opening sets the app modal id; closing clears it. One overlay is open at a time.</p>
  <FluentButton Appearance="ButtonAppearance.Primary" data-qa="DrawerOpen" OnClick="@(() => ApplicationState.SetActiveModal(DesignSystemDrawerId))">Open drawer</FluentButton>
  <Drawer Title="Sample drawer"
          IsOpen="@(ApplicationState.ActiveModalId == DesignSystemDrawerId)"
          OnClose="@(() => ApplicationState.CloseModal())"
          data-qa="DesignSystemDrawer">
    <ChildContent>
      <p>A detail or edit form can sit here without leaving the page.</p>
    </ChildContent>
    <Footer>
      <FluentButton Appearance="ButtonAppearance.Primary" data-qa="DrawerFooterClose" OnClick="@(() => ApplicationState.CloseModal())">Close</FluentButton>
    </Footer>
  </Drawer>
</Card>
