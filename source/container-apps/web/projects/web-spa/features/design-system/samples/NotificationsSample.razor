@namespace TimeWarp.Architecture.Features.DesignSystem
@inherits BaseComponent
@attribute [CrossSliceReference(typeof(CounterState), "Living design system deliberately exercises the counter throw-exception pipeline.")]

@code {
  // Message bars go through NotificationState (the generated ActionSet
  // dispatcher), rather than a direct INotificationService call, so the demo
  // exercises the app's own path.
  private async Task ShowMessage(MessageBarIntent intent, string title) =>
    await NotificationState.AddNotification(intent, title, externalCancellationToken: CancellationToken);

  // A handler throws, StateTransactionBehavior publishes ExceptionNotification,
  // and ExceptionNotificationHandler records a NotificationState row. Dispatched
  // through the generated ActionSet method (TWA0022 bans direct mediator Send here).
  private async Task TriggerException() =>
    await CounterState.ThrowException("Demo exception dispatched from the Design System.", CancellationToken);
}

<Card Title="Notifications (message bars)">
  <p class="ds-subtitle">Dispatched through the app's NotificationState pipeline. Bars render in the shell region at the top of the page; identical messages dedupe, Success auto-dismisses, and the stack caps at three with "+N more". The last button throws inside an action to exercise the exception → message bar path.</p>
  <div class="ds-row">
    <FluentButton Appearance="ButtonAppearance.Primary" data-qa="ToastInfo" OnClick="@(() => ShowMessage(MessageBarIntent.Info, "Heads up — this is an info message."))">Info</FluentButton>
    <FluentButton Appearance="ButtonAppearance.Primary" data-qa="ToastSuccess" OnClick="@(() => ShowMessage(MessageBarIntent.Success, "Saved successfully."))">Success</FluentButton>
    <FluentButton Appearance="ButtonAppearance.Primary" data-qa="ToastWarning" OnClick="@(() => ShowMessage(MessageBarIntent.Warning, "Careful — this is a warning."))">Warning</FluentButton>
    <FluentButton Appearance="ButtonAppearance.Primary" data-qa="ToastError" OnClick="@(() => ShowMessage(MessageBarIntent.Error, "Something went wrong."))">Error</FluentButton>
    <FluentButton Appearance="ButtonAppearance.Outline" data-qa="ToastException" OnClick="TriggerException">Throw exception</FluentButton>
  </div>
</Card>
