@namespace TimeWarp.Architecture.Features.DesignSystem

@*
  Purpose: In-page part list for the design system. Not a second FluentNav.

  Design: Native nav and lists, because the shell already owns the one FluentNav
  registry. All is the first entry and links to /DesignSystem. Each part links to
  /DesignSystem/{slug}. Each entry is a RouteLink (task 506, TWA0050), so a click is the
  RouteState.ChangeRoute action; the link styles reach its anchor through ::deep under the
  native list. The selected entry sets aria-current="page". The filter is
  component-local text (not a stored demo choice). Immediate delivers each
  keystroke. Wall A: the native filter div anchors ::deep to fluent-text-input.
  Each group name is an h2, and the nested part list is labelled by that heading,
  so the grouping is in the accessibility tree. The heading uses the shared
  eyebrow role. The list height is the space left in the viewport at page top,
  and the list scrolls inside that box.
*@

@code {
  [Parameter] public string? SelectedSlug { get; set; }
  [Parameter] public bool Known { get; set; }

  private string Filter { get; set; } = "";

  private bool AllCurrent => Known && SelectedSlug is null;

  private bool ShowAll
  {
    get
    {
      string query = Filter.Trim();
      return query.Length == 0 || "All".Contains(query, StringComparison.OrdinalIgnoreCase);
    }
  }

  private Task OnFilterChanged(string? value)
  {
    Filter = value ?? "";
    return Task.CompletedTask;
  }

  private bool Matches(DesignSystemParts.Part part)
  {
    string query = Filter.Trim();
    return query.Length == 0 || part.Title.Contains(query, StringComparison.OrdinalIgnoreCase);
  }

  private bool IsCurrent(DesignSystemParts.Part part) =>
    Known && string.Equals(SelectedSlug, part.Slug, StringComparison.Ordinal);

  private static string GroupHeadingId(DesignSystemParts.Group group) =>
    "ds-catalog-" + group.ToString().ToLowerInvariant();

  private List<(DesignSystemParts.Group Group, DesignSystemParts.Part[] Parts)> VisibleGroups()
  {
    List<(DesignSystemParts.Group Group, DesignSystemParts.Part[] Parts)> groups = [];
    foreach (DesignSystemParts.Group group in Enum.GetValues<DesignSystemParts.Group>())
    {
      List<DesignSystemParts.Part> parts = [];
      foreach (DesignSystemParts.Part part in DesignSystemParts.PageOrder)
      {
        if (part.Group == group && Matches(part))
        {
          parts.Add(part);
        }
      }

      if (parts.Count > 0)
      {
        groups.Add((group, [.. parts]));
      }
    }

    return groups;
  }
}

<nav class="ds-catalog" aria-label="Design system parts" data-qa="DesignSystemCatalog">
  <div class="ds-catalog__filter">
    <FluentTextInput Placeholder="Filter parts"
                     Value="@Filter"
                     ValueChanged="@OnFilterChanged"
                     Immediate="true"
                     ImmediateDelay="0"
                     AriaLabel="Filter parts"
                     Width="100%"
                     data-qa="DesignSystemFilter" />
  </div>
  <ul class="ds-catalog__list">
    @if (ShowAll)
    {
      <li>
        <RouteLink class="ds-catalog__link"
                   Route="@DesignSystemPage.GetPageUrl()"
                   aria-current="@(AllCurrent ? "page" : null)"
                   data-qa="DesignSystemAll"
                   data-part="all">All</RouteLink>
      </li>
    }
    @foreach ((DesignSystemParts.Group group, DesignSystemParts.Part[] parts) in VisibleGroups())
    {
      <li class="ds-catalog__group">
        <h2 class="ds-catalog__heading twe-type-eyebrow" id="@GroupHeadingId(group)">@group</h2>
        <ul class="ds-catalog__parts" aria-labelledby="@GroupHeadingId(group)">
          @foreach (DesignSystemParts.Part part in parts)
          {
            <li>
              <RouteLink class="ds-catalog__link"
                         Route="@DesignSystemPartLookup.Url(part)"
                         aria-current="@(IsCurrent(part) ? "page" : null)"
                         data-qa="DesignSystemPartLink"
                         data-part="@part.Slug">@part.Title</RouteLink>
            </li>
          }
        </ul>
      </li>
    }
  </ul>
</nav>
