@namespace TimeWarp.Architecture.Features.DesignSystem
@inherits BaseComponent
@inject IJSRuntime JsRuntime

@code {
  public static Icon? NavIcon => new Icons.Regular.Size20.Color();
  public static string Title => "Design System";

  private string? ScrolledPart;

  private DesignSystemParts.Selection Current => DesignSystemPartLookup.Resolve(Part);

  private string? CrumbLabel
  {
    get
    {
      if (Current.Kind == DesignSystemParts.SelectionKind.Part)
      {
        return Current.Part!.Title;
      }

      if (Current.Kind == DesignSystemParts.SelectionKind.Unknown)
      {
        return Part;
      }

      return null;
    }
  }

  // The unknown-slug All button is RouteState.ChangeRoute, not an anchor (TWA0050, task 506).
  private Task ShowAllAsync() => NoSubRouteState.ChangeRoute(newRoute: DesignSystemPage.GetPageUrl());

  [DirectComponentSideEffect("Resets the shell content scroller when the design-system part changes. The offset is DOM state on the layout content area.")]
  protected override Task OnAfterRenderAsync(bool firstRender)
  {
    _ = firstRender;
    if (!RendererInfo.IsInteractive)
    {
      return Task.CompletedTask;
    }

    string key = Part ?? "";
    if (string.Equals(key, ScrolledPart, StringComparison.Ordinal))
    {
      return Task.CompletedTask;
    }

    ScrolledPart = key;
    return DesignSystemPageJsModule.ScrollContentToTopAsync(JsRuntime);
  }

}

<TimeWarpPage Title="@Title" BreadcrumbLabel="@CrumbLabel">
  <Description>Live brand tokens, type scale, and components for the configured brand.</Description>
  <ChildContent>
    <div class="ds-layout">
      <DesignSystemCatalog SelectedSlug="@Current.Part?.Slug" Known="@(Current.Kind != DesignSystemParts.SelectionKind.Unknown)" />
      <div class="ds-stage" data-qa="DesignSystemStage">
        @if (Current.Kind == DesignSystemParts.SelectionKind.Unknown)
        {
          <div class="ds-missing" data-qa="DesignSystemUnknown">
            <p class="ds-missing__title">No such part.</p>
            <p class="ds-missing__body">This slug is not in the catalog.</p>
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="ShowAllAsync" data-qa="DesignSystemUnknownAll">All</FluentButton>
          </div>
        }
        else if (Current.Kind == DesignSystemParts.SelectionKind.All)
        {
          <div class="twe-stack">
            @foreach (DesignSystemParts.Part part in DesignSystemParts.PageOrder)
            {
              @DesignSystemPartLookup.Render(part)
            }
          </div>
        }
        else
        {
          <div class="twe-stack" data-qa="DesignSystemPart" data-part="@Current.Part!.Slug">
            @DesignSystemPartLookup.Render(Current.Part)
            <section class="ds-usage" data-qa="DesignSystemUsage">
              <h2 class="ds-usage__label">Usage</h2>
              <pre class="ds-usage__code"><code>@Current.Part.Usage</code></pre>
            </section>
          </div>
        }
      </div>
    </div>
  </ChildContent>
</TimeWarpPage>
