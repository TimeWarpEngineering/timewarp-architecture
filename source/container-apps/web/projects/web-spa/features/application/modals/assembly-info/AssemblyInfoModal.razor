@namespace TimeWarp.Architecture.Components
@inherits BaseComponent

@code
{
  // Purpose: The footer version dialog: the Web.Spa assembly record and its Copy button.
  // Design: The heading, rows, and links come from AssemblyInfoText (Title, Properties, Links),
  // the same members ClipboardText writes, so the clipboard matches the screen (task 450). ActionContent replaces the
  // container's default Close, so this dialog renders Copy beside its own Close.

  public const string ModalId = nameof(AssemblyInfoModal);
  private AssemblyInfo? AssemblyInfo;

  protected Task Activate()
  {
    AssemblyInfo = typeof(Program).Assembly.GetAssemblyInfo();
    return Task.CompletedTask;
  }

  private Task CloseModal() => ApplicationState.CloseModal();
}

<ModalContainer ModalId=@ModalId OnActivate=Activate>
  <MainContent>
    <Section Title="@(AssemblyInfoText.Title(AssemblyInfo) ?? "Assembly")">
    @if (AssemblyInfo != null)
    {
      @foreach ((string name, string value) in AssemblyInfoText.Properties(AssemblyInfo))
      {
        <PropertyDisplay PropertyName=@name Value=@value/>
      }
      @foreach ((string _, string url, string displayText) in AssemblyInfoText.Links(AssemblyInfo))
      {
        <LinkDisplay Url=@url DisplayText=@displayText/>
      }
    }
    else
    {
      <div class="twe-section__loading">
        <FluentSpinner />
      </div>
    }
    </Section>
  </MainContent>
  <ActionContent>
    <AssemblyInfoCopyButton AssemblyInfo=@AssemblyInfo/>
    <FluentButton Appearance=ButtonAppearance.Primary data-qa="ModalButton" OnClick=CloseModal>Close</FluentButton>
  </ActionContent>
</ModalContainer>
