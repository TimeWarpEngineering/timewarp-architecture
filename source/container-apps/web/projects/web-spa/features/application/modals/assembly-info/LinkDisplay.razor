@namespace TimeWarp.Architecture.Components

@*
  Purpose: One labelled link row in the assembly info dialog.

  Design: The url is a RouteLink (task 506, TWA0050), so a click is RouteState.ChangeRoute;
  an absolute url leaves the app through it. A blank url renders nothing.
*@

@code {
  [Parameter]
  public string? Url { get; set; }

  [Parameter]
  public string? DisplayText { get; set; }

  [Parameter]
  public string CssClass { get; set; } = "twe-ext-link";
}

@if (!string.IsNullOrWhiteSpace(Url))
{
  <div class="@CssClass"><RouteLink Route="@Url">@DisplayText</RouteLink></div>
}
