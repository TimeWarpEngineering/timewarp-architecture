@namespace TimeWarp.Architecture.Features.Applications
@inherits BaseComponent
@using Ai = Microsoft.AspNetCore.Components.AI
@using TimeWarp.Architecture.Components
@using TimeWarp.Architecture.Services

@*
  Purpose: Ask panel. A person describes what they want and the in-app model runs a page catalog tool.

  Design: Docked in TimeWarpPage's FluentLayout aside (450px), not a modal and not a flex
  sibling of the layout. The top-bar Ask AI button and the Ctrl-K Ask action both open it.
  The page reflows beside it; below 880px and when expanded the aside item covers the viewport.
  It renders the probe's state (task 293): only when the server answered "no key" does it show
  "AI not configured" and the pwsh user-secrets command. Signed out (401) shows "Sign in to use
  Ask" and a button that closes the panel and goes to Login with the current page as the return
  path. Any other failure shows the status, title and detail and a Retry that runs the probe
  again. The probe itself re-runs on every sign-in and sign-out (AuthenticationStateListener).
  Tools are the palette's agent-visible commands, navigate, the current page's tools, and
  page_context, the same list WebMCP publishes, including the approval bit for the conversation's
  edit mode. Global actions and navigate run from any page. A page-bound action off its page
  returns a navigate offer and does not run. The route is PageAgentRoute, which
  this panel refreshes from the browser location on WebAssembly before it rebuilds. Tool arguments
  render as JSON. An empty argument dictionary is omitted: Razor would print its CLR type name,
  and page_context's schema is empty so that dictionary is {}. The tool result stays in the model
  transcript and is not copied into the reasoning block. The panel rebuilds the agent when
  the route, the edit mode, or the conversation generation changes. A route or edit-mode rebuild
  never runs while a turn is streaming or waiting on an approval card: it waits for the turn to
  go idle. New conversation (a generation change) rebuilds at once and abandons that turn. A build
  that finishes after the panel was disposed (navigation mid-build) frees what it created.
  The root carries data-built-mode, the edit mode of the agent actually built.
  The transcript is not a component field. Every agent gets the AskConversationThread for the
  current generation (AskConversationThreads, app-scoped), and the panel owns the AgentContext
  instead of ChatPage's AgentBoundary, so it can await AgentContext.RestoreAsync before the
  MessageList attaches. That restores both the rendered turns and the model history across Close,
  navigation (TimeWarpPage remounts), and rebuilds. New conversation bumps the generation and
  gets an empty thread. The markup mirrors ChatPage (sc-ai-chat-page body and footer).
  MessageInput stays the library component. Scoped CSS turns its flex row into a two-row
  grid: the textarea spans the full width and grows with field-sizing up to 10rem, and send
  sits on the footer row. Typing @ at the start of a word in the composer (not mid-word, as in
  an email address) opens AskReferencePicker (task 345): the
  site-wide resource types the person may list, then a search of the chosen type's list query;
  choosing an item inserts its @prefix:id token at the caret. The Tag button in the composer's
  lead slot (task 346) dispatches AskTagState.StartPick for the current route: pick mode
  highlights the app's marked elements (AskTagMark) and the chosen one becomes a chip
  (AskTagChips) above the composer. The agent's client is AskTagChatClient over the tool-invoking
  client, so the chips go out with the next message and then move to page_context.tags.
  Closing the panel closes the picker and cancels pick mode.
  It mints one short-lived credential for the signed-in principal when a conversation has none.
  The credential is an advisory client-side guardrail, not a security boundary: its scopes are a
  copy of every permission claim the principal holds now, a null credential means unbounded, and
  server [EndpointAuthorize] remains the boundary. When it has expired the header says so and
  points at New conversation. Outcomes of dispatched actions stay on NotificationState. Copy and
  @ insertion are presentational JS on child components.
*@

@code {
  private const string AskPlaceholder =
    "Tell the app what you want. Type @ to reference a resource.";

  private static readonly string[] Suggestions =
  [
    "What can I do here?",
    "Explain this page",
    "What would need my approval?",
  ];

  [Inject] private IServiceProvider ServiceProvider { get; set; } = null!;
  [Inject] private IActionCatalog ActionCatalog { get; set; } = null!;
  [Inject] private NavigationManager NavigationManager { get; set; } = null!;
  [Inject] private IJSRuntime JsRuntime { get; set; } = null!;
  [Inject] private PageAgentRoute PageAgentRoute { get; set; } = null!;
  [Inject] private IStore ScopedStore { get; set; } = null!;
  [Inject] private AskConversationThreads Threads { get; set; } = null!;

  private Ai.UIAgent? Agent;
  private Ai.AgentContext? Conversation;
  private AskConversationThread? Thread;
  private IDisposable? StatusSubscription;
  private FunctionInvokingChatClient? InvokingClient;
  private AskTagChatClient? TagClient;
  private CatalogAgentFunctions? Functions;
  private bool Building;
  private bool Disposed;
  private int DeclinedGeneration = -1;
  private string? BuiltPath;
  private AgentEditMode BuiltMode;
  private int BuiltGeneration = -1;

  private CatalogAgentReadiness Readiness => CatalogAgentAvailability.Readiness(AgentSurfaceState);
  private string SetupCommand => CatalogAgentAvailability.SetupCommand(AgentSurfaceState);
  private string ConversationTitle =>
    string.IsNullOrWhiteSpace(AgentSurfaceState.ConversationDisplayName)
      ? "New conversation"
      : AgentSurfaceState.ConversationDisplayName;
  private string? Problem => CatalogAgentAvailability.Problem(AgentSurfaceState);

  private bool ConversationExpired =>
    AgentConversationAuthority.IsExpired(AgentSurfaceState.Conversation, DateTimeOffset.UtcNow);

  private bool TurnInProgress =>
    Conversation?.Status is Ai.ConversationStatus.Streaming or Ai.ConversationStatus.AwaitingInput;

  private bool ShowPrivacy => AskPrivacyNotice.ShouldShow
  (
    AgentSurfaceState.RecordChats,
    AgentSurfaceState.PrivacyNoticeDismissed,
    AgentSurfaceState.PrivacyNotice
  );

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    await base.OnAfterRenderAsync(firstRender);
    PageAgentRoute.Observe(NavigationManager, JsRuntime);
    await IssueConversationAsync();
    Ai.UIAgent? previous = Agent;
    await EnsureAgentAsync();
    if (!ReferenceEquals(previous, Agent))
    {
      StateHasChanged();
    }
  }

  private string CurrentPath() => PageAgentRoute.PathOr(NavigationManager);

  private async Task IssueConversationAsync()
  {
    if (AgentSurfaceState.Conversation is not null)
    {
      return;
    }

    if (DeclinedGeneration == AgentSurfaceState.ConversationGeneration)
    {
      return;
    }

    // Re-read on every issue. The panel does not cache an AuthenticationState.
#pragma warning disable BL0013
    AuthenticationState authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
#pragma warning restore BL0013
    string? idText = authentication.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    if (!Guid.TryParse(idText, out Guid principalId))
    {
      DeclinedGeneration = AgentSurfaceState.ConversationGeneration;
      return;
    }

    List<string> scopes = [];
    foreach (Claim claim in authentication.User.FindAll(PermissionIds.ClaimType))
    {
      if (!string.IsNullOrEmpty(claim.Value))
      {
        scopes.Add(claim.Value);
      }
    }

    int minutes = AgentSurfaceState.CredentialLifetimeMinutes;
    TimeSpan lifetime = minutes > 0
      ? TimeSpan.FromMinutes(minutes)
      : AgentConversationCredentialIssuer.DefaultLifetime;
    AgentConversationCredential credential = AgentConversationCredentialIssuer.Issue
    (
      principalId,
      scopes,
      DateTimeOffset.UtcNow,
      lifetime
    );
    await AgentSurfaceState.SetConversation
    (
      credential.Id,
      credential.PrincipalId,
      scopes.ToArray(),
      credential.ExpiresAt,
      credential.DisplayName
    );
  }

  private async Task EnsureAgentAsync()
  {
    if (Readiness != CatalogAgentReadiness.Configured)
    {
      if (Agent is not null)
      {
        ReleaseAgent();
      }

      return;
    }

    string path = CurrentPath();
    AgentEditMode mode = AgentSurfaceState.EditMode;
    int generation = AgentSurfaceState.ConversationGeneration;
    if (Agent is not null && BuiltPath == path && BuiltMode == mode && BuiltGeneration == generation)
    {
      return;
    }

    // A rebuild disposes the AgentContext, which cancels the stream and orphans an approval card.
    // Wait for the turn to finish; the status callback re-renders and this runs again. New
    // conversation (a generation change) abandons the turn on purpose, so it does not wait.
    if (Building || (TurnInProgress && BuiltGeneration == generation))
    {
      return;
    }

    IChatClient? chatClient = ServiceProvider.GetService<IChatClient>();
    if (chatClient is null)
    {
      return;
    }

    Building = true;
    try
    {
      // Re-read on every rebuild. The panel does not cache an AuthenticationState.
#pragma warning disable BL0013
      AuthenticationState authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
#pragma warning restore BL0013
      IReadOnlyList<CatalogAgentTool> selected = await CatalogAgentToolSet.SelectAsync
      (
        authentication.User,
        AuthorizationService,
        ActionCatalog.Entries,
        path,
        mode,
        CancellationToken.None
      );
      if (Disposed)
      {
        return;
      }

      ReleaseAgent();
      Functions = CatalogAgentFunctions.Create(selected);
      List<string> toolNames = [];
      foreach (CatalogAgentTool tool in selected)
      {
        toolNames.Add(tool.Name);
      }

      toolNames.Add(PageAgentContext.ToolName);
      string instructions = AgentAskInstructions.For
      (
        PageAgentContext.Describe(ScopedStore, path, toolNames, liveSurfaceJson: null, AgentAskInstructions.ContextCap)
      );
      InvokingClient = CatalogAgentSession.CreateInvokingClient(chatClient, ServiceProvider);
      TagClient = new AskTagChatClient
      (
        InvokingClient,
        () => AskTagState.AttachedFor(AgentSurfaceState.ConversationGeneration),
        () => InvokeAsync(() => AskTagState.MarkSent())
      );
      AskConversationThread thread = Threads.For(generation);
      Ai.UIAgent agent = new
      (
        TagClient,
        options =>
        {
          options.ChatOptions = new ChatOptions
          {
            Tools = [.. Functions.Tools],
            Instructions = instructions,
          };
          options.Thread = thread;
        }
      );
      Ai.AgentContext conversation = new(agent);
      // Restore before MessageList attaches: it reads Turns once, when its AgentContext changes.
      await conversation.RestoreAsync();
      if (Disposed)
      {
        // Dispose already released the fields; free what this build created.
        conversation.Dispose();
        agent.Dispose();
        ReleaseAgent();
        return;
      }

      Agent = agent;
      Conversation = conversation;
      Thread = thread;
      StatusSubscription = conversation.RegisterOnStatusChanged(OnStatusChanged);
      BuiltPath = path;
      BuiltMode = mode;
      BuiltGeneration = generation;
    }
    finally
    {
      Building = false;
    }
  }

  private async Task SignInAsync()
  {
    string returnPath = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    await AgentSurfaceState.CloseAskPanel();
    await NoSubRouteState.ChangeRoute(newRoute: TimeWarp.Architecture.Features.Identity.LoginPage.GetLoginUrl(returnPath));
  }

  private Task RetryAsync() => AgentSurfaceState.LoadChatConfiguration();

  private void OnStatusChanged(Ai.ConversationStatus status)
  {
    if (!Disposed && status is Ai.ConversationStatus.Idle or Ai.ConversationStatus.Error)
    {
      // A rebuild may have been deferred while the turn ran.
      _ = InvokeAsync(StateHasChanged);
    }
  }

  private void ReleaseAgent()
  {
    StatusSubscription?.Dispose();
    StatusSubscription = null;
    Conversation?.Dispose();
    Conversation = null;
    Thread = null;
    Agent?.Dispose();
    Agent = null;
    // TagClient owns InvokingClient (DelegatingChatClient disposes its inner client).
    TagClient?.Dispose();
    TagClient = null;
    InvokingClient = null;
    Functions?.Dispose();
    Functions = null;
  }

  private string? RecordedApproval(Ai.FunctionApprovalBlock approval)
  {
    bool? answer = Thread?.ApprovalAnswer(approval.ApprovalRequest.RequestId);
    return answer switch
    {
      true => nameof(Ai.ApprovalStatus.Approved),
      false => nameof(Ai.ApprovalStatus.Rejected),
      null => null,
    };
  }

  [DirectComponentSideEffect("Reads the library textarea's caret to open the @ picker only when @ starts a word; the caret is DOM state, and opening is still the Open action.")]
  private async Task OnComposerKeyDownAsync(KeyboardEventArgs args)
  {
    if (args.Key != "@" || AskReferenceState.IsOpen)
    {
      return;
    }

    if (await AskAiJsModule.AtStartsWordAsync(JsRuntime))
    {
      await AskReferenceState.Open();
    }
  }

  private Task TagAsync() => AskTagState.StartPick(CurrentPath());

  private bool Picking => ActionTrackingState.IsAnyActive(typeof(AskTagState.StartPickActionSet.Action));

  private async Task CloseAsync()
  {
    await AskTagState.CancelPick();
    await AskReferenceState.Close();
    await AgentSurfaceState.CloseAskPanel();
  }

  private Task ExpandAsync() => AgentSurfaceState.ToggleAskExpand();

  private Task NewConversationAsync() => AgentSurfaceState.NewConversation();

  private Task DismissPrivacyAsync() => AgentSurfaceState.DismissPrivacyNotice();

  private Task AskBeforeAsync() => AgentSurfaceState.SetEditMode(AgentEditMode.AskBeforeEditing);

  private Task AutoEditAsync() => AgentSurfaceState.SetEditMode(AgentEditMode.AutomaticallyEdit);

  private string AskBeforePressed =>
    AgentSurfaceState.EditMode == AgentEditMode.AskBeforeEditing ? "true" : "false";

  private string AutoEditPressed =>
    AgentSurfaceState.EditMode == AgentEditMode.AutomaticallyEdit ? "true" : "false";

  private string ExpandLabel => AgentSurfaceState.IsPanelExpanded ? "Collapse" : "Expand";

  private Icon ExpandIcon => AgentSurfaceState.IsPanelExpanded
    ? new Icons.Regular.Size20.FullScreenMinimize()
    : new Icons.Regular.Size20.FullScreenMaximize();

  private ButtonAppearance AskBeforeAppearance =>
    AskBeforePressed == "true" ? ButtonAppearance.Primary : ButtonAppearance.Outline;

  private ButtonAppearance AutoEditAppearance =>
    AutoEditPressed == "true" ? ButtonAppearance.Primary : ButtonAppearance.Outline;

  private string EditBehaviorLabelId => $"{Id}-edit-behavior";

  public override void Dispose()
  {
    Disposed = true;
    ReleaseAgent();
    base.Dispose();
  }
}

<div class="twe-agent-ask" data-qa="AgentAsk" data-built-mode="@(Agent is null ? null : BuiltMode.ToString())">
  <header class="twe-agent-ask__header">
    <div class="twe-agent-ask__heading">
      <h2 class="twe-agent-ask__title">Ask</h2>
      <p class="twe-agent-ask__conversation" data-qa="AskConversationTitle">@ConversationTitle</p>
      @if (ConversationExpired)
      {
        <p class="twe-agent-ask__expired" data-qa="AskConversationExpired">This conversation has expired, so page actions are refused. Choose New to start another.</p>
      }
    </div>
    <div class="twe-agent-ask__header-actions">
      <FluentButton Appearance="ButtonAppearance.Subtle"
                    IconOnly="true"
                    IconStart="@(new Icons.Regular.Size20.ChatAdd())"
                    Title="New conversation"
                    Tooltip="New conversation"
                    aria-label="New conversation"
                    data-qa="AskNewConversation"
                    OnClick="NewConversationAsync" />
      <FluentButton Appearance="ButtonAppearance.Subtle"
                    IconOnly="true"
                    IconStart="@ExpandIcon"
                    Title="@ExpandLabel"
                    Tooltip="@ExpandLabel"
                    aria-label="@ExpandLabel"
                    data-qa="AskExpand"
                    OnClick="ExpandAsync" />
      <FluentButton Appearance="ButtonAppearance.Subtle"
                    IconOnly="true"
                    IconStart="@(new Icons.Regular.Size20.Dismiss())"
                    Title="Close"
                    Tooltip="Close"
                    aria-label="Close"
                    data-qa="AgentAskClose"
                    OnClick="CloseAsync" />
    </div>
  </header>

  @if (ShowPrivacy)
  {
    <div class="twe-agent-ask__privacy" data-qa="AskPrivacyNotice">
      <p>@AgentSurfaceState.PrivacyNotice</p>
      <FluentButton Appearance="ButtonAppearance.Subtle" data-qa="AskPrivacyDismiss" OnClick="DismissPrivacyAsync">Dismiss</FluentButton>
    </div>
  }

  @if (Readiness == CatalogAgentReadiness.NotConfigured)
  {
    <p data-qa="AgentAskNotConfigured">AI not configured</p>
    <pre class="twe-agent-ask__setup" data-qa="AgentAskSetupCommand">@SetupCommand</pre>
  }
  else if (Readiness == CatalogAgentReadiness.Unauthenticated)
  {
    <p data-qa="AgentAskSignIn">Sign in to use Ask</p>
    <div class="twe-agent-ask__actions">
      <FluentButton Appearance="ButtonAppearance.Primary" data-qa="AgentAskSignInButton" OnClick="SignInAsync">Sign in</FluentButton>
    </div>
  }
  else if (Readiness == CatalogAgentReadiness.Error)
  {
    <p data-qa="AgentAskError">Ask could not load its configuration</p>
    <pre class="twe-agent-ask__setup" data-qa="AgentAskErrorDetail">@Problem</pre>
    <div class="twe-agent-ask__actions">
      <FluentButton Appearance="ButtonAppearance.Outline" data-qa="AgentAskRetry" OnClick="RetryAsync">Retry</FluentButton>
    </div>
  }
  else if (Agent is null || Conversation is null)
  {
    <p data-qa="AgentAskStarting">Starting Ask…</p>
  }
  else
  {
    @if (AskReferenceState.IsOpen)
    {
      <AskReferencePicker />
    }
    @* Mirrors ChatPage, with the panel's own AgentContext so the restored turns render. *@
    <div class="sc-ai-root sc-ai-chat-page" @key="Conversation">
      <CascadingValue Value="Conversation" IsFixed="true">
        <div class="sc-ai-chat-page__body">
          <Microsoft.AspNetCore.Components.AI.MessageList>
            <ChildContent>
              <AskStatusLine />
              <Microsoft.AspNetCore.Components.AI.BlockRenderer TBlock="Microsoft.AspNetCore.Components.AI.FunctionInvocationContentBlock" Context="call">
                <details class="twe-agent-ask__reasoning" data-qa="AskReasoning">
                  <summary>See reasoning</summary>
                  <p>@call.ToolName</p>
                  @if (AgentArgumentText.Format(call.Arguments) is { } arguments)
                  {
                    <pre data-qa="AskReasoningArguments">@arguments</pre>
                  }
                </details>
              </Microsoft.AspNetCore.Components.AI.BlockRenderer>
              <Microsoft.AspNetCore.Components.AI.BlockRenderer TBlock="Microsoft.AspNetCore.Components.AI.FunctionApprovalBlock" Context="approval">
                <div class="twe-agent-ask__approval" data-qa="AgentApproval">
                  <p>Allow <strong>@approval.ToolName</strong>?</p>
                  @if (AgentArgumentText.Format(approval.Arguments) is { } approvalArguments)
                  {
                    <pre data-qa="AgentApprovalArguments">@approvalArguments</pre>
                  }
                  @if (RecordedApproval(approval) is { } recorded)
                  {
                    <p data-qa="AgentApprovalStatus">@recorded</p>
                  }
                  else if (approval.Status == Ai.ApprovalStatus.Pending)
                  {
                    <FluentButton Appearance="ButtonAppearance.Primary" data-qa="AgentApprove" OnClick="() => approval.Approve()">Approve</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Outline" data-qa="AgentReject" OnClick="@(() => approval.Reject("Declined."))">Reject</FluentButton>
                  }
                  else
                  {
                    <p data-qa="AgentApprovalStatus">@approval.Status</p>
                  }
                </div>
              </Microsoft.AspNetCore.Components.AI.BlockRenderer>
              <AskAnswerBar SupportUrl="@AgentSurfaceState.SupportUrl" />
            </ChildContent>
            <EmptyContent>
              <div class="twe-agent-ask__welcome">
                <p class="twe-agent-ask__greeting">What should we do on this page?</p>
                <AskSuggestions Suggestions="Suggestions" />
              </div>
            </EmptyContent>
          </Microsoft.AspNetCore.Components.AI.MessageList>
        </div>
        <div class="sc-ai-chat-page__footer">
          <AskTagChips />
          <div class="sc-ai-chat-page__input-container" @onkeydown="OnComposerKeyDownAsync">
            <Microsoft.AspNetCore.Components.AI.MessageInput Placeholder="@AskPlaceholder">
              <LeadingActions>
                <div class="twe-agent-ask__lead">
                  <FluentButton Appearance="ButtonAppearance.Subtle"
                                IconStart="@(new Icons.Regular.Size20.Tag())"
                                Title="Tag an element on the page"
                                Tooltip="Tag an element on the page"
                                aria-pressed="@(Picking ? "true" : "false")"
                                Disabled="Picking"
                                data-qa="AskTag"
                                OnClick="TagAsync">Tag</FluentButton>
                </div>
              </LeadingActions>
            </Microsoft.AspNetCore.Components.AI.MessageInput>
          </div>
        </div>
      </CascadingValue>
    </div>
  }

  <footer class="twe-agent-ask__edit">
    <p class="twe-agent-ask__edit-label" id="@EditBehaviorLabelId">Edit behavior</p>
    <div class="twe-agent-ask__segments" role="group" aria-labelledby="@EditBehaviorLabelId" data-qa="AskEditMode">
      <FluentButton Appearance="@AskBeforeAppearance" Class="twe-agent-ask__segment" data-qa="AskBeforeEditing" aria-pressed="@AskBeforePressed" OnClick="AskBeforeAsync">Ask before editing</FluentButton>
      <FluentButton Appearance="@AutoEditAppearance" Class="twe-agent-ask__segment" data-qa="AskAutomaticallyEdit" aria-pressed="@AutoEditPressed" OnClick="AutoEditAsync">Automatically edit</FluentButton>
    </div>
  </footer>
</div>
