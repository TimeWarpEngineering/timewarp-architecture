@namespace TimeWarp.Architecture.Components

@code {
  [Parameter]
  public string PropertyName { get; set; } = string.Empty;

  [Parameter]
  public string? Value { get; set; }

  [Parameter]
  public string CssClass { get; set; } = "twe-prop";
}

@if (!string.IsNullOrWhiteSpace(Value))
{
  <div class="@CssClass">
    <span class="twe-prop__name">@PropertyName:</span>
    <span class="twe-prop__value">@Value</span>
  </div>
}
