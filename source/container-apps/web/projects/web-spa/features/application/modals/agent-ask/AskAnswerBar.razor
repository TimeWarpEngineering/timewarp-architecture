@namespace TimeWarp.Architecture.Features.Applications
@inherits BaseComponent
@using Ai = Microsoft.AspNetCore.Components.AI
@using TimeWarp.Architecture.Services
@attribute [DirectComponentSideEffect("Copy writes the last answer text, and Copy conversation the whole transcript, to the browser clipboard. Thumbs file feedback through SubmitFeedback.")]

@*
  Purpose: Copy, Copy conversation, feedback, and Support actions under an Ask answer.

  Design: Copy and thumbs use the same text: the last response block with raw text (LastAnswer),
  not the whole transcript. Copy conversation (task 444) walks the turns from the first and writes
  each prompt under "You:" and each reply under "{AssistantName}:", one paragraph per side,
  using the raw markdown of the rich text blocks (Transcript). A turn side with no text is skipped. Thumbs are a human SubmitFeedback, not an agent tool call, so they are
  not approval-gated. Support is hidden when configuration has no url; LoadChatConfiguration has
  already limited it to a relative path or http/https (AskSupportLink).
  The bar renders only once the conversation has an answer, so the empty state shows no Copy or
  thumbs (task 349). The bar subscribes to the conversation status: the cascade is fixed, so a
  finished turn would not otherwise re-render it.
  Feedback titles carry the assistant name (task 361): "{AssistantName} answer" and
  "{AssistantName} thumbs up/down", read from AgentSurfaceState when filed.
*@

@code {
  [System.Diagnostics.CodeAnalysis.SuppressMessage(
    "Design",
    "CA1056:URI-like properties should not be strings",
    Justification = "SupportUrl is a relative app path or an absolute href, copied as text into the anchor.")]
  [Parameter] public string? SupportUrl { get; set; }

  [CascadingParameter] private Ai.AgentContext? Conversation { get; set; }

  [Inject] private IJSRuntime JsRuntime { get; set; } = null!;

  private string NoAnswer => $"{AgentSurfaceState.AssistantName} answer";

  private IDisposable? StatusSubscription;

  protected override void OnInitialized()
  {
    base.OnInitialized();
    StatusSubscription = Conversation?.RegisterOnStatusChanged(OnStatusChanged);
  }

  private void OnStatusChanged(Ai.ConversationStatus status) => _ = InvokeAsync(StateHasChanged);

  public override void Dispose()
  {
    StatusSubscription?.Dispose();
    StatusSubscription = null;
    base.Dispose();
  }

  private async Task CopyAsync() => await AskAiJsModule.CopyTextAsync(JsRuntime, LastAnswer() ?? NoAnswer);

  private async Task CopyConversationAsync() => await AskAiJsModule.CopyTextAsync(JsRuntime, Transcript());

  private Task HelpfulAsync() => FileAsync($"{AgentSurfaceState.AssistantName} thumbs up");

  private Task UnhelpfulAsync() => FileAsync($"{AgentSurfaceState.AssistantName} thumbs down");

  private async Task FileAsync(string title)
  {
    string body = LastAnswer() ?? NoAnswer;
    if (body.Length > SubmitFeedback.MaxBodyLength)
    {
      body = body[..SubmitFeedback.MaxBodyLength];
    }

    await FeedbackState.SubmitFeedback(FeedbackKind.Other, title, body);
  }

  private string? LastAnswer()
  {
    if (Conversation is null)
    {
      return null;
    }

    for (int index = Conversation.Turns.Count - 1; index >= 0; index--)
    {
      Ai.ConversationTurn turn = Conversation.Turns[index];
      foreach (Ai.ContentBlock block in turn.ResponseBlocks)
      {
        if (block is Ai.RichContentBlock rich && !string.IsNullOrWhiteSpace(rich.RawText))
        {
          return rich.RawText;
        }
      }
    }

    return null;
  }

  private string Transcript()
  {
    if (Conversation is null)
    {
      return NoAnswer;
    }

    List<string> paragraphs = [];
    foreach (Ai.ConversationTurn turn in Conversation.Turns)
    {
      AddParagraph(paragraphs, "You", turn.RequestBlocks);
      AddParagraph(paragraphs, AgentSurfaceState.AssistantName, turn.ResponseBlocks);
    }

    return paragraphs.Count == 0 ? NoAnswer : string.Join("\n\n", paragraphs);
  }

  private static void AddParagraph(List<string> paragraphs, string speaker, IEnumerable<Ai.ContentBlock> blocks)
  {
    List<string> texts = [];
    foreach (Ai.ContentBlock block in blocks)
    {
      if (block is Ai.RichContentBlock rich && !string.IsNullOrWhiteSpace(rich.RawText))
      {
        texts.Add(rich.RawText.Trim());
      }
    }

    if (texts.Count > 0)
    {
      paragraphs.Add($"{speaker}:\n{string.Join("\n\n", texts)}");
    }
  }
}

@if (LastAnswer() is not null)
{
  <div class="twe-agent-ask__answer-bar">
    <FluentButton Appearance="ButtonAppearance.Subtle"
                  IconOnly="true"
                  IconStart="@(new Icons.Regular.Size20.Copy())"
                  Title="Copy"
                  Tooltip="Copy"
                  aria-label="Copy"
                  data-qa="AskCopy"
                  OnClick="CopyAsync" />
    <FluentButton Appearance="ButtonAppearance.Subtle"
                  IconOnly="true"
                  IconStart="@(new Icons.Regular.Size20.DocumentCopy())"
                  Title="Copy conversation"
                  Tooltip="Copy conversation"
                  aria-label="Copy conversation"
                  data-qa="AskCopyConversation"
                  OnClick="CopyConversationAsync" />
    <FluentButton Appearance="ButtonAppearance.Subtle"
                  IconOnly="true"
                  IconStart="@(new Icons.Regular.Size20.ThumbLike())"
                  Title="Thumbs up"
                  Tooltip="Thumbs up"
                  aria-label="Thumbs up"
                  data-qa="AskThumbsUp"
                  OnClick="HelpfulAsync" />
    <FluentButton Appearance="ButtonAppearance.Subtle"
                  IconOnly="true"
                  IconStart="@(new Icons.Regular.Size20.ThumbDislike())"
                  Title="Thumbs down"
                  Tooltip="Thumbs down"
                  aria-label="Thumbs down"
                  data-qa="AskThumbsDown"
                  OnClick="UnhelpfulAsync" />
    @if (!string.IsNullOrWhiteSpace(SupportUrl))
    {
      <a data-qa="AskSupport" href="@SupportUrl">Support</a>
    }
  </div>
}
