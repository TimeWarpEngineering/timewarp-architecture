@namespace TimeWarp.Architecture.Features.Applications
@inherits BaseComponent

@code
{
  public static Icon? NavIcon => new Icons.Regular.Size20.Home();
  public static string Title => "Home";
}

<TimeWarpPage Title=@ApplicationState.Name>
  <div class="twe-stack">

    <Card Title="Welcome to TimeWarp.Architecture">
      A distributed .NET reference application and project template by
      <NavLink href="https://timewarp.enterprises/" target="_blank">TimeWarp Enterprises</NavLink>.
      It demonstrates an opinionated, batteries-included architecture you can clone and build on.
    </Card>

    <Card Title="Built with">
      <ul>
        <li>.NET 10 &amp; Blazor WebAssembly</li>
        <li><NavLink href="https://github.com/microsoft/fluentui-blazor" target="_blank">FluentUI Blazor v5</NavLink> + plain CSS design tokens</li>
        <li><NavLink href="https://timewarpengineering.github.io/timewarp-state/" target="_blank">TimeWarp.State</NavLink> (Redux-style state) with Redux DevTools</li>
        <li><NavLink href="https://github.com/TimeWarpEngineering/timewarp-mediator" target="_blank">TimeWarp.Mediator</NavLink> for CQRS &amp; <NavLink href="https://fast-endpoints.com/" target="_blank">FastEndpoints</NavLink> for APIs</li>
        <li><NavLink href="https://learn.microsoft.com/dotnet/aspire/" target="_blank">.NET Aspire</NavLink> orchestration + YARP ingress</li>
      </ul>
    </Card>

    <AuthorizeView>
      <NotAuthorized>
        @* Entry only — passkey ceremony lives solely on LoginPage (/Login). Do not clone that CTA here. *@
        <Card Title="Account">
          <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <p>
              Passkey-first identity — sign in or create an account on the next screen.
            </p>
            <div>
              @* Single control — do not nest FluentButton inside NavLink (invalid HTML). *@
              <FluentButton Appearance="ButtonAppearance.Primary" OnClick="GoToLoginAsync">
                Sign in
              </FluentButton>
            </div>
          </FluentStack>
        </Card>
      </NotAuthorized>
      <Authorized>
        <Card Title="Signed in">
          <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
            <FluentAvatar Image=@ProfileState.Avatar Name=@ProfileState.Alias Size="AvatarSize.Size32" />
            <FluentText>@ProfileState.Alias</FluentText>
            <FluentSpacer />
            <NavLink href=@SettingsPage.GetPageUrl()>Settings</NavLink>
            <AuthorizeView Policy=@Policies.CanViewAdminSidebarNavSection Context="adminAuth">
              <Authorized Context="adminAuth">
                <NavLink href=@RolesListPage.GetPageUrl()>Admin</NavLink>
              </Authorized>
            </AuthorizeView>
          </FluentStack>
        </Card>
      </Authorized>
    </AuthorizeView>

  </div>
</TimeWarpPage>
