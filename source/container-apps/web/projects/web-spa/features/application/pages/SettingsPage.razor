@namespace TimeWarp.Architecture.Features.Applications
@inherits BaseComponent
@using TimeWarp.Architecture.Features.Identity
@using TimeWarp.Architecture.Services
@using Microsoft.AspNetCore.Components.Authorization

@code {
  public static string Title => "Settings";
  public static Icon? NavIcon => new Icons.Regular.Size20.Settings();

  [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
  [Inject] private IActionCatalog ActionCatalog { get; set; } = null!;
  [Inject] private CommandPaletteContext PaletteContext { get; set; } = null!;
  // TimeWarpStateComponent keeps its Store private; the offer runner needs the circuit/tab store.
  [Inject] private IStore ScopedStore { get; set; } = null!;

  private string? AccountFingerprint;

  private bool IsBusy => ActionTrackingState.IsActive;
  private IReadOnlyList<GetCredentials.CredentialSummary> Passkeys => CredentialsState.ActivePasskeys;
  private IReadOnlyList<GetCredentials.CredentialSummary> EntraAccounts => CredentialsState.ActiveEntraAccounts;
  private bool ShowMicrosoft365 => SignInState.Microsoft365Offered;
  private bool IsLinkMicrosoft365Offered => CredentialsState.IsOffered(OfferedActionNames.LinkMicrosoft365, credentialId: null);

  private bool IsRevokeOffered(GetCredentials.CredentialSummary credential) =>
    CredentialsState.IsOffered(RevokeCredential.OfferName, credential.Id.Value);

  private bool IsRenameOffered(GetCredentials.CredentialSummary credential) =>
    CredentialsState.IsOffered(RenameCredential.OfferName, credential.Id.Value);

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    await NoSubSignInState.FetchMicrosoft365Offered();
    await NoSubCredentialsState.FetchCredentials();
    if (RendererInfo.IsInteractive)
    {
      await NoSubSiteSettingsState.FetchSiteSettings();
    }
  }

  protected override async Task OnParametersSetAsync()
  {
    await base.OnParametersSetAsync();
    AccountFingerprint = AuthenticationStateTask is null
      ? null
      : (await AuthenticationStateTask).User
        .FindFirst(IdentitySessionAuthenticationStateProvider.AccountFingerprintClaimType)?.Value;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    await base.OnAfterRenderAsync(firstRender);
    if (firstRender && RendererInfo.IsInteractive && CredentialsState.Credentials is null)
    {
      await NoSubCredentialsState.FetchCredentials();
      if (!SiteSettingsState.HasSnapshot)
      {
        await NoSubSiteSettingsState.FetchSiteSettings();
      }

      await InvokeAsync(StateHasChanged);
    }
  }

  private async Task CreatePasskeyAsync()
  {
    await NoSubCredentialsState.AddPasskey();
    await FetchCredentialsIfCeremonySucceeded();
  }

  private async Task AddExistingPasskeyAsync()
  {
    await NoSubCredentialsState.AddExistingPasskey();
    await FetchCredentialsIfCeremonySucceeded();
  }

  private async Task FetchCredentialsIfCeremonySucceeded()
  {
    if (CredentialsState.CeremonyFailed)
    {
      return;
    }

    await NoSubCredentialsState.FetchCredentials();
  }

  // Offered actions run through the catalog; the runner refreshes FetchCredentials afterwards.
  private Task ConfirmRevokeAsync(GetCredentials.CredentialSummary credential) =>
    RunOfferAsync(RevokeCredential.OfferName, credential.Id.Value, input: null);

  private Task RenameAsync(CredentialRename rename) =>
    RunOfferAsync(RenameCredential.OfferName, rename.CredentialId, CredentialOfferRows.NicknameInput(rename.Nickname));

  private Task CancelPendingNicknameAsync() => NoSubCredentialsState.ClearPendingNickname();

  private Task LinkMicrosoft365Async() =>
    RunOfferAsync(OfferedActionNames.LinkMicrosoft365, credentialId: null, input: null);

  private Task RunOfferAsync(string name, Guid? credentialId, IReadOnlyDictionary<string, System.Text.Json.JsonElement>? input) =>
    CredentialOfferRows.RunAsync(name, credentialId, input, ScopedStore, ActionCatalog, PaletteContext, CancellationToken);
}

<TimeWarpPage Title="Settings">
  <div class="twe-stack">

    @if (AccountFingerprint is not null)
    {
      <FluentText data-qa="SignedInAccount">Signed in · @PasskeyAccountName.Format(AccountFingerprint)</FluentText>
    }

    <Section Title="Passkeys" LoadingActionType="typeof(CredentialsState.FetchCredentialsActionSet.Action)">
      <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <CredentialList Credentials="Passkeys"
                        IsBusy="IsBusy"
                        EmptyMessage="No passkeys on this account yet."
                        FallbackLabel="Passkey"
                        RevokeLabel="Revoke"
                        RevokeDataQa="RevokePasskey"
                        IsRevokeOffered="IsRevokeOffered"
                        IsRenameOffered="IsRenameOffered"
                        RevokeDisabledHint="Add another passkey or agent key before revoking this one."
                        RevokeDisabledHintDataQa="RevokePasskeyHint"
                        OnRevoke="ConfirmRevokeAsync"
                        OnRename="RenameAsync"
                        OnRenameCancel="CancelPendingNicknameAsync"
                        PendingRenameCredentialId="CredentialsState.PendingListRenameCredentialId"
                        PendingRenameDefault="CredentialsState.PendingNicknameDefault" />
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true">
          <FluentButton Appearance="ButtonAppearance.Primary"
                        data-qa="CreatePasskey"
                        Disabled="@IsBusy"
                        OnClick="CreatePasskeyAsync">
            Create a passkey
          </FluentButton>
          <FluentButton Appearance="ButtonAppearance.Outline"
                        data-qa="AddExistingPasskey"
                        Disabled="@IsBusy"
                        OnClick="AddExistingPasskeyAsync">
            Add an existing passkey
          </FluentButton>
        </FluentStack>
      </FluentStack>
    </Section>

    @if (ShowMicrosoft365)
    {
      <Section Title="Microsoft 365"
            LoadingActionType="typeof(CredentialsState.FetchCredentialsActionSet.Action)"
            data-qa="Microsoft365Settings">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
          <CredentialList Credentials="EntraAccounts"
                          IsBusy="IsBusy"
                          EmptyMessage="No Microsoft 365 account linked."
                          FallbackLabel="Microsoft 365"
                          TitleDataQa="Microsoft365AccountLabel"
                          RevokeLabel="Unlink"
                          RevokeDataQa="Unlink"
                          IsRevokeOffered="IsRevokeOffered"
                          IsRenameOffered="IsRenameOffered"
                          RevokeDisabledHint="Add a passkey first"
                          RevokeDisabledHintDataQa="UnlinkMicrosoft365Hint"
                          OnRevoke="ConfirmRevokeAsync"
                          OnRename="RenameAsync" />
          @if (IsLinkMicrosoft365Offered)
          {
            <FluentButton Appearance="ButtonAppearance.Primary"
                          data-qa="LinkMicrosoft365"
                          Disabled="@IsBusy"
                          OnClick="LinkMicrosoft365Async">
              Link Microsoft 365
            </FluentButton>
          }
        </FluentStack>
      </Section>
    }

  </div>
</TimeWarpPage>
