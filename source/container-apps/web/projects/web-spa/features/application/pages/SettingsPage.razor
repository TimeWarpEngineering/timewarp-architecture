@namespace TimeWarp.Architecture.Features.Applications
@inherits BaseComponent
@using TimeWarp.Architecture.Features.Identity
@using TimeWarp.Architecture.Services

@code {
  public static string Title => "Settings";
  public static Icon? NavIcon => new Icons.Regular.Size20.Settings();

  [Inject] private NavigationManager NavigationManager { get; set; } = null!;
  [Inject] private IWebServerApiService WebServerApiService { get; set; } = null!;

  private bool ShowMicrosoft365;

  private bool IsBusy => ActionTrackingState.IsActive;
  private IReadOnlyList<GetCredentials.CredentialSummary> Passkeys => CredentialsState.ActivePasskeys;
  private IReadOnlyList<GetCredentials.CredentialSummary> EntraAccounts => CredentialsState.ActiveEntraAccounts;
  private bool CanLinkMicrosoft365 => ShowMicrosoft365 && EntraAccounts.Count == 0;
  private bool CanUnlink => CredentialsState.ActiveCredentialCount > 1;
  private string Microsoft365CardTitle =>
    EntraAccounts.Count == 1 ? DisplayEntraLabel(EntraAccounts[0]) : "Microsoft 365";

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    ShowMicrosoft365 = await LoadEntraOfferedAsync();
    await NoSubCredentialsState.FetchCredentials();
    if (RendererInfo.IsInteractive)
    {
      await NoSubSiteSettingsState.FetchSiteSettings();
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    await base.OnAfterRenderAsync(firstRender);
    if (firstRender && RendererInfo.IsInteractive && CredentialsState.Credentials is null)
    {
      await NoSubCredentialsState.FetchCredentials();
      if (!SiteSettingsState.HasSnapshot)
      {
        await NoSubSiteSettingsState.FetchSiteSettings();
      }

      await InvokeAsync(StateHasChanged);
    }
  }

  private static string DisplayEntraLabel(GetCredentials.CredentialSummary credential) =>
    string.IsNullOrWhiteSpace(credential.Label) ? "Microsoft 365" : credential.Label!;

  private async Task CreatePasskeyAsync()
  {
    await NoSubCredentialsState.AddPasskey();
    await FetchCredentialsIfCeremonySucceeded();
  }

  private async Task AddExistingPasskeyAsync()
  {
    await NoSubCredentialsState.AddExistingPasskey();
    await FetchCredentialsIfCeremonySucceeded();
  }

  private async Task FetchCredentialsIfCeremonySucceeded()
  {
    if (CredentialsState.CeremonyFailed)
    {
      return;
    }

    await NoSubCredentialsState.FetchCredentials();
  }

  private async Task ConfirmRevokeAsync(GetCredentials.CredentialSummary credential)
  {
    await NoSubCredentialsState.RevokeCredential(credential.Id.Value);
    await NoSubCredentialsState.FetchCredentials();
  }

  private async Task<bool> LoadEntraOfferedAsync()
  {
    try
    {
      OneOf<GetEntraSignInOffered.Response, FileResponse, SharedProblemDetails> result =
        await WebServerApiService.GetResponse<GetEntraSignInOffered.Response>(
          new GetEntraSignInOffered.Query(),
          CancellationToken.None);
      return result.TryPickT0(out GetEntraSignInOffered.Response response, out _)
        && response.Offered;
    }
    catch (Exception)
    {
      return false;
    }
  }

  private void LinkMicrosoft365()
  {
    NavigationManager.NavigateTo(
      ChallengeEntra.GetRoute("link", "/Settings"),
      forceLoad: true);
  }
}

<TimeWarpPage Title="Settings">
  <div class="twe-stack">

    <Section Title="Passkeys" LoadingActionType="typeof(CredentialsState.FetchCredentialsActionSet.Action)">
      <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <CredentialList Credentials="Passkeys"
                        IsBusy="IsBusy"
                        EmptyMessage="No passkeys on this account yet."
                        FallbackLabel="Passkey"
                        DeleteLabel="Delete"
                        DeleteDataQa="DeletePasskey"
                        OnDelete="ConfirmRevokeAsync" />
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true">
          <FluentButton Appearance="ButtonAppearance.Primary"
                        data-qa="CreatePasskey"
                        Disabled="@IsBusy"
                        OnClick="CreatePasskeyAsync">
            Create a passkey
          </FluentButton>
          <FluentButton Appearance="ButtonAppearance.Outline"
                        data-qa="AddExistingPasskey"
                        Disabled="@IsBusy"
                        OnClick="AddExistingPasskeyAsync">
            Add an existing passkey
          </FluentButton>
        </FluentStack>
      </FluentStack>
    </Section>

    @if (ShowMicrosoft365)
    {
      <Section Title="@Microsoft365CardTitle"
            TitleDataQa="@(EntraAccounts.Count == 1 ? "Microsoft365AccountLabel" : null)"
            LoadingActionType="typeof(CredentialsState.FetchCredentialsActionSet.Action)"
            data-qa="Microsoft365Settings">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
          <CredentialList Credentials="EntraAccounts"
                          IsBusy="IsBusy"
                          EmptyMessage="No Microsoft 365 account linked."
                          FallbackLabel="Microsoft 365"
                          Subtitle="Microsoft 365"
                          TitleDataQa="Microsoft365AccountLabel"
                          DeleteLabel="Unlink"
                          DeleteDataQa="Unlink"
                          DeleteDisabled="@(!CanUnlink)"
                          DeleteDisabledHint="Add a passkey first"
                          DeleteDisabledHintDataQa="UnlinkMicrosoft365Hint"
                          OnDelete="ConfirmRevokeAsync" />
          @if (CanLinkMicrosoft365)
          {
            <FluentButton Appearance="ButtonAppearance.Primary"
                          data-qa="LinkMicrosoft365"
                          Disabled="@IsBusy"
                          OnClick="LinkMicrosoft365">
              Link Microsoft 365
            </FluentButton>
          }
        </FluentStack>
      </Section>
    }

  </div>
</TimeWarpPage>
