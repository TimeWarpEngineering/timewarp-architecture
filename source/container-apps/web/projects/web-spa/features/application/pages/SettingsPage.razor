@namespace TimeWarp.Architecture.Features.Applications
@inherits BaseComponent
@using Microsoft.Extensions.Configuration
@using TimeWarp.Architecture.Features.Identity
@using TimeWarp.Architecture.Services
@using TimeWarp.Identity

@code {
  public static string Title => "Settings";
  public static Icon? NavIcon => new Icons.Regular.Size20.Settings();

  [Inject] private IConfiguration Configuration { get; set; } = null!;
  [Inject] private NavigationManager NavigationManager { get; set; } = null!;

  private Guid? ExpandedId;
  private bool ShowMicrosoft365;
  private bool DraftEntraSignInEnabled;
  private bool DraftEntraAllowBootstrap;
  private string DraftTrustedTenantsText = "";
  private PasskeyPromptMode DraftPasskeyPromptMode = PasskeyPromptMode.Soft;
  private bool DraftLoaded;
  private bool CanWriteSettings;

  private bool IsLoading =>
    IsAnyActive(typeof(CredentialsState.FetchCredentialsActionSet.Action));
  private bool IsBusy => ActionTrackingState.IsActive;
  private IReadOnlyList<GetCredentials.CredentialSummary> Passkeys => CredentialsState.ActivePasskeys;
  private IReadOnlyList<GetCredentials.CredentialSummary> EntraAccounts => CredentialsState.ActiveEntraAccounts;
  private string? ErrorMessage => CredentialsState.CeremonyError;
  private string? StatusMessage => CredentialsState.StatusMessage;

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    AuthenticationState authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    CanWriteSettings = authenticationState.User.HasClaim(PermissionIds.ClaimType, PermissionIds.SettingsWrite);
    ShowMicrosoft365 = MockAuthenticationDefaults.IsEntraEnabled(
      Configuration[MockAuthenticationDefaults.EntraEnabledKey],
      Configuration[MockAuthenticationDefaults.UseEntraKey]);
    if (RendererInfo.IsInteractive)
    {
      await NoSubCredentialsState.FetchCredentials();
      await NoSubSiteSettingsState.FetchSiteSettings();
      SyncDraftFromState();
      SyncExpandedId();
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    await base.OnAfterRenderAsync(firstRender);
    if (firstRender && RendererInfo.IsInteractive && CredentialsState.Credentials is null)
    {
      await NoSubCredentialsState.FetchCredentials();
      if (!SiteSettingsState.HasSnapshot)
      {
        await NoSubSiteSettingsState.FetchSiteSettings();
      }

      SyncDraftFromState();
      SyncExpandedId();
      await InvokeAsync(StateHasChanged);
    }
  }

  private void ToggleExpanded(Guid id) =>
    ExpandedId = ExpandedId == id ? null : id;

  private static string DisplayLabel(GetCredentials.CredentialSummary credential) =>
    string.IsNullOrWhiteSpace(credential.Label) ? "Passkey" : credential.Label!;

  private async Task CreatePasskeyAsync()
  {
    await NoSubCredentialsState.AddPasskey();
    if (CredentialsState.LastAddedCredentialId is Guid added)
    {
      ExpandedId = added;
    }
    else
    {
      SyncExpandedId();
    }
  }

  private async Task ConfirmRevokeAsync(GetCredentials.CredentialSummary credential)
  {
    await NoSubCredentialsState.RevokeCredential(credential.Id.Value);
    SyncExpandedId();
  }

  private void LinkMicrosoft365()
  {
    NavigationManager.NavigateTo(
      ChallengeEntra.GetRoute("link", "/Settings"),
      forceLoad: true);
  }

  private static string DisplayEntraLabel(GetCredentials.CredentialSummary credential) =>
    string.IsNullOrWhiteSpace(credential.Label) ? "Microsoft 365" : credential.Label!;

  private void SyncDraftFromState()
  {
    if (!SiteSettingsState.HasSnapshot)
    {
      return;
    }

    DraftEntraSignInEnabled = SiteSettingsState.EntraSignInEnabled is true;
    DraftEntraAllowBootstrap = SiteSettingsState.EntraAllowBootstrap is true;
    DraftTrustedTenantsText = string.Join(Environment.NewLine, SiteSettingsState.EntraTrustedTenants);
    DraftPasskeyPromptMode = SiteSettingsState.PasskeyPromptMode;
    DraftLoaded = true;
  }

  private async Task SaveAuthenticationAsync()
  {
    List<string> tenants = [];
    foreach (string line in DraftTrustedTenantsText.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
    {
      tenants.Add(line);
    }

    await NoSubSiteSettingsState.UpdateSiteSettings(
      new UpdateSiteSettings.Command
      {
        EntraSignInEnabled = DraftEntraSignInEnabled,
        EntraAllowBootstrap = DraftEntraAllowBootstrap,
        EntraTrustedTenants = tenants,
        PasskeyPromptMode = DraftPasskeyPromptMode,
        Version = SiteSettingsState.Version
      });
    if (string.IsNullOrEmpty(SiteSettingsState.SaveError))
    {
      SyncDraftFromState();
    }
  }

  private void SyncExpandedId()
  {
    if (Passkeys.Count == 0)
    {
      ExpandedId = null;
      return;
    }

    if (ExpandedId is Guid id && Passkeys.All(c => c.Id.Value != id))
    {
      ExpandedId = Passkeys[0].Id.Value;
    }
    else if (ExpandedId is null)
    {
      ExpandedId = Passkeys[0].Id.Value;
    }
  }
}

<TimeWarpPage Title="Settings">
  <div class="twe-stack twe-settings">

    <section class="twe-settings__section">
      <h2 class="twe-settings__heading">Passkeys</h2>

      @if (IsLoading)
      {
        <p class="twe-settings__muted">Loading…</p>
      }
      else if (Passkeys.Count == 0)
      {
        <p class="twe-settings__muted">No passkeys on this account yet.</p>
      }
      else
      {
        <ul class="twe-settings__cred-list">
          @foreach (GetCredentials.CredentialSummary credential in Passkeys)
          {
            bool expanded = ExpandedId == credential.Id.Value;
            <li class="twe-settings__cred">
              <button type="button"
                      class="@(expanded ? "twe-settings__cred-toggle twe-settings__cred-toggle--open" : "twe-settings__cred-toggle")"
                      @onclick="() => ToggleExpanded(credential.Id.Value)"
                      disabled="@IsBusy">
                <span class="twe-settings__cred-label">@DisplayLabel(credential)</span>
                <span class="twe-settings__cred-chevron" aria-hidden="true">@(expanded ? "▾" : "▸")</span>
              </button>

              @if (expanded)
              {
                <div class="twe-settings__cred-body">
                  <div class="twe-settings__field">
                    <div class="twe-settings__field-title">Delete passkey</div>
                    <p class="twe-settings__muted">Delete this passkey from your account.</p>
                    <button type="button"
                            class="twe-settings__link twe-settings__link--danger"
                            disabled="@IsBusy"
                            @onclick="() => ConfirmRevokeAsync(credential)">
                      Delete
                    </button>
                  </div>

                  <div class="twe-settings__field">
                    <div class="twe-settings__field-title">Created at</div>
                    <p class="twe-settings__value">@credential.CreatedAt.ToLocalTime().ToString("M/d/yyyy, h:mm:ss tt")</p>
                  </div>
                </div>
              }
            </li>
          }
        </ul>
      }

      <div class="twe-settings__actions">
        <button type="button"
                class="twe-settings__link"
                data-qa="CreatePasskeyOnAccount"
                disabled="@IsBusy"
                @onclick="CreatePasskeyAsync">
          Create a passkey
        </button>
      </div>
    </section>

    @if (ShowMicrosoft365)
    {
      <section class="twe-settings__section">
        <h2 class="twe-settings__heading">Microsoft 365</h2>

        @if (IsLoading)
        {
          <p class="twe-settings__muted">Loading…</p>
        }
        else if (EntraAccounts.Count == 0)
        {
          <p class="twe-settings__muted">No Microsoft 365 account linked.</p>
        }
        else
        {
          <ul class="twe-settings__cred-list">
            @foreach (GetCredentials.CredentialSummary credential in EntraAccounts)
            {
              <li class="twe-settings__cred">
                <div class="twe-settings__cred-body">
                  <div class="twe-settings__field">
                    <div class="twe-settings__field-title">@DisplayEntraLabel(credential)</div>
                    <p class="twe-settings__value">@credential.CreatedAt.ToLocalTime().ToString("M/d/yyyy, h:mm:ss tt")</p>
                    <button type="button"
                            class="twe-settings__link twe-settings__link--danger"
                            disabled="@IsBusy"
                            @onclick="() => ConfirmRevokeAsync(credential)">
                      Unlink
                    </button>
                  </div>
                </div>
              </li>
            }
          </ul>
        }

        @if (SiteSettingsState.EntraSignInEnabled is true)
        {
          <div class="twe-settings__actions">
            <button type="button"
                    class="twe-settings__link"
                    data-qa="LinkMicrosoft365"
                    disabled="@IsBusy"
                    @onclick="LinkMicrosoft365">
              Link Microsoft 365
            </button>
          </div>
        }
      </section>
    }

    @if (DraftLoaded)
    {
      <section class="twe-settings__section" data-qa="AuthenticationSettings">
        <h2 class="twe-settings__heading">Authentication</h2>
        <p class="twe-settings__muted">
          Configuration still registers the Microsoft 365 scheme. These settings decide whether users may use it.
        </p>

        <div class="twe-settings__field">
          <label class="twe-settings__field-title">
            <input type="checkbox"
                   disabled="@(!CanWriteSettings || IsBusy)"
                   @bind="DraftEntraSignInEnabled" />
            Offer Microsoft 365 sign-in
          </label>
        </div>

        <div class="twe-settings__field">
          <label class="twe-settings__field-title">
            <input type="checkbox"
                   disabled="@(!CanWriteSettings || IsBusy)"
                   @bind="DraftEntraAllowBootstrap" />
            Allow first-time Microsoft 365 bootstrap
          </label>
        </div>

        <div class="twe-settings__field">
          <div class="twe-settings__field-title">Trusted tenants</div>
          <p class="twe-settings__muted">One tenant GUID per line. Empty refuses bootstrap and sync-hit.</p>
          <textarea class="twe-settings__textarea"
                    rows="4"
                    disabled="@(!CanWriteSettings || IsBusy)"
                    @bind="DraftTrustedTenantsText"></textarea>
        </div>

        <div class="twe-settings__field">
          <div class="twe-settings__field-title">Passkey prompt</div>
          <select class="twe-settings__select"
                  disabled="@(!CanWriteSettings || IsBusy)"
                  @bind="DraftPasskeyPromptMode">
            <option value="@PasskeyPromptMode.Soft">Soft (dismissible banner)</option>
            <option value="@PasskeyPromptMode.Required">Required (block app until a passkey is added)</option>
          </select>
        </div>

        @if (!string.IsNullOrEmpty(SiteSettingsState.SaveError))
        {
          <FluentMessageBar Intent="MessageBarIntent.Error" Title="Could not save" AllowDismiss="false">
            @SiteSettingsState.SaveError
          </FluentMessageBar>
        }

        @if (CanWriteSettings)
        {
          <div class="twe-settings__actions">
            <button type="button"
                    class="twe-settings__link"
                    data-qa="SaveAuthenticationSettings"
                    disabled="@IsBusy"
                    @onclick="SaveAuthenticationAsync">
              Save authentication settings
            </button>
          </div>
        }
      </section>
    }

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
      <FluentMessageBar Intent="MessageBarIntent.Success" Title="Success" AllowDismiss="false">
        @StatusMessage
      </FluentMessageBar>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
      <FluentMessageBar Intent="MessageBarIntent.Error" Title="Error" AllowDismiss="false">
        @ErrorMessage
      </FluentMessageBar>
    }

  </div>
</TimeWarpPage>

<style>
  @(@"
    .twe-settings__section + .twe-settings__section {
      margin-top: 24px;
    }
    .twe-settings__heading {
      margin: 0 0 12px;
      font-size: var(--twe-text-section-title);
      font-weight: 700;
      color: var(--twe-ink);
    }
    .twe-settings__muted {
      margin: 0;
      color: var(--twe-muted);
      font-size: var(--twe-text-body);
    }
    .twe-settings__value {
      margin: 4px 0 0;
      color: var(--twe-ink);
      font-size: var(--twe-text-body);
    }
    .twe-settings__cred-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .twe-settings__cred-toggle {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 14px;
      border: none;
      border-radius: var(--twe-radius-sm);
      background: var(--twe-paper-2);
      color: var(--twe-ink);
      font: inherit;
      font-weight: 600;
      cursor: pointer;
      text-align: left;
    }
    .twe-settings__cred-toggle--open {
      background: var(--twe-blue);
      color: #fff;
    }
    .twe-settings__cred-chevron {
      opacity: 0.85;
    }
    .twe-settings__cred-body {
      padding: 12px 4px 8px 8px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .twe-settings__field-title {
      font-weight: 600;
      color: var(--twe-ink);
      font-size: var(--twe-text-body);
    }
    .twe-settings__link {
      background: none;
      border: none;
      padding: 0;
      color: var(--twe-blue);
      font: inherit;
      cursor: pointer;
      text-decoration: none;
    }
    .twe-settings__link:hover { text-decoration: underline; }
    .twe-settings__link:disabled { opacity: 0.5; cursor: not-allowed; }
    .twe-settings__link--danger { color: var(--twe-danger); }
    .twe-settings__actions {
      margin-top: 16px;
      padding-top: 12px;
      border-top: 1px solid var(--twe-rule);
    }
    .twe-settings__textarea,
    .twe-settings__select {
      width: 100%;
      margin-top: 8px;
      padding: 8px 10px;
      border: 1px solid var(--twe-rule);
      border-radius: var(--twe-radius-sm);
      background: var(--twe-paper-2);
      color: var(--twe-ink);
      font: inherit;
    }
  ")
</style>
