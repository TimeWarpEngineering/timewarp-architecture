@namespace TimeWarp.Architecture.Features.Identity
@inherits BaseComponent

@code {
  protected override bool ShouldRender()
  {
    // This component should only render once. Given there is no UX.
    return false;
  }

  protected override async Task OnInitializedAsync()
  {
    AuthenticationStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;
    AuthenticationState authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    await HandleUserAuthentication(authenticationState.User);
    // Task 361: the assistant's name and avatar are public and the same for every session, so they
    // load once per app, signed in or not. After the identity work and next to the task-293 probe,
    // so a slow identity call never delays sign-in-dependent UI to show a label.
    await NoSubAgentSurfaceState.LoadAssistantIdentity();
  }

  private async void HandleAuthenticationStateChanged(Task<AuthenticationState> task)
  {
    AuthenticationState authenticationState = await task;
    await HandleUserAuthentication(authenticationState.User);
  }

  private async Task HandleUserAuthentication(ClaimsPrincipal user)
  {
    // Task 345: the Ask @ picker's types and chosen references belong to the principal; drop them
    // when it changes so a sign-out or a different sign-in never sees the previous user's labels.
    await NoSubAskReferenceState.SessionChanged(AskReferenceState.PrincipalIdOf(user));
    // Task 346: the same for Ask's tag chips and sent tags.
    await NoSubAskTagState.SessionChanged(AskReferenceState.PrincipalIdOf(user));

    if (user.Identity?.IsAuthenticated == true)
    {
      await NoSubProfileState.FetchProfileData();
      await NoSubCredentialsState.FetchCredentials();
      await NoSubSiteSettingsState.FetchSiteSettings();
    }
    else
    {
      await NoSubProfileState.ClearProfileData();
      await NoSubAuthorizationState.ClearCurrentUser();
      await NoSubCredentialsState.ClearCredentials();
      await NoSubSiteSettingsState.ClearSiteSettings();
      await ClearPasskeySoftPromptLaterAsync();
    }

    // Offered methods are public and the shell's passkey gate reads them signed in or out.
    await NoSubSignInState.FetchOfferedSignInMethods();

    // Task 293: Ask's readiness depends on the session, so re-read it on every change. An in-app
    // sign-in navigates without a page load; a once-per-app probe kept the signed-out 401. Last, so
    // the probe never delays or cuts short the identity work above.
    await NoSubAgentSurfaceState.LoadChatConfiguration();
  }

  private async Task ClearPasskeySoftPromptLaterAsync()
  {
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    await NoSubCredentialsState.ForgetPasskeySoftPromptLater();
  }

  public override void Dispose()
  {
    // Unsubscribe to avoid memory leaks
    AuthenticationStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
    base.Dispose();
    GC.SuppressFinalize(this);
  }
}
