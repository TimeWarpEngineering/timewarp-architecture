@namespace TimeWarp.Architecture.Features.Identity

@*
  Purpose: The login card's actions for the methods the server currently offers.

  Design: Buttons follow SignInMethod declaration order. Passkey, when offered, is the primary
  button and keeps account creation. Microsoft 365 is outline beside passkey and primary when it
  is the only method. A completed empty list is the work-account lead plus the unavailable line
  and no buttons. Null (not loaded, or the read failed) paints nothing. This component does not
  dispatch. Copy is generic; no product or client name.
*@

@code {
  [Parameter] public IReadOnlyList<SignInMethod>? Methods { get; set; }

  [Parameter] public bool IsBusy { get; set; }

  [Parameter] public EventCallback<MouseEventArgs> OnPasskey { get; set; }

  [Parameter] public EventCallback<MouseEventArgs> OnCreateAccount { get; set; }

  [Parameter] public EventCallback<MouseEventArgs> OnMicrosoft365 { get; set; }

  private bool Loaded => Methods is not null;

  private bool Passkey => Methods?.Contains(SignInMethod.Passkey) == true;

  private bool Microsoft365 => Methods?.Contains(SignInMethod.Microsoft365) == true;

  private bool WorkAccountLead => Loaded && !Passkey;
}

@if (Loaded)
{
  <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    @if (WorkAccountLead)
    {
      <p class="twe-login-lead" data-qa="SignInLead">@SignInCopy.WorkAccountLead</p>
    }

    @if (Passkey)
    {
      <FluentButton Appearance="ButtonAppearance.Primary"
                    data-qa="ContinueWithPasskey"
                    Disabled="IsBusy"
                    OnClick="OnPasskey">
        Sign in with a passkey
      </FluentButton>
    }

    @if (Microsoft365)
    {
      <FluentButton Appearance="@(Passkey ? ButtonAppearance.Outline : ButtonAppearance.Primary)"
                    data-qa="ContinueWithMicrosoft365"
                    Disabled="IsBusy"
                    OnClick="OnMicrosoft365">
        Continue with Microsoft 365
      </FluentButton>
    }
    else if (WorkAccountLead)
    {
      <p class="twe-login-lead" data-qa="Microsoft365Unavailable">@SignInCopy.Microsoft365UnavailableMessage</p>
    }

    @if (Passkey)
    {
      <hr class="twe-login-divider" />

      <p class="twe-login-create">
        Don't have an account?
        <FluentButton Appearance="ButtonAppearance.Outline"
                      data-qa="CreatePasskey"
                      Disabled="IsBusy"
                      OnClick="OnCreateAccount">
          Create account
        </FluentButton>
      </p>
    }
  </FluentStack>
}
