@namespace TimeWarp.Architecture.Features.Identity
@inherits BaseComponent

@*
  Purpose: Shared passkey / agent-key / Entra credential list with inline rename and a restating
  revoke confirmation.

  Design: Presentational — callers pass the snapshot and callbacks. One Card-free list so
  Settings and PasskeysPage do not duplicate row markup. Loading belongs on the parent Section,
  not this list. Row (task 248-001): title = nickname → provider → fallback
  (CredentialRowPresenter), context line = account hint · provider · attachment · browser/OS with
  any part that repeats the title dropped (task 250 — an Entra row reads "Microsoft 365" /
  "steve@contoso.com", never the label twice) and the <p> omitted when nothing is left; no
  caller-supplied subtitle (the card heading already names the provider), created, last used
  ("Last used <relative>" / "Never used", task 248-002 — the one signal for "is this the passkey I
  actually use"; the component passes UtcNow so the presenter's buckets stay pure), and the
  8-hex fingerprint in monospace. Rename opens an inline editor in place of the title (draft
  prefilled with the current nickname or provider); Save raises OnRename and the caller
  dispatches RenameCredential then FetchCredentials. PendingRenameCredentialId auto-opens that
  editor for a just-added row with PendingRenameDefault (the provider name) as the prefill —
  the "name your new passkey" prompt; Cancel on an auto-opened editor raises OnRenameCancel so
  the caller clears the pending state. Save on an auto-opened editor keeps it open (Save is disabled
  by IsBusy while the rename is in flight) and it closes only when the pending id clears on
  success — so a failed rename leaves the user's draft in place instead of reopening with the
  provider name (review M3). A manually opened editor closes on Save; a failure there is reported
  by the shell region and the user reopens it.
  Task 246: the row action is "Revoke" (server RevokeCredential + LastCredential 409 title
  agree; the old "Delete" wording was the odd one out). Callers set RevokeDisabled +
  RevokeDisabledHint when the row is the last active credential of ANY kind
  (CredentialsState.ActiveCredentialCount mirrors the handler count); the hint renders as
  visible text under the button, never a tooltip alone. The server guard remains the
  authority — this is courtesy for the honest client. Default RevokeDataQa is RevokePasskey
  (renamed from the old data-qa: no test or e2e referenced it, so agreement won over stability).
  Revoke is two-step (248-001): the danger button opens a confirmation block that restates
  nickname, provider, created, last used (248-002) and fingerprint; only Confirm raises OnRevoke. RevokeDisabled
  gates BOTH steps (the first button and the Confirm button), so a last credential can never
  reach the callback from either. Outcomes (success/failure) are reported by the state
  handlers to the shell notification region — this component renders no outcome bars (task 247
  rule 1). Destructive actions are Outline + twe-button-danger (style-guide appearance,
  --twe-danger). StatusBadge marks active credentials. Native root so isolation styles muted
  text and row layout. Editor/confirm ids are component-local UI state (not product data), so
  they stay out of CredentialsState.
*@

@code {
  [Parameter] public IReadOnlyList<GetCredentials.CredentialSummary> Credentials { get; set; } = [];
  [Parameter] public bool IsBusy { get; set; }
  [Parameter] public string EmptyMessage { get; set; } = "No credentials yet.";
  [Parameter] public string FallbackLabel { get; set; } = "Passkey";
  [Parameter] public string? TitleDataQa { get; set; }
  [Parameter] public string RevokeLabel { get; set; } = "Revoke";
  [Parameter] public string RevokeDataQa { get; set; } = "RevokePasskey";
  [Parameter] public bool RevokeDisabled { get; set; }
  [Parameter] public string? RevokeDisabledHint { get; set; }
  [Parameter] public string? RevokeDisabledHintDataQa { get; set; }
  [Parameter] public EventCallback<GetCredentials.CredentialSummary> OnRevoke { get; set; }
  [Parameter] public EventCallback<CredentialRename> OnRename { get; set; }
  [Parameter] public EventCallback OnRenameCancel { get; set; }
  [Parameter] public Guid? PendingRenameCredentialId { get; set; }
  [Parameter] public string? PendingRenameDefault { get; set; }

  private Guid? EditingId;
  private Guid? AutoOpenedId;
  private Guid? ConfirmingId;
  private string Draft = string.Empty;

  private bool CanClickRevoke => !IsBusy && !RevokeDisabled;
  private bool CanSaveRename => !IsBusy && Draft.Trim().Length is >= 1 and <= TimeWarp.Identity.Credential.MaxNicknameLength;

  protected override void OnParametersSet()
  {
    base.OnParametersSet();

    if (PendingRenameCredentialId is Guid pendingId)
    {
      if (AutoOpenedId != pendingId && Credentials.Any(credential => credential.Id.Value == pendingId))
      {
        AutoOpenedId = pendingId;
        EditingId = pendingId;
        ConfirmingId = null;
        Draft = string.IsNullOrWhiteSpace(PendingRenameDefault) ? FallbackLabel : PendingRenameDefault!;
      }
    }
    else if (AutoOpenedId is not null)
    {
      // Pending cleared elsewhere (saved from another surface, or skipped) — close the auto-opened editor.
      if (EditingId == AutoOpenedId)
      {
        EditingId = null;
      }

      AutoOpenedId = null;
    }
  }

  private void BeginRename(GetCredentials.CredentialSummary credential)
  {
    ConfirmingId = null;
    EditingId = credential.Id.Value;
    Draft = CredentialRowPresenter.NicknameDefault(credential, FallbackLabel);
  }

  private async Task CancelRenameAsync()
  {
    bool wasAutoOpened = EditingId is not null && EditingId == AutoOpenedId;
    EditingId = null;
    if (wasAutoOpened)
    {
      AutoOpenedId = null;
      await OnRenameCancel.InvokeAsync();
    }
  }

  private async Task SaveRenameAsync()
  {
    if (EditingId is not Guid id || !CanSaveRename)
    {
      return;
    }

    string nickname = Draft.Trim();
    if (AutoOpenedId != id)
    {
      EditingId = null;
    }

    await OnRename.InvokeAsync(new CredentialRename(id, nickname));
  }

  private void BeginRevoke(GetCredentials.CredentialSummary credential)
  {
    EditingId = null;
    ConfirmingId = credential.Id.Value;
  }

  private void CancelRevoke() => ConfirmingId = null;

  private async Task ConfirmRevokeAsync(GetCredentials.CredentialSummary credential)
  {
    ConfirmingId = null;
    await OnRevoke.InvokeAsync(credential);
  }
}

<div class="twe-credential-list">
  @if (Credentials.Count == 0)
  {
    <p class="twe-credential-list__muted">@EmptyMessage</p>
  }
  else
  {
    @foreach (GetCredentials.CredentialSummary credential in Credentials)
    {
      <div class="twe-credential-list__item" @key="credential.Id.Value" data-qa="CredentialRow">
        @if (EditingId == credential.Id.Value)
        {
          <div class="twe-credential-list__editor" data-qa="CredentialRenameEditor">
            <FluentTextInput @bind-Value="Draft"
                             AriaLabel="Nickname"
                             Placeholder="Nickname"
                             Width="100%"
                             data-qa="CredentialNicknameInput" />
            <FluentButton Appearance="ButtonAppearance.Primary"
                          data-qa="CredentialRenameSave"
                          Disabled="@(!CanSaveRename)"
                          OnClick="SaveRenameAsync">
              Save
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline"
                          data-qa="CredentialRenameCancel"
                          OnClick="CancelRenameAsync">
              Cancel
            </FluentButton>
          </div>
        }
        else
        {
          <div class="twe-credential-list__heading">
            <span class="twe-credential-list__label" data-qa="@TitleDataQa">@CredentialRowPresenter.Title(credential, FallbackLabel)</span>
            @if (credential.IsActive)
            {
              <StatusBadge Status="BadgeStatus.Active" />
            }
            else
            {
              <StatusBadge Status="BadgeStatus.Inactive" />
            }
          </div>
        }
        @{ string contextLine = CredentialRowPresenter.ContextLine(credential, FallbackLabel); }
        @if (contextLine.Length > 0)
        {
          <p class="twe-credential-list__muted" data-qa="CredentialContext">@contextLine</p>
        }
        <p class="twe-credential-list__value" data-qa="CredentialCreated">Created @CredentialRowPresenter.CreatedText(credential)</p>
        <p class="twe-credential-list__value" data-qa="CredentialLastUsed">@CredentialRowPresenter.LastUsedText(credential, DateTimeOffset.UtcNow)</p>
        <p class="twe-credential-list__fingerprint" data-qa="CredentialFingerprint" title="Fingerprint">@credential.Fingerprint</p>
        <div class="twe-credential-list__actions">
          <FluentButton Appearance="ButtonAppearance.Outline"
                        data-qa="RenameCredential"
                        Disabled="@(IsBusy || EditingId == credential.Id.Value)"
                        OnClick="@(() => BeginRename(credential))">
            Rename
          </FluentButton>
          <FluentButton Appearance="ButtonAppearance.Outline"
                        Class="twe-button-danger"
                        data-qa="@RevokeDataQa"
                        Disabled="@(!CanClickRevoke || ConfirmingId == credential.Id.Value)"
                        OnClick="@(() => BeginRevoke(credential))">
            @RevokeLabel
          </FluentButton>
          @if (RevokeDisabled && !string.IsNullOrWhiteSpace(RevokeDisabledHint))
          {
            <p class="twe-credential-list__muted" data-qa="@RevokeDisabledHintDataQa">@RevokeDisabledHint</p>
          }
        </div>
        @if (ConfirmingId == credential.Id.Value)
        {
          <div class="twe-credential-list__confirm" data-qa="RevokeConfirm">
            <p class="twe-credential-list__value" data-qa="RevokeConfirmText">@CredentialRowPresenter.RevokeConfirmation(credential, FallbackLabel, RevokeLabel, DateTimeOffset.UtcNow)</p>
            <div class="twe-credential-list__actions">
              <FluentButton Appearance="ButtonAppearance.Primary"
                            Class="twe-button-danger"
                            data-qa="@($"{RevokeDataQa}Confirm")"
                            Disabled="@(!CanClickRevoke)"
                            OnClick="@(() => ConfirmRevokeAsync(credential))">
                Confirm @RevokeLabel.ToLowerInvariant()
              </FluentButton>
              <FluentButton Appearance="ButtonAppearance.Outline"
                            data-qa="RevokeCancel"
                            OnClick="CancelRevoke">
                Keep
              </FluentButton>
            </div>
          </div>
        }
      </div>
    }
  }
</div>
