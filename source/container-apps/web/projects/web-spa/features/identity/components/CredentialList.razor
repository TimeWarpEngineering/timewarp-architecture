@namespace TimeWarp.Architecture.Features.Identity
@inherits BaseComponent

@*
  Purpose: Shared passkey / Entra credential list with FluentButton row actions.

  Design: Presentational — callers pass the snapshot and delete callback. One Card-free
  list so Settings and PasskeysPage do not duplicate row markup. Destructive actions are
  Outline + twe-button-danger (style-guide appearance, --twe-danger). StatusBadge marks
  active credentials. Native root so isolation styles muted text and row layout.
*@

@code {
  [Parameter] public IReadOnlyList<GetCredentials.CredentialSummary> Credentials { get; set; } = [];
  [Parameter] public bool IsLoading { get; set; }
  [Parameter] public bool IsBusy { get; set; }
  [Parameter] public string EmptyMessage { get; set; } = "No credentials yet.";
  [Parameter] public string FallbackLabel { get; set; } = "Passkey";
  [Parameter] public string? Subtitle { get; set; }
  [Parameter] public string? TitleDataQa { get; set; }
  [Parameter] public string DeleteLabel { get; set; } = "Delete";
  [Parameter] public string DeleteDataQa { get; set; } = "DeletePasskey";
  [Parameter] public bool DeleteDisabled { get; set; }
  [Parameter] public string? DeleteDisabledHint { get; set; }
  [Parameter] public string? DeleteDisabledHintDataQa { get; set; }
  [Parameter] public EventCallback<GetCredentials.CredentialSummary> OnDelete { get; set; }

  private bool CanClickDelete => !IsBusy && !DeleteDisabled;

  private static string DisplayLabel(GetCredentials.CredentialSummary credential, string fallback) =>
    string.IsNullOrWhiteSpace(credential.Label) ? fallback : credential.Label!;
}

<div class="twe-credential-list">
  @if (IsLoading)
  {
    <p class="twe-credential-list__muted">Loading…</p>
  }
  else if (Credentials.Count == 0)
  {
    <p class="twe-credential-list__muted">@EmptyMessage</p>
  }
  else
  {
    @foreach (GetCredentials.CredentialSummary credential in Credentials)
    {
      <div class="twe-credential-list__item" @key="credential.Id.Value">
        <div class="twe-credential-list__heading">
          <span class="twe-credential-list__label" data-qa="@TitleDataQa">@DisplayLabel(credential, FallbackLabel)</span>
          @if (credential.IsActive)
          {
            <StatusBadge Status="BadgeStatus.Active" />
          }
          else
          {
            <StatusBadge Status="BadgeStatus.Inactive" />
          }
        </div>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
          <p class="twe-credential-list__muted">@Subtitle</p>
        }
        <p class="twe-credential-list__value">@credential.CreatedAt.ToLocalTime().ToString("M/d/yyyy, h:mm:ss tt")</p>
        <div class="twe-credential-list__actions">
          <FluentButton Appearance="ButtonAppearance.Outline"
                        Class="twe-button-danger"
                        data-qa="@DeleteDataQa"
                        Disabled="@(!CanClickDelete)"
                        OnClick="@(() => OnDelete.InvokeAsync(credential))">
            @DeleteLabel
          </FluentButton>
          @if (DeleteDisabled && !string.IsNullOrWhiteSpace(DeleteDisabledHint))
          {
            <p class="twe-credential-list__muted" data-qa="@DeleteDisabledHintDataQa">@DeleteDisabledHint</p>
          }
        </div>
      </div>
    }
  }
</div>
