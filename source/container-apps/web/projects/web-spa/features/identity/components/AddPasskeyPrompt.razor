@namespace TimeWarp.Architecture.Features.Identity
@inherits BaseComponent
@inject ISessionStorageService SessionStorage
@using TimeWarp.Identity

@*
  Purpose: RFC 219 D8 dismissible "Add a passkey" banner after an Entra-issued identity-session.

  Design: Shown when GetCredentials has an active EntraAccount and no active Passkey. CTA
  dispatches existing CredentialsState.AddPasskey (StartPasskeyRegistration + AddPasskey).
  Soft: Later dismisses for the SPA session and optionally persists in sessionStorage.
  Required (site settings PasskeyPromptMode): Later is hidden; TimeWarpPage hides page body
  until a passkey exists. Never a route policy — this is UX plus a chrome gate.
*@

@code {
  private bool IsAddingPasskey =>
    IsAnyActive(typeof(CredentialsState.AddPasskeyActionSet.Action));
  private bool IsRequired => SiteSettingsState.PasskeyPromptMode == PasskeyPromptMode.Required;
  private bool ShouldShow =>
    PasskeySoftPrompt.ShouldShow(CredentialsState.Credentials, dismissed: IsRequired ? false : CredentialsState.PasskeySoftPromptDismissed);

  protected override async Task OnInitializedAsync()
  {
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    if (!IsRequired
      && await SessionStorage.ContainKeyAsync(PasskeySoftPrompt.LaterStorageKey)
      && await SessionStorage.GetItemAsync<bool>(PasskeySoftPrompt.LaterStorageKey))
    {
      await NoSubCredentialsState.DismissPasskeySoftPrompt();
    }
  }

  private async Task AddPasskeyAsync()
  {
    await NoSubCredentialsState.AddPasskey();
    await NoSubCredentialsState.FetchCredentials();
  }

  private async Task DismissAsync()
  {
    if (RendererInfo.IsInteractive)
    {
      await SessionStorage.SetItemAsync(PasskeySoftPrompt.LaterStorageKey, true);
    }

    await NoSubCredentialsState.DismissPasskeySoftPrompt();
  }
}

@if (ShouldShow)
{
  <div class="twe-passkey-prompt" data-qa="AddPasskeySoftPrompt">
    <FluentMessageBar Intent="@(IsRequired ? MessageBarIntent.Warning : MessageBarIntent.Info)"
                      Title="Add a passkey"
                      AllowDismiss="false"
                      Layout="MessageBarLayout.MultiLine">
      <ChildContent>
        @if (IsRequired)
        {
          <text>You signed in with Microsoft 365. Add a passkey to continue using this app.</text>
        }
        else
        {
          <text>You signed in with Microsoft 365. Add a passkey for this site so you can sign in without Entra next time.</text>
        }
      </ChildContent>
      <ActionsTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary"
                      data-qa="AddPasskeySoftPromptCta"
                      Disabled="@IsAddingPasskey"
                      OnClick="AddPasskeyAsync">
          Add a passkey
        </FluentButton>
        @if (!IsRequired)
        {
          <FluentButton data-qa="AddPasskeySoftPromptLater"
                        OnClick="DismissAsync">
            Later
          </FluentButton>
        }
      </ActionsTemplate>
    </FluentMessageBar>
  </div>
}
