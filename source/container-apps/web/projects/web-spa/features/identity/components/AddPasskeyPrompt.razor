@namespace TimeWarp.Architecture.Features.Identity
@inherits BaseComponent
@inject ISessionStorageService SessionStorage
@using TimeWarp.Identity

@*
  Purpose: RFC 219 D8 dismissible "Add a passkey" banner after an Entra-issued identity-session.

  Design: Shown when GetCredentials has an active EntraAccount and no active Passkey. CTA
  dispatches existing CredentialsState.AddPasskey (StartPasskeyRegistration + AddPasskey)
  then FetchCredentials only when CeremonyError is still null. CeremonyError renders as a
  FluentMessageBar (handler no longer toasts).
  Task 248-001: after THIS banner's CTA succeeds, a small "Name this passkey" form appears in
  its place (prefilled with the provider name from CredentialsState.PendingNicknameDefault);
  Save dispatches RenameCredential (+ FetchCredentials), Skip dispatches ClearPendingNickname.
  The form is contextual input, not an outcome bar (task 247 rule 1 allows it inline); the
  rename outcome itself is reported to the shell notification region by the state handler.
  ShowNicknameForm is component-local so a pending nickname set by another surface (Settings'
  Create button) does not also open a form here.
  Soft: Later dismisses for the SPA session and optionally persists in sessionStorage.
  Required (site settings PasskeyPromptMode): Later is hidden; TimeWarpPage hides page body
  until a passkey exists. Never a route policy — this is UX plus a chrome gate.
*@

@code {
  private bool IsAddingPasskey =>
    IsAnyActive(typeof(CredentialsState.AddPasskeyActionSet.Action));
  private bool IsRenaming =>
    IsAnyActive(typeof(CredentialsState.RenameCredentialActionSet.Action));
  private bool ShowNicknameForm;
  private string NicknameDraft = string.Empty;
  private bool ShouldShowNicknameForm =>
    ShowNicknameForm && CredentialsState.PendingNicknameCredentialId is not null;
  private bool CanSaveNickname =>
    !IsRenaming && NicknameDraft.Trim().Length is >= 1 and <= TimeWarp.Identity.Credential.MaxNicknameLength;
  private bool IsRequired => SiteSettingsState.PasskeyPromptMode == PasskeyPromptMode.Required;
  private bool ShouldShow =>
    PasskeySoftPrompt.ShouldShow(CredentialsState.Credentials, dismissed: IsRequired ? false : CredentialsState.PasskeySoftPromptDismissed);

  protected override async Task OnInitializedAsync()
  {
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    if (!IsRequired
      && await SessionStorage.ContainKeyAsync(PasskeySoftPrompt.LaterStorageKey)
      && await SessionStorage.GetItemAsync<bool>(PasskeySoftPrompt.LaterStorageKey))
    {
      await NoSubCredentialsState.DismissPasskeySoftPrompt();
    }
  }

  private async Task AddPasskeyAsync()
  {
    await NoSubCredentialsState.AddPasskey();
    if (CredentialsState.CeremonyError is not null)
    {
      return;
    }

    await NoSubCredentialsState.FetchCredentials();
    if (CredentialsState.PendingNicknameCredentialId is not null)
    {
      NicknameDraft = CredentialsState.PendingNicknameDefault ?? "Passkey";
      ShowNicknameForm = true;
    }
  }

  private async Task SaveNicknameAsync()
  {
    if (CredentialsState.PendingNicknameCredentialId is not Guid credentialId || !CanSaveNickname)
    {
      return;
    }

    ShowNicknameForm = false;
    await NoSubCredentialsState.RenameCredential(credentialId, NicknameDraft.Trim());
    await NoSubCredentialsState.FetchCredentials();
  }

  private async Task SkipNicknameAsync()
  {
    ShowNicknameForm = false;
    await NoSubCredentialsState.ClearPendingNickname();
  }

  private async Task DismissAsync()
  {
    if (RendererInfo.IsInteractive)
    {
      await SessionStorage.SetItemAsync(PasskeySoftPrompt.LaterStorageKey, true);
    }

    await NoSubCredentialsState.DismissPasskeySoftPrompt();
  }
}

@if (!string.IsNullOrEmpty(CredentialsState.CeremonyError))
{
  <FluentMessageBar Intent="MessageBarIntent.Error" Title="Error" AllowDismiss="false" data-qa="AddPasskeyPromptError">
    @CredentialsState.CeremonyError
  </FluentMessageBar>
}

@if (ShouldShowNicknameForm)
{
  <div class="twe-passkey-prompt" data-qa="AddPasskeyNicknamePrompt">
    <FluentMessageBar Intent="MessageBarIntent.Info"
                      Title="Name this passkey"
                      AllowDismiss="false"
                      Layout="MessageBarLayout.MultiLine">
      <ChildContent>
        <FluentTextInput @bind-Value="NicknameDraft"
                         AriaLabel="Nickname"
                         Placeholder="Nickname"
                         Width="100%"
                         data-qa="AddPasskeyNicknameInput" />
      </ChildContent>
      <ActionsTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary"
                      data-qa="AddPasskeyNicknameSave"
                      Disabled="@(!CanSaveNickname)"
                      OnClick="SaveNicknameAsync">
          Save
        </FluentButton>
        <FluentButton data-qa="AddPasskeyNicknameSkip"
                      OnClick="SkipNicknameAsync">
          Skip
        </FluentButton>
      </ActionsTemplate>
    </FluentMessageBar>
  </div>
}

@if (ShouldShow)
{
  <div class="twe-passkey-prompt" data-qa="AddPasskeySoftPrompt">
    <FluentMessageBar Intent="@(IsRequired ? MessageBarIntent.Warning : MessageBarIntent.Info)"
                      Title="Add a passkey"
                      AllowDismiss="false"
                      Layout="MessageBarLayout.MultiLine">
      <ChildContent>
        @if (IsRequired)
        {
          <text>You signed in with Microsoft 365. Add a passkey to continue using this app.</text>
        }
        else
        {
          <text>You signed in with Microsoft 365. Add a passkey for this site so you can sign in without Entra next time.</text>
        }
      </ChildContent>
      <ActionsTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary"
                      data-qa="AddPasskeySoftPromptCta"
                      Disabled="@IsAddingPasskey"
                      OnClick="AddPasskeyAsync">
          Add a passkey
        </FluentButton>
        @if (!IsRequired)
        {
          <FluentButton data-qa="AddPasskeySoftPromptLater"
                        OnClick="DismissAsync">
            Later
          </FluentButton>
        }
      </ActionsTemplate>
    </FluentMessageBar>
  </div>
}
