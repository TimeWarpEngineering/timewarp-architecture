@namespace TimeWarp.Architecture.Features.Identity

@*
  Purpose: The unlinked Microsoft 365 account choice.

  Design: When Passkey is offered, the card includes the passkey proof ("I already have an
  account"). Otherwise the only action is a new account. The page supplies the clicks. This
  component does not dispatch. Copy is generic; no product or client name.
*@

@code {
  [Parameter] public IReadOnlyList<SignInMethod>? Methods { get; set; }

  [Parameter] public bool IsBusy { get; set; }

  [Parameter] public EventCallback<MouseEventArgs> OnCreateAccount { get; set; }

  [Parameter] public EventCallback<MouseEventArgs> OnAlreadyHaveAccount { get; set; }

  private bool Passkey => Methods?.Contains(SignInMethod.Passkey) == true;
}

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
  @if (Passkey)
  {
    <p>This Microsoft 365 account is not linked yet. Create a new account, or prove you already have one with a passkey.</p>
  }
  else
  {
    <p>This Microsoft 365 account is not linked yet. Create a new account to continue.</p>
  }
  <FluentButton Appearance="ButtonAppearance.Primary"
                data-qa="CreateNewAccount"
                Disabled="IsBusy"
                OnClick="OnCreateAccount">
    Create a new account
  </FluentButton>
  @if (Passkey)
  {
    <FluentButton Appearance="ButtonAppearance.Outline"
                  data-qa="AlreadyHaveAccount"
                  Disabled="IsBusy"
                  OnClick="OnAlreadyHaveAccount">
      I already have an account
    </FluentButton>
  }
</FluentStack>
