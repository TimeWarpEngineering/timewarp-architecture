@namespace TimeWarp.Architecture.Features.Identity
@inherits BaseComponent
@code {
  public static string Title => "Microsoft 365 account";
  public static Icon? NavIcon => new Icons.Regular.Size20.PersonPasskey();

  private bool IsBusy => ActionTrackingState.IsActive;
  private bool? IsValid => SignInState.Microsoft365ChoiceValid;

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    await NoSubSignInState.FetchOfferedSignInMethods();
    await NoSubSignInState.FetchMicrosoft365Choice();
  }

  // Each button is one dispatch. The SignInState handlers complete the parked sign-in, navigate
  // on success, and publish failures to the shell's MessageBars region (TimeWarpFocusedPage hosts
  // it); an "expired" failure flips Microsoft365ChoiceValid so the Warning below replaces the
  // choice. The Warning is static guidance and stays inline.
  private Task CreateNewAccount() => NoSubSignInState.CreateAccountFromMicrosoft365();

  private Task AlreadyHaveAccount() => NoSubSignInState.UseExistingAccountForMicrosoft365();

  private Task SignInAgain() => NoSubRouteState.ChangeRoute(newRoute: LoginPage.GetPageUrl());
}

<PageTitle>Microsoft 365 account</PageTitle>

<TimeWarpFocusedPage>
  <div class="twe-stack">
    <Card Title="Microsoft 365">
      @if (IsValid is null)
      {
        <p>Checking sign-in…</p>
      }
      else if (IsValid is false)
      {
        <MessageBar Intent="MessageBarIntent.Warning"
                    Title="Session expired"
                    Body="Session expired, sign in with Microsoft 365 again." />
        <FluentButton Appearance="ButtonAppearance.Primary"
                      data-qa="SignInWithMicrosoft365Again"
                      OnClick="SignInAgain">
          Sign in with Microsoft 365 again
        </FluentButton>
      }
      else
      {
        <Microsoft365AccountChoice Methods="SignInState.OfferedMethods"
                                   IsBusy="IsBusy"
                                   OnCreateAccount="CreateNewAccount"
                                   OnAlreadyHaveAccount="AlreadyHaveAccount" />
      }
    </Card>
  </div>
</TimeWarpFocusedPage>
