@namespace TimeWarp.Architecture.Features.Identity
@inherits BaseComponent

@code {
  public static string Title => "Passkeys";
  public static Icon? NavIcon => new Icons.Regular.Size20.Key();

  [Inject] private PasskeyCeremonyClient Ceremony { get; set; } = null!;

  private string? ErrorMessage;
  private string? StatusMessage;
  private bool IsBusy;
  private bool? IsAuthenticated;

  private bool IsListBusy => ActionTrackingState.IsActive;
  private IReadOnlyList<GetCredentials.CredentialSummary> Passkeys => CredentialsState.ActivePasskeys;
  private bool CanRevoke => CredentialsState.CanUnlink(CredentialsState.ActiveCredentialCount);

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    await RefreshSessionAsync();
    await NoSubCredentialsState.FetchCredentials();
  }

  private async Task RegisterPasskey()
  {
    ErrorMessage = null;
    StatusMessage = null;
    IsBusy = true;
    try
    {
      OneOf<CompletePasskeyRegistration.Response, SharedProblemDetails> result =
        await Ceremony.RegisterAsync(CancellationToken.None);

      if (result.IsT1)
      {
        ErrorMessage = PasskeyCeremonyClient.FormatError(result.AsT1);
        return;
      }

      StatusMessage = $"Passkey registered. PrincipalId: {result.AsT0.PrincipalId}";
      await RefreshSessionAsync();
      await NoSubCredentialsState.FetchCredentials();
      // Task 248-001: prompt for a nickname, prefilled with the provider name, on the new row.
      await NoSubCredentialsState.SetPendingNickname(result.AsT0.CredentialId.Value, result.AsT0.ProviderLabel ?? string.Empty);
    }
    catch (JSException jsException)
    {
      ErrorMessage = $"The browser could not complete the passkey ceremony: {jsException.Message}";
    }
    finally
    {
      IsBusy = false;
    }
  }

  private async Task AuthenticateWithPasskey()
  {
    ErrorMessage = null;
    StatusMessage = null;
    IsBusy = true;
    try
    {
      OneOf<CompletePasskeyAuthentication.Response, SharedProblemDetails> result =
        await Ceremony.AuthenticateAsync(CancellationToken.None);

      if (result.IsT1)
      {
        ErrorMessage = PasskeyCeremonyClient.FormatError(result.AsT1);
        return;
      }

      StatusMessage = $"Authenticated. PrincipalId: {result.AsT0.PrincipalId}";
      await RefreshSessionAsync();
    }
    catch (JSException jsException)
    {
      ErrorMessage = $"The browser could not complete the passkey ceremony: {jsException.Message}";
    }
    finally
    {
      IsBusy = false;
    }
  }

  private async Task RefreshSessionAsync()
  {
    IsAuthenticated = await Ceremony.GetIsAuthenticatedAsync(CancellationToken.None);
  }

  private async Task ConfirmRevokeAsync(GetCredentials.CredentialSummary credential)
  {
    await NoSubCredentialsState.RevokeCredential(credential.Id.Value);
    await NoSubCredentialsState.FetchCredentials();
  }

  private async Task RenameAsync(CredentialRename rename)
  {
    await NoSubCredentialsState.RenameCredential(rename.CredentialId, rename.Nickname);
    await NoSubCredentialsState.FetchCredentials();
  }

  private Task CancelPendingNicknameAsync() => NoSubCredentialsState.ClearPendingNickname();
}

<TimeWarpPage Title="Passkeys">
  <div class="twe-stack">
    <Card Title="Passkey ceremony demo">
      <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <p>
          Technical demo of the first-party WebAuthn ceremony (no email/username).
          Product sign-in CTA: <NavLink href="/Login">Continue with passkey</NavLink>.
        </p>
        <p>
          Session: @(IsAuthenticated is true ? "authenticated" : IsAuthenticated is false ? "not authenticated" : "checking...")
        </p>
        <div>
          <FluentButton Appearance="ButtonAppearance.Primary" data-qa="RegisterPasskey" Disabled="IsBusy" OnClick="RegisterPasskey">
            Register a passkey
          </FluentButton>
        </div>
        <div>
          <FluentButton Appearance="ButtonAppearance.Outline" data-qa="AuthenticateWithPasskey" Disabled="IsBusy" OnClick="AuthenticateWithPasskey">
            Sign in with a passkey
          </FluentButton>
        </div>
      </FluentStack>
    </Card>

    <Section Title="Passkeys on this account" LoadingActionType="typeof(CredentialsState.FetchCredentialsActionSet.Action)">
      <CredentialList Credentials="Passkeys"
                      IsBusy="IsListBusy"
                      EmptyMessage="No passkeys on this account yet."
                      FallbackLabel="Passkey"
                      RevokeLabel="Revoke"
                      RevokeDataQa="RevokePasskey"
                      RevokeDisabled="@(!CanRevoke)"
                      RevokeDisabledHint="Add another passkey or agent key before revoking this one."
                      RevokeDisabledHintDataQa="RevokePasskeyHint"
                      OnRevoke="ConfirmRevokeAsync"
                      OnRename="RenameAsync"
                      OnRenameCancel="CancelPendingNicknameAsync"
                      PendingRenameCredentialId="CredentialsState.PendingListRenameCredentialId"
                      PendingRenameDefault="CredentialsState.PendingNicknameDefault" />
    </Section>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
      <FluentMessageBar Intent="MessageBarIntent.Success" Title="Success" AllowDismiss="false">
        @StatusMessage
      </FluentMessageBar>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
      <FluentMessageBar Intent="MessageBarIntent.Error" Title="Error" AllowDismiss="false">
        @ErrorMessage
      </FluentMessageBar>
    }
  </div>
</TimeWarpPage>
