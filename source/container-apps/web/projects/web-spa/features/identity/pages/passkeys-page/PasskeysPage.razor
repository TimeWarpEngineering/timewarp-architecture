@namespace TimeWarp.Architecture.Features.Identity
@inherits BaseComponent

@code {
  public static string Title => "Passkeys";
  public static Icon? NavIcon => new Icons.Regular.Size20.Key();

  [Inject] private IActionCatalog ActionCatalog { get; set; } = null!;
  [Inject] private CommandPaletteContext PaletteContext { get; set; } = null!;
  // TimeWarpStateComponent keeps its Store private; the offer runner needs the circuit/tab store.
  [Inject] private IStore ScopedStore { get; set; } = null!;

  private bool IsBusy => IsAnyActive
  (
    typeof(SignInState.SignInWithPasskeyActionSet.Action),
    typeof(SignInState.CreateAccountWithPasskeyActionSet.Action)
  );
  private bool? IsAuthenticated => SignInState.IsAuthenticated;

  private bool IsListBusy => ActionTrackingState.IsActive;
  private IReadOnlyList<GetCredentials.CredentialSummary> Passkeys => CredentialsState.ActivePasskeys;

  private bool IsRevokeOffered(GetCredentials.CredentialSummary credential) =>
    CredentialsState.IsOffered(OfferedActionNames.RevokeCredential, credential.Id.Value);

  private bool IsRenameOffered(GetCredentials.CredentialSummary credential) =>
    CredentialsState.IsOffered(OfferedActionNames.RenameCredential, credential.Id.Value);

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    await NoSubSignInState.FetchSession();
    await NoSubCredentialsState.FetchCredentials();
  }

  // Ceremonies are SignInState actions (StayOnPage: no navigation and publish the outcome to the
  // shell region, task 247). The page only sequences the follow-ups after a success.
  private async Task RegisterPasskey()
  {
    await NoSubSignInState.CreateAccountWithPasskey(SignInState.StayOnPage);
    if (SignInState.CeremonyFailed || SignInState.LastRegisteredCredentialId is not Guid credentialId)
    {
      return;
    }

    await NoSubCredentialsState.FetchCredentials();
    // Task 248-001: prompt for a nickname, prefilled with the provider name, on the new row.
    await NoSubCredentialsState.SetPendingNickname(credentialId, SignInState.LastRegisteredProviderLabel ?? string.Empty);
  }

  private Task AuthenticateWithPasskey() => NoSubSignInState.SignInWithPasskey(SignInState.StayOnPage);

  // Offered actions run through the catalog; the runner refreshes FetchCredentials afterwards.
  private Task ConfirmRevokeAsync(GetCredentials.CredentialSummary credential) =>
    CredentialOfferRows.RunAsync(OfferedActionNames.RevokeCredential, credential.Id.Value, input: null, ScopedStore, ActionCatalog, PaletteContext, CancellationToken);

  private Task RenameAsync(CredentialRename rename) =>
    CredentialOfferRows.RunAsync
    (
      OfferedActionNames.RenameCredential,
      rename.CredentialId,
      CredentialOfferRows.NicknameInput(rename.Nickname),
      ScopedStore,
      ActionCatalog,
      PaletteContext,
      CancellationToken
    );

  private Task CancelPendingNicknameAsync() => NoSubCredentialsState.ClearPendingNickname();
}

<TimeWarpPage Title="Passkeys">
  <div class="twe-stack">
    <Card Title="Passkey ceremony demo">
      <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        <p>
          Technical demo of the first-party WebAuthn ceremony (no email/username).
          Product sign-in CTA: <NavLink href="/Login">Continue with passkey</NavLink>.
        </p>
        <p>
          Session: @(IsAuthenticated is true ? "authenticated" : IsAuthenticated is false ? "not authenticated" : "checking...")
        </p>
        <div>
          <FluentButton Appearance="ButtonAppearance.Primary" data-qa="RegisterPasskey" Disabled="IsBusy" OnClick="RegisterPasskey">
            Register a passkey
          </FluentButton>
        </div>
        <div>
          <FluentButton Appearance="ButtonAppearance.Outline" data-qa="AuthenticateWithPasskey" Disabled="IsBusy" OnClick="AuthenticateWithPasskey">
            Sign in with a passkey
          </FluentButton>
        </div>
      </FluentStack>
    </Card>

    <Section Title="Passkeys on this account" LoadingActionType="typeof(CredentialsState.FetchCredentialsActionSet.Action)">
      <CredentialList Credentials="Passkeys"
                      IsBusy="IsListBusy"
                      EmptyMessage="No passkeys on this account yet."
                      FallbackLabel="Passkey"
                      RevokeLabel="Revoke"
                      RevokeDataQa="RevokePasskey"
                      IsRevokeOffered="IsRevokeOffered"
                      IsRenameOffered="IsRenameOffered"
                      RevokeDisabledHint="Add another passkey or agent key before revoking this one."
                      RevokeDisabledHintDataQa="RevokePasskeyHint"
                      OnRevoke="ConfirmRevokeAsync"
                      OnRename="RenameAsync"
                      OnRenameCancel="CancelPendingNicknameAsync"
                      PendingRenameCredentialId="CredentialsState.PendingListRenameCredentialId"
                      PendingRenameDefault="CredentialsState.PendingNicknameDefault" />
    </Section>
  </div>
</TimeWarpPage>
