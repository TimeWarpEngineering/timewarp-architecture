@namespace TimeWarp.Architecture.Features.Identity
@inherits BaseComponent
@using Microsoft.Extensions.Configuration
@using TimeWarp.Architecture.Services

@code {
  public static string Title => "Sign in";
  public static Icon? NavIcon => new Icons.Regular.Size20.PersonPasskey();

  [Inject] private PasskeyCeremonyClient Ceremony { get; set; } = null!;
  [Inject] private NavigationManager NavigationManager { get; set; } = null!;
  [Inject] private IWebServerApiService WebServerApiService { get; set; } = null!;

  [SuppressMessage
  (
    "Design",
    "CA1056:URI-like properties should not be strings",
    Justification = "SupplyParameterFromQuery binds strings; the raw value is validated by GetSafeReturnUrl."
  )]
  [Parameter] [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

  private bool IsBusy;
  private bool? IsAuthenticated;
  private bool ShowMicrosoft365;

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    await RefreshSessionAsync();
    ShowMicrosoft365 = await LoadEntraOfferedAsync();

    if (IsAuthenticated is true)
    {
      NavigateOnward();
    }
  }

  /// <summary>
  /// Collapses a requested return URL to a safe local destination: relative paths only
  /// (no absolute/protocol-relative URLs — open-redirect guard) and never /Login itself
  /// (redirect loop guard). Everything else falls back to home.
  /// </summary>
  internal static string GetSafeReturnUrl(string? returnUrl)
  {
    if (string.IsNullOrEmpty(returnUrl)
      || !returnUrl.StartsWith('/')
      || returnUrl.StartsWith("//", StringComparison.Ordinal)
      || returnUrl.StartsWith("/\\", StringComparison.Ordinal))
    {
      return "/";
    }

    string path = returnUrl.Split('?', '#')[0].TrimEnd('/');
    return path.Equals(GetPageUrl(), StringComparison.OrdinalIgnoreCase) ? "/" : returnUrl;
  }

  private void NavigateOnward() => NavigationManager.NavigateTo(GetSafeReturnUrl(ReturnUrl));

  /// <summary>
  /// After Create account: deep-link returnUrl if present, else /Settings (passkeys.io-style
  /// post-create: see your new passkey listed). Literal path avoids TWA0009 cross-slice type refs.
  /// </summary>
  private void NavigateAfterCreateAccount()
  {
    string destination = GetSafeReturnUrl(ReturnUrl);
    NavigationManager.NavigateTo(destination is "/" or "" ? "/Settings" : destination);
  }

  // Ceremony failures go to the shell's MessageBars region (TimeWarpFocusedPage hosts it)
  // via NotificationState — no page-local error bar (task 247).
  private async Task ContinueWithPasskey()
  {
    IsBusy = true;
    try
    {
      OneOf<CompletePasskeyAuthentication.Response, SharedProblemDetails> result =
        await Ceremony.AuthenticateAsync(CancellationToken.None);

      if (result.IsT1)
      {
        await NoSubNotificationState.ReportProblem(result.AsT1, CancellationToken);
        return;
      }

      NavigateOnward();
    }
    catch (JSException jsException)
    {
      await ReportCeremonyFailureAsync(jsException);
    }
    finally
    {
      IsBusy = false;
    }
  }

  private async Task CreatePasskey()
  {
    IsBusy = true;
    try
    {
      OneOf<CompletePasskeyRegistration.Response, SharedProblemDetails> result =
        await Ceremony.RegisterAsync(CancellationToken.None);

      if (result.IsT1)
      {
        await NoSubNotificationState.ReportProblem(result.AsT1, CancellationToken);
        return;
      }

      NavigateAfterCreateAccount();
    }
    catch (JSException jsException)
    {
      await ReportCeremonyFailureAsync(jsException);
    }
    finally
    {
      IsBusy = false;
    }
  }

  private Task ReportCeremonyFailureAsync(JSException jsException) =>
    NoSubNotificationState.AddNotification
    (
      MessageBarIntent.Error,
      "The browser could not complete the passkey ceremony",
      jsException.Message,
      CancellationToken
    );

  private async Task RefreshSessionAsync()
  {
    IsAuthenticated = await Ceremony.GetIsAuthenticatedAsync(CancellationToken.None);
  }

  private async Task<bool> LoadEntraOfferedAsync()
  {
    try
    {
      OneOf<GetEntraSignInOffered.Response, FileResponse, SharedProblemDetails> result =
        await WebServerApiService.GetResponse<GetEntraSignInOffered.Response>(
          new GetEntraSignInOffered.Query(),
          CancellationToken.None);
      return result.TryPickT0(out GetEntraSignInOffered.Response response, out _)
        && response.Offered;
    }
    catch (Exception)
    {
      return false;
    }
  }

  private void ContinueWithMicrosoft365()
  {
    NavigationManager.NavigateTo(
      ChallengeEntra.GetRoute("bootstrap", GetSafeReturnUrl(ReturnUrl)),
      forceLoad: true);
  }
}

<PageTitle>Sign in</PageTitle>

<TimeWarpFocusedPage>
  <div class="twe-stack">
    <Card Title="Sign in">
      <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
        @* Single modal path: the browser passkey UI lists this-device managers (e.g. Proton Pass)
           and nearby-device / QR after cancel or "other options" — no empty text box, no second
           site button (task 166 autofill UX rejected; hybrid still allowed via server hints). *@
        <FluentButton Appearance="ButtonAppearance.Primary"
                      data-qa="ContinueWithPasskey"
                      Disabled="IsBusy"
                      OnClick="ContinueWithPasskey">
          Sign in with a passkey
        </FluentButton>

        @if (ShowMicrosoft365)
        {
          <FluentButton Appearance="ButtonAppearance.Outline"
                        data-qa="ContinueWithMicrosoft365"
                        Disabled="IsBusy"
                        OnClick="ContinueWithMicrosoft365">
            Continue with Microsoft 365
          </FluentButton>
        }

        <hr class="twe-login-divider" />

        <p class="twe-login-create">
          Don't have an account?
          <FluentButton Appearance="ButtonAppearance.Outline"
                        data-qa="CreatePasskey"
                        Disabled="IsBusy"
                        OnClick="CreatePasskey">
            Create account
          </FluentButton>
        </p>
      </FluentStack>
    </Card>
  </div>
</TimeWarpFocusedPage>

<style>
  @(@"
    .twe-login-divider {
      border: 0;
      border-top: 1px solid var(--twe-rule);
      margin: 0;
      width: 100%;
    }
    .twe-login-create {
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      color: var(--twe-ink-2);
      font-size: var(--twe-text-body);
    }
  ")
</style>
