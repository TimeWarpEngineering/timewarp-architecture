@namespace TimeWarp.Architecture.Features.Identity
@inherits BaseComponent
@code {
  public static string Title => "Sign in";
  public static Icon? NavIcon => new Icons.Regular.Size20.PersonPasskey();

  [SuppressMessage
  (
    "Design",
    "CA1056:URI-like properties should not be strings",
    Justification = "SupplyParameterFromQuery binds strings; the raw value is validated by GetSafeReturnUrl."
  )]
  [Parameter] [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

  private bool IsBusy => ActionTrackingState.IsActive;

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    await NoSubSignInState.FetchSession();
    await NoSubSignInState.FetchOfferedSignInMethods();

    // Lifecycle redirect: an already-signed-in visitor never sees this page. Still an action
    // (RouteState.ChangeRoute) — components only dispatch (TWA0026).
    if (SignInState.IsAuthenticated is true)
    {
      await NoSubRouteState.ChangeRoute(GetSafeReturnUrl(ReturnUrl));
    }
  }

  /// <summary>
  /// Collapses a requested return URL to a safe local destination: relative paths only
  /// (no absolute/protocol-relative URLs — open-redirect guard) and never /Login itself
  /// (redirect loop guard). Everything else falls back to home.
  /// </summary>
  internal static string GetSafeReturnUrl(string? returnUrl)
  {
    if (string.IsNullOrEmpty(returnUrl)
      || !returnUrl.StartsWith('/', StringComparison.Ordinal)
      || returnUrl.StartsWith("//", StringComparison.Ordinal)
      || returnUrl.StartsWith("/\\", StringComparison.Ordinal))
    {
      return "/";
    }

    string path = returnUrl.Split('?', '#')[0].TrimEnd('/');
    return path.Equals(GetPageUrl(), StringComparison.OrdinalIgnoreCase) ? "/" : returnUrl;
  }

  /// <summary>
  /// /Login carrying <paramref name="returnPath"/> as ?returnUrl once it passes
  /// <see cref="GetSafeReturnUrl"/>; plain /Login when that collapses to home.
  /// </summary>
  internal static string GetLoginUrl(string? returnPath)
  {
    string safeReturnUrl = GetSafeReturnUrl(returnPath);
    return safeReturnUrl == "/"
      ? GetPageUrl()
      : $"{GetPageUrl()}?returnUrl={Uri.EscapeDataString(safeReturnUrl)}";
  }

  // Each button is one dispatch; the SignInState handlers run the ceremony / challenge and
  // navigate. Failures reach the shell's MessageBars region (TimeWarpFocusedPage hosts it).
  private Task ContinueWithPasskey() => NoSubSignInState.SignInWithPasskey(GetSafeReturnUrl(ReturnUrl));

  private Task CreatePasskey() => NoSubSignInState.CreateAccountWithPasskey(GetSafeReturnUrl(ReturnUrl));

  private Task ContinueWithMicrosoft365() => NoSubSignInState.SignInWithMicrosoft365(GetSafeReturnUrl(ReturnUrl));

  private Task RetryOfferedMethods() => NoSubSignInState.FetchOfferedSignInMethods();
}

<PageTitle>Sign in</PageTitle>

<TimeWarpFocusedPage>
  <div class="twe-stack">
    <Card Title="Sign in">
      <SignInChoices Methods="SignInState.OfferedMethods"
                     IsBusy="IsBusy"
                     LoadFailed="SignInState.OfferedMethodsFailed"
                     OnPasskey="ContinueWithPasskey"
                     OnCreateAccount="CreatePasskey"
                     OnMicrosoft365="ContinueWithMicrosoft365"
                     OnRetry="RetryOfferedMethods" />
    </Card>
  </div>
</TimeWarpFocusedPage>
