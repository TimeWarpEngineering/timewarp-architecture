@namespace TimeWarp.Architecture.Components

@*
  Purpose: One table whose rows are sorted into titled groups — a paper container around a single table.

  Design: Native div root so CSS isolation stamps the scope attribute. Class is appended on that
  root the way Card does, and unmatched attributes splat onto it. The table is one real table
  (class twe-table) so column widths stay shared and assistive tech sees one set of column
  headers. ChildContent is the page's thead followed by TableGroup bodies. ColumnCount cascades
  to those groups under the name TweGroupedTableColumnCount and is not fixed, so a group does
  not repeat it and an unnamed int cascade is left alone. Label becomes aria-label on the table;
  a blank label omits the attribute. The page owns grouping, order, and cells. This component
  wires no events, does not sort, and does not collapse. Isolated CSS uses --twe-* tokens.
  Cell padding and rules stay on the global .twe-table rule. There is no FluentUI child, so
  the stylesheet needs no ::deep.
*@

@code {
  [Parameter, EditorRequired] public int ColumnCount { get; set; }
  [Parameter] public string? Label { get; set; }
  [Parameter] public RenderFragment? ChildContent { get; set; }
  [Parameter] public string? Class { get; set; }
  [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

  private string? TableLabel => string.IsNullOrWhiteSpace(Label) ? null : Label;
}

<div class="twe-grouped-table @Class" @attributes="AdditionalAttributes">
  <table class="twe-table" aria-label="@TableLabel">
    <CascadingValue Name="@TableGroup.ColumnCountCascadeName" Value="ColumnCount">
      @ChildContent
    </CascadingValue>
  </table>
</div>
