@namespace TimeWarp.Architecture.Components
@*
  Purpose: Status pill — a word and a dot for one record status.

  Design: Native span root so CSS isolation stamps the scope attribute. Class is
  appended on that root, and unmatched attributes splat onto it. The default label
  is the enum name. A caller passes Label to replace it. The dot is decorative.
  This component wires no events.
*@

@code {
  [Parameter] public BadgeStatus Status { get; set; } = BadgeStatus.Active;
  [Parameter] public string? Label { get; set; }
  [Parameter] public string? Class { get; set; }
  [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

  private string Modifier => Status switch
  {
    BadgeStatus.Active => "active",
    BadgeStatus.Inactive => "inactive",
    BadgeStatus.Warning => "warning",
    BadgeStatus.Info => "info",
    _ => "active",
  };
}

<span class="twe-badge twe-badge--@Modifier @Class" @attributes="AdditionalAttributes">
  <span class="twe-badge__dot"></span>
  @(Label ?? Status.ToString())
</span>
