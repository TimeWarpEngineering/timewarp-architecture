@namespace TimeWarp.Architecture.Components
@inherits BaseComponent
@using TimeWarp.Architecture.Features.Applications
@using TimeWarp.Architecture.Features.Profiles
@using TimeWarp.Features.Theme
@using TimeWarp.Identity
@*
  Purpose: Single app-shell page component. Pages wrap content in
      <TimeWarpPage Title="Settings"> ...content... </TimeWarpPage>

  Design: Built on FluentUI v5 FluentLayout. MainLayout stays empty (FluentProviders only);
  this component owns the chrome so it gets TimeWarp.State render-trigger / Id /
  per-navigation lifecycle that a LayoutComponentBase can't.
  The location breadcrumb sits under the h1: Home, then each ancestor page, then this
  page. Parents are PageRegistry routes (longest literal prefix), not the RouteState
  history stack. Ancestors are links. The current page is text with aria-current="page".
  Nav groups are not crumbs. BreadcrumbLabel overrides the current crumb when the nav
  title is not the label (a design system part). Title is that label when it already
  matches (the role name). ShowInBreadcrumbs=false omits the trail (403, 404, auth)
  and uses PageTitle instead of TwPageTitle. TwPageTitle still sets document.title.
  There is no per-page Back button. The trail is a native nav/ol styled with brand
  tokens in TimeWarpPage.razor.css.
  RFC 219 D8 / 219-006: AddPasskeyPrompt sits above ChildContent so post-login Home and
  Profile (and every other TimeWarpPage) can show the Entra add-passkey banner. Required
  mode hides ChildContent until a passkey exists. Login uses TimeWarpFocusedPage and never
  hosts this prompt. Soft dismiss is not a gate. The prompt and the required gate run only
  when the server lists Passkey among the offered methods.
  MessageBars sits above that prompt: it is the ONE notification region per page (task 247),
  painting NotificationState rows (pipeline failures, handler outcomes, AddNotification)
  directly below the breadcrumb and above the first card, without a toast provider. Pages
  render no outcome bars of their own (TWA0025).
  Task 239-003: the appbar search field is the Ctrl-K palette's trigger, not a text box — it is
  ReadOnly and carries the CommandPaletteJsModule trigger attribute, so focusing or clicking it
  opens the CommandPalette modal (as Ctrl-K / Cmd-K anywhere on the page does). The palette is a
  ModalContainer beside AssemblyInfoModal and owns its JS registration; only this shell hosts it.
  The app-bar logo is BrandOptions (source, alt, width, height). This shell authors the img so
  the isolated .twe-brand__logo rule can match it. Height is --twe-logo-height from /brand.css.
  Task 290: all shell CSS is in TimeWarpPage.razor.css (CSS isolation), which the browser loads in
  <head> before first paint. A <style>@(...)</style> block here was HTML-encoded by prerender and
  dropped until interactive, so the shell flashed unstyled. Components author no <style> elements
  (skills/tw-blazor-css-strategy).
  Task 293: the shell no longer runs the Ask readiness probe. It ran once per app, so a signed-out
  401 survived an in-app sign-in. AuthenticationStateListener probes at startup and on every
  AuthenticationState change.
  Task 296: Ask is a FluentLayout aside, not a sibling of the layout. FluentLayout's grid is
  `nav content aside` / `auto 1fr auto`, so a 450px aside reflows the page. The layout has one
  aside column. While Ask is open it owns that column and the page Aside parameter is not
  rendered; the page aside returns when Ask closes. Two aside items would share one grid area
  and paint on top of each other. FluentLayout MobileBreakdownWidth is 880. Below that, and
  when the panel is expanded, TimeWarpPage.razor.css covers the viewport with one full-screen
  treatment on `.fluent-layout-item[area=aside]`. `.twe-shell` stays `display: contents`.
  The `twe-shell--ask` class is only the hook for that treatment. It does not change display.
  Description and Actions are optional header slots. Both unset leaves the title and breadcrumb
  markup unchanged, so existing pages keep one h1 and no extra row. Either slot set lays the
  title and description on the left and the actions (wrapping) on the right. The document title
  stays here. PageTitleBar is the one copy of the heading, description, and actions. This
  component passes IsPageHeading true, so the shell still owns the only h1. A blank Title
  omits that heading and still renders Description and Actions. Callers put buttons in
  Actions; this shell does not handle their clicks. Page-wide actions (create, sync, export) go
  in Actions, with at most one Primary. A form's submit button goes at the bottom of that form,
  in FormActions, after the fields it saves. A sample of the title bar must not render a second h1.
  SearchMode chooses the app-bar search slot. Palette is the read-only Ctrl-K field. Hidden
  omits it. Custom renders the Search fragment in that same slot. The command palette modal
  stays mounted, so Ctrl-K still opens it.
  The navigation column pins a user card under the menu when someone is signed in. The name
  is the profile alias, the identity name, or Account. The detail is the profile email.
  The card links to the profile page only when that policy allows it. A UserCard fragment
  replaces that default. ShowUserCard false omits it. Signed out, the default card is absent.
  NavPlacement.Bottom groups render in NavMenu's pinned nav, and only when a
  permitted page uses Bottom. External stays in the primary nav. The navigation item's
  Width is var(--twe-shell-nav-width). A button under the user card dispatches ToggleMenu.
  That action stores full or rail for this browser (twe.shellNav). From 1280px up the column
  starts full. From 880px through 1279px it starts as the --twe-shell-rail-width rail. The
  stored choice overrides both. Below 880px Fluent's drawer is unchanged and the toggle is
  hidden. Rail rules (clipped labels, centered items, rail user card, 68px column) are one
  set, gated by --twe-nav-rail. The breakpoint and data-twe-nav both set that variable.
  App.razor runs ShellNavScript in the head before the body is parsed. Prerender cannot know
  the stored choice; the script sets data-twe-nav before first paint, so the full column does
  not flash. Without JavaScript the breakpoint default remains.
*@

@code {
  [Inject] private IOptions<BrandOptions> BrandOptionsAccessor { get; set; } = null!;
  [Inject] private NavigationManager NavigationManager { get; set; } = null!;

  private BrandOptions Brand => BrandOptionsAccessor.Value;

  private bool BlockForPasskey =>
    SignInState.PasskeyOffered is true
    && SiteSettingsState.PasskeyPromptMode == PasskeyPromptMode.Required
    && PasskeySoftPrompt.ShouldShow(CredentialsState.Credentials, dismissed: false);

  [Parameter] public string? Title { get; set; }
  [Parameter] public string? BreadcrumbLabel { get; set; }
  [Parameter] public RenderFragment? Description { get; set; }
  [Parameter] public RenderFragment? Actions { get; set; }
  [Parameter] public RenderFragment? ChildContent { get; set; }
  [Parameter] public RenderFragment? Aside { get; set; }
  [Parameter] public bool ShowInBreadcrumbs { get; set; } = true;
  [Parameter] public ShellSearchMode SearchMode { get; set; } = ShellSearchMode.Palette;
  [Parameter] public RenderFragment? Search { get; set; }
  [Parameter] public RenderFragment? UserCard { get; set; }
  [Parameter] public bool ShowUserCard { get; set; } = true;

  // The attribute command-palette.js looks for; the name is CommandPaletteJsModule's constant.
  private static readonly Dictionary<string, object> CommandPaletteTrigger =
    new() { [TimeWarp.Architecture.Services.CommandPaletteJsModule.TriggerAttribute] = true };

  private string? ActiveModalId => ApplicationState.ActiveModalId;
  private bool ShellNavLoaded;
  private async Task ShowAssemblyInfoModalAsync() => await ApplicationState.SetActiveModal(AssemblyInfoModal.ModalId);
  private Task OpenAskPanelAsync() => AgentSurfaceState.OpenAskPanel();
  private Task ToggleNavAsync() => ApplicationState.ToggleMenu();

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender || !RendererInfo.IsInteractive || ShellNavLoaded)
    {
      return;
    }

    ShellNavLoaded = true;
    await ApplicationState.LoadShellNav();
  }

  private string ShellClass =>
    !AgentSurfaceState.IsPanelOpen
      ? "twe-shell"
      : AgentSurfaceState.IsPanelExpanded
        ? "twe-shell twe-shell--ask twe-shell--ask-expanded"
        : "twe-shell twe-shell--ask";

  private RenderFragment TitleBlock => @<text>
    @if (!string.IsNullOrWhiteSpace(Title))
    {
      @if (ShowInBreadcrumbs)
      {
        <TwPageTitle>@Title</TwPageTitle>
      }
      else
      {
        <PageTitle>@Title</PageTitle>
      }
    }
  </text>;

  private RenderFragment? BreadcrumbBlock
  {
    get
    {
      if (!ShowInBreadcrumbs)
      {
        return null;
      }

      IReadOnlyList<PageBreadcrumbTrail.Crumb> crumbs = PageBreadcrumbTrail.Build
      (
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri),
        BreadcrumbLabel,
        Title,
        PageRegistry.All
      );
      if (crumbs.Count == 0)
      {
        return null;
      }

      return @<nav class="twe-page__crumbs" aria-label="Breadcrumb" data-qa="Breadcrumb">
        <ol class="twe-breadcrumb">
          @for (int index = 0; index < crumbs.Count; index++)
          {
            PageBreadcrumbTrail.Crumb crumb = crumbs[index];
            <li class="twe-breadcrumb__item">
              @if (index > 0)
              {
                <span class="twe-breadcrumb__sep" aria-hidden="true">/</span>
              }
              @if (crumb.Href is null)
              {
                <span class="twe-breadcrumb__current" aria-current="page" data-qa="BreadcrumbCurrent">@crumb.Label</span>
              }
              else
              {
                <a class="twe-breadcrumb__link" href="@crumb.Href" data-qa="BreadcrumbLink">@crumb.Label</a>
              }
            </li>
          }
        </ol>
      </nav>;
    }
  }
}

<CascadingValue Value=@this>
  @* Native root: CSS isolation stamps its scope attribute only on elements this component
     authors, never on FluentLayout's root (Wall A). TimeWarpPage.razor.css anchors its
     ::deep rules for Fluent children on this div. *@
  <div class="@ShellClass">
    <FluentLayout Class=@($"{Id} twe-shell__layout") MobileBreakdownWidth="880">

      @* No Height parameter here: with it, FluentLayoutItem swaps its default
         height: var(--layout-header-height) for a hard-coded inline height. The slot
         height comes from the --layout-header-height override in TimeWarpPage.razor.css. *@
      <FluentLayoutItem Area="LayoutArea.Header">
        <header class="twe-appbar">
          <div class="twe-brand">
            @* Horizontal lockup (icon + wordmark side by side) built from the original
               stacked timewarp-logo.svg so the wordmark stays readable at bar height.
               Explicit width/height reserve the box before styles apply (no first-paint
               size flash). *@
            <img class="twe-brand__logo"
                 src="@Brand.LogoSrc"
                 alt="@Brand.LogoAlt"
                 width="@Brand.LogoWidth"
                 height="@Brand.LogoHeight"
                 data-qa="BrandLogo" />
          </div>
          @if (SearchMode == ShellSearchMode.Palette)
          {
            <div class="twe-appbar__search" @attributes=CommandPaletteTrigger>
              <FluentTextInput Placeholder="Search pages and commands" Width="100%" ReadOnly="true" aria-label="Search pages and commands (Ctrl-K)">
                <EndTemplate><span class="search-end">Ctrl-K</span></EndTemplate>
              </FluentTextInput>
            </div>
          }
          else if (SearchMode == ShellSearchMode.Custom && Search is not null)
          {
            <div class="twe-appbar__search">@Search</div>
          }
          <div class="twe-appbar__actions">
            <FluentButton Appearance="ButtonAppearance.Subtle" data-qa="AskAiButton" OnClick="OpenAskPanelAsync">@AgentSurfaceState.AskLabel</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick=@(async () => await ThemeState.Update(ThemeState.Theme.Dark))>
              <FluentIcon Value=@(new Icons.Regular.Size24.DarkTheme()) Color="Color.Default" />
            </FluentButton>
            <Profile />
          </div>
        </header>
      </FluentLayoutItem>

      <FluentLayoutItem Area="LayoutArea.Navigation" Width="var(--twe-shell-nav-width)">
        <div class="twe-nav-column">
          <NavMenu />
          @if (UserCard is not null)
          {
            <div class="twe-nav-column__user">@UserCard</div>
          }
          else if (ShowUserCard)
          {
            <ShellUserCard />
          }
          <div class="twe-nav-column__toggle" data-qa="NavWidthToggle">
            <FluentButton Class="twe-nav-toggle twe-nav-toggle--collapse"
                          Appearance="ButtonAppearance.Subtle"
                          IconOnly="true"
                          IconStart="@(new Icons.Regular.Size20.PanelLeftContract())"
                          Title="Collapse navigation"
                          aria-label="Collapse navigation"
                          aria-expanded="true"
                          OnClick="ToggleNavAsync" />
            <FluentButton Class="twe-nav-toggle twe-nav-toggle--expand"
                          Appearance="ButtonAppearance.Subtle"
                          IconOnly="true"
                          IconStart="@(new Icons.Regular.Size20.PanelLeftExpand())"
                          Title="Expand navigation"
                          aria-label="Expand navigation"
                          aria-expanded="false"
                          OnClick="ToggleNavAsync" />
          </div>
        </div>
      </FluentLayoutItem>

      <FluentLayoutItem Area="LayoutArea.Content">
        <div class="twe-page">
          @TitleBlock
          <PageTitleBar Title="@Title" IsPageHeading="true" Description="Description" Actions="Actions" />
          @BreadcrumbBlock
          <div class="twe-page__body">
            <WebMcpAgentSurface />
            <MessageBars />
            @if (SignInState.PasskeyOffered is true)
            {
              <AddPasskeyPrompt />
            }
            @if (!BlockForPasskey)
            {
              @ChildContent
            }
          </div>
        </div>
      </FluentLayoutItem>

      @* One aside column. Ask owns it while open; the page Aside is the column only while Ask is closed. *@
      @if (AgentSurfaceState.IsPanelOpen)
      {
        <FluentLayoutItem Area="LayoutArea.Aside" Width="450px">
          <AgentAsk />
        </FluentLayoutItem>
      }
      else if (Aside is not null)
      {
        <FluentLayoutItem Area="LayoutArea.Aside" Width="300px">
          <div class="twe-aside">@Aside</div>
        </FluentLayoutItem>
      }

      @* Like the header: no Height parameter, so the item keeps its default
         height: var(--layout-footer-height); TimeWarpPage.razor.css overrides the variable. *@
      <FluentLayoutItem Area="LayoutArea.Footer">
        <footer class="twe-footer">
          <span class="twe-footer__mode">@RendererInfo.Name</span>
          <FluentSpacer />
          <FluentSpinner Visible=@ActionTrackingState.IsActive Size="SpinnerSize.Tiny" />
          <FluentSpacer />
          <FluentButton Appearance="ButtonAppearance.Transparent" @onclick=ShowAssemblyInfoModalAsync>@ApplicationState.Version</FluentButton>
        </footer>
      </FluentLayoutItem>

    </FluentLayout>
  </div>
</CascadingValue>

<ModalController ActiveModalId=@ActiveModalId>
  <ModalContainers>
    <AssemblyInfoModal />
    <CommandPalette />
    <AgentLinkPromptModal />
  </ModalContainers>
</ModalController>
