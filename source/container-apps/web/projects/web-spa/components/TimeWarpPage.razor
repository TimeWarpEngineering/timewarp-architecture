@namespace TimeWarp.Architecture.Components
@inherits BaseComponent
@using TimeWarp.Architecture.Features.Applications
@using TimeWarp.Architecture.Features.Profiles
@using TimeWarp.Features.Theme
@using TimeWarp.Identity
@*
  Purpose: Single app-shell page component. Pages wrap content in
      <TimeWarpPage Title="Settings"> ...content... </TimeWarpPage>

  Design: Built on FluentUI v5 FluentLayout. MainLayout stays empty (FluentProviders only);
  this component owns the chrome so it gets TimeWarp.State render-trigger / Id /
  per-navigation lifecycle that a LayoutComponentBase can't.
  Navigation trail is here (TwBreadcrumb under the h1), not per-page Back buttons.
  TwPageTitle sets document.title and, with PushRouteInfo on after-render, feeds RouteState
  so crumbs use the Title text. TwPageTitle only pushes on its first render; this shell
  also PushRouteInfo when interactive so async titles (role name after FetchRoles) update
  the current stack entry. PushRouteInfo reads document.title via JS — skip it during
  prerender (RendererInfo.IsInteractive). ShowInBreadcrumbs=false still sets PageTitle
  but does not push (403/404/auth must not pollute the trail). TwBreadcrumb emits
  Bootstrap class names with no CSS of its own (timewarp-state 081); a thin wrapper
  under .twe-shell styles that contract with tokens. Do not load Bootstrap.
  RFC 219 D8 / 219-006: AddPasskeyPrompt sits above ChildContent so post-login Home and
  Profile (and every other TimeWarpPage) can show the Entra add-passkey banner. Required
  mode hides ChildContent until a passkey exists. Login uses TimeWarpFocusedPage and never
  hosts this prompt. Soft dismiss is not a gate.
  MessageBars sits above that prompt: it is the ONE notification region per page (task 247),
  painting NotificationState rows (pipeline failures, handler outcomes, AddNotification)
  directly below the breadcrumb and above the first card, without a toast provider. Pages
  render no outcome bars of their own (TWA0025).
  Task 239-003: the appbar search field is the Ctrl-K palette's trigger, not a text box — it is
  ReadOnly and carries the CommandPaletteJsModule trigger attribute, so focusing or clicking it
  opens the CommandPalette modal (as Ctrl-K / Cmd-K anywhere on the page does). The palette is a
  ModalContainer beside AssemblyInfoModal and owns its JS registration; only this shell hosts it.
  Task 290: all shell CSS is in TimeWarpPage.razor.css (CSS isolation), which the browser loads in
  <head> before first paint. A <style>@(...)</style> block here was HTML-encoded by prerender and
  dropped until interactive, so the shell flashed unstyled. Components author no <style> elements
  (skills/tw-blazor-css-strategy).
  Task 293: the shell no longer runs the Ask readiness probe. It ran once per app, so a signed-out
  401 survived an in-app sign-in. AuthenticationStateListener probes at startup and on every
  AuthenticationState change.
  Task 296: Ask is a FluentLayout aside, not a sibling of the layout. FluentLayout's grid is
  `nav content aside` / `auto 1fr auto`, so a 450px aside reflows the page. The layout has one
  aside column. While Ask is open it owns that column and the page Aside parameter is not
  rendered; the page aside returns when Ask closes. Two aside items would share one grid area
  and paint on top of each other. FluentLayout MobileBreakdownWidth is 880. Below that, and
  when the panel is expanded, TimeWarpPage.razor.css covers the viewport with one full-screen
  treatment on `.fluent-layout-item[area=aside]`. `.twe-shell` stays `display: contents`.
  The `twe-shell--ask` class is only the hook for that treatment. It does not change display.
*@

@code {
  [Parameter] public string? Title { get; set; }
  [Parameter] public RenderFragment? ChildContent { get; set; }
  [Parameter] public RenderFragment? Aside { get; set; }
  [Parameter] public bool ShowInBreadcrumbs { get; set; } = true;

  // The attribute command-palette.js looks for; the name is CommandPaletteJsModule's constant.
  private static readonly Dictionary<string, object> CommandPaletteTrigger =
    new() { [TimeWarp.Architecture.Services.CommandPaletteJsModule.TriggerAttribute] = true };

  private string? ActiveModalId => ApplicationState.ActiveModalId;
  private async Task ShowAssemblyInfoModalAsync() => await ApplicationState.SetActiveModal(AssemblyInfoModal.ModalId);
  private Task OpenAskPanelAsync() => AgentSurfaceState.OpenAskPanel();

  private string ShellClass =>
    !AgentSurfaceState.IsPanelOpen
      ? "twe-shell"
      : AgentSurfaceState.IsPanelExpanded
        ? "twe-shell twe-shell--ask twe-shell--ask-expanded"
        : "twe-shell twe-shell--ask";

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    await base.OnAfterRenderAsync(firstRender);
    if (ShowInBreadcrumbs && RendererInfo.IsInteractive)
    {
      await NoSubRouteState.PushRouteInfo();
    }
  }
}

<CascadingValue Value=@this>
  @* Native root: CSS isolation stamps its scope attribute only on elements this component
     authors, never on FluentLayout's root (Wall A). TimeWarpPage.razor.css anchors its
     ::deep rules for Fluent children on this div. *@
  <div class="@ShellClass">
    <FluentLayout Class=@($"{Id} twe-shell__layout") MobileBreakdownWidth="880">

      @* No Height parameter here: with it, FluentLayoutItem swaps its default
         height: var(--layout-header-height) for a hard-coded inline height. The slot
         height comes from the --layout-header-height override in TimeWarpPage.razor.css. *@
      <FluentLayoutItem Area="LayoutArea.Header">
        <header class="twe-appbar">
          <div class="twe-brand">
            @* Horizontal lockup (icon + wordmark side by side) built from the original
               stacked timewarp-logo.svg so the wordmark stays readable at bar height.
               Explicit width/height reserve the box before styles apply (no first-paint
               size flash). *@
            <img class="twe-brand__logo" src="images/timewarp-horizontal.svg" alt="TimeWarp Architecture" width="201" height="48" />
          </div>
          <div class="twe-appbar__search" @attributes=CommandPaletteTrigger>
            <FluentTextInput Placeholder="Search pages and commands" Width="100%" ReadOnly="true" aria-label="Search pages and commands (Ctrl-K)">
              <EndTemplate><span class="search-end">Ctrl-K</span></EndTemplate>
            </FluentTextInput>
          </div>
          <div class="twe-appbar__actions">
            <FluentButton Appearance="ButtonAppearance.Subtle" data-qa="AskAiButton" OnClick="OpenAskPanelAsync">Ask AI</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick=@(async () => await ThemeState.Update(ThemeState.Theme.Dark))>
              <FluentIcon Value=@(new Icons.Regular.Size24.DarkTheme()) Color="Color.Default" />
            </FluentButton>
            <Profile />
          </div>
        </header>
      </FluentLayoutItem>

      <FluentLayoutItem Area="LayoutArea.Navigation" Width="240px">
        <NavMenu />
      </FluentLayoutItem>

      <FluentLayoutItem Area="LayoutArea.Content">
        <div class="twe-page">
          @if (!string.IsNullOrWhiteSpace(Title))
          {
            @if (ShowInBreadcrumbs)
            {
              <TwPageTitle>@Title</TwPageTitle>
            }
            else
            {
              <PageTitle>@Title</PageTitle>
            }
            <h1 class="twe-page__title">@Title</h1>
          }
          @if (ShowInBreadcrumbs)
          {
            <div class="twe-page__crumbs">
              <TwBreadcrumb MaxLinks="4" />
            </div>
          }
          <div class="twe-page__body">
            <WebMcpAgentSurface />
            <MessageBars />
            <AddPasskeyPrompt />
            @if (!(SiteSettingsState.PasskeyPromptMode == PasskeyPromptMode.Required
              && PasskeySoftPrompt.ShouldShow(CredentialsState.Credentials, dismissed: false)))
            {
              @ChildContent
            }
          </div>
        </div>
      </FluentLayoutItem>

      @* One aside column. Ask owns it while open; the page Aside is the column only while Ask is closed. *@
      @if (AgentSurfaceState.IsPanelOpen)
      {
        <FluentLayoutItem Area="LayoutArea.Aside" Width="450px">
          <AgentAsk />
        </FluentLayoutItem>
      }
      else if (Aside is not null)
      {
        <FluentLayoutItem Area="LayoutArea.Aside" Width="300px">
          <div class="twe-aside">@Aside</div>
        </FluentLayoutItem>
      }

      @* Like the header: no Height parameter, so the item keeps its default
         height: var(--layout-footer-height); TimeWarpPage.razor.css overrides the variable. *@
      <FluentLayoutItem Area="LayoutArea.Footer">
        <footer class="twe-footer">
          <span class="twe-footer__mode">@RendererInfo.Name</span>
          <FluentSpacer />
          <FluentSpinner Visible=@ActionTrackingState.IsActive Size="SpinnerSize.Tiny" />
          <FluentSpacer />
          <FluentButton Appearance="ButtonAppearance.Transparent" @onclick=ShowAssemblyInfoModalAsync>@ApplicationState.Version</FluentButton>
        </footer>
      </FluentLayoutItem>

    </FluentLayout>
  </div>
</CascadingValue>

<ModalController ActiveModalId=@ActiveModalId>
  <ModalContainers>
    <AssemblyInfoModal />
    <CommandPalette />
  </ModalContainers>
</ModalController>
