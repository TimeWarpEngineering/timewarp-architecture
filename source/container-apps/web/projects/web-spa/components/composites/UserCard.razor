@namespace TimeWarp.Architecture.Components

@*
  Purpose: Identity row pinned under the navigation menu.

  Design: Native root so CSS isolation stamps the scope attribute. Href makes the
  root an anchor; otherwise it is a div, so a person who cannot open a destination
  still sees the name. The avatar is decorative. Class is appended on the root, and
  unmatched attributes splat onto it. Detail renders only when it has text. This
  card wires no events and reads no state. The shell passes the signed-in name.
*@

@code {
  [Parameter, EditorRequired] public string Name { get; set; } = "";
  [Parameter] public string? Detail { get; set; }
  [Parameter] public string? Href { get; set; }
  [Parameter] public string? Class { get; set; }
  [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

  private bool HasDetail => !string.IsNullOrWhiteSpace(Detail);

  private bool IsLink => !string.IsNullOrWhiteSpace(Href);

  private string RootClass =>
    string.IsNullOrWhiteSpace(Class) ? "twe-user-card" : "twe-user-card " + Class;

  private RenderFragment Body => @<text>
    <Avatar Name="@Name" />
    <span class="twe-user-card__meta">
      <span class="twe-user-card__name">@Name</span>
      @if (HasDetail)
      {
        <span class="twe-user-card__detail">@Detail</span>
      }
    </span>
  </text>;
}

@if (IsLink)
{
  <a class="@RootClass" href="@Href" @attributes="AdditionalAttributes">@Body</a>
}
else
{
  <div class="@RootClass" @attributes="AdditionalAttributes">@Body</div>
}
