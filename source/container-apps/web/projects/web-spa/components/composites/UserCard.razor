@namespace TimeWarp.Architecture.Components

@*
  Purpose: Identity row pinned under the navigation menu.

  Design: Native root so CSS isolation stamps the scope attribute. OnClick makes the
  root a button; otherwise it is a div, so a person who cannot open a destination
  still sees the name. Task 506 (TWA0050): the card was an anchor with Href, which
  navigated outside the store. The caller now passes OnClick and dispatches its
  navigate action (the shell's is RouteState.ChangeRoute to the profile). The avatar
  is decorative. Class is appended on the root, and unmatched attributes splat onto
  it. Detail renders only when it has text. This card reads no state. The shell
  passes the signed-in name.
*@

@code {
  [Parameter, EditorRequired] public string Name { get; set; } = "";
  [Parameter] public string? Detail { get; set; }
  [Parameter] public EventCallback OnClick { get; set; }
  [Parameter] public string? Class { get; set; }
  [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

  private bool HasDetail => !string.IsNullOrWhiteSpace(Detail);

  private bool IsAction => OnClick.HasDelegate;

  private string RootClass =>
    string.IsNullOrWhiteSpace(Class) ? "twe-user-card" : "twe-user-card " + Class;

  private RenderFragment Body => @<text>
    <Avatar Name="@Name" />
    <span class="twe-user-card__meta">
      <span class="twe-user-card__name">@Name</span>
      @if (HasDetail)
      {
        <span class="twe-user-card__detail">@Detail</span>
      }
    </span>
  </text>;
}

@if (IsAction)
{
  <button type="button" class="@RootClass" @onclick="OnClick" @attributes="AdditionalAttributes">@Body</button>
}
else
{
  <div class="@RootClass" @attributes="AdditionalAttributes">@Body</div>
}
