@namespace TimeWarp.Architecture.Components
@implements IDisposable

@*
  Purpose: Paper toolbar for list filters — optional search, then the caller's controls.

  Design: Native div root so CSS isolation stamps the scope attribute. Unmatched attributes
  splat onto that root, as Card does. The root carries role="toolbar".
  FluentUI Blazor 5.0.1 has no FluentSearch type (the component catalog that ships with that
  package). The box is FluentTextInput, TextInputType.Search, with Icons.Regular.Size16.Search
  in StartTemplate. Immediate is on and ImmediateDelay is 0 so each keystroke reaches this
  component; Fluent's own delay is not the clock. SearchDebouncer waits on the injected
  TimeProvider and then raises SearchTextChanged once. Empty text (the clear control) and
  Escape publish immediately and cancel a pending wait. A text equal to the last published
  value is not published again, immediate or delayed, and that path still cancels the
  pending wait. The baseline is SearchText on the first parameter set, or empty when that
  is unset: Escape on an empty box does not fetch, the browser's search-clear after Escape
  does not fetch a second time, and typing back to that text before the delay elapses
  cancels the wait and does not publish. Dispose cancels that wait. The callback runs
  through InvokeAsync. This component stores no filter and fetches nothing; the page
  handler only dispatches a TimeWarp.State action.
*@

@code {
  [Parameter] public bool ShowSearch { get; set; } = true;
  [Parameter] public string SearchPlaceholder { get; set; } = "Search…";
  [Parameter] public string? SearchText { get; set; }
  [Parameter] public EventCallback<string> SearchTextChanged { get; set; }
  [Parameter] public TimeSpan SearchDelay { get; set; } = TimeSpan.FromMilliseconds(300);
  [Parameter] public RenderFragment? ChildContent { get; set; }
  [Parameter] public string? Class { get; set; }
  [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

  [Inject] private TimeProvider Clock { get; set; } = default!;

  private SearchDebouncer? Debouncer;
  private int Disposed;
  private string LastPublished = "";
  private bool BaselineReady;

  private const string PlaceholderStyle = "::placeholder { color: var(--twe-muted); }";

  private SearchDebouncer Timer => Debouncer ??= new SearchDebouncer(Clock);

  protected override void OnParametersSet()
  {
    if (BaselineReady)
    {
      return;
    }

    LastPublished = SearchText ?? "";
    BaselineReady = true;
  }

  internal Task OnSearchChanged(string? value)
  {
    string text = value ?? "";
    return ScheduleAsync(text, immediate: text.Length == 0);
  }

  internal Task OnSearchKeyDown(KeyboardEventArgs args)
  {
    if (!string.Equals(args.Key, "Escape", StringComparison.Ordinal))
    {
      return Task.CompletedTask;
    }

    return ScheduleAsync("", immediate: true);
  }

  private Task ScheduleAsync(string text, bool immediate)
  {
    if (string.Equals(text, LastPublished, StringComparison.Ordinal))
    {
      Debouncer?.Cancel();
      return Task.CompletedTask;
    }

    return Timer.ScheduleAsync(text, SearchDelay, immediate, PublishAsync);
  }

  private Task PublishAsync(string text)
  {
    if (Volatile.Read(ref Disposed) != 0 || string.Equals(text, LastPublished, StringComparison.Ordinal))
    {
      return Task.CompletedTask;
    }

    LastPublished = text;
    return InvokeAsync(async () =>
    {
      if (Volatile.Read(ref Disposed) != 0)
      {
        return;
      }

      await SearchTextChanged.InvokeAsync(text);
    });
  }

  public void Dispose()
  {
    if (Interlocked.Exchange(ref Disposed, 1) != 0)
    {
      return;
    }

    Debouncer?.Dispose();
  }
}

<div class="twe-filter-bar @Class" role="toolbar" @attributes="AdditionalAttributes">
  @if (ShowSearch)
  {
    <div class="twe-filter-bar__search">
      <FluentTextInput Placeholder="@SearchPlaceholder"
                       Value="@SearchText"
                       ValueChanged="@OnSearchChanged"
                       Immediate="true"
                       ImmediateDelay="0"
                       TextInputType="TextInputType.Search"
                       AriaLabel="@SearchPlaceholder"
                       Width="100%"
                       ControlStyle="@PlaceholderStyle"
                       @onkeydown="OnSearchKeyDown">
        <StartTemplate>
          <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Color="Color.Default" />
        </StartTemplate>
      </FluentTextInput>
    </div>
  }
  @ChildContent
</div>
