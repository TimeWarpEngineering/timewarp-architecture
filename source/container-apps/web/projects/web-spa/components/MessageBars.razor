@namespace TimeWarp.Architecture.Components
@inherits BaseComponent

@code {
  // Purpose: The one notification region — paints NotificationState as MessageBar rows.
  // Design: Section and Card have no error slot. Operation outcomes are application-surface
  // status, so this host sits at the top of TimeWarpPage and TimeWarpFocusedPage, directly
  // below the header/breadcrumb and above the first card, and is the ONLY place a message bar
  // with Error/Success intent may render (TWA0025). Pages report through NotificationState;
  // they never paint their own outcome bars.
  // Shape: each row is the shared MessageBar control (Title + optional Body; Notification
  // layout when there is no body, MultiLine when there is). Dismiss dispatches DismissMessage
  // so the row stays gone across re-renders.
  // Cap: NotificationState.VisibleMessages is the newest MaxVisible; "+N more" toggles the
  // full list (ShowAll is view-only state, reset per page because this host is re-created).
  // Lifetime: after each render the host schedules ExpireMessages for NotificationState
  // .NextExpiry (Success auto-dismiss, and the end of any bar's "Copied" confirmation);
  // navigation clearing lives in NavigationListener.
  // Copy (task 313, shared in task 445): MessageBar paints the Copy button before Dismiss. Rows
  // pass NotificationId, so Copy dispatches CopyMessage(id) and the row matching
  // CopiedMessageId shows the "Copied" check until the ExpireMessages timer clears it.
  // Spacing: MessageBars.razor.css owns the bar gap and bottom margin via tokens; the
  // fluent-message-bar actions slot spaces Copy and Dismiss itself.
  // Ask Tag (task 346): MessageBar marks each bar as AskTagMark.MessageBarKind(intent) ("Error
  // bar") with its title as the label.
  // No INotificationService and no FluentMessageBarProvider — headless tests never render this.

  private bool ShowAll;
  private CancellationTokenSource? ExpiryCts;
  private DateTimeOffset? ScheduledExpiry;

  private IReadOnlyList<NotificationState.NotificationMessage> Rows =>
    ShowAll ? NotificationState.Messages : NotificationState.VisibleMessages;

  private int HiddenCount => ShowAll ? 0 : NotificationState.HiddenCount;

  private Task DismissAsync(string id) =>
    NotificationState.DismissMessage(id, CancellationToken);

  private void ToggleShowAll() => ShowAll = !ShowAll;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    await base.OnAfterRenderAsync(firstRender);
    if (!RendererInfo.IsInteractive)
    {
      return;
    }

    ScheduleExpiry();
  }

  private void ScheduleExpiry()
  {
    DateTimeOffset? nextExpiry = NotificationState.NextExpiry;
    if (nextExpiry == ScheduledExpiry)
    {
      return;
    }

    ExpiryCts?.Cancel();
    ExpiryCts?.Dispose();
    ExpiryCts = null;
    ScheduledExpiry = nextExpiry;
    if (nextExpiry is null)
    {
      return;
    }

    ExpiryCts = CancellationTokenSource.CreateLinkedTokenSource(CancellationToken);
    _ = ExpireAfterAsync(nextExpiry.Value, ExpiryCts.Token);
  }

  private async Task ExpireAfterAsync(DateTimeOffset expiry, CancellationToken cancellationToken)
  {
    TimeSpan delay = expiry - DateTimeOffset.UtcNow;
    try
    {
      if (delay > TimeSpan.Zero)
      {
        await Task.Delay(delay, cancellationToken);
      }

      await InvokeAsync(() => NotificationState.ExpireMessages(DateTimeOffset.UtcNow, cancellationToken));
    }
    catch (OperationCanceledException)
    {
      // Host disposed or a newer expiry superseded this one.
    }
  }

  public override void Dispose()
  {
    ExpiryCts?.Cancel();
    ExpiryCts?.Dispose();
    ExpiryCts = null;
    base.Dispose();
    GC.SuppressFinalize(this);
  }
}

@if (NotificationState.Messages.Count > 0)
{
  <div class="twe-message-bars" data-qa="MessageBars">
    @foreach (NotificationState.NotificationMessage message in Rows)
    {
      <MessageBar @key="message.Id"
                  NotificationId="@message.Id"
                  Intent="@message.Intent"
                  Title="@message.Title"
                  Body="@message.Body">
        <ActionsTemplate>
          <FluentButton Size="ButtonSize.Small" data-qa="MessageBarDismiss" OnClick="@(() => DismissAsync(message.Id))">
            Dismiss
          </FluentButton>
        </ActionsTemplate>
      </MessageBar>
    }
    @if (HiddenCount > 0)
    {
      <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" data-qa="MessageBarsShowMore" OnClick="ToggleShowAll">
        +@HiddenCount more
      </FluentButton>
    }
    else if (ShowAll && NotificationState.HiddenCount > 0)
    {
      <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" data-qa="MessageBarsShowLess" OnClick="ToggleShowAll">
        Show fewer
      </FluentButton>
    }
  </div>
}
