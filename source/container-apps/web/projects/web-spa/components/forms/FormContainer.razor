@namespace TimeWarp.Architecture.Components
@*
  Purpose: card-wrapped form shell with title row, main content, and FormActions.

  Design: folds onto the shared form primitives — ActionContent renders inside
  FormActions (right-aligned, --twe-space-3). Header uses the same section-title
  token as FormSection. No inline styles (CSP). TodoItemFormContainer is the caller.
*@

@code {
  [Parameter] public RenderFragment? MainContent { get; set; }
  [Parameter] public RenderFragment? TitleContent { get; set; }
  [Parameter] public RenderFragment? ActionContent { get; set; }
  [Parameter] public RenderFragment? TitleButtonContent { get; set; }
}

<Card>
  <div class="twe-form-container">
    <div class="twe-form-container__header">
      <h2 class="twe-form-container__title">@TitleContent</h2>
      @TitleButtonContent
    </div>
    <div class="twe-form-container__main">@MainContent</div>
    <FormActions>@ActionContent</FormActions>
  </div>
</Card>
