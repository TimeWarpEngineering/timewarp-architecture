@namespace TimeWarp.Architecture.Components

@code
{
#if ReduxDevToolsEnabled
  private static bool ReduxDevToolsEnabled => true;
  [Inject] private ReduxDevToolsInterop ReduxDevToolsInterop { get; set; } = default!;
#else
  private static bool ReduxDevToolsEnabled => false;
#endif

  [Inject] private JsonRequestHandler JsonRequestHandler { get; set; } = default!;

  protected override async Task OnAfterRenderAsync(bool aFirstRender)
  {
#if ReduxDevToolsEnabled
    await ReduxDevToolsInterop.InitAsync().ConfigureAwait(false);
#endif
    await JsonRequestHandler.InitAsync().ConfigureAwait(false);
  }
}

<CascadingAuthenticationState>
  <Router
    AppAssembly=@typeof(IAssemblyMarker).Assembly
    AdditionalAssemblies=@(new[] { typeof(IAssemblyMarker).Assembly })>
    <Found Context="routeData">
      <AuthorizeRouteView RouteData=@routeData DefaultLayout=@typeof(MainLayout)>
        <NotAuthorized>
          @if (context.User.Identity?.IsAuthenticated != true)
          {
            <RedirectToLogin/>
          }
          else
          {
            <ForbiddenPage/>
          }
        </NotAuthorized>
      </AuthorizeRouteView>
      <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
    </Found>
    <NotFound>
      <NotFoundPage/>
    </NotFound>
  </Router>

  @* ReduxDevTools ships only when ReduxDevToolsEnabled (Debug-only symbol, task 119): the
     component injects ReduxDevToolsInterop, which program.cs registers under the SAME symbol.
     web-server prerenders this tree with those same services, so an unconditional component
     with a conditional registration 500'd every Release SPA-shell request. *@
  @if (ReduxDevToolsEnabled)
  {
    <ReduxDevTools />
  }
  <TimeWarpJavaScriptInterop />
  @* Loads/clears ProfileState + AuthorizationState when AuthenticationState changes (sign-in/out). *@
  <AuthenticationStateListener />
</CascadingAuthenticationState>
