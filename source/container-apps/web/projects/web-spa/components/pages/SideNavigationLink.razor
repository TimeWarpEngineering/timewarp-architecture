@namespace TimeWarp.Architecture.Components
@inherits ParentComponent

@code {
  private readonly string BaseClasses = "";

  private BlazorComponentUtilities.CssBuilder CssBuilder =>
    new BlazorComponentUtilities.CssBuilder(BaseClasses)
    .AddClassFromAttributes(Attributes);
}

<NavLink class=@CssBuilder @attributes=Attributes>
  @ChildContent
</NavLink>
