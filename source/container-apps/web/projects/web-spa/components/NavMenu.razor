@namespace TimeWarp.Architecture.Components
@using TimeWarp.Architecture.Features.Applications

@code {
  // Purpose: Primary navigation for the app shell (rendered in TimeWarpPage's Navigation area).
  // Design: Rendered from NavigationDestinations (task 300): the generated PageRegistry
  // ([Page(Navigable = true)]) filtered by each page's own Policy for the signed-in principal,
  // in NavOrder. The same list is the Ctrl-K palette's pages and the agent's navigate and
  // site_map destinations, so the menu cannot drift from them. A page's [Page] NavGroup names
  // its FluentNavCategory; consecutive pages with the same group share one category and "" is
  // the top level. There is no category gate: Admin, Demos and Developer show when one of their
  // pages is permitted. Template flags need no markup here: a page excluded by a flag (api's
  // Weather, grpc's Superheros) is not compiled, so it is not in the registry. Login is not a
  // registry page (the profile menu and the palette's Sign in row reach it). The External
  // category is plain links to other sites, not app pages. Destinations are re-read only when
  // the cascaded authentication state task is replaced (sign-in and sign-out), not on every
  // parent render.

  [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

  [Inject] private IAuthorizationService AuthorizationService { get; set; } = null!;

  private List<(string Group, List<PageRegistryEntry> Pages)> Groups = [];

  private Task<AuthenticationState>? LoadedAuthenticationState;

  private bool Loaded;

  protected override async Task OnParametersSetAsync()
  {
    if (Loaded && ReferenceEquals(LoadedAuthenticationState, AuthenticationState))
    {
      return;
    }

    Loaded = true;
    LoadedAuthenticationState = AuthenticationState;
    ClaimsPrincipal user = AuthenticationState is null
      ? new ClaimsPrincipal(new ClaimsIdentity())
      : (await AuthenticationState).User;
    List<(string Group, List<PageRegistryEntry> Pages)> groups = [];
    foreach (PageRegistryEntry destination in await NavigationDestinations.ForAsync(user, AuthorizationService))
    {
      if (groups.Count == 0 || !string.Equals(groups[^1].Group, destination.NavGroup, StringComparison.Ordinal))
      {
        groups.Add((destination.NavGroup, []));
      }

      groups[^1].Pages.Add(destination);
    }

    Groups = groups;
  }
}

<FluentNav Class="twe-nav">
  @foreach ((string group, List<PageRegistryEntry> pages) in Groups)
  {
    if (group.Length == 0)
    {
      foreach (PageRegistryEntry destination in pages)
      {
        <FluentNavItem IconRest=destination.NavIcon Href=@destination.Url Match=NavLinkMatch.All>@destination.Title</FluentNavItem>
      }
    }
    else
    {
      <FluentNavCategory Title=@group>
        @foreach (PageRegistryEntry destination in pages)
        {
          <FluentNavItem IconRest=destination.NavIcon Href=@destination.Url Match=NavLinkMatch.All>@destination.Title</FluentNavItem>
        }
      </FluentNavCategory>
    }
  }

  <FluentNavCategory Title="External">
    <FluentNavItem IconRest=@(new Icons.Regular.Size20.Link()) Href="https://thefreezeteam.com/" Target="LinkTarget.Blank">The Freeze Team</FluentNavItem>
    <FluentNavItem IconRest=@(new Icons.Regular.Size20.Link()) Href="https://github.com/TimeWarpEngineering/timewarp-architecture" Target="LinkTarget.Blank">GitHub</FluentNavItem>
  </FluentNavCategory>
</FluentNav>
