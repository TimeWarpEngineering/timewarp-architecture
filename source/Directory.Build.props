<Project>
  <!-- Import parent Directory.Build.props. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Platform distribution switches (UseFoundationPackages / UseAnalyzerPackages /
       UseIdentityPackages) moved to ROOT Directory.Build.props (task 124): tests/ projects need
       them too, and the source-tree props never reach the tests tree. -->

  <!-- Default package metadata (can be overridden in individual projects) -->
  <PropertyGroup Label="Package Metadata">
    <!-- Single repo-wide package version. Lives here (not root) so it matches the TimeWarp convention
         and `dev check-version`, which read source/Directory.Build.props. Keep in sync with the
         timewarp-templates tree's <Version> — both publish at this version. -->
    <Version>2.0.0-beta.32</Version>
    <Authors>Steven T. Cramer</Authors>
    <RepositoryUrl>https://github.com/TimeWarpEngineering/timewarp-architecture</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/TimeWarpEngineering/timewarp-architecture</PackageProjectUrl>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
    <!-- Deterministic + SourceLink (built into the .NET SDK); only affects packable projects. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Label="Shared Package Assets">
    <None Include="$(RepositoryRoot)assets/logo.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Repo-wide convention analyzers. The wiring is in the root Directory.Build.props, shared with
       tests/ and tools/ (task 470). -->
  <PropertyGroup Label="Convention Analyzers">
    <EnableConventionAnalyzers>true</EnableConventionAnalyzers>
  </PropertyGroup>

</Project>
