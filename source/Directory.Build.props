<Project>
  <!-- Import parent Directory.Build.props. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Platform distribution switches (UseFoundationPackages / UseAnalyzerPackages /
       UseIdentityPackages) moved to ROOT Directory.Build.props (task 124): tests/ projects need
       them too, and the source-tree props never reach the tests tree. -->

  <!-- Default package metadata (can be overridden in individual projects) -->
  <PropertyGroup Label="Package Metadata">
    <!-- Single repo-wide package version. Lives here (not root) so it matches the TimeWarp convention
         and `dev check-version`, which read source/Directory.Build.props. Keep in sync with the
         timewarp-templates tree's <Version> — both publish at this version. -->
    <Version>2.0.0-beta.8</Version>
    <Authors>Steven T. Cramer</Authors>
    <RepositoryUrl>https://github.com/TimeWarpEngineering/timewarp-architecture</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/TimeWarpEngineering/timewarp-architecture</PackageProjectUrl>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
    <!-- Deterministic + SourceLink (built into the .NET SDK); only affects packable projects. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Label="Shared Package Assets">
    <None Include="$(RepositoryRoot)assets/logo.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Repo-wide convention analyzers (TWA0002–0016 only — no source generators). Project ref in
       monorepo; platform Analyzers package in generated apps (UseAnalyzerPackages). Package ID is
       composed (task 115) so template sourceName cannot rewrite it. -->
  <ItemGroup Condition="'$(UseAnalyzerPackages)' != 'true' and '$(MSBuildProjectName)' != 'timewarp-architecture-convention-analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analyzers/timewarp-architecture-convention-analyzers/timewarp-architecture-convention-analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      IsAspireProjectResource="false" />
    <!-- TWA0009 reads build_property.TimeWarpSliceRoot for an optional SliceRoot override.
         Custom properties are not analyzer-visible unless listed (RootNamespace is SDK-visible). -->
    <CompilerVisibleProperty Include="TimeWarpSliceRoot" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseAnalyzerPackages)' == 'true'">
    <PackageReference Include="$(TwArchitectureAnalyzersPackageId)" PrivateAssets="all" />
    <CompilerVisibleProperty Include="TimeWarpSliceRoot" />
  </ItemGroup>

  <!-- template.json feeds TWA0010 (template-flag directives must have matching DefineConstants).
       Absent in generated apps — the analyzer is silent there. -->
  <ItemGroup Condition="Exists('$(RepositoryRoot).template.config/template.json')">
    <AdditionalFiles Include="$(RepositoryRoot).template.config/template.json" />
  </ItemGroup>

</Project>
