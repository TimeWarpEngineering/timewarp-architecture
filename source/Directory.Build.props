<Project>
  <!-- Import parent Directory.Build.props. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Foundation distribution switch (task 051). The container-apps reference the foundation layer
       as project refs in THIS repo (where the source lives) and as published TimeWarp.Foundation.*
       NuGet packages in an app generated from the template (where the source is excluded). We detect
       which world we're in by whether the foundation source is present — so the csproj switch and the
       dotnet-new template exclusion agree automatically. Can be forced via -p:UseFoundationPackages=. -->
  <PropertyGroup>
    <UseFoundationPackages Condition="'$(UseFoundationPackages)' == '' and !Exists('$(MSBuildThisFileDirectory)foundation/foundation-domain/foundation-domain.csproj')">true</UseFoundationPackages>
    <UseFoundationPackages Condition="'$(UseFoundationPackages)' == ''">false</UseFoundationPackages>
  </PropertyGroup>

  <!-- Analyzer distribution switch (task 092). Same dual-mode idea as foundation: ProjectReference
       when source/analyzers is present (this repo dogfoods the projects); PackageReference when the
       template excluded analyzer source (generated apps). Force with -p:UseAnalyzerPackages=. -->
  <PropertyGroup>
    <UseAnalyzerPackages Condition="'$(UseAnalyzerPackages)' == '' and !Exists('$(MSBuildThisFileDirectory)analyzers/timewarp-architecture-convention-analyzers/timewarp-architecture-convention-analyzers.csproj')">true</UseAnalyzerPackages>
    <UseAnalyzerPackages Condition="'$(UseAnalyzerPackages)' == ''">false</UseAnalyzerPackages>
  </PropertyGroup>

  <!-- Identity distribution switch (task 115). Independent of foundation: generated apps default to
       shipping identity SOURCE (identityPackages=false) until TimeWarp.Identity is published.
       Force with -p:UseIdentityPackages=. -->
  <PropertyGroup>
    <UseIdentityPackages Condition="'$(UseIdentityPackages)' == '' and !Exists('$(MSBuildThisFileDirectory)libraries/timewarp-identity/timewarp-identity.csproj')">true</UseIdentityPackages>
    <UseIdentityPackages Condition="'$(UseIdentityPackages)' == ''">false</UseIdentityPackages>
  </PropertyGroup>

  <!-- Default package metadata (can be overridden in individual projects) -->
  <PropertyGroup Label="Package Metadata">
    <!-- Single repo-wide package version. Lives here (not root) so it matches the TimeWarp convention
         and `dev check-version`, which read source/Directory.Build.props. Keep in sync with the
         timewarp-templates tree's <Version> — both publish at this version. -->
    <Version>2.0.0-beta.5</Version>
    <Authors>Steven T. Cramer</Authors>
    <RepositoryUrl>https://github.com/TimeWarpEngineering/timewarp-architecture</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/TimeWarpEngineering/timewarp-architecture</PackageProjectUrl>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
    <!-- Deterministic + SourceLink (built into the .NET SDK); only affects packable projects. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Label="Shared Package Assets">
    <None Include="$(RepositoryRoot)assets/logo.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Repo-wide convention analyzers (TWA0002–0016 only — no source generators). Project ref in
       monorepo; platform Analyzers package in generated apps (UseAnalyzerPackages). Package ID is
       composed (task 115) so template sourceName cannot rewrite it. -->
  <ItemGroup Condition="'$(UseAnalyzerPackages)' != 'true' and '$(MSBuildProjectName)' != 'timewarp-architecture-convention-analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analyzers/timewarp-architecture-convention-analyzers/timewarp-architecture-convention-analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      IsAspireProjectResource="false" />
    <!-- TWA0009 reads build_property.TimeWarpSliceRoot for an optional SliceRoot override.
         Custom properties are not analyzer-visible unless listed (RootNamespace is SDK-visible). -->
    <CompilerVisibleProperty Include="TimeWarpSliceRoot" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseAnalyzerPackages)' == 'true'">
    <PackageReference Include="$(TwArchitectureAnalyzersPackageId)" PrivateAssets="all" />
    <CompilerVisibleProperty Include="TimeWarpSliceRoot" />
  </ItemGroup>

  <!-- template.json feeds TWA0010 (template-flag directives must have matching DefineConstants).
       Absent in generated apps — the analyzer is silent there. -->
  <ItemGroup Condition="Exists('$(RepositoryRoot).template.config/template.json')">
    <AdditionalFiles Include="$(RepositoryRoot).template.config/template.json" />
  </ItemGroup>

</Project>
