<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>TimeWarp.Foundation.Server</PackageId>
    <Title>TimeWarp.Foundation.Server</Title>
    <Description>ASP.NET server building blocks (modules, base endpoints, CORS) for the TimeWarp foundation layer.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FastEndpoints.OpenApi" />
    <!-- Lift FastEndpoints.OpenApi's net11.0 floor (11.0.0-rc.2) to the RC3 train pin. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Lift Microsoft.AspNetCore.OpenApi's Microsoft.OpenApi 3.10.2 floor to the 3.11.0 pin. -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="TimeWarp.Mediator" />
    <PackageReference Include="OneOf" />
    <PackageReference Include="Scalar.AspNetCore" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\foundation-infrastructure\foundation-infrastructure.csproj" />
  </ItemGroup>
</Project>