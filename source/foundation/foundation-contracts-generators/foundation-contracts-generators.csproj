<Project Sdk="Microsoft.NET.Sdk">

  <!-- Roslyn source generator for [ApiRoute]/[AuthApiRequest]/[OpenDataQueryParameters] (task 053)
       and the [Offerable] Offer record (task 281).
       Targets net10.0 (inherited from Directory.Build.props, matching timewarp-architecture-analyzers)
       and ships as an analyzer asset inside the TimeWarp.Foundation.Contracts package. We do NOT
       target netstandard2.0 — that only matters for hosts running Roslyn on .NET Framework (Visual
       Studio); the dotnet CLI build host is .NET. Not packed on its own. -->
  <PropertyGroup>
    <RootNamespace>TimeWarp.Foundation.Contracts.Generators</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- CA1031: generators must be resilient. RS1041: distributing for the compiler host.
         RS2008: release tracking for the linked TWE descriptors lives with the SSOT (see below). -->
    <NoWarn>$(NoWarn);RS1041;CA1031;CA1062;NU5128;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- TWE SSOT (task 281): the [Offerable] diagnostics TWE012/TWE013 are declared in the
         Generators package's descriptor registry and linked here, so IDs stay unique across both
         generator assemblies. Release tracking for them lives beside the SSOT
         (timewarp-architecture-analyzers/AnalyzerReleases.Unshipped.md), so RS2008 is off here. -->
    <Compile Include="..\..\analyzers\timewarp-architecture-analyzers\diagnostics\diagnostic-descriptors.cs" Link="diagnostics\diagnostic-descriptors.cs" />
    <Using Include="Microsoft.CodeAnalysis" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
