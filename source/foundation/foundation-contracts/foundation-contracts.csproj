<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>TimeWarp.Foundation.Contracts</PackageId>
    <Title>TimeWarp.Foundation.Contracts</Title>
    <Description>Shared contracts, request/response markers, route/auth/query source generator, and common types for the TimeWarp foundation layer.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="libphonenumber-csharp" />
    <PackageReference Include="TimeWarp.Mediator.Contracts" />
    <PackageReference Include="TimeWarp.Mediator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="OneOf" />
  </ItemGroup>

  <!-- The contracts generator (task 053) ships as an analyzer asset of this package. foundation-contracts
       only DEFINES the markers (it doesn't apply them), so we build the generator (for ordering) but
       do NOT run it here; we BUNDLE its dll as an analyzer asset (same pattern as timewarp-nuru) so
       consumers of the package get the generator automatically via PackageReference. -->
  <ItemGroup>
    <ProjectReference Include="..\foundation-contracts-generators\foundation-contracts-generators.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\foundation-contracts-generators\bin\$(Configuration)\$(TargetFramework)\foundation-contracts-generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
