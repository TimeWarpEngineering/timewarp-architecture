<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>$(TwArchitectureAnalyzersPackageId)</PackageId>
    <Title>$(TwArchitectureAnalyzersPackageId)</Title>

    <Description>Roslyn convention analyzers for TimeWarp Architecture (TWA0002–TWA0050 except the generic style ids; retired ids in AnalyzerReleases.Unshipped.md). Analyzer-only package; safe to reference from every project including contracts. Generic style rules TWA0004, TWA0023, and TWA0038 are reported by TimeWarp.SourceGenerators 1.0.0-beta.13 and later, with those same IDs. A reference that exists only for those rules takes TimeWarp.SourceGenerators and does not take this package.</Description>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Convention-enforcement DiagnosticAnalyzers only (no source generators), so this assembly is
         safe to reference from every project — including contracts — without triggering the
         FastEndpoint generator. Wired repo-wide via source/Directory.Build.props. -->
    <!-- Suppress RS1041: Analyzer intentionally targets net11.0 for CLI usage -->
    <!-- Suppress CA1031: Analyzers must be resilient and catch general exceptions -->
    <!-- Suppress CA1062: Roslyn framework guarantees non-null analysis-context parameters -->
    <NoWarn>$(NoWarn);RS1041;CA1031;CA1062</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- F-004: shared hosted-route discovery linked into both Generators and Analyzers packages
         (no ProjectReference between them). -->
    <Compile Include="..\shared\hosted-route-discovery.cs" Link="shared\hosted-route-discovery.cs" />
    <Compile Include="..\shared\referenceable-resource-shape.cs" Link="shared\referenceable-resource-shape.cs" />
    <Compile Include="..\shared\details-copy-classification.cs" Link="shared\details-copy-classification.cs" />
  </ItemGroup>

  <!-- Feature filename grammar SSOT: feature-filename-grammar.json → committed feature-filename-grammar.g.cs
       plus one source/container-apps/{web,api,grpc}/msbuild/feature-filename-grammar.g.props per family.
       The build does not regenerate them. Edit the JSON and run `dev regenerate-generated`
       (tools/dev-cli/services/feature-filename-grammar-generator.cs); `dev workflow` fails CI on drift. -->
  <ItemGroup>
    <None Include="feature-filename-grammar.json" />
    <!-- Keep generated C# in compile; it is the baked-in registry for the packaged analyzer. -->
    <Compile Update="feature-filename-grammar.g.cs" AutoGen="true" DesignTime="true" />
  </ItemGroup>
</Project>
