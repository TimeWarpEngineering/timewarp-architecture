<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>$(TwArchitectureGeneratorsPackageId)</PackageId>
    <Title>$(TwArchitectureGeneratorsPackageId)</Title>

    <Description>Roslyn source generators and diagnostics for TimeWarp Architecture (FastEndpoint, Page, StateAccess, mock-factory registry, TypedId, ingress route prefixes) — TWA0001 and TWA0017/0018. Analyzer-only; attach only where generators should run — not repo-wide.</Description>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Suppress RS1041: Analyzer intentionally targets net10.0 for CLI usage -->
    <!-- Suppress CA1031: Source generators must be resilient and catch general exceptions -->
    <!-- Suppress CA1062: Roslyn framework guarantees non-null AnalysisContext/CompilationStartAnalysisContext parameters -->
    <NoWarn>$(NoWarn);RS1041;CA1031;CA1062</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile-time only; generator matches [ApiEndpoint] by metadata name. Consumers take a
         separate TimeWarp.Architecture.Attributes PackageReference where they apply the attribute.
         PrivateAssets so the project ref never flows as a runtime dependency of this analyzer. -->
    <ProjectReference Include="../timewarp-architecture-attributes/timewarp-architecture-attributes.csproj"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
