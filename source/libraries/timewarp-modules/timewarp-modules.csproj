<Project Sdk="Microsoft.NET.Sdk">
  <!-- Version + shared metadata inherited from source/Directory.Build.props (single repo version). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>TimeWarp.Modules</PackageId>
    <Title>TimeWarp.Modules</Title>
    <Description>Lightweight IModule composition abstraction used by the TimeWarp foundation layer.</Description>
    <PackageTags>timewarp;modules;dependency-injection</PackageTags>
  </PropertyGroup>
  <!-- Configuration.Abstractions and DependencyInjection.Abstractions ship in the net11
       shared framework (NU1510). A direct PackageReference is a restore error. -->
</Project>
