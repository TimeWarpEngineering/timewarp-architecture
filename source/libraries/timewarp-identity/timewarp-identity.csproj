<Project Sdk="Microsoft.NET.Sdk">
  <!-- Version + shared metadata inherited from source/Directory.Build.props (single repo version). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>TimeWarp.Identity</PackageId>
    <Title>TimeWarp.Identity</Title>
    <Description>Principal identity (passkeys, agent keys, sessions/tokens, trust tiers) for TimeWarp applications.</Description>
    <PackageTags>timewarp;identity;webauthn;passkey;agents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- [TypedId] BCL surface for PrincipalId / CredentialId (task 104-027). Generators only —
         not the repo-wide convention analyzer package. -->
    <ProjectReference Include="../../analyzers/timewarp-architecture-analyzers/timewarp-architecture-analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      Condition="'$(UseAnalyzerPackages)' != 'true'" />
    <PackageReference Include="$(TwArchitectureGeneratorsPackageId)" PrivateAssets="all"
                      Condition="'$(UseAnalyzerPackages)' == 'true'" />
  </ItemGroup>

  <!-- TypedIdAttribute is emitted into the platform root namespace by Generators (package mode =
       fixed composed root; source mode = literal that sourceName rewrites with the app name,
       matching AttributeSource rewrite in the generator). Task 115. -->
  <ItemGroup>
    <Using Include="$(TwArchitectureRootNamespace)" Condition="'$(UseAnalyzerPackages)' == 'true'" />
    <Using Include="TimeWarp.Architecture" Condition="'$(UseAnalyzerPackages)' != 'true'" />
  </ItemGroup>


  <ItemGroup>
    <!-- Entity<TId> (typed id, identity equality, Version) for Principal/Credential (task 104-028).
         Dual-mode, mirroring web-domain.csproj: ProjectReference in this monorepo, PackageReference
         in package mode. foundation-domain only — this library stays independent of the rest of
         foundation (application/server layers). -->
    <ProjectReference Include="../../foundation/foundation-domain/foundation-domain.csproj" Condition="'$(UseFoundationPackages)' != 'true'" />
    <PackageReference Include="TimeWarp.Foundation.Domain" Condition="'$(UseFoundationPackages)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hand-rolled WebAuthn verifier (task 104-003): attestationObject/authenticatorData/COSE_Key
         are CBOR-encoded per spec. Microsoft/MIT, BCL-adjacent (ships in the ASP.NET Core shared
         framework too) — not a third-party dependency in the Fido2NetLib sense; see the
         "CENTRAL DECISION" Design region in ceremonies/webauthn/webauthn-registration.cs. -->
    <PackageReference Include="System.Formats.Cbor" />
  </ItemGroup>

  <!-- Snapshot rehydration is internal (store-only). Host EF store (web-infrastructure) and its
       dual-fixture contract tests call Snapshot; library stays EF-free (task 104-032). -->
  <ItemGroup>
    <InternalsVisibleTo Include="web-infrastructure" />
    <InternalsVisibleTo Include="web-infrastructure-tests" />
  </ItemGroup>
</Project>
