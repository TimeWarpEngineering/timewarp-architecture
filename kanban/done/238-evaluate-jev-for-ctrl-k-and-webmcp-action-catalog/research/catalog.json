{
  "contract": {
    "opt_in": "New CatalogAction (or CatalogTool) attribute on the Action nested type. Not [TrackAction]. Not [TrackEvent].",
    "fields": ["name", "description", "inputSchema", "execute", "visibility"],
    "description_ssot": "Purpose region first sentence, or a small CatalogDescription attribute. Not Jev. Not hollow XML (architecture 177).",
    "input_schema_source": "Action ctor parameters (ActionSet generator already reads these). Do not ask Jev to invent JSON Schema.",
    "execute": "Generated ActionSet method: State.Method(args). Same method for Ctrl-K and WebMCP.",
    "visibility": "human | agent | both. Permissions stay in code (AuthorizeView / policy ids).",
    "not_catalog": ["[TrackAction] busy spinner", "Fetch* page-load", "Clear* sign-out internals", "inbound hub actions", "Debug", "template FiveSecondTask / TwoSecondTask", "ThrowException"]
  },
  "repo_split": {
    "timewarp_state": "Catalog attribute + harvest Purpose/attribute into catalog metadata + source-gen of name/description/inputSchema next to ActionSet Method.g.cs",
    "timewarp_architecture": "Ctrl-K overlay + hotkey on TimeWarpPage; navigator.modelContext.registerTool from the same catalog; later fill 104-019 tools[]"
  },
