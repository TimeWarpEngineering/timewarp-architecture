<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Compile-include of aspire-run.cs / aspire-deploy.cs / deploy-operate.cs / neon-connection.cs / db-nuke.cs / entra-setup.cs / entra-tenants.cs / jaribu-aggregator-summary-gate.cs / template-smoke-content-assets.cs / xai-preflight.cs / dotnet-test-arguments.cs / generated-ingress-prefixes.cs / test-groups.cs / aspire-publish-targets.cs / test-parallelism.cs / skill-spec-lint.cs
         (with in-proc-test-ports.cs, which test-parallelism.cs uses)
         (pure helpers). Monorepo-only:
         template.json excludes this tree. The slnx tests/tools folder is gated by a template
         false condition so generated apps do not list a project the template strips. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);CA1707;CA1849;IDE0021;IDE0058</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TimeWarp.Jaribu.TestingPlatform" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\tools\dev-cli\services\aspire-run.cs" Link="services\aspire-run.cs" />
