<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Compile-include of aspire-run.cs / aspire-deploy.cs / deploy-operate.cs / db-nuke.cs / entra-setup.cs / entra-tenants.cs / jaribu-aggregator-summary-gate.cs / template-smoke-content-assets.cs / xai-preflight.cs
         (pure helpers). Monorepo-only:
         template.json excludes this tree. The slnx tests/tools folder is gated by a template
         false condition so generated apps do not list a project the template strips. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);CA1707;CA1849;IDE0021;IDE0058</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TimeWarp.Jaribu.TestingPlatform" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\tools\dev-cli\services\aspire-run.cs" Link="services\aspire-run.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\aspire-deploy.cs" Link="services\aspire-deploy.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\deploy-operate.cs" Link="services\deploy-operate.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\db-ef.cs" Link="services\db-ef.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\db-nuke.cs" Link="services\db-nuke.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\template-nupkg.cs" Link="services\template-nupkg.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\entra-setup.cs" Link="services\entra-setup.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\entra-tenants.cs" Link="services\entra-tenants.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\jaribu-aggregator-summary-gate.cs" Link="services\jaribu-aggregator-summary-gate.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\template-smoke-content-assets.cs" Link="services\template-smoke-content-assets.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\xai-preflight.cs" Link="services\xai-preflight.cs" />
  </ItemGroup>
</Project>
