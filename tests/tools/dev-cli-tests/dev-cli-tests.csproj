<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Compile-include of aspire-run.cs / aspire-version-sources.cs / services/deploy/*.cs (AspireDeploy, DeployOperate, and their records) / neon-connection.cs / db-nuke.cs / services/entra/*.cs (EntraSetup, EntraTenants, and their records) / jaribu-aggregator-summary-gate.cs / template-smoke-content-assets.cs / xai-preflight.cs / dotnet-test-arguments.cs / test-project-selection.cs / test-file-selection.cs / generated-ingress-prefixes.cs / feature-filename-grammar-generator.cs / test-groups.cs / aspire-publish-targets.cs / test-parallelism.cs / skill-spec-lint.cs / workflow-path-classes.cs / green-key.cs / build-output.cs / app-features.cs
         (with in-proc-test-ports.cs, which test-parallelism.cs uses)
         (pure helpers). Monorepo-only:
         template.json excludes this tree. The slnx tests/tools folder is gated by a template
         false condition so generated apps do not list a project the template strips. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);CA1707;CA1849;IDE0021;IDE0058</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TimeWarp.Jaribu.TestingPlatform" />
    <PackageReference Include="Shouldly" />
    <!-- client-name-scan.cs runs git grep through Amuru, and app-features.cs finds the repo root and
         writes its refusal through it (TimeWarp.Terminal comes with Amuru). The other compile-includes
         stay free of it. -->
    <PackageReference Include="TimeWarp.Amuru" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\tools\dev-cli\services\aspire-run.cs" Link="services\aspire-run.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\aspire-version-sources.cs" Link="services\aspire-version-sources.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\deploy\*.cs" Link="services\deploy\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\tools\dev-cli\services\deploy-pipeline.cs" Link="services\deploy-pipeline.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\neon-connection.cs" Link="services\neon-connection.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\db-ef.cs" Link="services\db-ef.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\db-nuke.cs" Link="services\db-nuke.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\template-nupkg.cs" Link="services\template-nupkg.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\entra\*.cs" Link="services\entra\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\tools\dev-cli\services\jaribu-aggregator-summary-gate.cs" Link="services\jaribu-aggregator-summary-gate.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\template-smoke-content-assets.cs" Link="services\template-smoke-content-assets.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\xai-preflight.cs" Link="services\xai-preflight.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\dotnet-test-arguments.cs" Link="services\dotnet-test-arguments.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\test-project-selection.cs" Link="services\test-project-selection.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\test-file-selection.cs" Link="services\test-file-selection.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\generated-ingress-prefixes.cs" Link="services\generated-ingress-prefixes.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\feature-filename-grammar-generator.cs" Link="services\feature-filename-grammar-generator.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\test-groups.cs" Link="services\test-groups.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\aspire-publish-targets.cs" Link="services\aspire-publish-targets.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\test-parallelism.cs" Link="services\test-parallelism.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\skill-spec-lint.cs" Link="services\skill-spec-lint.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\client-name-scan.cs" Link="services\client-name-scan.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\workflow-path-classes.cs" Link="services\workflow-path-classes.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\green-key.cs" Link="services\green-key.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\build-output.cs" Link="services\build-output.cs" />
    <Compile Include="..\..\..\tools\dev-cli\services\app-features.cs" Link="services\app-features.cs" />
    <Compile Include="..\..\common\timewarp-testing\in-proc-test-ports.cs" Link="services\in-proc-test-ports.cs" />
  </ItemGroup>
</Project>
