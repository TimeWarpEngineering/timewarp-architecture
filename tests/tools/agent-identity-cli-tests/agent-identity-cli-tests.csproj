<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Only CA1031 fires under the linked service sources (audited 2026-07-20): best-effort
         File.SetUnixFileMode chmod-tighten blocks catch Exception so a permission failure can't
         crash key writing. The other suppressions this once carried were dead. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);CA1031;CA1707;CA1849;IDE0021;IDE0058</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TimeWarp.Jaribu.TestingPlatform" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\source\libraries\timewarp-identity\timewarp-identity.csproj" />
  </ItemGroup>
  <!-- Prefer compile-include of pure services (no HTTP) over a thin core project (task 104-029). -->
  <ItemGroup>
    <Compile Include="..\..\..\tools\agent-identity-cli\services\agent-signing.cs" Link="services\agent-signing.cs" />
    <Compile Include="..\..\..\tools\agent-identity-cli\services\agent-wire-dtos.cs" Link="services\agent-wire-dtos.cs" />
    <Compile Include="..\..\..\tools\agent-identity-cli\services\cli-json.cs" Link="services\cli-json.cs" />
    <Compile Include="..\..\..\tools\agent-identity-cli\services\local-key-store.cs" Link="services\local-key-store.cs" />
    <Compile Include="..\..\..\tools\agent-identity-cli\services\path-defaults.cs" Link="services\path-defaults.cs" />
  </ItemGroup>
</Project>
