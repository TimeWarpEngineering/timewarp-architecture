<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Host-free domain unit suite (task 145-007): suite-shaped under tests/, Jaribu MTP. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- .NET 10 MTP-native dotnet test — pair with project-local global.json test.runner
         project-local MTP runner; timewarp-jaribu#20: mirror root SDK pin. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Jaribu SUT_/Action_Given_ naming uses underscores (CA1707). -->
    <NoWarn>$(NoWarn);CA1707;CA1849;IDE0021;IDE0058</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TimeWarp.Jaribu.TestingPlatform" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\source\container-apps\web\projects\web-domain\web-domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="TimeWarp.Jaribu" />
    <Using Include="TimeWarp.Jaribu.TestRunner" Static="true" />
  </ItemGroup>
</Project>
