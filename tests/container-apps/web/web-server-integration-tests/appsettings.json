{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Grpc": "Debug"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "Api": {
        "Destinations": {
          "Api1": {
            "Address": "https://localhost:7255"
          }
        }
      },
      "Web": {
        "Destinations": {
          "Web1": {
            "Address": "https://localhost:7000"
          }
        }
      }
    },
    "Routes": {
      "ApiRoute": {
        "ClusterId": "Api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "WebRoute": {
        "ClusterId": "Web",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    }
  },
  "AzureAd": {
    "Instance": "https://thefreezeteam.b2clogin.com/",
    "ClientId": "f61bdae5-1d7e-4bab-8a51-ccf0c28db536",
    "Domain": "thefreezeteam.onmicrosoft.com",
    "SignUpSignInPolicyId": "B2C_1_SignUpSignIn"
  },
  "ServiceCollectionOptions": {
    "web-server": {
      "protocol": "https",
      "host": "localhost",
      "port": "7000"
    },
    "api-server": {
      "protocol": "https",
      "host": "localhost",
      "port": "7000"
    },
    "grpc-server": {
      "protocol": "https",
      "host": "localhost",
      "port": "7227"
    }
  },
  "SampleOptions": {
    "SampleOption": "SampleValue"
  },
