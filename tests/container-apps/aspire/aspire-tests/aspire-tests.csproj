<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Closed-box Aspire topology suite (task 145-003): suite-shaped under tests/, Jaribu MTP.
         Hybrid policy keeps topology tests here rather than co-located under features/. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- .NET 10 MTP-native dotnet test — pair with project-local global.json test.runner
         project-local MTP runner; timewarp-jaribu#20: mirror root SDK pin. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Jaribu SUT_/Action_Given_ naming uses underscores (CA1707); static SetupOnce/CleanUpOnce. -->
    <NoWarn>$(NoWarn);CA1707;CA1849;IDE0021;IDE0058</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="TimeWarp.Jaribu.TestingPlatform" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <!-- Task 266: dev db nuke resolves this AppHost's volumes by name prefix; the model test proves
       that prefix equals what Aspire actually generates (pure helper, no Amuru/Terminal). Only
       where the dev CLI source exists (template smoke output carries no tools/ tree). -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\tools\dev-cli\services\db-nuke.cs')">
    <DefineConstants>$(DefineConstants);DEV_CLI_SOURCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\tools\dev-cli\services\db-nuke.cs')">
    <Compile Include="..\..\..\..\tools\dev-cli\services\db-nuke.cs" Link="dev-cli\db-nuke.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\source\container-apps\aspire\projects\aspire-app-host\aspire-app-host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Aspire.Hosting.Testing" />
    <Using Include="Shouldly" />
    <Using Include="TimeWarp.Jaribu" />
    <Using Include="TimeWarp.Jaribu.TestRunner" Static="true" />
  </ItemGroup>
</Project>
