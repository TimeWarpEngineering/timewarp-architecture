<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Composed platform package IDs (task 115). Guarded: projects also import via Directory.Build.props. -->
  <Import Project="$(MSBuildThisFileDirectory)msbuild/timewarp-platform-packages.props" Condition="'$(_TwPlatformPackagesPropsImported)' != 'true'" />


  <!-- Central Package Management - add your package versions here -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- One Aspire version. The AppHost SDK (Sdk Version="$(AspireVersion)"), every Aspire.*
         package pin, and the CI Aspire.Cli install read this. Preview packages keep their own
         build suffix after the property: $(AspireVersion)-preview… -->
    <AspireVersion>13.6.4</AspireVersion>
  </PropertyGroup>
  <ItemGroup Label="TimeWarp Packages">
    <!-- Nuru stays on the 4.0.0 betas: `ganda nuget outdated` treats stable 3.0.0 as current, but the
         `ganda repo audit` nuru check requires the 4.0.0 line and blocks signing on 3.0.0 (task 389). -->
    <PackageVersion Include="TimeWarp.Nuru" Version="4.0.0-beta.11" />
    <PackageVersion Include="TimeWarp.Nuru.DevCli" Version="4.0.0-beta.11" />
    <PackageVersion Include="TimeWarp.Amuru" Version="2.0.0" />
    <PackageVersion Include="TimeWarp.Amuru.Tools" Version="2.0.0" />
    <PackageVersion Include="TimeWarp.Terminal" Version="1.0.2" />
    <PackageVersion Include="TimeWarp.Build.Tasks" Version="1.0.0" />
    <PackageVersion Include="TimeWarp.Components" Version="1.0.0-beta.2" />
    <!-- Foundation packages (task 051). Used ONLY by an app generated from the template (the repo
         itself uses project refs). Per task-124 policy, these pins equal the release <Version> and
         bump in the same commit as it — packages and template publish together in one release run,
         so pins always reference versions that exist by the time a generated app restores. -->
    <PackageVersion Include="TimeWarp.Foundation.Domain" Version="2.0.0-beta.32" />
    <PackageVersion Include="TimeWarp.Foundation.Contracts" Version="2.0.0-beta.32" />
    <PackageVersion Include="TimeWarp.Foundation.Application" Version="2.0.0-beta.32" />
    <PackageVersion Include="TimeWarp.Foundation.Infrastructure" Version="2.0.0-beta.32" />
    <PackageVersion Include="TimeWarp.Foundation.Server" Version="2.0.0-beta.32" />
    <PackageVersion Include="TimeWarp.Modules" Version="2.0.0-beta.32" />
    <!-- Analyzer/generator packages (task 092). Package IDs composed via properties so template
         sourceName cannot rewrite them (task 115). Per task-124 policy, these pins equal the
         release <Version> and bump in the same commit as it. -->
    <PackageVersion Include="$(TwArchitectureAnalyzersPackageId)" Version="2.0.0-beta.32" />
    <PackageVersion Include="$(TwArchitectureGeneratorsPackageId)" Version="2.0.0-beta.32" />
    <PackageVersion Include="$(TwArchitectureAttributesPackageId)" Version="2.0.0-beta.32" />
    <!-- TimeWarp.Identity has been published since 2.0.0-beta.6 (task 124). Per task-124 policy,
         this pin equals the release <Version> and bumps in the same commit as it, same as the
         TimeWarp.Foundation.* and analyzer/generator pins above. This pin is inert for this
         repo/CI (UseIdentityPackages resolves to ProjectReference mode when identity source is
         present) and only matters for package-mode consumers (generated apps always package-mode). -->
    <PackageVersion Include="TimeWarp.Identity" Version="2.0.0-beta.32" />
    <!-- TimeWarp.402: packed by the release run (workflow-command.cs) and template-smoke's local
         feed; first nuget.org publish rides the next release. Same task-124 pin policy as
         TimeWarp.Identity above — equals <Version>, bumps in the same commit (task 104-035). -->
    <PackageVersion Include="TimeWarp.402" Version="2.0.0-beta.32" />
    <PackageVersion Include="TimeWarp.Multiavatar" Version="1.0.0-beta.13" />
    <!-- TimeWarp.Contracts ships from TimeWarpEngineering/timewarp-contracts (its task 002,
         2.0.0-beta.30). Consumer pin only: check-version reads packable projects under source/,
         and this id is absent from msbuild/timewarp-platform-packages.props and from
         PlatformPinIncludeFragments. Leave the version on the contracts release line. -->
    <PackageVersion Include="TimeWarp.Contracts" Version="2.0.0-beta.31" />
  </ItemGroup>
  <ItemGroup Label="Microsoft Extensions Packages">
    <!-- Configuration.Abstractions, DependencyInjection.Abstractions, Hosting.Abstractions, and
         Logging.Abstractions, and Options are in the net11 shared framework. Direct
         PackageReferences to them are NU1510, so those pins are gone. A co-located runfile must
         not take Options with a #:package directive either.
         Shared-framework Microsoft.* and System.* pins on this train are 11.0.0-rc.3.26522.148,
         matching SDK 11.0.100-rc.3.26522.148. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0-rc.3.26522.148" />
    <!-- Extensions monthly package. No 11.x, so the pin is 10.11.0. -->
    <PackageVersion Include="Microsoft.Extensions.Telemetry.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="System.Threading.RateLimiting" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>
  <ItemGroup Label="Foundation Packages">
    <PackageVersion Include="Ardalis.GuardClauses" Version="[5.0.0]" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="libphonenumber-csharp" Version="9.0.42" />
    <PackageVersion Include="OneOf" Version="3.0.271" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.85.0" />
    <PackageVersion Include="Grpc.AspNetCore.Server.Reflection" Version="2.85.0" />
    <PackageVersion Include="Grpc.AspNetCore.Web" Version="2.85.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.85.0" />
    <PackageVersion Include="Grpc.Net.Client.Web" Version="2.85.0" />
    <PackageVersion Include="protobuf-net.Grpc" Version="1.3.14" />
    <PackageVersion Include="protobuf-net.Grpc.AspNetCore" Version="1.3.14" />
    <PackageVersion Include="protobuf-net.Grpc.AspNetCore.Reflection" Version="1.3.14" />
    <PackageVersion Include="protobuf-net.Grpc.Reflection" Version="1.3.14" />
    <!-- No 11.x. The pin is 10.1.0. -->
    <PackageVersion Include="System.ServiceModel.Primitives" Version="10.1.0" />
    <!-- Yarp / Reverse Proxy (used by Yarp gateway and Aspire.AppHost) -->
    <PackageVersion Include="Aspire.Hosting.Yarp" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <!-- Task 070-003: Docker Compose publish environment (AddDockerComposeEnvironment). Publish-only. -->
    <PackageVersion Include="Aspire.Hosting.Docker" Version="$(AspireVersion)" />
    <!-- Task 070-007: Azure Container Apps publish environment (AddAzureContainerAppEnvironment → Bicep) and
         Azure Database for PostgreSQL Flexible Server. Publish-only (Publish:Target=aca); run mode never declares them. -->
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.PostgreSQL" Version="$(AspireVersion)" />
    <!-- Preview: task 070-004 Kubernetes publish environment (AddKubernetesEnvironment → Helm chart). Publish-only.
         The prefix is AspireVersion. The preview build suffix is this package's own build (no stable release of it). -->
    <PackageVersion Include="Aspire.Hosting.Kubernetes" Version="$(AspireVersion)-preview.1.26523.11" />
    <!-- Preview: AppHost AddEFMigrations resource (task 147-007). Same AspireVersion prefix; own preview build suffix. -->
    <PackageVersion Include="Aspire.Hosting.EntityFrameworkCore" Version="$(AspireVersion)-preview.1.26523.11" />
    <!-- Extensions monthly package. No 11.x, so the pin is 10.11.0. -->
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.11.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- Aspire AppHost -->
    <!-- No first-party code calls MessagePack APIs directly; this pin only lifts StreamJsonRpc's
         transitive MessagePack dependency for flag-off graphs (no Yarp) where Aspire.Hosting.Yarp
         isn't present to do the lift itself (see aspire-app-host.csproj). Bumped 2.5.302 -> 3.1.8
         (task 144), 3.1.10 (task 249): StreamJsonRpc 2.25.29's own nuspec already floors MessagePack at >=2.5.302
         (no upper bound), and aspire-tests (DistributedApplicationTestingBuilder spinning up the
         real AppHost + an HTTP round-trip through api-server) passed 7/7 against MessagePack 3.1.8,
         verifying the DCP/StreamJsonRpc communication path tolerates the v3 major. -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0-rc.3.26522.148" />
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL 11.0.0-rc.3 pins Microsoft.EntityFrameworkCore
         exactly at 11.0.0-rc.3.26522.148. Move that package with the EF family
         (Microsoft.EntityFrameworkCore*, Microsoft.AspNetCore.DataProtection.EntityFrameworkCore,
         Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore). Moving the EF
         family alone fails restore (NU1608/NU1107). -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />

    <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0-rc.3.26522.148" />
    <!-- Microsoft/MIT, BCL-adjacent (System.Formats.Cbor.dll ships in the ASP.NET Core shared
         framework too) — used by timewarp-identity's hand-rolled WebAuthn verifier (task 104-003)
         to parse attestationObject/authenticatorData COSE keys. timewarp-identity is a plain
         library (no FrameworkReference to the shared framework), so it needs the explicit package. -->
    <PackageVersion Include="System.Formats.Cbor" Version="11.0.0-rc.3.26522.148" />
    <!-- 15.0 reuses the id TimeWarp.Mediator for the contracts assembly and ships TWM001–TWM004
         inside that package. TimeWarp.Mediator.Contracts and TimeWarp.Mediator.Analyzers stop at
         14.0.0. TimeWarp.Nuru 4.0.0-beta.11 still restores Contracts 14 transitively for dev-cli;
         that dependency is not a direct pin. -->
    <PackageVersion Include="TimeWarp.Mediator" Version="15.0.0-beta.4" />
    <PackageVersion Include="TimeWarp.Mediator.Generators" Version="15.0.0-beta.4" />
    <!-- FastEndpoints.OpenApi 9.0.0-beta.7 (net11.0) depends on Microsoft.AspNetCore.OpenApi
         >= 11.0.0-rc.3.26522.148, the same as this repo's ASP.NET Core train. That package allows
         Microsoft.OpenApi [3.10.2, 4.0.0). The foundation-server Microsoft.OpenApi reference lifts
         that 3.10.2 floor to the 3.11.0 pin. -->
    <PackageVersion Include="FastEndpoints" Version="9.0.0-beta.7" />
    <PackageVersion Include="FastEndpoints.OpenApi" Version="9.0.0-beta.7" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
    <PackageVersion Include="Timewarp.OptionsValidation" Version="1.0.0-beta.5" />
    <PackageVersion Include="BlazorComponentUtilities" Version="1.8.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.QuickGrid" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.AI" Version="0.1.0-preview.1.26466.103" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
    <!-- Extensions monthly packages (Microsoft.Extensions.AI and Microsoft.Extensions.AI.OpenAI).
         No 11.x, so the pins are 10.11.0. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <!-- Chat completions against api.x.ai. Pinned beside Microsoft.Extensions.AI (10.11.0, task 389).
         Do not float onto the Responses API. TypeLoadExceptions on tool calls when OpenAI 2.14
         is resolved (GlobalMcpToolCallApprovalPolicy) were observed on adapter 10.10.0 and were
         not re-checked on 10.11.0. -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.1" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.0.1" />
    <!-- Task 201: take 7.0.1 (native tsc-go). web-spa.csproj runs SetTscExecutable +
         RunTscCompile before ResolveProjectStaticWebAssets; classic CheckFileSystemCaseSensitive
         is gone (MSB4057 if those v6 target names stay in PrepareForBuildDependsOn). -->
    <PackageVersion Include="Microsoft.TypeScript.MSBuild" Version="7.0.1" />
    <PackageVersion Include="Morris.Blazor.ControlFlow" Version="2.2.0" />
    <PackageVersion Include="Blazilla" Version="2.4.3" />
    <!-- Task 353: CommonMark parser for SafeMarkdown. Raw HTML is off and the SPA renders the AST
         itself, so no HTML string from Markdig reaches the DOM. -->
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="TimeWarp.State" Version="12.0.0-beta.16" />
    <PackageVersion Include="TimeWarp.State.Blazor" Version="12.0.0-beta.16" />
    <PackageVersion Include="TimeWarp.State.Plus" Version="12.0.0-beta.16" />
    <!-- Task 335-001: State DevTools. Telemetry weaves the action-span behavior into web-spa's
         ClientPipeline; Export (web-server, Development) ships those spans to the inspector that
         DevTools.Hosting starts from the AppHost in run mode. Same version as the State pins. -->
    <PackageVersion Include="TimeWarp.State.Telemetry" Version="12.0.0-beta.16" />
    <PackageVersion Include="TimeWarp.State.DevTools.Export" Version="12.0.0-beta.16" />
    <PackageVersion Include="TimeWarp.State.DevTools.Hosting" Version="12.0.0-beta.16" />
    <!-- Task 335-002: browser (WASM) exporter. web-spa references it in Debug only. -->
    <PackageVersion Include="TimeWarp.State.DevTools.Wasm" Version="12.0.0-beta.16" />
    <PackageVersion Include="timewarp-heroicons" Version="2.2.0" />
    <PackageVersion Include="timewarp-simple-icons" Version="16.36.0" />
  </ItemGroup>

  <ItemGroup Label="Aspire Packages">
    <!-- Extensions monthly packages (Compliance.Redaction, Http.Resilience, ServiceDiscovery,
         Telemetry). No 11.x, so the pins are 10.11.0. -->
    <PackageVersion Include="Microsoft.Extensions.Compliance.Redaction" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Telemetry" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>
  
  <ItemGroup Label="Code Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- Move file-level usings into per-project global-usings.cs (BDSoftware; nuru/tui/flexbox pin). Task 172. -->
    <PackageVersion Include="GlobalUsingsAnalyzer" Version="1.4.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
  </ItemGroup>
  <!-- Versions for test projects pending migration to the root tree (task 053-050-019).
       Sourced from TimeWarp.Architecture/Directory.Packages.props; family-versioned
       packages (ASP.NET Core, Aspire) aligned with the pins above. -->
  <ItemGroup Label="Test Packages">
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireVersion)" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="AutoFixture.AutoFakeItEasy" Version="4.18.1" />
    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.3.26522.148" />
    <!-- Extensions monthly package. No 11.x, so the pin is 10.11.0. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <!-- Lifts Analyzer.Testing 1.1.4's transitive NuGet.Packaging dependency past
         GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7 (NU1902/NU1903). Task 389 takes 10.0.13,
         the latest `ganda nuget outdated` reported then (9.0.21 was the first patched 9.x).
         Task 456 takes 10.0.14.
         Referenced directly by the two analyzer test projects. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="TimeWarp.Jaribu" Version="1.0.0-beta.15" />
    <PackageVersion Include="TimeWarp.Jaribu.TestingPlatform" Version="1.0.0-beta.15" />
    <PackageVersion Include="TimeWarp.SourceGenerators" Version="1.0.0-beta.11" />
  </ItemGroup>
</Project>


