<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Suppress warnings that don't apply to CLI tools.
         IDE0211 is a .NET 11 file-based-app false positive: dev.cs stays top-level so
         `dotnet run tools/dev-cli/dev.cs` (CI workflow + template-smoke) keeps working.
         A Program.Main rewrite would not be that runfile.
         The IDE style rules that fire only in TimeWarp.Nuru.DevCli content files are not listed:
         tools/Directory.Build.props exempts package content by path (task 470), so they stay on
         for this repo's own CLI code. IDE0005 is the exception: it needs the XML documentation file
         to run on build, and the dev CLI turns that file off (below), so the SDK would report
         EnableGenerateDocumentationFile instead. -->
    <NoWarn>$(NoWarn);CA1031;CA1034;CA1303;CA1508;CA1515;CA1849;CA2007;CA2016;CA2000;CA5399;RCS1046;IDE0005;IDE0211</NoWarn>

    <!-- No XML documentation file. The root props turn GenerateDocumentationFile on only so IDE0005
         (unnecessary usings) can run during build (Roslyn #41640). The dev CLI does not keep the
         file, so IDE0005 is in NoWarn above. On the .NET 11 RC2 SDK the runfile's AOT publish
         (`dev self-install`) failed with MSB3030, because it looked for bin/release/dev.xml, which
         the build only wrote under obj/release (task 364). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- AOT Support -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Enable interceptors for TimeWarp.Nuru source generator -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);TimeWarp.Nuru.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <!-- The template pack ships this CLI to every generated app (task 530). .template.config/template.json
       excludes the template-only command files. -->
  <!--#if (templateRepository)-->
  <!-- Template repository only: the computed templateRepository symbol (false at generation) strips
       this block from generated apps. Here it sets DevCliTemplateRepository and the C# constant of the
       same symbol, so the template-only regions of shared files compile; TWA0010 checks that agreement. -->
  <PropertyGroup Label="Template repository">
    <DevCliTemplateRepository>true</DevCliTemplateRepository>
    <DefineConstants>$(DefineConstants);templateRepository</DefineConstants>
  </PropertyGroup>
  <!--#endif-->

  <!-- check-version and release are TimeWarp.Nuru.DevCli content endpoints. They cut a NuGet release
       from source/Directory.Build.props; a generated app publishes no packages, so its CLI compiles
       without them. The package props add these Compile items after this file is read, so the removal
       runs as a target before the compiler (and the endpoint generator) sees them. -->
  <Target Name="RemoveTemplateRepositoryOnlyPackageEndpoints"
          BeforeTargets="CoreCompile"
          Condition="'$(DevCliTemplateRepository)' != 'true' and '$(NuruDevCliContentDirectory)' != ''">
    <!-- Same spelling as the package's own Compile Include ($(NuruDevCliContentDirectory) is that
         include's directory): a target-time Remove matches the item text, so a normalized FullPath
         would not match. -->
    <ItemGroup>
      <Compile Remove="$(NuruDevCliContentDirectory)endpoints/check-version-command.cs" />
      <Compile Remove="$(NuruDevCliContentDirectory)endpoints/release-command.cs" />
      <Compile Remove="$(NuruDevCliContentDirectory)endpoints/release-command.guards.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Include command files in compilation -->
    <Compile Include="global-usings.cs" />
    <Compile Include="endpoints/**/*.cs" />
    <Compile Include="services/**/*.cs" />
    <!-- InProcTestPorts is the one place the in-proc test port base is decided (task 330).
         `dev test` and template-smoke compile it in and export its result to child processes. -->
    <Compile Include="../../tests/common/timewarp-testing/in-proc-test-ports.cs" Link="services/in-proc-test-ports.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Package references -->
    <PackageReference Include="TimeWarp.Nuru" />
    <PackageReference Include="TimeWarp.Nuru.DevCli" />
    <PackageReference Include="TimeWarp.Amuru" />
    <PackageReference Include="TimeWarp.Amuru.Tools" />
    <PackageReference Include="TimeWarp.Terminal" />
  </ItemGroup>

</Project>
