<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Suppress warnings that don't apply to CLI tools.
         IDE0211 is a .NET 11 file-based-app false positive: dev.cs stays top-level so
         `dotnet run tools/dev-cli/dev.cs` (CI workflow + template-smoke) keeps working.
         A Program.Main rewrite would not be that runfile.
         IDE0005/IDE0022/IDE0046/IDE0055/IDE0058/IDE0065/IDE0066/IDE0078/IDE0160/IDE0290 fire in
         TimeWarp.Nuru.DevCli content files that this runfile compiles in. Those sources live in
         the NuGet package (outside this repo, so .editorconfig cannot mark them generated) and
         follow the package's style. Our own CLI files do not emit these ids under `dotnet build dev.cs`. -->
    <NoWarn>$(NoWarn);CA1031;CA1034;CA1303;CA1508;CA1515;CA1849;CA2007;CA2016;CA2000;CA5399;RCS1046;IDE0005;IDE0022;IDE0046;IDE0055;IDE0058;IDE0065;IDE0066;IDE0078;IDE0160;IDE0211;IDE0290</NoWarn>

    <!-- No XML documentation file. The root props turn GenerateDocumentationFile on only so IDE0005
         (unnecessary usings) can run during build (Roslyn #41640); IDE0005 is in NoWarn above, so the
         dev CLI has no use for the file. On the .NET 11 RC2 SDK the runfile's AOT publish
         (`dev self-install`) failed with MSB3030: it looked for bin/release/dev.xml, which the build
         only wrote under obj/release (task 364). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- AOT Support -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Enable interceptors for TimeWarp.Nuru source generator -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);TimeWarp.Nuru.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include command files in compilation -->
    <Compile Include="global-usings.cs" />
    <Compile Include="endpoints/**/*.cs" />
    <Compile Include="services/**/*.cs" />
    <!-- InProcTestPorts is the one place the in-proc test port base is decided (task 330).
         `dev test` and template-smoke compile it in and export its result to child processes. -->
    <Compile Include="../../tests/common/timewarp-testing/in-proc-test-ports.cs" Link="services/in-proc-test-ports.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Package references -->
    <PackageReference Include="TimeWarp.Nuru" />
    <PackageReference Include="TimeWarp.Nuru.DevCli" />
    <PackageReference Include="TimeWarp.Amuru" />
    <PackageReference Include="TimeWarp.Amuru.Tools" />
    <PackageReference Include="TimeWarp.Terminal" />
  </ItemGroup>

</Project>
